<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="module_category_assembly" model="ir.module.category">
        <field name="name">Assembly</field>
        <field name="description">Assembly Management</field>
        <field name="sequence" eval="50" />
    </record>

    <record id="assembly_group_user" model="res.groups">
        <field name="name">Assembly User</field>
        <field name="category_id" ref="module_category_assembly"/>
        <field name="comment">Assembly member access: read assemblies and agenda, register own attendance, and cast own votes. Record rules limit attendee, delegation, representation, and voting-line rows to the user's own partner. Base level of the Assembly category.</field>
    </record>
    <record id="assembly_group_manager" model="res.groups">
        <field name="name">Assembly Manager</field>
        <field name="category_id" ref="module_category_assembly"/>
        <field name="implied_ids" eval="[(4, ref('assembly_group_user'))]"/>
        <field name="comment">Full access to all assembly records. Includes Assembly User and sees every row in the allowed companies (permissive record rules). Granted automatically to Settings / Administration.</field>
    </record>

    <!-- Settings / Administration users get Assembly Manager (which implies Assembly User) -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('assembly_group_manager'))]"/>
    </record>
</odoo>
