<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Groups -->
    <!-- Assembly category -->
    <record id="module_category_assembly" model="ir.module.category">
        <field name="name">Assembly</field>
        <field name="description">Assembly Management</field>
        <field name="sequence">50</field>
    </record>

    <record id="assembly_group_user" model="res.groups">
        <field name="name">Assembly User</field>
        <field name="category_id" ref="module_category_assembly"/>
        <field name="comment">Read-only on assemblies, agenda, delegations, votings, results. Read/write/create attendees (no unlink); record rules limit attendee rows to the user&apos;s own partner, so bulk or third-party lines are blocked at rule level. May create own voting lines (cast vote); no write/unlink on those lines. Not implied by Assembly Manager—assign groups separately.</field>
    </record>
    <record id="assembly_group_manager" model="res.groups">
        <field name="name">Assembly Manager</field>
        <field name="category_id" ref="module_category_assembly"/>
        <field name="comment">Full CRUD on assembly models (ACL). Implied by Settings / Administration (base.group_system). Does not imply Assembly User; if both groups are assigned, permissive manager ir.rule ORs with user rules so back-office rows stay visible.</field>
    </record>

    <!-- Multi-company: one rule per model (no groups = all users with ACL on that model). -->
    <record id="assembly_type_rule_multicompany" model="ir.rule">
        <field name="name">assembly.type: multi-company</field>
        <field name="model_id" ref="model_assembly_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_assembly_rule_multicompany" model="ir.rule">
        <field name="name">assembly.assembly: multi-company</field>
        <field name="model_id" ref="model_assembly_assembly"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_agenda_rule_multicompany" model="ir.rule">
        <field name="name">assembly.agenda: multi-company</field>
        <field name="model_id" ref="model_assembly_agenda"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_agenda_option_rule_multicompany" model="ir.rule">
        <field name="name">assembly.agenda.option: multi-company</field>
        <field name="model_id" ref="model_assembly_agenda_option"/>
        <field name="domain_force">[('agenda_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_attendee_rule_multicompany" model="ir.rule">
        <field name="name">assembly.attendee: multi-company</field>
        <field name="model_id" ref="model_assembly_attendee"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_delegation_rule_multicompany" model="ir.rule">
        <field name="name">assembly.delegation: multi-company</field>
        <field name="model_id" ref="model_assembly_delegation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_representation_rule_multicompany" model="ir.rule">
        <field name="name">assembly.representation: multi-company</field>
        <field name="model_id" ref="model_assembly_representation"/>
        <field name="domain_force">[('assembly_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_voting_rule_multicompany" model="ir.rule">
        <field name="name">assembly.voting: multi-company</field>
        <field name="model_id" ref="model_assembly_voting"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_voting_line_rule_multicompany" model="ir.rule">
        <field name="name">assembly.voting.line: multi-company</field>
        <field name="model_id" ref="model_assembly_voting_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_voting_result_rule_multicompany" model="ir.rule">
        <field name="name">assembly.voting.result: multi-company</field>
        <field name="model_id" ref="model_assembly_voting_result"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="assembly_attendee_vote_rule_multicompany" model="ir.rule">
        <field name="name">assembly.attendee.vote: multi-company</field>
        <field name="model_id" ref="model_assembly_attendee_vote"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!--
      Assembly User: further scope to the logged-in partner (AND with multi-company).
      Assembly Manager: permissive rule so ir.rule ORs with the user rule (Odoo combines
      group rules with OR). Users with both groups therefore see all rows in company,
      not only own-partner rows.
    -->
    <record id="assembly_attendee_rule_manager" model="ir.rule">
        <field name="name">assembly.attendee: manager sees all in company</field>
        <field name="model_id" ref="model_assembly_attendee"/>
        <field name="groups" eval="[(4, ref('assembly_group_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="assembly_attendee_rule_user" model="ir.rule">
        <field name="name">assembly.attendee: user sees own partner row</field>
        <field name="model_id" ref="model_assembly_attendee"/>
        <field name="groups" eval="[(4, ref('assembly_group_user'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="assembly_delegation_rule_manager" model="ir.rule">
        <field name="name">assembly.delegation: manager sees all in company</field>
        <field name="model_id" ref="model_assembly_delegation"/>
        <field name="groups" eval="[(4, ref('assembly_group_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="assembly_delegation_rule_user" model="ir.rule">
        <field name="name">assembly.delegation: user sees own delegator rows</field>
        <field name="model_id" ref="model_assembly_delegation"/>
        <field name="groups" eval="[(4, ref('assembly_group_user'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="assembly_representation_rule_manager" model="ir.rule">
        <field name="name">assembly.representation: manager sees all in company</field>
        <field name="model_id" ref="model_assembly_representation"/>
        <field name="groups" eval="[(4, ref('assembly_group_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="assembly_representation_rule_user" model="ir.rule">
        <field name="name">assembly.representation: user sees owner or agent rows</field>
        <field name="model_id" ref="model_assembly_representation"/>
        <field name="groups" eval="[(4, ref('assembly_group_user'))]"/>
        <field name="domain_force">['|', ('owner_partner_id', '=', user.partner_id.id), ('agent_partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="assembly_voting_line_rule_manager" model="ir.rule">
        <field name="name">assembly.voting.line: manager sees all in company</field>
        <field name="model_id" ref="model_assembly_voting_line"/>
        <field name="groups" eval="[(4, ref('assembly_group_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="assembly_voting_line_rule_user" model="ir.rule">
        <field name="name">assembly.voting.line: user sees own attendee lines</field>
        <field name="model_id" ref="model_assembly_voting_line"/>
        <field name="groups" eval="[(4, ref('assembly_group_user'))]"/>
        <field name="domain_force">[('attendee_id.partner_id', '=', user.partner_id.id)]</field>
    </record>

</odoo>
