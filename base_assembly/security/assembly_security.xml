<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Groups -->
    <!-- Assembly category -->
    <record id="module_category_assembly" model="ir.module.category">
        <field name="name">Assembly</field>
        <field name="description">Assembly Management</field>
        <field name="sequence">50</field>
    </record>

    <record id="assembly_group_user" model="res.groups">
        <field name="name">Assembly User</field>
        <field name="category_id" ref="module_category_assembly"/>
        <field name="comment">Read-only on assemblies, agenda, attendees, delegations, votings, results. May create own voting lines (cast vote); no write/unlink on those lines. No create/write/unlink on attendees or delegations (managers use backend attendance links). Not implied by Assembly Manager—assign groups separately.</field>
    </record>
    <record id="assembly_group_manager" model="res.groups">
        <field name="name">Assembly Manager</field>
        <field name="category_id" ref="module_category_assembly"/>
        <field name="comment">Full CRUD on assembly models (ACL). Does not imply Assembly User: managers should not also assign User, or record rules for User would restrict them to own partner.</field>
    </record>

    <!--
      Record rules (assembly_group_user only): scope rows to the logged-in partner.
      Managers use Manager group only (no User) so these rules do not apply to them.
      No global rules; no portal/public groups on these rules.
    -->
    <record id="assembly_attendee_rule_user" model="ir.rule">
        <field name="name">assembly.attendee: user sees own partner row</field>
        <field name="model_id" ref="model_assembly_attendee"/>
        <field name="groups" eval="[(4, ref('assembly_group_user'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="assembly_delegation_rule_user" model="ir.rule">
        <field name="name">assembly.delegation: user sees own delegator rows</field>
        <field name="model_id" ref="model_assembly_delegation"/>
        <field name="groups" eval="[(4, ref('assembly_group_user'))]"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
    </record>
    <record id="assembly_voting_line_rule_user" model="ir.rule">
        <field name="name">assembly.voting.line: user sees own attendee lines</field>
        <field name="model_id" ref="model_assembly_voting_line"/>
        <field name="groups" eval="[(4, ref('assembly_group_user'))]"/>
        <field name="domain_force">[('attendee_id.partner_id', '=', user.partner_id.id)]</field>
    </record>

</odoo>
