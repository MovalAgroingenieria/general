<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_assembly_publication_default" model="mail.template">
        <field name="name">Assembly: publication (default)</field>
        <field name="description">AF v2.0 default convocation/publication layout for assembly.assembly.</field>
        <field name="subject">Assembly convocation: {{ object.name }}</field>
        <field name="model_id" ref="base_assembly.model_assembly_assembly"/>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div class="o_assembly_publication">
                <h2 t-out="object.name"/>
                <p t-if="object.date_first_call">
                    <span t-field="object.date_first_call"/>
                    <t t-if="object.location"> — <span t-field="object.location"/></t>
                </p>
                <div t-if="object.description" t-field="object.description"/>
            </div>
        </field>
    </record>
    <record id="mail_template_assembly_delegation_document_default" model="mail.template">
        <field name="name">Assembly: delegation document (default)</field>
        <field name="description">AF v2.0 default delegation PDF introduction.</field>
        <field name="subject">Vote delegation: {{ object.name }}</field>
        <field name="model_id" ref="base_assembly.model_assembly_assembly"/>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div class="o_assembly_delegation_intro">
                <p>Vote delegation form for the assembly <strong t-out="object.name"/>.</p>
                <p>Identify the delegator and the delegate below and specify the vote types delegated.</p>
            </div>
        </field>
    </record>
    <record id="mail_template_assembly_delegation_footer_default" model="mail.template">
        <field name="name">Assembly: delegation footer (default)</field>
        <field name="description">AF v2.0 default delegation PDF footer.</field>
        <field name="subject">Delegation footer: {{ object.name }}</field>
        <field name="model_id" ref="base_assembly.model_assembly_assembly"/>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div class="o_assembly_delegation_footer">
                <p>The delegator certifies the accuracy of the information above and authorizes the delegate to cast votes on their behalf for the indicated vote type(s).</p>
            </div>
        </field>
    </record>
    <record id="mail_template_assembly_ballot_intro_default" model="mail.template">
        <field name="name">Assembly: ballot introduction (default)</field>
        <field name="description">AF v2.0 default voting ballot introduction.</field>
        <field name="subject">Voting ballot: {{ object.name }}</field>
        <field name="model_id" ref="base_assembly.model_assembly_assembly"/>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div class="o_assembly_ballot_intro">
                <p>Voting ballot for <strong t-out="object.name"/>.</p>
                <p>Mark your choice clearly for each agenda item.</p>
            </div>
        </field>
    </record>
    <record id="mail_template_assembly_ballot_nominative_intro_default" model="mail.template">
        <field name="name">Assembly: nominative ballot introduction (default)</field>
        <field name="description">AF v2.0 default nominative ballot introduction.</field>
        <field name="subject">Nominative ballot: {{ object.name }}</field>
        <field name="model_id" ref="base_assembly.model_assembly_assembly"/>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div class="o_assembly_ballot_nominative_intro">
                <p>Personalized voting ballot for the assembly <strong t-out="object.name"/>.</p>
            </div>
        </field>
    </record>
</odoo>
