<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="assembly_document_preview_wizard_view_form" model="ir.ui.view">
        <field name="name">assembly.document.preview.wizard.form</field>
        <field name="model">assembly.document.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Preview rendered document">
                <group>
                    <field name="assembly_id"/>
                    <field name="document_type_whitelist" invisible="1"/>
                    <field name="document_category"/>
                    <field name="document_type"
                           widget="filterable_selection"
                           options="{'whitelist_fname': 'document_type_whitelist'}"/>
                </group>
                <div class="alert alert-secondary small mb-2 py-2" role="status">
                    <p class="mb-1">
                        <strong>How this preview works:</strong>
                        The document text on the assembly (seeded from the assembly type, with placeholders like <code>{{ object.name }}</code>) is rendered here. Use <strong>Refresh</strong> after editing the texts, agenda lines, or assembly fields.
                    </p>
                    <p class="mb-0 text-muted">
                        The framed area simulates a printed page; it is not a stored legal document.
                    </p>
                </div>
                <field name="preview_html" nolabel="1" colspan="2" force_save="1"/>
                <footer>
                    <button name="action_refresh_preview" string="Refresh" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_assembly_document_preview_wizard" model="ir.actions.act_window">
        <field name="name">Preview rendered document</field>
        <field name="res_model">assembly.document.preview.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="assembly_document_preview_wizard_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>
