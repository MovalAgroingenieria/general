<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wizard_preview_publicationtext_view_form" model="ir.ui.view">
        <field name="name">wizard.preview.publicationtext.form</field>
        <field name="model">wizard.preview.publicationtext</field>
        <field name="arch" type="xml">
            <form string="Preview">
                <group>
                    <field name="publication_text_preview" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
