<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Template: full attendees list -->
    <template id="report_assembly_attendance">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_attendance_doc_all"/>
        </t>
    </template>

    <!-- Template: present-only attendees list -->
    <template id="report_assembly_attendance_present">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_attendance_doc_present"/>
        </t>
    </template>

    <!-- Template: attendees list with delegated votes -->
    <template id="report_assembly_attendance_delegation">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_attendance_doc_delegation"/>
        </t>
    </template>

    <!-- Template: present-only list with delegations column -->
    <template id="report_assembly_attendance_present_delegation">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_attendance_doc_present_delegation"/>
        </t>
    </template>

    <template id="report_assembly_attendance_call_register">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_attendance_doc_call_register"/>
        </t>
    </template>

    <!-- Document: full attendees list -->
    <template id="report_assembly_attendance_doc_all">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="attendees" t-value="o.attendee_ids.sorted(key=lambda a: a.partner_id.name)"/>
                <div class="page o_assembly_report_attendance_all">
                    <h3 class="text-center"><strong>Attendees list (all)</strong></h3>
                    <t t-set="asm" t-value="o"/>
                    <t t-call="base_assembly.report_assembly_asm_meta_block"/>
                    <t t-call="base_assembly.report_assembly_operational_roster_note"/>
                    <table class="table table-sm table-bordered mt-2">
                        <thead>
                            <tr>
                                <th>Attendee</th>
                                <th>Represents</th>
                                <th>TIN</th>
                                <th>Attendance mode</th>
                                <th>Registered</th>
                                <th>Attendance status</th>
                                <th class="text-end">Total votes</th>
                                <th>Delegations received</th>
                                <th>Delegations given</th>
                                <th>Representation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="attendees" t-as="att">
                                <td><span t-field="att.partner_id" t-options="{'widget': 'contact', 'fields': ['name'], 'no_marker': True}"/></td>
                                <td>
                                    <t t-if="att.participant_partner_id and att.participant_partner_id != att.partner_id">
                                        <span t-field="att.participant_partner_id" t-options="{'widget': 'contact', 'fields': ['name'], 'no_marker': True}"/>
                                    </t>
                                    <t t-else="">–</t>
                                </td>
                                <td><span t-field="att.partner_id.vat"/></td>
                                <td><span t-field="att.attendance_type"/></td>
                                <td><span t-field="att.date_register" t-options="{'format': 'dd/MM/yyyy HH:mm'}"/></td>
                                <td><span t-field="att.attendee_state"/></td>
                                <td class="text-end">
                                    <t t-set="total" t-value="sum(att.attendee_vote_ids.mapped('attendee_vote_total'))"/>
                                    <span t-out="total"/>
                                </td>
                                <td>
                                    <t t-call="base_assembly.report_assembly_attendee_delegations_received_cell"/>
                                </td>
                                <td>
                                    <t t-call="base_assembly.report_assembly_attendee_delegations_given_cell"/>
                                </td>
                                <td>
                                    <t t-call="base_assembly.report_assembly_attendee_representation_cell"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-call="base_assembly.report_assembly_attendance_roster_footer"/>
                </div>
            </t>
        </t>
    </template>

