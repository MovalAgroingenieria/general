    <!-- 11.8 Individual call (document) -->
    <template id="report_assembly_attendee_individual_call">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_attendee_call_doc"/>
        </t>
    </template>

    <!-- 11.9 Individual call with votes (document) -->
    <template id="report_assembly_attendee_individual_call_votes">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_attendee_call_doc_votes"/>
        </t>
    </template>

    <template id="report_assembly_attendee_call_doc">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="assembly" t-value="o.assembly_id.with_context(lang=(o.partner_id.lang or 'en_US'))"/>
                <div class="page o_assembly_report_individual_call">
                    <div class="row mb-5 align-items-start">
                        <div t-if="o.attendance_qr_png" class="col-4 text-center">
                            <img t-att-src="image_data_uri(o.attendance_qr_png)" style="width: 130px; height: 130px;"/>
                        </div>
                        <div t-attf-class="col-#{8 if o.attendance_qr_png else 12} text-end">
                            <div t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'vat'], 'no_marker': True}"/>
                        </div>
                    </div>
                    <h3 class="text-center mb-4"><strong t-out="assembly.name"/></h3>
                    <div class="o_assembly_report_publication" t-out="assembly.get_rendered_publication()"/>
                    <table class="table table-borderless table-sm mt-3 mb-3">
                        <tbody>
                            <tr t-foreach="assembly.agenda_ids.sorted(lambda a: a.sequence)" t-as="item">
                                <td class="text-end align-top" style="width: 3rem;"><strong><span t-out="item_index + 1"/>.-</strong></td>
                                <td class="text-justify">
                                    <strong t-out="item.name"/>
                                    <div t-if="item.description" t-out="item.description"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="mt-4 o_assembly_report_final" t-out="assembly.get_rendered_final_text()"/>
                </div>
            </t>
        </t>
    </template>

    <template id="report_assembly_attendee_call_doc_votes">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="assembly" t-value="o.assembly_id.with_context(lang=(o.partner_id.lang or 'en_US'))"/>
                <div class="page o_assembly_report_individual_call_votes">
                    <div class="row mb-5 align-items-start">
                        <div t-if="o.attendance_qr_png" class="col-4 text-center">
                            <img t-att-src="image_data_uri(o.attendance_qr_png)" style="width: 130px; height: 130px;"/>
                        </div>
                        <div t-attf-class="col-#{8 if o.attendance_qr_png else 12} text-end">
                            <div t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'vat'], 'no_marker': True}"/>
                        </div>
                    </div>
                    <h3 class="text-center mb-4"><strong t-out="assembly.name"/></h3>
                    <div class="o_assembly_report_publication" t-out="assembly.get_rendered_publication()"/>
                    <table class="table table-borderless table-sm mt-3 mb-3">
                        <tbody>
                            <tr t-foreach="assembly.agenda_ids.sorted(lambda a: a.sequence)" t-as="item">
                                <td class="text-end align-top" style="width: 3rem;"><strong><span t-out="item_index + 1"/>.-</strong></td>
                                <td class="text-justify">
                                    <strong t-out="item.name"/>
                                    <div t-if="item.description" t-out="item.description"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-if="o.attendee_vote_ids">
                        <p class="fw-semibold mb-1 mt-3">Votes by type</p>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Vote type</th>
                                    <th class="text-end">Own</th>
                                    <th class="text-end">Delegated in</th>
                                    <th class="text-end">Delegated out</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.attendee_vote_ids" t-as="av">
                                    <td><span t-field="av.vote_type_id.name"/></td>
                                    <td class="text-end"><span t-field="av.own_votes"/></td>
                                    <td class="text-end"><span t-field="av.delegated_in_votes"/></td>
                                    <td class="text-end"><span t-field="av.delegated_out_votes"/></td>
                                    <td class="text-end"><span t-field="av.attendee_vote_total"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <div class="mt-4 o_assembly_report_final" t-out="assembly.get_rendered_final_text()"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
