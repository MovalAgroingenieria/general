<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_assembly_representation">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_representation_doc"/>
        </t>
    </template>

    <template id="report_assembly_representation_doc">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page o_assembly_representation_register">
                    <t t-set="asm" t-value="o"/>
                    <t t-call="base_assembly.report_assembly_v10_header"/>
                    <h5 class="mb-2"><strong>Representation register</strong></h5>
                    <t t-set="rep_lines" t-value="o.representation_ids.filtered(lambda r: r.active)"/>
                    <table class="table table-sm table-bordered mt-2 o_assembly_representation_register_table" t-if="rep_lines">
                        <thead>
                            <tr>
                                <th>Represented member</th>
                                <th>Representative (agent)</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="rep_lines.sorted(key=lambda r: r.owner_partner_id.name or '')" t-as="line">
                                <td><span t-field="line.owner_partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'vat'], 'no_marker': True}"/></td>
                                <td><span t-field="line.agent_partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'vat'], 'no_marker': True}"/></td>
                                <td><span t-field="line.notes"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <p t-if="not rep_lines" class="text-muted mt-3">No active representation records for this assembly.</p>
                </div>
            </t>
        </t>
    </template>

    <template id="report_assembly_representation_record">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page o_assembly_representation_poa">
                        <t t-set="asm" t-value="o.assembly_id"/>
                        <t t-call="base_assembly.report_assembly_v10_header"/>
                        <h5 class="text-center mb-1"><strong>Power of attorney — assembly representation</strong></h5>
                        <div class="mb-3 o_assembly_representation_poa_intro" t-if="asm.representation_document_text" t-out="asm.get_rendered_representation_document_text()"/>
                        <section class="mb-3 small o_assembly_representation_poa_formal">
                            <p class="fw-semibold mb-2">Formal statement</p>
                            <ol class="mb-0 ps-3">
                                <li class="mb-2">
                                    The <strong>represented member</strong> identified below appoints the <strong>representative</strong> identified below to represent them at the assembly referenced above.
                                </li>
                                <li class="mb-2">
                                    The representative may register attendance and perform other acts expressly allowed by the applicable rules, to the exclusion of any matter not covered by representation.
                                </li>
                                <li>
                                    The represented member declares that the information stated is correct and undertakes to notify the assembly secretariat of any change that affects this appointment.
                                </li>
                            </ol>
                        </section>
                        <table class="table table-bordered table-sm o_assembly_representation_poa_parties">
                            <tr>
                                <th class="w-25">Represented member</th>
                                <td>
                                    <span t-field="o.owner_partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'vat', 'phone', 'email'], 'no_marker': True}"/>
                                </td>
                            </tr>
                            <tr>
                                <th>Representative (agent)</th>
                                <td>
                                    <span t-field="o.agent_partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'address', 'vat', 'phone', 'email'], 'no_marker': True}"/>
                                </td>
                            </tr>
                        </table>
                        <div t-if="o.notes" class="mt-3 o_assembly_representation_poa_notes">
                            <strong>Notes</strong>
                            <div class="small"><span t-field="o.notes"/></div>
                        </div>
                        <div class="mt-5 pt-3 o_assembly_representation_poa_signatures">
                            <p><strong>Signature (represented member):</strong> _____________________________</p>
                            <p class="mt-3"><strong>Signature (representative):</strong> _____________________________</p>
                            <p class="mt-3"><strong>Date:</strong> _____________________________</p>
                            <p><strong>Place:</strong> _____________________________</p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
