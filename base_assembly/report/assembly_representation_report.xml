<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 11.5 Representation template (from assembly; generic template) -->
    <record id="assembly_assembly_action_report_representation" model="ir.actions.report">
        <field name="name">Representation (template)</field>
        <field name="model">assembly.assembly</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_assembly.report_assembly_representation</field>
        <field name="report_file">base_assembly.report_assembly_representation</field>
        <field name="print_report_name">'Representation template - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_assembly_assembly"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_assembly_representation">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_representation_doc"/>
        </t>
    </template>

    <template id="report_assembly_representation_doc">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mb-4">
                        <h4><strong>Representation / proxy</strong></h4>
                        <h5><span t-field="o.name"/></h5>
                        <div t-if="o.date_first_call">
                            <span t-field="o.date_first_call" t-options="{'format': 'dd/MM/yyyy HH:mm'}"/>
                            <t t-if="o.location"> – <span t-field="o.location"/></t>
                        </div>
                    </div>
                    <t t-set="repr_intro" t-value="o.get_rendered_representation_document_text()"/>
                    <div t-if="repr_intro" class="mb-4" t-out="repr_intro"/>
                    <t t-else="">
                        <p>
                            The undersigned partner authorizes the following person to represent them at the above assembly and, where applicable, to cast votes on their behalf.
                        </p>
                    </t>
                    <table class="table table-sm table-bordered mt-4">
                        <tr>
                            <th style="width: 35%;">Represented (partner)</th>
                            <td><em>Name / TIN</em></td>
                        </tr>
                        <tr>
                            <th>Representative (proxy)</th>
                            <td><em>Name / TIN</em></td>
                        </tr>
                    </table>
                    <t t-set="repr_footer" t-value="o.get_rendered_representation_footer_text()"/>
                    <div t-if="repr_footer" class="mt-4" t-out="repr_footer"/>
                    <p t-else="" class="mt-4">
                        <strong>Signature (represented):</strong> _____________________________
                    </p>
                    <p>
                        <strong>Date:</strong> _____________________________
                    </p>
                </div>
            </t>
        </t>
    </template>
</odoo>
