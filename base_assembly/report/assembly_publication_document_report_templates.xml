<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_assembly_publication_document">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_publication_document_doc"/>
        </t>
    </template>

    <template id="report_assembly_publication_document_doc">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page o_assembly_report_publication_doc">
                    <t t-set="asm" t-value="o"/>
                    <t t-call="base_assembly.report_assembly_v10_header"/>
                    <t t-call="base_assembly.report_assembly_publication_html_block"/>
                    <t t-set="assembly" t-value="o"/>
                    <t t-call="base_assembly.report_assembly_agenda_summary_compact_block"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
