<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Shared report fragments. Set ``asm`` = assembly.assembly before calling. -->
    <template id="report_assembly_attendance_roster_footer">
        <div class="small text-muted mt-3 pt-2 border-top o_assembly_report_roster_footer">
            <span>Convocable members:</span>
            <strong><span t-field="asm.total_possible_attendees"/></strong>
            <span class="ms-3">Attended (confirmed):</span>
            <strong><span t-field="asm.total_present_attendees"/></strong>
        </div>
    </template>

    <template id="report_assembly_attendee_representation_cell">
        <t t-set="rep_as_owner" t-value="asm.representation_ids.filtered(lambda r: r.active and r.owner_partner_id == att.partner_id)[:1]"/>
        <t t-set="rep_as_agent" t-value="asm.representation_ids.filtered(lambda r: r.active and r.agent_partner_id == att.partner_id)"/>
        <t t-if="rep_as_owner">
            <span class="text-muted">Represented by </span>
            <span t-field="rep_as_owner.agent_partner_id" t-options="{'widget': 'contact', 'fields': ['name'], 'no_marker': True}"/>
        </t>
        <t t-elif="rep_as_agent">
            <span class="text-muted">Acts for </span>
            <t t-foreach="rep_as_agent" t-as="ra">
                <span t-field="ra.owner_partner_id" t-options="{'widget': 'contact', 'fields': ['name'], 'no_marker': True}"/>
                <t t-if="not ra_last">; </t>
            </t>
        </t>
        <t t-else="">–</t>
    </template>

    <template id="report_assembly_attendee_delegations_received_cell">
        <t t-set="delegations_in" t-value="asm.delegation_ids.filtered(lambda d: d.delegate_partner_id == att.partner_id)"/>
        <t t-if="delegations_in">
            <t t-foreach="delegations_in" t-as="del_in">
                <span t-field="del_in.partner_id" t-options="{'widget': 'contact', 'fields': ['name'], 'no_marker': True}"/>
                <t t-if="del_in.vote_type_ids"> (<t t-foreach="del_in.vote_type_ids" t-as="vt"><span t-field="vt.name"/><t t-if="not vt_last">, </t></t>)</t>
                <t t-if="not del_in_last">; </t>
            </t>
        </t>
        <t t-else="">–</t>
    </template>

    <template id="report_assembly_attendee_delegations_given_cell">
        <t t-set="delegations_out" t-value="asm.delegation_ids.filtered(lambda d: d.partner_id == att.partner_id)"/>
        <t t-if="delegations_out">
            <t t-foreach="delegations_out" t-as="del_out">
                <span class="text-muted">To</span>
                <span t-field="del_out.delegate_partner_id" t-options="{'widget': 'contact', 'fields': ['name'], 'no_marker': True}"/>
                <t t-if="del_out.vote_type_ids"> (<t t-foreach="del_out.vote_type_ids" t-as="vt"><span t-field="vt.name"/><t t-if="not vt_last">, </t></t>)</t>
                <t t-if="del_out.delegation_vote_transfer_state"> <span class="text-muted">(<span t-field="del_out.delegation_vote_transfer_state"/>)</span></t>
                <t t-if="not del_out_last">; </t>
            </t>
        </t>
        <t t-else="">–</t>
    </template>

    <template id="report_assembly_attendee_signature_cell">
        <t t-if="att.attendance_signature">
            <img
                t-att-src="image_data_uri(att.attendance_signature)"
                class="o_assembly_report_signature img-fluid"
                style="max-height: 48px;"
                alt=""
            />
        </t>
        <t t-else="">—</t>
    </template>

    <template id="report_assembly_v10_header">
        <div class="text-center mb-4 o_assembly_report_v10_header">
            <h4 class="mb-1"><strong t-out="asm.name"/></h4>
            <div class="text-muted">
                <span t-field="asm.date_first_call" t-options="{'format': 'dd/MM/yyyy'}"/>
                <t t-set="city_txt" t-value="asm.city_id.name or asm.city"/>
                <t t-if="city_txt"> — <span t-out="city_txt"/></t>
                <t t-if="asm.state_id">, <span t-out="asm.state_id.name"/></t>
            </div>
        </div>
    </template>

    <template id="report_assembly_publication_html_block">
        <t t-set="pub_html" t-value="asm.get_rendered_publication()"/>
        <div t-if="pub_html" class="mb-3 o_assembly_report_publication" t-out="pub_html"/>
        <div t-elif="asm.description" class="mb-3 o_assembly_report_publication_fallback">
            <div t-field="asm.description"/>
        </div>
    </template>

    <template id="report_assembly_representation_table_block">
        <t t-set="rep_lines_snip" t-value="asm.representation_ids.filtered(lambda r: r.active)"/>
        <div class="row mt-4" t-if="rep_lines_snip">
            <div class="col-12"><strong>Representations (registered)</strong></div>
        </div>
        <table class="table table-sm table-bordered mt-2" t-if="rep_lines_snip">
            <thead>
                <tr>
                    <th>Represented member</th>
                    <th>Agent</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="rep_lines_snip.sorted(key=lambda r: r.owner_partner_id.name)" t-as="rep">
                    <td><span t-field="rep.owner_partner_id" t-options="{'widget': 'contact', 'fields': ['name'], 'no_marker': True}"/></td>
                    <td><span t-field="rep.agent_partner_id" t-options="{'widget': 'contact', 'fields': ['name'], 'no_marker': True}"/></td>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_assembly_agenda_summary_compact_block">
        <t t-if="assembly.agenda_ids">
            <div class="row mt-4"><div class="col-12"><strong>Agenda summary</strong></div></div>
            <p class="small text-muted mb-2">Item titles and voting mode only; full wording stays in the notice body or the detailed agenda report.</p>
            <ol class="mt-1 small o_assembly_report_agenda_compact">
                <li t-foreach="assembly.agenda_ids.sorted(key=lambda x: x.sequence)" t-as="item">
                    <span t-field="item.name"/>
                    <span class="text-muted"> — <span t-field="item.agenda_vote_mode"/></span>
                    <t t-if="item.requires_vote and item.vote_type_id"> (<span t-field="item.vote_type_id.name"/>)</t>
                </li>
            </ol>
        </t>
    </template>
</odoo>
