<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 11.6 Voting ballot (per assembly) -->
    <record id="assembly_assembly_action_report_voting_ballot" model="ir.actions.report">
        <field name="name">Voting ballot</field>
        <field name="model">assembly.assembly</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_assembly.report_assembly_voting_ballot</field>
        <field name="report_file">base_assembly.report_assembly_voting_ballot</field>
        <field name="print_report_name">'Voting ballot - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_assembly_assembly"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 11.7 Nominative voting ballot (per attendee) -->
    <record id="assembly_attendee_action_report_voting_ballot_nominative" model="ir.actions.report">
        <field name="name">Voting ballot (nominative)</field>
        <field name="model">assembly.attendee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">base_assembly.report_assembly_voting_ballot_nominative</field>
        <field name="report_file">base_assembly.report_assembly_voting_ballot_nominative</field>
        <field name="print_report_name">'Ballot - %s - %s' % (object.assembly_id.name, object.partner_id.name)</field>
        <field name="binding_model_id" ref="model_assembly_attendee"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_assembly_voting_ballot">
        <t t-foreach="docs" t-as="o">
            <t t-call="base_assembly.report_assembly_voting_ballot_doc"/>
