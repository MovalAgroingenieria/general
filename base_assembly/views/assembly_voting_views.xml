<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assembly_voting_result_view_tree" model="ir.ui.view">
        <field name="name">assembly.voting.result.tree</field>
        <field name="model">assembly.voting.result</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="vote_option"/>
                <field name="total_votes"/>
                <field name="result_percentage"/>
            </list>
        </field>
    </record>

    <record id="assembly_voting_line_view_tree" model="ir.ui.view">
        <field name="name">assembly.voting.line.tree</field>
        <field name="model">assembly.voting.line</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="1">
                <field name="assembly_id" column_invisible="1"/>
                <field
                    name="attendee_id"
                    domain="[('assembly_id', '=', assembly_id), ('attendee_state', '!=', 'absent')]"
                    options="{'no_create': True}"
                />
                <field name="partner_id" optional="show"/>
                <field name="vote_option"/>
                <field name="votes_applied"/>
                <field name="vote_channel"/>
                <field name="vote_cast_at"/>
                <field name="vote_cast_by_user_id"/>
            </list>
        </field>
    </record>

    <record id="assembly_voting_view_form" model="ir.ui.view">
        <field name="name">assembly.voting.form</field>
        <field name="model">assembly.voting</field>
        <field name="arch" type="xml">
            <form string="Voting">
                <header>
                    <button name="action_refresh_roll_call" string="Refresh roll call" type="object" class="btn-secondary" invisible="voting_state != 'open'"/>
                    <button name="action_close" string="Close voting" type="object" class="btn-primary" invisible="voting_state != 'open'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_cancel" string="Cancel voting" type="object" invisible="voting_state != 'open'" groups="base_assembly.assembly_group_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assembly" type="object" class="oe_stat_button" icon="fa-building-o" title="Assembly">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Assembly</span>
                            </div>
                        </button>
                        <button name="action_open_agenda_item" type="object" class="oe_stat_button" icon="fa-list-ol" title="Agenda item">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Agenda</span>
                            </div>
                        </button>
                        <button name="action_open_vote_lines" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_vote_lines"/></span>
                                <span class="o_stat_text">Votes</span>
                            </div>
                        </button>
                        <button name="action_open_results" type="object" class="oe_stat_button" icon="fa-bar-chart">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_results"/></span>
                                <span class="o_stat_text">Results</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <field name="assembly_id" readonly="1"/>
                        <field name="agenda_id"/>
                        <field name="vote_type_id"/>
                        <field name="allow_online_voting" readonly="1"/>
                        <field name="name"/>
                        <field name="voting_state"/>
                        <field name="date_open"/>
                        <field name="date_close"/>
                        <field name="total_votes_cast"/>
                        <field name="total_votes_possible"/>
                        <field name="participation_percentage"/>
                    </group>
                    <notebook>
                        <page string="Roll call" name="lines">
                            <field name="vote_line_ids">
                                <list
                                    string="Roll call"
                                    editable="top"
                                    create="0"
                                    delete="1"
                                    default_order="partner_id"
                                >
                                    <field name="assembly_id" column_invisible="1"/>
                                    <field name="attendee_id" readonly="1" force_save="1"/>
                                    <field name="partner_id" optional="hide"/>
                                    <field name="vote_option"/>
                                    <field name="votes_applied" readonly="1"/>
                                    <field name="vote_channel" optional="hide"/>
                                    <field name="vote_cast_at" optional="show" readonly="1"/>
                                    <field name="vote_cast_by_user_id" optional="hide" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Results" name="results">
                            <field name="result_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="assembly_voting_view_tree" model="ir.ui.view">
        <field name="name">assembly.voting.tree</field>
        <field name="model">assembly.voting</field>
        <field name="arch" type="xml">
            <list>
                <field name="assembly_id" optional="show"/>
                <field name="agenda_id"/>
                <field name="vote_type_id"/>
                <field name="voting_state"/>
                <field name="date_open"/>
                <field name="total_votes_cast"/>
                <field name="total_votes_possible"/>
            </list>
        </field>
    </record>

    <record id="assembly_voting_view_search" model="ir.ui.view">
        <field name="name">assembly.voting.search</field>
        <field name="model">assembly.voting</field>
        <field name="arch" type="xml">
            <search string="Votings">
                <field name="assembly_id"/>
                <field name="agenda_id"/>
                <field name="vote_type_id"/>
                <filter string="Open" name="filter_open" domain="[('voting_state','=','open')]"/>
                <filter string="Closed" name="filter_closed" domain="[('voting_state','=','closed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('voting_state','=','cancelled')]"/>
            </search>
        </field>
    </record>

    <record id="assembly_voting_view_kanban" model="ir.ui.view">
        <field name="name">assembly.voting.kanban</field>
        <field name="model">assembly.voting</field>
        <field name="arch" type="xml">
            <kanban default_group_by="voting_state" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="assembly_id"/>
                <field name="agenda_id"/>
                <field name="vote_type_id"/>
                <field name="voting_state"/>
                <field name="total_votes_cast"/>
                <field name="total_votes_possible"/>
                <field name="participation_percentage"/>
                <field name="count_results"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-1">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted small"><field name="assembly_id"/> · <field name="agenda_id"/></div>
                                <field name="voting_state"/>
                            </div>
                            <div class="o_kanban_record_body small">
                                <div><field name="vote_type_id"/></div>
                                <div>Cast / possible: <field name="total_votes_cast"/> / <field name="total_votes_possible"/></div>
                                <div>Participation: <field name="participation_percentage"/>%</div>
                                <div>Result rows: <field name="count_results"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="assembly_voting_view_graph" model="ir.ui.view">
        <field name="name">assembly.voting.graph</field>
        <field name="model">assembly.voting</field>
        <field name="arch" type="xml">
            <graph string="Votings" type="bar" stacked="0">
                <field name="voting_state"/>
            </graph>
        </field>
    </record>
    <record id="assembly_voting_view_pivot" model="ir.ui.view">
        <field name="name">assembly.voting.pivot</field>
        <field name="model">assembly.voting</field>
        <field name="arch" type="xml">
            <pivot string="Votings">
                <field name="vote_type_id" type="row"/>
                <field name="voting_state" type="col"/>
                <field name="total_votes_cast" type="measure"/>
                <field name="participation_percentage" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
