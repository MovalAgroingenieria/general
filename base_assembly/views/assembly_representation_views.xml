<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assembly_representation_view_tree" model="ir.ui.view">
        <field name="name">assembly.representation.tree</field>
        <field name="model">assembly.representation</field>
        <field name="arch" type="xml">
            <list editable="bottom" default_order="partner_id">
                <field name="assembly_id"/>
                <field name="partner_id" string="Represented"/>
                <field name="agent_id" string="Representative"/>
                <field name="representation_state"/>
                <field name="date_representation"/>
            </list>
        </field>
    </record>
    <record id="assembly_representation_view_form" model="ir.ui.view">
        <field name="name">assembly.representation.form</field>
        <field name="model">assembly.representation</field>
        <field name="arch" type="xml">
            <form string="Representation">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assembly" type="object" class="oe_stat_button" icon="fa-building-o" title="Assembly">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Assembly</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="partner_id" string="Represented (partner):"/>
                        <h1><field name="partner_id" options="{'no_create': True}" style="margin-top:5px;"/></h1>
                    </div>
                    <group>
                        <group string="Representation">
                            <field name="assembly_id"/>
                            <field name="agent_id" string="Representative (agent)" options="{'no_create': True}"/>
                            <field name="representation_state"/>
                            <field name="date_representation"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="assembly_representation_view_search" model="ir.ui.view">
        <field name="name">assembly.representation.search</field>
        <field name="model">assembly.representation</field>
        <field name="arch" type="xml">
            <search string="Representations">
                <field name="partner_id" string="Represented"/>
                <field name="agent_id" string="Representative"/>
                <field name="assembly_id"/>
                <filter string="Draft" name="filter_draft" domain="[('representation_state','=','draft')]"/>
                <filter string="Confirmed" name="filter_confirmed" domain="[('representation_state','=','confirmed')]"/>
                <filter string="Revoked" name="filter_revoked" domain="[('representation_state','=','revoked')]"/>
                <group expand="0" string="Group By">
                    <filter string="Assembly" name="group_assembly" context="{'group_by': 'assembly_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
