<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="assembly_representation_view_tree" model="ir.ui.view">
        <field name="name">assembly.representation.tree</field>
        <field name="model">assembly.representation</field>
        <field name="arch" type="xml">
            <list string="Representations" decoration-muted="not active">
                <field name="assembly_id"/>
                <field name="owner_partner_id"/>
                <field name="agent_partner_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="assembly_representation_view_form" model="ir.ui.view">
        <field name="name">assembly.representation.form</field>
        <field name="model">assembly.representation</field>
        <field name="arch" type="xml">
            <form string="Representation">
                <sheet>
                    <group readonly="assembly_id.assembly_state == 'closed'">
                        <field name="assembly_id" options="{'no_create': True}" readonly="context.get('default_assembly_id')"/>
                        <field name="allowed_owner_partner_ids" invisible="1"/>
                        <field name="owner_partner_id" domain="[('id', 'in', allowed_owner_partner_ids)]"/>
                        <field name="agent_partner_id"/>
                    </group>
                    <group string="Notes" readonly="assembly_id.assembly_state == 'closed'">
                        <field name="notes" nolabel="1" placeholder="Optional notes…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="assembly_representation_view_search" model="ir.ui.view">
        <field name="name">assembly.representation.search</field>
        <field name="model">assembly.representation</field>
        <field name="arch" type="xml">
            <search string="Representations">
                <field name="assembly_id"/>
                <field name="owner_partner_id"/>
                <field name="agent_partner_id"/>
                <filter string="Active" name="filter_active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

</odoo>
