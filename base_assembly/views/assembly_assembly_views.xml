<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assembly_agenda_view_tree" model="ir.ui.view">
        <field name="name">assembly.agenda.tree</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="agenda_vote_mode"/>
                <field name="requires_vote" column_invisible="0" invisible="agenda_vote_mode != 'weighted'" optional="show"/>
                <field
                    name="vote_type_id"
                    required="agenda_vote_mode == 'weighted'"
                    column_invisible="0"
                    invisible="agenda_vote_mode != 'weighted'"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field name="manual_yes" column_invisible="0" optional="hide" invisible="agenda_vote_mode != 'manual_yes_no'"/>
                <field name="manual_no" column_invisible="0" optional="hide" invisible="agenda_vote_mode != 'manual_yes_no'"/>
                <field name="manual_abstain" column_invisible="0" optional="hide" invisible="agenda_vote_mode != 'manual_yes_no'"/>
                <field name="manual_count_blank" column_invisible="0" optional="hide" invisible="agenda_vote_mode != 'manual_yes_no'"/>
                <field name="manual_total_expected" column_invisible="0" optional="hide" invisible="agenda_vote_mode not in ('manual_yes_no','manual_multi')"/>
                <field name="agenda_state"/>
                <button name="action_start_voting" string="Start voting" type="object" icon="fa-check" invisible="agenda_state not in ('pending','in_progress') or agenda_vote_mode != 'weighted'" groups="base_assembly.assembly_group_manager"/>
                <button name="action_finalize_manual" string="Finalize manual" type="object" icon="fa-check-circle" invisible="agenda_vote_mode not in ('manual_yes_no','manual_multi') or agenda_state not in ('pending','in_progress')" groups="base_assembly.assembly_group_manager"/>
                <button name="action_skip" string="Skip" type="object" icon="fa-forward" invisible="agenda_state not in ('pending','in_progress')" groups="base_assembly.assembly_group_manager"/>
            </list>
        </field>
    </record>
    <record id="assembly_agenda_view_search" model="ir.ui.view">
        <field name="name">assembly.agenda.search</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <search string="Agenda items">
                <field name="name"/>
                <field name="assembly_id"/>
                <filter string="No vote" name="filter_vote_mode_no_vote" domain="[('agenda_vote_mode','=','no_vote')]"/>
                <filter string="Weighted vote (roll-call)" name="filter_vote_mode_weighted" domain="[('agenda_vote_mode','=','weighted')]"/>
                <filter string="Requires vote" name="filter_requires_vote" domain="[('requires_vote','=',True)]"/>
                <filter string="Pending" name="filter_pending" domain="[('agenda_state','=','pending')]"/>
                <filter string="Voted" name="filter_voted" domain="[('agenda_state','=','voted')]"/>
                <separator/>
                <filter string="Manual yes / no" name="filter_manual_yes_no" domain="[('agenda_vote_mode','=','manual_yes_no')]"/>
                <filter string="Manual multi-option" name="filter_manual_multi" domain="[('agenda_vote_mode','=','manual_multi')]"/>
            </search>
        </field>
    </record>
    <record id="assembly_agenda_view_form" model="ir.ui.view">
        <field name="name">assembly.agenda.form</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <form string="Agenda item">
                <header>
                    <button name="action_start_voting" string="Start voting" type="object" invisible="agenda_vote_mode != 'weighted' or agenda_state not in ('pending','in_progress')" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_finalize_manual" string="Finalize manual" type="object" invisible="agenda_vote_mode not in ('manual_yes_no','manual_multi') or agenda_state not in ('pending','in_progress')" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_skip" string="Skip" type="object" invisible="agenda_state not in ('pending','in_progress')" groups="base_assembly.assembly_group_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assembly" type="object" class="oe_stat_button" icon="fa-building-o" title="Assembly">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Assembly</span>
                            </div>
                        </button>
                        <button name="action_open_votings" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_votings"/></span>
                                <span class="o_stat_text">Votings</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <span>Item </span>
                            <field name="sequence" style="width: 80px;" class="oe_inline"/>
                            <span> – </span>
                            <field name="name" placeholder="Title" class="oe_inline" style="min-width: 200px;"/>
                        </h1>
                    </div>
                    <group>
                        <field name="assembly_id" invisible="1"/>
                    </group>
                    <div class="mb-3 p-3 bg-light border rounded">
                        <label for="description" string="Description"/>
                        <field name="description" nolabel="1" placeholder="Detail of this agenda item…"/>
                    </div>
                    <group string="Voting">
                        <group>
                            <field name="agenda_vote_mode"/>
                            <field name="requires_vote" readonly="agenda_vote_mode != 'weighted'"/>
                            <field
                                name="vote_type_id"
                                invisible="agenda_vote_mode != 'weighted'"
                                required="agenda_vote_mode == 'weighted'"
                                options="{'no_create': True, 'no_open': True}"
                            />
                            <field name="agenda_state"/>
                        </group>
                    </group>
                    <group string="Manual yes / no / abstention / blank" invisible="agenda_vote_mode != 'manual_yes_no'">
                        <group>
                            <field name="manual_yes"/>
                            <field name="manual_no"/>
                            <field name="manual_abstain"/>
                            <field name="manual_count_blank"/>
                        </group>
                    </group>
                    <group string="Manual voting parameters" invisible="agenda_vote_mode not in ('manual_yes_no','manual_multi')">
                        <field name="manual_total_expected"/>
                    </group>
                    <group string="Ballot options" invisible="agenda_vote_mode != 'manual_multi'">
                        <field name="option_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="manual_vote_count"/>
                            </list>
                        </field>
                    </group>
                    <group string="Final summary">
                        <field name="final_summary" nolabel="1" colspan="2" placeholder="HTML summary when the point is closed…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="assembly_agenda_view_kanban" model="ir.ui.view">
        <field name="name">assembly.agenda.kanban</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <kanban default_group_by="agenda_state" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="sequence"/>
                <field name="assembly_id"/>
                <field name="agenda_vote_mode"/>
                <field name="requires_vote"/>
                <field name="count_votings"/>
                <field name="agenda_state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click o_kanban_card rounded-3 shadow-sm border overflow-hidden">
                            <div class="d-flex align-items-center justify-content-between gap-2 px-3 py-2 border-bottom bg-100">
                                <span class="badge rounded-pill text-bg-secondary"><i class="fa fa-list-ol me-1"/><field name="sequence"/></span>
                                <field name="agenda_state" widget="badge"/>
                            </div>
                            <div class="px-3 py-2">
                                <div class="fw-bold text-truncate mb-1"><field name="name"/></div>
                                <div class="text-muted small text-truncate mb-2"><i class="fa fa-sitemap me-1"/><field name="assembly_id"/></div>
                                <div class="d-flex flex-wrap align-items-center gap-2 small">
                                    <span class="badge text-bg-light border">
                                        <i class="fa fa-check-square-o me-1"/><field name="count_votings"/> <span class="text-muted">votings</span>
                                    </span>
                                    <span class="badge text-bg-light border"><i class="fa fa-sliders me-1"/><field name="agenda_vote_mode"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="assembly_agenda_view_graph" model="ir.ui.view">
        <field name="name">assembly.agenda.graph</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <graph string="Agenda items" type="bar" stacked="0">
                <field name="agenda_state"/>
            </graph>
        </field>
    </record>
    <record id="assembly_agenda_view_pivot" model="ir.ui.view">
        <field name="name">assembly.agenda.pivot</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <pivot string="Agenda items">
                <field name="assembly_id" type="row"/>
                <field name="agenda_state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="assembly_assembly_view_form" model="ir.ui.view">
        <field name="name">assembly.assembly.form</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <form string="Assembly">
                <header>
                    <button name="action_announce" string="Announce" type="object" class="btn-primary" invisible="assembly_state != 'draft'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_open_registration" string="Open registration" type="object" invisible="assembly_state != 'announced'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_start_session" string="Start session" type="object" invisible="assembly_state != 'open'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_close" string="Close" type="object" invisible="assembly_state != 'in_session'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="assembly_state == 'cancelled'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="assembly_state != 'cancelled'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_generate_attendees" string="Generate attendees" type="object" invisible="assembly_state not in ('draft','announced','open')" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_recompute_attendee_votes" string="Recompute votes" type="object" invisible="not attendee_ids or assembly_state == 'closed'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_open_document_preview_wizard" string="Preview documents" type="object" invisible="assembly_state == 'closed'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_mail_compose_publication" string="Email convocation" type="object" invisible="assembly_state == 'closed'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_mail_compose_delegation" string="Email delegation" type="object" invisible="assembly_state == 'closed'" groups="base_assembly.assembly_group_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_agenda_items" type="object" class="oe_stat_button" icon="fa-list-ol">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_agenda_items"/></span>
                                <span class="o_stat_text">Agenda</span>
                            </div>
                        </button>
                        <button name="action_open_votings" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="voting_sessions_count"/></span>
                                <span class="o_stat_text">Votings</span>
                            </div>
                        </button>
                        <button name="action_open_delegations" type="object" class="oe_stat_button" icon="fa-hand-o-right" invisible="assembly_state == 'draft'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_delegations"/></span>
                                <span class="o_stat_text">Delegations</span>
                            </div>
                        </button>
                        <button name="action_open_representations" type="object" class="oe_stat_button" icon="fa-user" invisible="assembly_state == 'draft'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_representations"/></span>
                                <span class="o_stat_text">Representations</span>
                            </div>
                        </button>
                        <button name="action_open_attendees" type="object" class="oe_stat_button" icon="fa-users" invisible="assembly_state == 'draft'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="total_present_attendees"/></span>
                                <span class="o_stat_text">Attendees</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Assembly name" readonly="assembly_state == 'closed'"/></h1>
                        <field name="code" readonly="1"/>
                    </div>
                    <field name="assembly_state" widget="statusbar" statusbar_visible="draft,announced,open,in_session,closed,cancelled"/>
                    <div class="row mt-3 mb-2">
                        <div class="col-12">
                            <button name="action_open_agenda_items" type="object" class="btn btn-link px-2 o_smart_button">
                                <i class="fa fa-list-ol fa-2x d-block text-primary" title="Agenda"/>
                                <span class="o_stat_info"><field name="count_agenda_items"/></span> Agenda
                            </button>
                            <button name="action_open_votings" type="object" class="btn btn-link px-2 o_smart_button">
                                <i class="fa fa-check-square-o fa-2x d-block text-primary" title="Votings"/>
                                <span class="o_stat_info"><field name="voting_sessions_count"/></span> Votings
                            </button>
                            <button name="action_open_delegations" type="object" class="btn btn-link px-2 o_smart_button" invisible="assembly_state == 'draft'">
                                <i class="fa fa-hand-o-right fa-2x d-block text-primary" title="Delegations"/>
                                <span class="o_stat_info"><field name="count_delegations"/></span> Delegations
                            </button>
                            <button name="action_open_representations" type="object" class="btn btn-link px-2 o_smart_button" invisible="assembly_state == 'draft'">
                                <i class="fa fa-user fa-2x d-block text-primary" title="Representations"/>
                                <span class="o_stat_info"><field name="count_representations"/></span> Representations
                            </button>
                            <button name="action_open_attendees" type="object" class="btn btn-link px-2 o_smart_button" invisible="assembly_state == 'draft'">
                                <i class="fa fa-users fa-2x d-block text-primary" title="Attendees"/>
                                <span class="o_stat_info"><field name="total_present_attendees"/></span> Attendees
                            </button>
                        </div>
                    </div>
                    <group readonly="assembly_state == 'closed'">
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="assembly_state == 'closed'"/>
                            <field name="assembly_type_id" domain="[('company_id', '=', company_id)]"/>
                            <field name="date_announcement"/>
                            <field name="date_first_call"/>
                            <field name="date_second_call"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="location"/>
                            <field name="is_second_call"/>
                            <field name="president_id"/>
                            <field name="secretary_id"/>
                        </group>
                        <group>
                            <field name="total_possible_attendees" readonly="1"/>
                            <field name="total_present_attendees" readonly="1"/>
                            <field name="quorum_percentage" readonly="1"/>
                            <field name="quorum_reached" readonly="1"/>
                        </group>
                    </group>
                    <group string="Address (for documents)" readonly="assembly_state == 'closed'">
                        <field name="street" autocomplete="chrome-off"/>
                        <field name="country_id" autocomplete="off"/>
                        <field name="state_id" domain="[('country_id', '=', country_id)]" autocomplete="off"/>
                        <field name="zip" autocomplete="chrome-off"/>
                        <field name="city_id" options="{'no_open': True, 'no_create': True}" autocomplete="off"/>
                        <field name="city" autocomplete="chrome-off"/>
                    </group>
                    <notebook>
                        <page string="Agenda" name="agenda">
                            <field name="agenda_ids" readonly="assembly_state == 'closed'">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="agenda_vote_mode"/>
                                    <field name="requires_vote" column_invisible="0" invisible="agenda_vote_mode != 'weighted'" optional="hide"/>
                                    <field
                                        name="vote_type_id"
                                        required="agenda_vote_mode == 'weighted'"
                                        column_invisible="0"
                                        invisible="agenda_vote_mode != 'weighted'"
                                        options="{'no_create': True, 'no_open': True}"
                                    />
                                    <field name="manual_yes" column_invisible="0" optional="hide" invisible="agenda_vote_mode != 'manual_yes_no'"/>
                                    <field name="manual_no" column_invisible="0" optional="hide" invisible="agenda_vote_mode != 'manual_yes_no'"/>
                                    <field name="manual_abstain" column_invisible="0" optional="hide" invisible="agenda_vote_mode != 'manual_yes_no'"/>
                                    <field name="manual_count_blank" column_invisible="0" optional="hide" invisible="agenda_vote_mode != 'manual_yes_no'"/>
                                    <field name="manual_total_expected" column_invisible="0" optional="hide" invisible="agenda_vote_mode not in ('manual_yes_no','manual_multi')"/>
                                    <field name="agenda_state"/>
                                    <button name="action_start_voting" string="Start voting" type="object" icon="fa-check" invisible="agenda_state not in ('pending','in_progress') or agenda_vote_mode != 'weighted'" groups="base_assembly.assembly_group_manager"/>
                                    <button name="action_finalize_manual" string="Finalize manual" type="object" icon="fa-check-circle" invisible="agenda_vote_mode not in ('manual_yes_no','manual_multi') or agenda_state not in ('pending','in_progress')" groups="base_assembly.assembly_group_manager"/>
                                    <button name="action_skip" string="Skip" type="object" icon="fa-forward" invisible="agenda_state not in ('pending','in_progress')" groups="base_assembly.assembly_group_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attendees" name="attendees">
                            <field name="attendee_ids" readonly="assembly_state == 'closed'">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="participant_partner_id"/>
                                    <field name="partner_vat" string="TIN"/>
                                    <field name="attendance_type"/>
                                    <field name="attendee_state" readonly="1"/>
                                    <field name="date_register"/>
                                    <field name="total_votes" sum="Total"/>
                                    <field name="attendance_notes" invisible="not parent.allow_attendance_notes"/>
                                    <field name="attendance_signature" column_invisible="1"/>
                                    <button name="action_confirm" string="Confirm" type="object" icon="fa-check" invisible="attendee_state == 'confirmed'" groups="base_assembly.assembly_group_manager"/>
                                    <button name="action_mark_absent" string="Absent" type="object" icon="fa-times" invisible="attendee_state == 'absent'" groups="base_assembly.assembly_group_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Delegations" name="delegations" groups="base_assembly.assembly_group_manager">
                            <field
                                name="delegation_ids"
                                readonly="assembly_state == 'closed'"
                                context="{'search_default_filter_open': 1}"
                            >
                                <list editable="bottom">
                                    <field name="partner_id" string="Delegator"/>
                                    <field name="delegate_partner_id" string="Delegate"/>
                                    <field name="vote_type_ids" widget="many2many_tags"/>
                                    <field name="delegation_state"/>
                                    <field name="date_delegation"/>
                                </list>
                            </field>
                        </page>
                        <page string="Representations" name="representations" groups="base_assembly.assembly_group_manager">
                            <field
                                name="representation_ids"
                                readonly="assembly_state == 'closed'"
                                context="{'default_assembly_id': id}"
                            >
                                <list editable="bottom">
                                    <field name="owner_partner_id"/>
                                    <field name="agent_partner_id"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Configuration" name="config">
                            <group readonly="assembly_state == 'closed'">
                                <group string="Quorum &amp; online voting">
                                    <field name="allow_online_voting"/>
                                    <field name="allow_attendance_notes"/>
                                    <field name="include_qr_code"/>
                                    <field name="attendance_require_partner_vat_confirm"/>
                                    <field name="attendance_partner_vat_format_strict"
                                           invisible="not attendance_require_partner_vat_confirm"/>
                                    <field name="quorum_type"/>
                                    <field name="quorum_value"/>
                                    <field name="quorum_second_call_type"/>
                                    <field name="quorum_second_call_value"/>
                                </group>
                                <group string="Vote types">
                                    <field
                                        name="vote_type_ids"
                                        widget="many2many_tags"
                                    />
                                </group>
                            </group>
                            <group readonly="assembly_state == 'closed'">
                                <field
                                    name="partner_domain"
                                    string="Partner domain (convocable partners)"
                                    widget="domain"
                                    colspan="2"
                                    options="{'model': 'res.partner'}"
                                />
                            </group>
                            <group readonly="assembly_state == 'closed'">
                                <field
                                    name="description"
                                    string="Convocation / description"
                                    placeholder="Convocation text"
                                    colspan="2"
                                />
                            </group>
                            <group string="Document templates (optional overrides)" readonly="assembly_state == 'closed'" groups="base_assembly.assembly_group_manager">
                                <field name="publication_mail_template_id" options="{'no_create': True}"/>
                                <field name="delegation_document_mail_template_id" options="{'no_create': True}"/>
                                <field name="delegation_footer_mail_template_id" options="{'no_create': True}"/>
                                <field name="ballot_intro_mail_template_id" options="{'no_create': True}"/>
                                <field name="ballot_nominative_intro_mail_template_id" options="{'no_create': True}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="assembly_assembly_view_tree" model="ir.ui.view">
        <field name="name">assembly.assembly.tree</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <list decoration-muted="assembly_state == 'cancelled'" default_order="date_first_call desc">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="assembly_type_id"/>
                <field name="assembly_state"/>
                <field name="date_first_call"/>
                <field name="date_start"/>
                <field name="location"/>
                <field name="president_id"/>
                <field name="secretary_id"/>
                <field name="total_possible_attendees"/>
                <field name="total_present_attendees"/>
                <field name="quorum_reached"/>
            </list>
        </field>
    </record>

    <record id="assembly_assembly_view_search" model="ir.ui.view">
        <field name="name">assembly.assembly.search</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <search string="Assemblies">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="assembly_type_id"/>
                <field name="location"/>
                <field name="president_id"/>
                <field name="secretary_id"/>
                <filter string="Draft" name="filter_draft" domain="[('assembly_state','=','draft')]"/>
                <filter string="Announced" name="filter_announced" domain="[('assembly_state','=','announced')]"/>
                <filter string="Open" name="filter_open" domain="[('assembly_state','=','open')]"/>
                <filter string="In session" name="filter_in_session" domain="[('assembly_state','=','in_session')]"/>
                <filter string="Closed" name="filter_closed" domain="[('assembly_state','=','closed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('assembly_state','=','cancelled')]"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Assembly type" name="group_type" context="{'group_by':'assembly_type_id'}"/>
                    <filter string="President" name="group_president" context="{'group_by':'president_id'}"/>
                    <filter string="Secretary" name="group_secretary" context="{'group_by':'secretary_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="assembly_assembly_view_kanban" model="ir.ui.view">
        <field name="name">assembly.assembly.kanban</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <kanban default_group_by="assembly_state" class="o_kanban_small_column o_assembly_kanban_classic" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="assembly_state"/>
                <field name="assembly_type_id"/>
                <field name="date_first_call"/>
                <field name="kanban_call_day"/>
                <field name="kanban_call_month_year"/>
                <field name="kanban_call_time"/>
                <field name="kanban_location_label"/>
                <field name="quorum_percentage"/>
                <field name="quorum_reached"/>
                <field name="total_present_attendees"/>
                <field name="total_possible_attendees"/>
                <field name="kanban_open_votings_count"/>
                <field name="kanban_closed_votings_count"/>
                <field name="kanban_avg_participation"/>
                <field name="kanban_results_summary"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click o_kanban_card o_assembly_kanban_card d-flex flex-row flex-nowrap rounded-2 shadow-sm border overflow-hidden">
                            <div
                                t-attf-class="o_assembly_kanban_date_rail flex-shrink-0 d-flex flex-column align-items-center justify-content-center px-2 py-3 text-center #{record.assembly_state.raw_value === 'closed' || record.assembly_state.raw_value === 'cancelled' ? 'bg-secondary-subtle text-secondary' : 'bg-warning-subtle'}"
                                style="min-width: 4.75rem;"
                            >
                                <div t-if="record.kanban_call_day.raw_value" class="fs-3 fw-bold lh-1 mb-1">
                                    <field name="kanban_call_day"/>
                                </div>
                                <div t-else="" class="fs-5 fw-bold text-muted lh-1 mb-1">—</div>
                                <div t-if="record.kanban_call_month_year.raw_value" class="small text-uppercase fw-semibold lh-sm px-1">
                                    <field name="kanban_call_month_year"/>
                                </div>
                                <div t-if="record.kanban_call_time.raw_value" class="small text-muted mt-2 lh-1">
                                    <field name="kanban_call_time"/>
                                </div>
                            </div>
                            <div class="flex-grow-1 min-w-0 d-flex flex-column bg-view">
                                <div class="d-flex justify-content-between align-items-start gap-2 px-3 pt-2 pb-1">
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="fw-bold text-truncate fs-5"><field name="name"/></div>
                                        <div class="text-muted small font-monospace text-truncate"><field name="code"/></div>
                                    </div>
                                    <field name="assembly_state" widget="badge"/>
                                </div>
                                <div class="px-3 pb-1 small">
                                    <div t-if="record.kanban_location_label.raw_value" class="text-muted text-truncate mb-2">
                                        <i class="fa fa-map-marker me-1"/><field name="kanban_location_label" class="d-inline"/>
                                    </div>
                                    <div t-if="record.assembly_type_id.raw_value" class="text-muted text-truncate mb-2">
                                        <i class="fa fa-tag me-1"/><field name="assembly_type_id"/>
                                    </div>
                                    <div class="d-flex align-items-center flex-wrap gap-1 small text-muted mb-2 user-select-none">
                                        <i t-attf-class="fa fa-pencil fa-fw #{record.assembly_state.raw_value === 'cancelled' ? 'text-muted opacity-25' : (record.assembly_state.raw_value === 'draft' ? 'text-primary' : 'text-muted opacity-50')}"/>
                                        <span class="text-muted opacity-50">&gt;</span>
                                        <i t-attf-class="fa fa-bullhorn fa-fw #{record.assembly_state.raw_value === 'cancelled' ? 'text-muted opacity-25' : ((record.assembly_state.raw_value === 'announced' || record.assembly_state.raw_value === 'open' || record.assembly_state.raw_value === 'in_session' || record.assembly_state.raw_value === 'closed') ? 'text-primary' : 'text-muted opacity-50')}"/>
                                        <span class="text-muted opacity-50">&gt;</span>
                                        <i t-attf-class="fa fa-circle-o-notch fa-fw #{record.assembly_state.raw_value === 'cancelled' ? 'text-muted opacity-25' : ((record.assembly_state.raw_value === 'open' || record.assembly_state.raw_value === 'in_session' || record.assembly_state.raw_value === 'closed') ? 'text-primary' : 'text-muted opacity-50')}"/>
                                        <span class="text-muted opacity-50">&gt;</span>
                                        <i t-attf-class="fa fa-gavel fa-fw #{record.assembly_state.raw_value === 'cancelled' ? 'text-muted opacity-25' : (record.assembly_state.raw_value === 'closed' ? 'text-primary' : 'text-muted opacity-50')}"/>
                                        <i t-if="record.assembly_state.raw_value === 'cancelled'" class="fa fa-ban fa-fw text-danger ms-1" title="Cancelled"/>
                                    </div>
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between text-muted mb-1">
                                            <span><i class="fa fa-users me-1"/>Quorum</span>
                                            <span><field name="total_present_attendees"/> / <field name="total_possible_attendees"/> · <field name="quorum_percentage"/>%</span>
                                        </div>
                                        <div class="progress rounded-pill" style="height: 6px;">
                                            <div role="progressbar" t-att-class="'progress-bar ' + (record.quorum_reached.raw_value ? 'bg-success' : 'bg-warning')" t-attf-style="width: {{ Math.min(100, Math.round(100 * (record.total_present_attendees.raw_value || 0) / (record.total_possible_attendees.raw_value || 1))) }}%;"></div>
                                        </div>
                                        <div class="mt-1 small">
                                            <span t-if="record.quorum_reached.raw_value" class="text-success"><i class="fa fa-check-circle me-1"/>Quorum reached</span>
                                            <span t-else="" class="text-warning"><i class="fa fa-exclamation-circle me-1"/>Quorum pending</span>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-1 mb-1">
                                        <span class="badge rounded-pill text-bg-primary">
                                            <i class="fa fa-folder-open-o me-1"/><field name="kanban_open_votings_count"/> open
                                        </span>
                                        <span class="badge rounded-pill text-bg-secondary">
                                            <i class="fa fa-check me-1"/><field name="kanban_closed_votings_count"/> closed
                                        </span>
                                    </div>
                                    <div t-if="record.kanban_closed_votings_count.raw_value" class="text-muted small mb-1">
                                        <i class="fa fa-pie-chart me-1"/>Avg. participation (closed): <strong><field name="kanban_avg_participation"/>%</strong>
                                    </div>
                                    <div t-if="record.kanban_results_summary.raw_value" class="fw-bold border-top pt-2 mt-1 text-truncate small">
                                        <field name="kanban_results_summary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="assembly_assembly_view_graph" model="ir.ui.view">
        <field name="name">assembly.assembly.graph</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <graph string="Assemblies" type="bar" stacked="0">
                <field name="assembly_state"/>
            </graph>
        </field>
    </record>
    <record id="assembly_assembly_view_pivot" model="ir.ui.view">
        <field name="name">assembly.assembly.pivot</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <pivot string="Assemblies">
                <field name="assembly_type_id" type="row"/>
                <field name="assembly_state" type="col"/>
            </pivot>
        </field>
    </record>
</odoo>
