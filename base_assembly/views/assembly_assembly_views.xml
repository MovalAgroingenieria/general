<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assembly_agenda_view_tree" model="ir.ui.view">
        <field name="name">assembly.agenda.tree</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="requires_vote"/>
                <field
                    name="vote_type_id"
                    required="requires_vote"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field name="agenda_state"/>
                <button name="action_start_voting" string="Start voting" type="object" icon="fa-check" invisible="agenda_state not in ('pending','in_progress') or not requires_vote" groups="base_assembly.assembly_group_manager"/>
                <button name="action_skip" string="Skip" type="object" icon="fa-forward" invisible="agenda_state not in ('pending','in_progress')" groups="base_assembly.assembly_group_manager"/>
            </list>
        </field>
    </record>
    <record id="assembly_agenda_view_search" model="ir.ui.view">
        <field name="name">assembly.agenda.search</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <search string="Agenda items">
                <field name="name"/>
                <field name="assembly_id"/>
                <filter string="Requires vote" name="filter_requires_vote" domain="[('requires_vote','=',True)]"/>
                <filter string="Pending" name="filter_pending" domain="[('agenda_state','=','pending')]"/>
                <filter string="Voted" name="filter_voted" domain="[('agenda_state','=','voted')]"/>
            </search>
        </field>
    </record>
    <record id="assembly_agenda_view_form" model="ir.ui.view">
        <field name="name">assembly.agenda.form</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <form string="Agenda item">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assembly" type="object" class="oe_stat_button" icon="fa-building-o" title="Assembly">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Assembly</span>
                            </div>
                        </button>
                        <button name="action_open_votings" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_votings"/></span>
                                <span class="o_stat_text">Votings</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <span>Item </span>
                            <field name="sequence" style="width: 80px;" class="oe_inline"/>
                            <span> – </span>
                            <field name="name" placeholder="Title" class="oe_inline" style="min-width: 200px;"/>
                        </h1>
                    </div>
                    <group>
                        <field name="assembly_id" invisible="1"/>
                    </group>
                    <div class="mb-3 p-3 bg-light border rounded">
                        <label for="description" string="Description"/>
                        <field name="description" nolabel="1" placeholder="Detail of this agenda item…"/>
                    </div>
                    <group string="Voting">
                        <group>
                            <field name="requires_vote"/>
                <field
                    name="vote_type_id"
                    required="requires_vote"
                    options="{'no_create': True, 'no_open': True}"
                />
                            <field name="agenda_state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="assembly_agenda_view_kanban" model="ir.ui.view">
        <field name="name">assembly.agenda.kanban</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <kanban default_group_by="agenda_state" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="sequence"/>
                <field name="assembly_id"/>
                <field name="requires_vote"/>
                <field name="count_votings"/>
                <field name="agenda_state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-1">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted small"><field name="assembly_id"/></div>
                            </div>
                            <div class="o_kanban_record_body small">
                                <div>Item <field name="sequence"/> · <field name="agenda_state"/></div>
                                <div>Votings: <field name="count_votings"/></div>
                                <div t-if="record.requires_vote.raw_value" class="text-info">Requires vote</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="assembly_agenda_view_graph" model="ir.ui.view">
        <field name="name">assembly.agenda.graph</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <graph string="Agenda items" type="bar" stacked="0">
                <field name="agenda_state"/>
            </graph>
        </field>
    </record>
    <record id="assembly_agenda_view_pivot" model="ir.ui.view">
        <field name="name">assembly.agenda.pivot</field>
        <field name="model">assembly.agenda</field>
        <field name="arch" type="xml">
            <pivot string="Agenda items">
                <field name="assembly_id" type="row"/>
                <field name="agenda_state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="assembly_assembly_view_form" model="ir.ui.view">
        <field name="name">assembly.assembly.form</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <form string="Assembly">
                <header>
                    <button name="action_announce" string="Announce" type="object" class="btn-primary" invisible="assembly_state != 'draft'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_open_registration" string="Open registration" type="object" invisible="assembly_state != 'announced'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_start_session" string="Start session" type="object" invisible="assembly_state != 'open'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_close" string="Close" type="object" invisible="assembly_state != 'in_session'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="assembly_state == 'cancelled'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_reopen" string="Reopen" type="object" invisible="assembly_state != 'cancelled'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_generate_attendees" string="Generate attendees" type="object" invisible="assembly_state not in ('draft','announced','open')" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_recompute_attendee_votes" string="Recompute votes" type="object" invisible="not attendee_ids or assembly_state == 'closed'" groups="base_assembly.assembly_group_manager"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_agenda_items" type="object" class="oe_stat_button" icon="fa-list-ol">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_agenda_items"/></span>
                                <span class="o_stat_text">Agenda</span>
                            </div>
                        </button>
                        <button name="action_open_votings" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="voting_sessions_count"/></span>
                                <span class="o_stat_text">Votings</span>
                            </div>
                        </button>
                        <button name="action_open_delegations" type="object" class="oe_stat_button" icon="fa-hand-o-right" invisible="assembly_state == 'draft'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_delegations"/></span>
                                <span class="o_stat_text">Delegations</span>
                            </div>
                        </button>
                        <button name="action_open_attendees" type="object" class="oe_stat_button" icon="fa-users" invisible="assembly_state == 'draft'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="total_present_attendees"/></span>
                                <span class="o_stat_text">Attendees</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Assembly name" readonly="assembly_state == 'closed'"/></h1>
                        <field name="code" readonly="1"/>
                    </div>
                    <field name="assembly_state" widget="statusbar" statusbar_visible="draft,announced,open,in_session,closed,cancelled"/>
                    <div class="row mt-3 mb-2">
                        <div class="col-12">
                            <button name="action_open_agenda_items" type="object" class="btn btn-link px-2 o_smart_button">
                                <i class="fa fa-list-ol fa-2x d-block text-primary" title="Agenda"/>
                                <span class="o_stat_info"><field name="count_agenda_items"/></span> Agenda
                            </button>
                            <button name="action_open_votings" type="object" class="btn btn-link px-2 o_smart_button">
                                <i class="fa fa-check-square-o fa-2x d-block text-primary" title="Votings"/>
                                <span class="o_stat_info"><field name="voting_sessions_count"/></span> Votings
                            </button>
                            <button name="action_open_delegations" type="object" class="btn btn-link px-2 o_smart_button" invisible="assembly_state == 'draft'">
                                <i class="fa fa-hand-o-right fa-2x d-block text-primary" title="Delegations"/>
                                <span class="o_stat_info"><field name="count_delegations"/></span> Delegations
                            </button>
                            <button name="action_open_attendees" type="object" class="btn btn-link px-2 o_smart_button" invisible="assembly_state == 'draft'">
                                <i class="fa fa-users fa-2x d-block text-primary" title="Attendees"/>
                                <span class="o_stat_info"><field name="total_present_attendees"/></span> Attendees
                            </button>
                        </div>
                    </div>
                    <group readonly="assembly_state == 'closed'">
                        <group>
                            <field name="assembly_type_id"/>
                            <field name="date_announcement"/>
                            <field name="date_first_call"/>
                            <field name="date_second_call"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="location"/>
                            <field name="is_second_call"/>
                            <field name="president_id"/>
                            <field name="secretary_id"/>
                        </group>
                        <group>
                            <field name="total_possible_attendees" readonly="1"/>
                            <field name="total_present_attendees" readonly="1"/>
                            <field name="quorum_percentage" readonly="1"/>
                            <field name="quorum_reached" readonly="1"/>
                        </group>
                    </group>
                    <group string="Address (for documents)" readonly="assembly_state == 'closed'">
                        <field name="street"/>
                        <field name="city"/>
                        <field name="zip"/>
                        <field name="state_id"/>
                        <field name="country_id"/>
                    </group>
                    <notebook>
                        <page string="Agenda" name="agenda">
                            <field name="agenda_ids" readonly="assembly_state == 'closed'">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="requires_vote"/>
                                    <field
                                        name="vote_type_id"
                                        required="requires_vote"
                                        options="{'no_create': True, 'no_open': True}"
                                    />
                                    <field name="agenda_state"/>
                                    <button name="action_start_voting" string="Start voting" type="object" icon="fa-check" invisible="agenda_state not in ('pending','in_progress') or not requires_vote" groups="base_assembly.assembly_group_manager"/>
                                    <button name="action_skip" string="Skip" type="object" icon="fa-forward" invisible="agenda_state not in ('pending','in_progress')" groups="base_assembly.assembly_group_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attendees" name="attendees">
                            <field name="attendee_ids" readonly="assembly_state == 'closed'">
                                <list>
                                    <field name="partner_id"/>
                                    <field name="participant_partner_id"/>
                                    <field name="partner_vat" string="TIN"/>
                                    <field name="attendance_type"/>
                                    <field name="attendee_state" readonly="1"/>
                                    <field name="date_register"/>
                                    <field name="total_votes" sum="Total"/>
                                    <field name="attendance_notes"/>
                                    <field name="attendance_signature" column_invisible="1"/>
                                    <button name="action_confirm" string="Confirm" type="object" icon="fa-check" invisible="attendee_state == 'confirmed'" groups="base_assembly.assembly_group_manager"/>
                                    <button name="action_mark_absent" string="Absent" type="object" icon="fa-times" invisible="attendee_state == 'absent'" groups="base_assembly.assembly_group_manager"/>
                                </list>
                            </field>
                        </page>
                        <page string="Delegations" name="delegations" groups="base_assembly.assembly_group_manager">
                            <field name="delegation_ids" readonly="assembly_state == 'closed'">
                                <list editable="bottom">
                                    <field name="partner_id" string="Delegator"/>
                                    <field name="delegate_partner_id" string="Delegate"/>
                                    <field name="vote_type_ids" widget="many2many_tags"/>
                                    <field name="delegation_state"/>
                                    <field name="date_delegation"/>
                                </list>
                            </field>
                        </page>
                        <page string="Configuration" name="config">
                            <group readonly="assembly_state == 'closed'">
                            <field name="allow_online_voting"/>
                            <field name="vote_type_ids" widget="many2many_tags"/>
                            <group>
                                <group>
                                    <field name="quorum_type"/>
                                    <field name="quorum_value"/>
                                    <field name="quorum_second_call_type"/>
                                    <field name="quorum_second_call_value"/>
                                </group>
                            </group>
                            <label for="partner_domain" string="Partner domain (convocable partners)"/>
                            <field name="partner_domain" widget="domain" nolabel="1" options="{'model': 'res.partner'}"/>
                            <label for="description" string="Convocation / description"/>
                            <field name="description" nolabel="1" placeholder="Convocation text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="assembly_assembly_view_tree" model="ir.ui.view">
        <field name="name">assembly.assembly.tree</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <list decoration-muted="assembly_state == 'cancelled'" default_order="date_first_call desc">
                <field name="name"/>
                <field name="code"/>
                <field name="assembly_type_id"/>
                <field name="assembly_state"/>
                <field name="date_first_call"/>
                <field name="date_start"/>
                <field name="location"/>
                <field name="president_id"/>
                <field name="secretary_id"/>
                <field name="total_possible_attendees"/>
                <field name="total_present_attendees"/>
                <field name="quorum_reached"/>
            </list>
        </field>
    </record>

    <record id="assembly_assembly_view_search" model="ir.ui.view">
        <field name="name">assembly.assembly.search</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <search string="Assemblies">
                <field name="name"/>
                <field name="code"/>
                <field name="assembly_type_id"/>
                <field name="location"/>
                <field name="president_id"/>
                <field name="secretary_id"/>
                <filter string="Draft" name="filter_draft" domain="[('assembly_state','=','draft')]"/>
                <filter string="Announced" name="filter_announced" domain="[('assembly_state','=','announced')]"/>
                <filter string="Open" name="filter_open" domain="[('assembly_state','=','open')]"/>
                <filter string="In session" name="filter_in_session" domain="[('assembly_state','=','in_session')]"/>
                <filter string="Closed" name="filter_closed" domain="[('assembly_state','=','closed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('assembly_state','=','cancelled')]"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Assembly type" name="group_type" context="{'group_by':'assembly_type_id'}"/>
                    <filter string="President" name="group_president" context="{'group_by':'president_id'}"/>
                    <filter string="Secretary" name="group_secretary" context="{'group_by':'secretary_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="assembly_assembly_view_kanban" model="ir.ui.view">
        <field name="name">assembly.assembly.kanban</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <kanban default_group_by="assembly_state" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="assembly_state"/>
                <field name="assembly_type_id"/>
                <field name="quorum_percentage"/>
                <field name="total_present_attendees"/>
                <field name="total_possible_attendees"/>
                <field name="kanban_open_votings_count"/>
                <field name="kanban_closed_votings_count"/>
                <field name="kanban_avg_participation"/>
                <field name="kanban_results_summary"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb-1">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted small"><field name="code"/></div>
                                <field name="assembly_state"/>
                            </div>
                            <div class="o_kanban_record_body small">
                                <div t-if="record.assembly_type_id.raw_value"><field name="assembly_type_id"/></div>
                                <div>Quorum: <field name="quorum_percentage"/>% · <field name="total_present_attendees"/> / <field name="total_possible_attendees"/></div>
                                <div>Votings: open <field name="kanban_open_votings_count"/> · closed <field name="kanban_closed_votings_count"/></div>
                                <div t-if="record.kanban_closed_votings_count.raw_value">Avg. participation (closed): <field name="kanban_avg_participation"/>%</div>
                                <div t-if="record.kanban_results_summary.raw_value" class="fw-bold"><field name="kanban_results_summary"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="assembly_assembly_view_graph" model="ir.ui.view">
        <field name="name">assembly.assembly.graph</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <graph string="Assemblies" type="bar" stacked="0">
                <field name="assembly_state"/>
            </graph>
        </field>
    </record>
    <record id="assembly_assembly_view_pivot" model="ir.ui.view">
        <field name="name">assembly.assembly.pivot</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <pivot string="Assemblies">
                <field name="assembly_type_id" type="row"/>
                <field name="assembly_state" type="col"/>
            </pivot>
        </field>
    </record>
</odoo>
