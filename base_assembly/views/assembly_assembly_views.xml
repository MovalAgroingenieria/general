<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="assembly_assembly_view_form" model="ir.ui.view">
        <field name="name">assembly.assembly.form</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <form string="Assembly">
                <header>
                    <button name="action_announce" string="Announce assembly" type="object" class="oe_highlight" invisible="assembly_state != 'draft'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_start_session" string="Start session" type="object" class="oe_highlight" invisible="assembly_state != 'announced'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_open_live_voting_dashboard" string="Voting dashboard" type="object" class="oe_highlight" invisible="assembly_state != 'in_session'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_close" string="Close assembly" type="object" invisible="assembly_state != 'in_session'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_reopen_from_closed" string="Reopen session" type="object" class="oe_highlight" invisible="assembly_state != 'closed'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_reopen" string="Back to draft" type="object" class="oe_highlight" invisible="assembly_state != 'cancelled'" groups="base_assembly.assembly_group_manager"/>
                    <button name="action_open_header_actions_wizard" string="Actions" type="object" invisible="assembly_state == 'cancelled'" groups="base_assembly.assembly_group_manager"/>
                    <field name="assembly_state" widget="statusbar" statusbar_visible="draft,announced,in_session,closed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert" invisible="assembly_state != 'closed'">
                        This assembly is closed: data is read-only on the server. Use <strong>Cancel</strong> to void it, or <strong>Reopen session</strong> (managers) to allow edits again.
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="mail_outbound_email_count" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_agenda_items" type="object" class="oe_stat_button" icon="fa-list-ol" invisible="not active">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_agenda_items"/></span>
                                <span class="o_stat_text">Agenda items</span>
                            </div>
                        </button>
                        <button name="action_open_votings" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="not active or assembly_state == 'draft'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="voting_sessions_count"/></span>
                                <span class="o_stat_text">Votings</span>
                            </div>
                        </button>
                        <button name="action_open_delegations" type="object" class="oe_stat_button" icon="fa-hand-o-right" invisible="not active or assembly_state == 'draft'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_delegations"/></span>
                                <span class="o_stat_text">Delegations</span>
                            </div>
                        </button>
                        <button name="action_open_representations" type="object" class="oe_stat_button" icon="fa-user" invisible="not active or assembly_state == 'draft'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="count_representations"/></span>
                                <span class="o_stat_text">Representations</span>
                            </div>
                        </button>
                        <button name="action_open_attendees" type="object" class="oe_stat_button" icon="fa-users" invisible="not active or assembly_state == 'draft'">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="total_present_attendees"/></span>
                                <span class="o_stat_text">Attendees</span>
                            </div>
                        </button>
                        <button name="action_open_assembly_outbound_mails" type="object" class="oe_stat_button" icon="fa-envelope-o" invisible="assembly_state == 'closed'" groups="base_assembly.assembly_group_manager" title="Emails queued or sent from this assembly (mail queue: outgoing, sent, exception).">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="mail_outbound_email_count"/></span>
                                <span class="o_stat_text">Outgoing emails</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Assembly name" readonly="assembly_state != 'draft'"/></h1>
                        <field name="code" readonly="1" invisible="1"/>
                    </div>
                    <group readonly="assembly_state != 'draft'">
                        <group>
                            <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                            <field name="assembly_type_id" domain="[('company_id', '=', company_id)]"/>
                            <field name="date_start"/>
                            <field name="date_first_call"/>
                            <field name="date_second_call"/>
                            <field name="date_announcement"/>
                        </group>
                        <group>
                            <field name="location" readonly="assembly_state != 'draft'"/>
                            <label for="street" string="Venue address (for documents)"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street" class="o_address_street" readonly="assembly_state != 'draft'" autocomplete="chrome-off"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip" readonly="assembly_state != 'draft'" autocomplete="chrome-off"/>
                                <field name="city_id" placeholder="City (directory)" class="o_address_city" options="{'no_open': True, 'no_create': True}" readonly="assembly_state != 'draft'" autocomplete="off"/>
                                <field name="city" placeholder="City (manual)" class="o_address_city" readonly="assembly_state != 'draft'" autocomplete="chrome-off"/>
                                <field name="state_id" placeholder="State" class="o_address_state" domain="[('country_id', '=', country_id)]" options="{'no_open': True}" readonly="assembly_state != 'draft'" autocomplete="off"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True}" readonly="assembly_state != 'draft'" autocomplete="off"/>
                            </div>
                            <field name="president_id" readonly="assembly_state != 'draft'"/>
                            <field name="secretary_id" readonly="assembly_state != 'draft'"/>
                            <field name="date_end" readonly="1" invisible="not date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="doc_notes">
                            <group readonly="assembly_state == 'closed'">
                                <field name="notes" nolabel="1" colspan="2" placeholder="Notes…"/>
                            </group>
                        </page>
                        <page string="Internal notes" name="doc_internal_notes" groups="base_assembly.assembly_group_manager">
                            <group readonly="assembly_state == 'closed'">
                                <field name="internal_notes" nolabel="1" colspan="2" placeholder="Internal notes…"/>
                            </group>
                        </page>
                        <page string="Convocation text" name="doc_convocation">
                            <div class="alert alert-info mb-3 py-2 px-3 small" role="status">
                                Text for the assembly documents. Supports placeholders like <code>{{ object.name }}</code>. New assemblies start from the assembly type's default texts (per language); edit here to override for this assembly.
                            </div>
                            <group readonly="assembly_state == 'closed'">
                                <field name="description" nolabel="1" colspan="2" placeholder="Convocation / publication text…"/>
                            </group>
                        </page>
                        <page string="Final paragraph" name="doc_final">
                            <group readonly="assembly_state == 'closed'">
                                <field name="final_text" nolabel="1" colspan="2" placeholder="Closing paragraph after the agenda…"/>
                            </group>
                        </page>
                        <page string="Voting ballot" name="doc_ballot_intro" groups="base_assembly.assembly_group_manager">
                            <group readonly="assembly_state == 'closed'">
                                <field name="ballot_intro_text" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Nominative voting ballot" name="doc_ballot_nominative_intro" groups="base_assembly.assembly_group_manager">
                            <group readonly="assembly_state == 'closed'">
                                <field name="ballot_nominative_intro_text" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Vote delegation text" name="doc_delegation_document" groups="base_assembly.assembly_group_manager">
                            <group readonly="assembly_state == 'closed'">
                                <field name="delegation_document_text" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Delegation footer" name="doc_delegation_footer" groups="base_assembly.assembly_group_manager">
                            <group readonly="assembly_state == 'closed'">
                                <field name="delegation_footer_text" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Representation text" name="doc_representation" groups="base_assembly.assembly_group_manager">
                            <group readonly="assembly_state == 'closed'">
                                <field name="representation_document_text" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Configuration" name="config">
                            <group readonly="assembly_state == 'closed'">
                                <group string="Online voting &amp; attendance">
                                    <field name="allow_online_voting"/>
                                    <field name="allow_attendance_notes"/>
                                    <field name="include_qr_code"/>
                                    <div class="alert alert-light py-2 px-3 small mb-0" role="status" colspan="2" invisible="not include_qr_code">
                                        <strong>Where to use it:</strong> top smart button <strong>Links &amp; QR</strong>, or each attendee form — header buttons <strong>Open attendance link</strong> / <strong>Show QR</strong>, plus the <strong>Tracked attendance URL</strong> field. Opens are counted on the link tracker. Landing/error QWeb: Settings → Assemblies → Attendance deep links (HTTP).
                                    </div>
                                    <field name="attendance_require_partner_vat_confirm"/>
                                    <field name="attendance_partner_vat_format_strict"
                                           invisible="not attendance_require_partner_vat_confirm"/>
                                </group>
                                <group string="Vote types">
                                    <field
                                        name="vote_type_ids"
                                        widget="many2many_tags"
                                    />
                                </group>
                            </group>
                            <group readonly="assembly_state == 'closed'">
                                <field
                                    name="partner_domain"
                                    string="Partner domain (convocable partners)"
                                    widget="domain"
                                    colspan="2"
                                    options="{'model': 'res.partner'}"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="assembly_assembly_view_tree" model="ir.ui.view">
        <field name="name">assembly.assembly.tree</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <list decoration-muted="assembly_state == 'cancelled'" default_order="date_first_call desc">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="assembly_type_id"/>
                <field name="assembly_state"/>
                <field name="date_first_call" optional="hide"/>
                <field name="date_start"/>
                <field name="location"/>
                <field name="president_id"/>
                <field name="secretary_id"/>
                <field name="total_possible_attendees"/>
                <field name="total_present_attendees"/>
            </list>
        </field>
    </record>

    <record id="assembly_assembly_view_search" model="ir.ui.view">
        <field name="name">assembly.assembly.search</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <search string="Assemblies">
                <field name="name"/>
                <field name="code"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="assembly_type_id"/>
                <field name="location"/>
                <field name="president_id"/>
                <field name="secretary_id"/>
                <filter string="Draft" name="filter_draft" domain="[('assembly_state','=','draft')]"/>
                <filter string="Announced" name="filter_announced" domain="[('assembly_state','=','announced')]"/>
                <filter string="In session" name="filter_in_session" domain="[('assembly_state','=','in_session')]"/>
                <filter string="Closed" name="filter_closed" domain="[('assembly_state','=','closed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('assembly_state','=','cancelled')]"/>
                <separator/>
                <filter string="Active" name="filter_active" domain="[('active','=',True)]"/>
                <filter string="Inactive" name="filter_inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by':'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Assembly type" name="group_type" context="{'group_by':'assembly_type_id'}"/>
                    <filter string="President" name="group_president" context="{'group_by':'president_id'}"/>
                    <filter string="Secretary" name="group_secretary" context="{'group_by':'secretary_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="assembly_assembly_view_kanban" model="ir.ui.view">
        <field name="name">assembly.assembly.kanban</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <kanban default_group_by="assembly_state" class="o_kanban_small_column o_assembly_kanban_classic" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="assembly_state"/>
                <field name="assembly_type_id"/>
                <field name="date_first_call"/>
                <field name="kanban_call_day"/>
                <field name="kanban_call_month_year"/>
                <field name="kanban_call_time"/>
                <field name="kanban_location_label"/>
                <field name="total_present_attendees"/>
                <field name="total_possible_attendees"/>
                <field name="kanban_open_votings_count"/>
                <field name="kanban_closed_votings_count"/>
                <field name="kanban_avg_participation"/>
                <field name="kanban_results_summary"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_card o_assembly_kanban_card d-flex flex-row flex-nowrap rounded-2 shadow-sm border overflow-hidden">
                            <div
                                t-attf-class="o_assembly_kanban_date_rail flex-shrink-0 d-flex flex-column align-items-center justify-content-center px-2 py-3 text-center #{record.assembly_state.raw_value === 'closed' || record.assembly_state.raw_value === 'cancelled' ? 'bg-secondary-subtle text-secondary' : 'bg-warning-subtle'}"
                                style="min-width: 4.75rem;"
                            >
                                <div t-if="record.kanban_call_day.raw_value" class="fs-3 fw-bold lh-1 mb-1">
                                    <field name="kanban_call_day"/>
                                </div>
                                <div t-else="" class="fs-5 fw-bold text-muted lh-1 mb-1">—</div>
                                <div t-if="record.kanban_call_month_year.raw_value" class="small text-uppercase fw-semibold lh-sm px-1">
                                    <field name="kanban_call_month_year"/>
                                </div>
                                <div t-if="record.kanban_call_time.raw_value" class="small text-muted mt-2 lh-1">
                                    <field name="kanban_call_time"/>
                                </div>
                            </div>
                            <div class="flex-grow-1 min-w-0 d-flex flex-column bg-view">
                                <div class="d-flex justify-content-between align-items-start gap-2 px-3 pt-2 pb-1">
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="fw-bold text-truncate fs-5"><field name="name"/></div>
                                        <div class="text-muted small font-monospace text-truncate"><field name="code"/></div>
                                    </div>
                                    <field name="assembly_state" widget="badge"/>
                                </div>
                                <div class="px-3 pb-1 small">
                                    <div t-if="record.kanban_location_label.raw_value" class="text-muted text-truncate mb-2">
                                        <i class="fa fa-map-marker me-1" title="Location"/><field name="kanban_location_label" class="d-inline"/>
                                    </div>
                                    <div t-if="record.assembly_type_id.raw_value" class="text-muted text-truncate mb-2">
                                        <i class="fa fa-tag me-1" title="Assembly type"/><field name="assembly_type_id"/>
                                    </div>
                                    <div class="d-flex align-items-center flex-wrap gap-1 small text-muted mb-2 user-select-none">
                                        <i t-attf-class="fa fa-pencil fa-fw #{record.assembly_state.raw_value === 'cancelled' ? 'text-muted opacity-25' : (record.assembly_state.raw_value === 'draft' ? 'text-primary' : 'text-muted opacity-50')}"/>
                                        <span class="text-muted opacity-50">&gt;</span>
                                        <i t-attf-class="fa fa-bullhorn fa-fw #{record.assembly_state.raw_value === 'cancelled' ? 'text-muted opacity-25' : ((record.assembly_state.raw_value === 'announced' || record.assembly_state.raw_value === 'open' || record.assembly_state.raw_value === 'in_session' || record.assembly_state.raw_value === 'closed') ? 'text-primary' : 'text-muted opacity-50')}"/>
                                        <span class="text-muted opacity-50">&gt;</span>
                                        <i t-attf-class="fa fa-circle-o-notch fa-fw #{record.assembly_state.raw_value === 'cancelled' ? 'text-muted opacity-25' : ((record.assembly_state.raw_value === 'open' || record.assembly_state.raw_value === 'in_session' || record.assembly_state.raw_value === 'closed') ? 'text-primary' : 'text-muted opacity-50')}"/>
                                        <span class="text-muted opacity-50">&gt;</span>
                                        <i t-attf-class="fa fa-gavel fa-fw #{record.assembly_state.raw_value === 'cancelled' ? 'text-muted opacity-25' : (record.assembly_state.raw_value === 'closed' ? 'text-primary' : 'text-muted opacity-50')}"/>
                                        <i t-if="record.assembly_state.raw_value === 'cancelled'" class="fa fa-ban fa-fw text-danger ms-1" title="Cancelled"/>
                                    </div>
                                    <div class="mb-2">
                                        <div class="d-flex justify-content-between text-muted">
                                            <span><i class="fa fa-users me-1"/>Attendees</span>
                                            <span><field name="total_present_attendees"/> / <field name="total_possible_attendees"/></span>
                                        </div>
                                    </div>
                                    <div class="d-flex flex-wrap gap-1 mb-1">
                                        <span class="badge rounded-pill text-bg-primary">
                                            <i class="fa fa-folder-open-o me-1" title="Open votings"/><field name="kanban_open_votings_count"/> open
                                        </span>
                                        <span class="badge rounded-pill text-bg-secondary">
                                            <i class="fa fa-check me-1" title="Closed votings"/><field name="kanban_closed_votings_count"/> closed
                                        </span>
                                    </div>
                                    <div t-if="record.kanban_closed_votings_count.raw_value" class="text-muted small mb-1">
                                        <i class="fa fa-pie-chart me-1"/>Avg. participation (closed): <strong><field name="kanban_avg_participation"/>%</strong>
                                    </div>
                                    <div t-if="record.kanban_results_summary.raw_value" class="fw-bold border-top pt-2 mt-1 text-truncate small">
                                        <field name="kanban_results_summary"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="assembly_assembly_view_graph" model="ir.ui.view">
        <field name="name">assembly.assembly.graph</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <graph string="Assemblies" type="bar" stacked="0">
                <field name="assembly_state"/>
            </graph>
        </field>
    </record>
    <record id="assembly_assembly_view_pivot" model="ir.ui.view">
        <field name="name">assembly.assembly.pivot</field>
        <field name="model">assembly.assembly</field>
        <field name="arch" type="xml">
            <pivot string="Assemblies">
                <field name="assembly_type_id" type="row"/>
                <field name="assembly_state" type="col"/>
            </pivot>
        </field>
    </record>
</odoo>
