<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assembly_assembly_action" model="ir.actions.act_window">
        <field name="name">Assemblies</field>
        <field name="res_model">assembly.assembly</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="groups_id" eval="[(4, ref('base_assembly.assembly_group_user'))]"/>
    </record>
    <record id="assembly_type_action" model="ir.actions.act_window">
        <field name="name">Assembly types</field>
        <field name="res_model">assembly.type</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('base_assembly.assembly_group_manager'))]"/>
    </record>
    <record id="assembly_agenda_action" model="ir.actions.act_window">
        <field name="name">Agenda items</field>
        <field name="res_model">assembly.agenda</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="domain" eval="[('assembly_id.active', '=', True)]"/>
        <field name="context">{}</field>
        <field name="groups_id" eval="[(4, ref('base_assembly.assembly_group_user'))]"/>
    </record>
    <record id="assembly_voting_action" model="ir.actions.act_window">
        <field name="name">Votings</field>
        <field name="res_model">assembly.voting</field>
        <field name="view_mode">list,kanban,graph,pivot,form</field>
        <field name="domain" eval="[('assembly_id.active', '=', True)]"/>
        <field name="context">{}</field>
        <field name="groups_id" eval="[(4, ref('base_assembly.assembly_group_user'))]"/>
    </record>
    <record id="assembly_representation_action" model="ir.actions.act_window">
        <field name="name">Representations</field>
        <field name="res_model">assembly.representation</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('base_assembly.assembly_representation_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base_assembly.assembly_representation_view_form')}),
        ]"/>
        <field name="search_view_id" ref="assembly_representation_view_search"/>
        <field name="domain" eval="[('assembly_id.active', '=', True)]"/>
        <field name="context">{}</field>
        <field name="groups_id" eval="[(4, ref('base_assembly.assembly_group_user'))]"/>
    </record>
    <record id="assembly_delegation_action_manager" model="ir.actions.act_window">
        <field name="name">Delegations</field>
        <field name="res_model">assembly.delegation</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('base_assembly.assembly_delegation_view_tree_manager')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base_assembly.assembly_delegation_view_form_manager')}),
        ]"/>
        <field name="search_view_id" ref="assembly_delegation_view_search_manager"/>
        <field name="domain" eval="[('assembly_id.active', '=', True)]"/>
        <field name="context">{}</field>
        <field name="groups_id" eval="[(4, ref('base_assembly.assembly_group_manager'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create and review vote delegations across assemblies.</p>
        </field>
    </record>
    <record id="assembly_attendee_action_call_register" model="ir.actions.act_window">
        <field name="name">Call register</field>
        <field name="res_model">assembly.attendee</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('base_assembly.assembly_attendee_view_tree_call_register')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('base_assembly.assembly_attendee_view_form_call_register')}),
        ]"/>
        <field name="search_view_id" ref="assembly_attendee_view_search_call_register"/>
        <field name="domain" eval="[('assembly_id.active', '=', True)]"/>
        <field name="context">{}</field>
        <field name="groups_id" eval="[(4, ref('base_assembly.assembly_group_manager'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Review called members, contacts, and attendance preparation across assemblies.</p>
        </field>
    </record>
    <record id="assembly_attendee_action_called_members" model="ir.actions.act_window">
        <field name="name">Called members</field>
        <field name="res_model">assembly.attendee</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('assembly_id.active', '=', True)]"/>
        <field name="context">{}</field>
        <field name="groups_id" eval="[(4, ref('base_assembly.assembly_group_user'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Member registrations across assemblies.</p>
        </field>
    </record>

    <record id="action_assembly_configuration" model="ir.actions.act_window">
        <field name="name">Assembly settings</field>
        <field name="path">assembly-settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'assembly_settings', 'bin_size': False}</field>
        <field name="groups_id" eval="[(4, ref('base_assembly.assembly_group_manager'))]"/>
    </record>

    <menuitem id="assembly_menu_root" name="Assemblies" sequence="60" groups="base_assembly.assembly_group_user" web_icon="base_assembly,static/description/icon.png"/>
    <menuitem id="assembly_menu_operational" name="Assemblies" parent="base_assembly.assembly_menu_root" sequence="10"/>
    <menuitem id="assembly_assembly_menu" name="Assemblies" parent="base_assembly.assembly_menu_operational" action="base_assembly.assembly_assembly_action" sequence="10"/>
    <menuitem id="assembly_agenda_menu" name="Agenda items" parent="base_assembly.assembly_menu_operational" action="base_assembly.assembly_agenda_action" sequence="15"/>
    <menuitem id="assembly_attendee_call_register_menu" name="Call register" parent="base_assembly.assembly_menu_operational" action="base_assembly.assembly_attendee_action_call_register" sequence="16" groups="base_assembly.assembly_group_manager"/>
    <menuitem id="assembly_attendee_called_menu" name="Called members" parent="base_assembly.assembly_menu_operational" action="base_assembly.assembly_attendee_action_called_members" sequence="17"/>
    <menuitem id="assembly_delegation_menu" name="Delegations" parent="base_assembly.assembly_menu_operational" action="base_assembly.assembly_delegation_action_manager" sequence="18" groups="base_assembly.assembly_group_manager"/>
    <menuitem id="assembly_voting_menu" name="Votings" parent="base_assembly.assembly_menu_operational" action="base_assembly.assembly_voting_action" sequence="19"/>
    <menuitem id="assembly_representation_menu" name="Representations" parent="base_assembly.assembly_menu_operational" action="base_assembly.assembly_representation_action" sequence="20"/>
    <menuitem id="assembly_menu_config" name="Configuration" parent="base_assembly.assembly_menu_root" sequence="40" groups="base_assembly.assembly_group_manager"/>
    <menuitem id="assembly_menu_app_settings" name="Assembly settings" parent="base_assembly.assembly_menu_config" action="base_assembly.action_assembly_configuration" sequence="5"/>
    <menuitem id="assembly_type_menu" name="Assembly types" parent="base_assembly.assembly_menu_config" action="base_assembly.assembly_type_action" sequence="10"/>
    <menuitem id="assembly_vote_type_menu" name="Vote Types" parent="base_assembly.assembly_menu_config" action="base_vote.vote_type_action" sequence="30" groups="base_assembly.assembly_group_manager"/>
    <menuitem id="assembly_partner_vote_menu" name="Votes by Contact" parent="base_assembly.assembly_menu_config" action="base_vote.partner_vote_action" sequence="40" groups="base_assembly.assembly_group_manager"/>
</odoo>
