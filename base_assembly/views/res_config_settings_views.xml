<odoo>
    <record id="res_config_settings_view_form_inherit_assembly" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base_assembly</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Assemblies" data-string="Assemblies" name="assembly_settings" logo="/base_assembly/static/description/icon.svg" groups="base_assembly.assembly_group_manager">
                    <block title="General" name="assembly_general_setting_container">
                        <setting id="assembly_default_use_qr_setting" string="Tracked attendance links &amp; QR by default" help="Default for new assemblies when no assembly type is applied yet; the assembly type still overrides when chosen." company_dependent="1">
                            <field name="assembly_default_use_qr"/>
                        </setting>
                        <setting id="assembly_allow_edit_closed_setting" string="Allow editing closed assemblies" help="When enabled, assemblies in closed state can still be edited for this company." company_dependent="1">
                            <field name="assembly_allow_edit_closed_assembly"/>
                        </setting>
                        <setting id="assembly_sequence_setting" string="Assembly reference sequence" help="Sequence used to generate assembly reference codes. Leave empty to resolve by sequence code assembly.assembly." company_dependent="1">
                            <field name="assembly_sequence_id" domain="[('code', '=', 'assembly.assembly'), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                        </setting>
                    </block>
                    <block title="Default mail templates" name="assembly_mail_defaults_setting_container" help="Used when an assembly has no override on the corresponding document.">
                        <setting id="assembly_default_publication_mail_template_setting" string="Publication" company_dependent="1">
                            <field name="assembly_default_publication_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                        <setting id="assembly_default_delegation_document_mail_template_setting" string="Delegation document" company_dependent="1">
                            <field name="assembly_default_delegation_document_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                        <setting id="assembly_default_delegation_footer_mail_template_setting" string="Delegation footer" company_dependent="1">
                            <field name="assembly_default_delegation_footer_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                        <setting id="assembly_default_ballot_intro_mail_template_setting" string="Ballot introduction" company_dependent="1">
                            <field name="assembly_default_ballot_intro_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                        <setting id="assembly_default_ballot_nominative_intro_mail_template_setting" string="Nominative ballot introduction" company_dependent="1">
                            <field name="assembly_default_ballot_nominative_intro_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                    </block>
                    <block title="Fallback QWeb views" name="assembly_qweb_fallback_setting_container" help="QWeb used when mail template bodies are empty, and pages for tracked attendance deep links (landing before the form and errors for invalid or expired links).">
                        <setting id="assembly_af_publication_fallback_qweb_setting" string="Publication" company_dependent="1">
                            <field name="assembly_af_publication_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_af_delegation_document_fallback_qweb_setting" string="Delegation document" company_dependent="1">
                            <field name="assembly_af_delegation_document_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_af_delegation_footer_fallback_qweb_setting" string="Delegation footer" company_dependent="1">
                            <field name="assembly_af_delegation_footer_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_af_ballot_intro_fallback_qweb_setting" string="Ballot introduction" company_dependent="1">
                            <field name="assembly_af_ballot_intro_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_af_ballot_nominative_intro_fallback_qweb_setting" string="Nominative ballot introduction" company_dependent="1">
                            <field name="assembly_af_ballot_nominative_intro_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_attendance_landing_qweb_setting" string="Attendance deep link — landing page" company_dependent="1">
                            <field name="assembly_attendance_landing_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_attendance_error_qweb_setting" string="Attendance deep link — error page" company_dependent="1">
                            <field name="assembly_attendance_error_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
