<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base_assembly</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Assemblies" data-string="Assemblies" name="assembly_settings" logo="/base_assembly/static/description/icon.png" groups="base_assembly.assembly_group_manager">
                    <block title="General" name="assembly_general_setting_container">
                        <setting id="assembly_default_use_qr_setting" string="Tracked attendance links &amp; QR by default" help="Default for new assemblies when no assembly type is applied yet; the assembly type still overrides when chosen." company_dependent="1">
                            <field name="assembly_default_use_qr"/>
                        </setting>
                        <setting id="assembly_allow_edit_closed_setting" string="Allow editing closed assemblies" help="When enabled, assemblies in closed state can still be edited for this company." company_dependent="1">
                            <field name="assembly_allow_edit_closed_assembly"/>
                        </setting>
                        <setting id="assembly_sequence_setting" string="Assembly reference sequence" help="Sequence used to generate assembly reference codes. Leave empty to resolve by sequence code assembly.assembly." company_dependent="1">
                            <field name="assembly_sequence_id" domain="[('code', '=', 'assembly.assembly'), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                        </setting>
                    </block>
                    <block title="Attendance deep-link pages" name="assembly_attendance_pages_setting_container" help="Public pages shown for tracked attendance deep links (landing before the form and errors for invalid or expired links).">
                        <setting id="assembly_attendance_landing_qweb_setting" string="Attendance deep link — landing page" company_dependent="1">
                            <field name="assembly_attendance_landing_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_attendance_error_qweb_setting" string="Attendance deep link — error page" company_dependent="1">
                            <field name="assembly_attendance_error_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
