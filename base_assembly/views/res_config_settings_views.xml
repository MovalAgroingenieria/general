<odoo>
    <record id="res_config_settings_view_form_inherit_assembly" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.base_assembly</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="40"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app notApp="1" string="Assemblies" data-string="Assemblies" name="assembly_settings" groups="base_assembly.assembly_group_manager">
                    <block title="Numbering" name="assembly_numbering_setting_container">
                        <setting id="assembly_sequence_setting" string="Assembly reference sequence" help="Sequence used to generate assembly reference codes for this company. Leave empty to resolve by sequence code.">
                            <field name="assembly_sequence_id" domain="[('code', '=', 'assembly.assembly'), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                        </setting>
                    </block>
                    <block title="Default mail templates" name="assembly_mail_defaults_setting_container">
                        <setting id="assembly_default_publication_mail_template_setting" string="Publication" help="Default convocation / publication template when an assembly has no override.">
                            <field name="assembly_default_publication_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                        <setting id="assembly_default_delegation_document_mail_template_setting" string="Delegation document" help="Default delegation document body when an assembly has no override.">
                            <field name="assembly_default_delegation_document_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                        <setting id="assembly_default_delegation_footer_mail_template_setting" string="Delegation footer" help="Default delegation footer when an assembly has no override.">
                            <field name="assembly_default_delegation_footer_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                        <setting id="assembly_default_ballot_intro_mail_template_setting" string="Ballot introduction" help="Default ballot introduction when an assembly has no override.">
                            <field name="assembly_default_ballot_intro_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                        <setting id="assembly_default_ballot_nominative_intro_mail_template_setting" string="Nominative ballot introduction" help="Default nominative ballot introduction when an assembly has no override.">
                            <field name="assembly_default_ballot_nominative_intro_mail_template_id" domain="[('model', '=', 'assembly.assembly')]"/>
                        </setting>
                    </block>
                    <block title="AF QWeb fallbacks" name="assembly_af_qweb_fallback_setting_container">
                        <setting id="assembly_af_publication_fallback_qweb_setting" string="Publication" help="Used when mail template bodies are empty (after sanitization, etc.).">
                            <field name="assembly_af_publication_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_af_delegation_document_fallback_qweb_setting" string="Delegation document">
                            <field name="assembly_af_delegation_document_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_af_delegation_footer_fallback_qweb_setting" string="Delegation footer">
                            <field name="assembly_af_delegation_footer_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_af_ballot_intro_fallback_qweb_setting" string="Ballot introduction">
                            <field name="assembly_af_ballot_intro_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_af_ballot_nominative_intro_fallback_qweb_setting" string="Nominative ballot introduction">
                            <field name="assembly_af_ballot_nominative_intro_fallback_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                    </block>
                    <block title="Attendance deep links (HTTP)" name="assembly_attendance_http_setting_container" help="Shown when someone opens a tracked attendance URL from an assembly or attendee (managers see the landing page unless the link uses direct=1). Does not create links; enable tracked links per assembly under Configuration.">
                        <setting id="assembly_attendance_landing_qweb_setting" string="Landing page" help="HTML shown before the attendance form when a manager opens a tracked sign-in URL (omit direct=1).">
                            <field name="assembly_attendance_landing_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                        <setting id="assembly_attendance_error_qweb_setting" string="Error page" help="HTML for invalid, expired, or disallowed tracked attendance / deep links.">
                            <field name="assembly_attendance_error_qweb_id" domain="[('type', '=', 'qweb')]"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
