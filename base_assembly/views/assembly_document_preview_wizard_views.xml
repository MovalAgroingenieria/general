<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="assembly_document_preview_wizard_view_form" model="ir.ui.view">
        <field name="name">assembly.document.preview.wizard.form</field>
        <field name="model">assembly.document.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Preview rendered document">
                <group>
                    <field name="assembly_id"/>
                    <field name="document_type"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Rendered with Odoo mail templates (QWeb on mail.template) when available;
                    otherwise AF QWeb views or convocation HTML are used. Refresh to rebuild.
                </div>
                <field name="preview_html" nolabel="1" colspan="2"/>
                <footer>
                    <button name="action_refresh_preview" string="Refresh" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
