<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="assembly_type_view_tree" model="ir.ui.view">
        <field name="name">assembly.type.tree</field>
        <field name="model">assembly.type</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="name"/>
                <field name="code"/>
                <field name="vote_type_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
            </list>
        </field>
    </record>
    <record id="assembly_type_view_form" model="ir.ui.view">
        <field name="name">assembly.type.form</field>
        <field name="model">assembly.type</field>
        <field name="arch" type="xml">
            <form string="Assembly type">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="vote_type_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="default_quorum_type"/>
                            <field name="default_quorum_value"/>
                            <field name="default_quorum_second_call_type"/>
                            <field name="default_quorum_second_call_value"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Default address">
                        <field name="default_street" autocomplete="chrome-off"/>
                        <field name="default_country_id" autocomplete="off"/>
                        <field name="default_state_id" domain="[('country_id', '=', default_country_id)]" autocomplete="off"/>
                        <field name="default_zip" autocomplete="chrome-off"/>
                        <field name="default_city_id" options="{'no_open': True, 'no_create': True}" autocomplete="off"/>
                        <field name="default_city" autocomplete="chrome-off"/>
                    </group>
                    <group string="Default responsible persons">
                        <field name="default_president_id"/>
                        <field name="default_secretary_id"/>
                    </group>
                    <group string="Controls (flags)">
                        <field name="require_vat"/>
                        <field name="default_allow_attendance_notes"/>
                        <field name="default_include_qr_code"/>
                        <div class="alert alert-light py-2 px-3 small mb-0" colspan="2" role="status" invisible="not default_include_qr_code">
                            New assemblies will show the <strong>Links &amp; QR</strong> smart button and per-attendee <strong>Open attendance link</strong> / <strong>Show QR</strong> when this default is on.
                        </div>
                    </group>
                    <group string="Attendance (defaults for new assemblies)">
                        <field name="default_attendance_require_partner_vat_confirm"/>
                        <field name="default_attendance_partner_vat_format_strict"/>
                    </group>
                    <group>
                        <field name="description" placeholder="Description"/>
                        <field name="partner_domain" widget="domain" options="{'model': 'res.partner'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
