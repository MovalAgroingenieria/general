"<div class=\"o_assembly_publication\">\n"
"<h2 t-out=\"objeto.nombre\"/>\n"
"<p t-if=\"objeto.fecha_primera_llamada\">\n"
"<span t-field=\"object.date_first_call\"/>\n"
"<t t-if=\"objeto.ubicación\"> — <span t-field=\"objeto.ubicación\"/></t>\n"
"</p>\n"
"<div t-if=\"objeto.descripción\" t-field=\"objeto.descripción\"/>\n"
"</div>"

