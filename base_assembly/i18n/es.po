#. module: base_assembly
#: model_terms:ir.ui.view,arch_db:base_assembly.assembly_attendee_view_form
msgid ""
"<strong>Attendance status:</strong>\n"
"                                <em>Listed — not finalized</em> = on the list only (not counted for quorum or as an active delegate).\n"
"                                <em>Attended (confirmed present)</em> = actually present; counts for quorum and voting; delegations to this person can become active.\n"
"                                <em>Did not attend</em> = recorded absent; does not count for quorum; use <strong>Mark Present</strong> if that changes."
msgstr ""
"<strong>Estado de asistencia:</strong>\n"
"<em>Listado: no finalizado</em> = solo en la lista (no cuenta para el cuórum ni como delegado activo).\n"
"<em>Asistió (presente confirmado)</em> = realmente presente; cuenta para el cuórum y la votación; las delegaciones a esta persona pueden activarse.\n"
"<em>No asistió</em> = registrado ausente; no cuenta para el cuórum; use <strong>Marcar presente</strong> si eso cambia."

#. module: base_assembly
#: model_terms:ir.ui.view,arch_db:base_assembly.assembly_assembly_view_form
msgid ""
"<strong>Attendance:</strong>\n"
"                                <em>Listed — not finalized</em> = on the list only (not quorum, not an active delegate).\n"
"                                <em>Attended (confirmed present)</em> = counts for quorum and voting; delegations to this person can activate.\n"
"                                <em>Did not attend</em> = absent (excluded from quorum).\n"
"                                Each row shows one main action: <strong>Mark Present</strong> until attended, then <strong>Mark Absent</strong>. Use the print icon for a ballot PDF."
msgstr ""
"<strong>Asistencia:</strong>\n"
"<em>Listado: no finalizado</em> = solo en la lista (no cuenta para el cuórum ni como delegado activo).\n"
"<em>Asistió (presente confirmado)</em> = cuenta para el cuórum y la votación; las delegaciones a esta persona pueden activarse.\n"
"<em>No asistió</em> = ausente (excluido del cuórum).\n"
"Cada fila muestra una acción principal: <strong>Marcar presente</strong> hasta confirmar asistencia y luego <strong>Marcar ausente</strong>. Use el icono de impresión para un PDF de papeleta."

