#. module: base_assembly
#: model:ir.model.fields.selection,name:base_assembly.selection__assembly_delegation__delegation_vote_transfer_state__waiting_delegate
msgid "Waiting (delegate not attended yet)"
msgstr "En espera (el delegat encara no ha assistit)"

#. module: base_assembly
#: model:ir.model.fields,help:base_assembly.field_assembly_delegation__delegation_vote_transfer_state
msgid ""
"Waiting: the delegation is saved but the delegate is not Attended (confirmed"
" present), so units are not transferred yet. Active: the delegate is "
"attended (confirmed present); covered types are transferred for vote totals "
"(other rules such as vote-type overlap still apply in the engine)."
msgstr ""
"En espera: la delegació està desada però el delegat no ha assistit "
"(presència confirmada), per tant les unitats encara no es transfereixen. "
"Activa: el delegat ha assistit (presència confirmada); els tipus coberts es "
"transfereixen per als totals de vot (altres regles, com la coincidència de "
"tipus, també s'apliquen al motor)."

#. module: base_assembly
