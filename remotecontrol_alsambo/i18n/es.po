#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<code>\"PostgreSQL Unicode\"</code> - PostgreSQL with Unicode support"
msgstr "<code>\"PostgreSQL Unicode\"</code> - PostgreSQL con soporte Unicode"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<code>\"PostgreSQL\"</code> - PostgreSQL database"
msgstr "<code>\"PostgreSQL\"</code> - Base de datos PostgreSQL"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<code>start_date</code>: Initial sync date (default: last reading or current year start)"
msgstr "<code>start_date</code>: Fecha de sincronización inicial (por defecto: última lectura o inicio del año actual)"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<code>table</code>: Always \"valoresmoval\""
msgstr "<code>table</code>: Siempre \"valoresmoval\""

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<code>time_field</code>: Always \"fecha\""
msgstr "<code>time_field</code>: Siempre \"fecha\""

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<code>value_field</code>: Column name containing the sensor readings"
msgstr "<code>value_field</code>: Nombre de la columna que contiene las lecturas del sensor"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<strong>Column not found</strong> → Verify value_field matches column name exactly"
msgstr "<strong>Columna no encontrada</strong> → Verifique que value_field coincida exactamente con el nombre de la columna"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<strong>Connection refused</strong> → Check host/port/firewall"
msgstr "<strong>Conexión rechazada</strong> → Verifique host/puerto/firewall"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<strong>Driver not found</strong> → Install ODBC driver (psqlodbc) or change driver_name"
msgstr "<strong>Controlador no encontrado</strong> → Instale el controlador ODBC (psqlodbc) o cambie driver_name"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<strong>Login failed</strong> → Verify user/password/database name"
msgstr "<strong>Error de inicio de sesión</strong> → Verifique usuario/contraseña/nombre de base de datos"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<strong>Other columns</strong>: Each column represents a different sensor and contains its value"
msgstr "<strong>Otras columnas</strong>: Cada columna representa un sensor diferente y contiene su valor"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<strong>Type:</strong> SQL Database Connection (pyodbc)"
msgstr "<strong>Tipo:</strong> Conexión a Base de Datos SQL (pyodbc)"

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "<strong>fecha</strong>: Column containing the timestamp of the reading"
msgstr "<strong>fecha</strong>: Columna que contiene la marca de tiempo de la lectura"

