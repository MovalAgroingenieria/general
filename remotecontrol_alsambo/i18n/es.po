msgid "Run the procedure <strong>\"Alsambo: Daily Sync\"</strong> to import readings from all configured sensors."
msgstr "Ejecute el procedimiento <strong>\"Alsambo: Sincronización diaria\"</strong> para importar lecturas de todos los sensores configurados."

#. module: remotecontrol_alsambo
#: model:remotecontrol,remotecontrol_help:remotecontrol_alsambo.remotecontrol_alsambo
msgid "SELECT sensor1, fecha\n"
"FROM valoresmoval\n"
"WHERE fecha &gt;= '2025-01-01 00:00:00'\n"
"  AND fecha &lt;= '2025-01-31 23:59:59'\n"
"  AND sensor1 IS NOT NULL\n"
"ORDER BY fecha ASC"
msgstr "SELECT sensor1, fecha\n"
"FROM valoresmoval\n"
"WHERE fecha &gt;= '2025-01-01 00:00:00'\n"
"  AND fecha &lt;= '2025-01-31 23:59:59'\n"
"  AND sensor1 IS NOT NULL\n"
"ORDER BY fecha ASC"

