<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

    <template id="complaints_channel_page" name="Canal de Denuncias">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_text_block_image_fw oe_img_bg oe_custom_bg" style="background-image: url('/website/static/src/img/library/sign.jpg'); background-position: 39.55% 57.12%;">
                    <div class="container">
                        <div class="row">
                            <div class="mt64 bg-black-25 col-md-7 mb92">
                                <h2 style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(255, 255, 255); font-size: 62px;">Canal de Denuncias<br/></h2>
                                <h4 style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(255, 255, 255);">Sistema Interno de Información.<br/></h4>
                                <h2 style="font-family: Ubuntu-Regular; color: rgb(140, 140, 140); font-size: 62px;"/>
                                <h2 style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(255, 255, 255); font-size: 62px;"/>
                                <h2 style="font-size:62px"/>
                                <p style="font-size: 14px;">Ley 2/2023, de 20 de febrero, reguladora de la protección de las personas que informen sobre infracciones normativas y de lucha contra la corrupción.</p>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="jumbotron s_button mb0 mt48 bg-info">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-9">
                                <p class="mb0" style="background-color: rgb(217, 237, 247);">
                                    <strong>
                                        <font class="text-epsilon" style="font-size: 24px;">Canal de denuncias</font>
                                    </strong>
                                </p>
                                <p class="mb0" style="background-color: rgb(217, 237, 247);">
                                    <font class="text-epsilon" style="font-size: 24px;">Lee atentamente la información del Canal antes de interponer una demanda.</font>
                                </p>
                            </div>
                            <div class="col-md-3">
                                <a href="/page/info-complaints-channel" class="pull-right mt8 btn btn-primary btn-lg">Preguntas Frecuentes <i class="fa fa-chevron-right"/></a>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="s_three_columns">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-4 mt32 mb48">
                                <a href="/page/new-complaint" style="text-decoration-line: underline; outline: 0px;">
                                    <img class="img img-responsive" src="/cim_complaints_channel_website/static/src/img/new_complaint.jpg" alt="Odoo - Prueba 1 de tres columnas"/>
                                </a>
                                <span style="color: rgb(140, 140, 140); font-family: PT_Sans-Web-Regular; font-size: 16px;"/>
                                <span style="color: rgb(140, 140, 140); font-family: PT_Sans-Web-Regular; font-size: 16px;"/>
                                <h4 class="mt16" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51); text-align: center;">
                                    <font class="text-epsilon" style="color: rgb(51, 122, 183); font-size: 24px;">
                                        <a href="/page/new-complaint">Denunciar</a>
                                    </font>
                                </h4>
                                <h4 class="mt16" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51); text-align: center;">
                                    <font class="text-epsilon" style="font-size: 14px;">
                                        <a href="/page/new-complaint">Interponer denuncia por hechos relacionados con los delitos del artículo 2 de la Ley 2/2023, de 20 de febrero.</a>
                                    </font>
                                </h4>
                            </div>
                            <div class="col-md-4 mt32 mb48">
                                <a href="/page/new-communication" style="text-decoration-line: underline; outline: 0px;">
                                    <img class="img img-responsive" src="/cim_complaints_channel_website/static/src/img/new_communication.jpg" alt="Odoo - Prueba 2 a tres columnas"/>
                                </a>
                                <span style="color: rgb(140, 140, 140); font-family: PT_Sans-Web-Regular; font-size: 16px;"/>
                                <span style="color: rgb(140, 140, 140); font-family: PT_Sans-Web-Regular; font-size: 16px;"/>
                                <h4 class="mt16" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51); text-align: center;">
                                    <font class="text-epsilon" style="color: rgb(51, 122, 183); font-size: 24px;">
                                        <a href="/page/new-communication">Añadir documentación</a>
                                    </font>
                                </h4>
                                <h4 class="mt16" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51); text-align: center;">
                                    <font class="text-epsilon" style="font-size: 14px;">
                                        <a href="/page/new-communication">Aportar más información o documentación a una denuncia ya interpuesta con mi código de seguimiento.</a>
                                    </font>
                                </h4>
                            </div>
                            <div class="col-md-4 mt32 mb48">
                                <a href="/tracing" style="text-decoration-line: underline; outline: 0px;">
                                    <img class="img img-responsive" src="/cim_complaints_channel_website/static/src/img/tracing.jpg" alt="Odoo - Prueba 3 a tres columnas"/>
                                </a>
                                <span style="color: rgb(140, 140, 140); font-family: PT_Sans-Web-Regular; font-size: 16px;"/>
                                <span style="color: rgb(140, 140, 140); font-family: PT_Sans-Web-Regular; font-size: 16px;"/>
                                <h4 class="mt16" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51); text-align: center;">
                                    <font class="text-epsilon" style="color: rgb(35, 82, 124); outline: 0px; font-size: 24px;">
                                        <a href="/tracing">Seguimiento</a>
                                    </font>
                                </h4>
                                <h4 class="mt16" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51); text-align: center;">
                                    <font class="text-epsilon" style="outline: 0px; font-size: 14px;">
                                        <a href="/tracing">Conocer el estado de la tramitación de mi denuncia o expediente.</a>
                                    </font>
                                </h4>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="s_features bg-info mt16 mb48">
                    <div class="container">
                        <div class="row mt16 mb16">
                            <div class="col-md-4 text-center">
                                <h3 class="mt8 mb0"><br/></h3>
                                <h3 class="mt8 mb0"><br/></h3>
                                <h3 class="mt8 mb0" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51);">
                                    <font class="text-epsilon">Recuerda:&amp;nbsp;</font>
                                </h3>
                                <p class="text-muted"><br/></p>
                            </div>
                            <div class="col-md-4 text-center">
                                <span class="fa fa-warning fa-5x"/>
                                <h3 class="mb0 mt8" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51);">
                                    <font class="text-epsilon">No es un buzón de sugerencias&amp;nbsp;</font>
                                </h3>
                                <p class="text-muted">
                                    <span style="color: rgb(11, 46, 89);">El canal de Denuncias no es el buzón adecuado para interponer reclamaciones a otros comuneros, a la entidad o relacionadas con las Ordenanzas. Es el medio para informar de infracciones reguladas en la Ley 2/2023.</span>
                                </p>
                            </div>
                            <div class="col-md-4 text-center">
                                <span class="fa fa-edit fa-5x"/>
                                <h3 class="mb0 mt8" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51);">
                                    <font class="text-epsilon">Anota tú código de seguimiento</font>
                                </h3>
                                <p class="text-muted">
                                    <span style="color: rgb(11, 46, 89);">Al interponer tu denuncia se generará un código único y personal. Es fundamental que anotes este código para el seguimiento de su tramitación, especialmente si tu denuncia es anónima.</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
                <section class="s_text_block">
                    <div class="container">
                        <h2 class="text-center" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51); text-align: left;">
                            <font class="text-epsilon">Otras opciones:</font>
                            <br/>
                        </h2>
                        <h3 class="text-center text-muted" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;"/>
                        <h2 class="text-center" style="font-family: Ubuntu-Regular; color: rgb(140, 140, 140); font-size: 34px;">
                            <div class="row" style="color: rgb(51, 51, 51); font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 14px; text-align: start;">
                                <div class="col-md-12 mb16 mt16" style="width: 1170px;">
                                    <p style="text-align: justify;">
                                        <font class="text-epsilon" style="font-size: 18px;">También puede remitir su denuncia o comunicación ante la Autoridad Independiente de Protección del Informante, A.A.I., (una vez esté constituida) o ante las autoridades u órganos autonómicos correspondientes, de la comisión de cualesquiera acciones u omisiones incluidas en el ámbito de aplicación de esta ley, ya sea directamente o después de remitir su comunicación a través de este Canal de Denuncias.&amp;nbsp;</font>
                                    </p>
                                </div>
                            </div>
                        </h2>
                        <div class="row">
                            <div class="col-md-12 mb16 mt16"/>
                        </div>
                    </div>
                </section>
                <section class="s_text_block">
                    <div class="container">
                        <h2 class="text-center" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: rgb(51, 51, 51);">
                            <font class="text-epsilon" style="font-size: 24px;">Política de protección de datos del Canal de Denuncias</font>
                        </h2>
                        <h2 class="text-center" style="font-family: Ubuntu-Regular; color: rgb(140, 140, 140); font-size: 34px;">
                            <section class="s_text_block" style="color: rgb(51, 51, 51); font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 14px; text-align: start;">
                                <div class="container" style="padding-left: 15px; padding-right: 15px; width: 1170px;">
                                    <div class="row">
                                        <div class="col-md-12 mb16 mt16" style="width: 1170px;">
                                            <p style="text-align: justify;">
                                                <font class="text-epsilon">
                                                    El Responsable del tratamiento de los datos de carácter personal que se recaben en el marco del canal de denuncias es
                                                    <t t-esc="(legal_data and legal_data.responsible_name) or (website_company and website_company.name) or ''"/>,
                                                    con NIF
                                                    <t t-esc="((legal_data and legal_data.responsible_vat) or (website_company and website_company.vat) or '')[2:]"/>,
                                                    domicilio en
                                                    <t t-esc="(legal_data and legal_data.responsible_address) or ''"/>
                                                    y teléfono de contacto
                                                    <t t-esc="(legal_data and legal_data.responsible_phone) or (website_company and website_company.phone) or ''"/>.
                                                    <br/><br/>
                                                    <t t-if="legal_data and legal_data.legal_body_html">
                                                        <span t-raw="legal_data.legal_body_html"/>
                                                    </t>
                                                    <t t-else="">
                                                        La legitimación se basa en el cumplimiento de una obligación legal derivada de la Ley 2/2023, de conformidad con lo establecido en el artículo 6.1.C. del Reglamento UE 679/2016 General de Protección de Datos.
                                                    </t>
                                                </font>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </h2>
                        <div class="row">
                            <div class="col-md-12 mb16 mt16"/>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    </data>
</odoo>
