#. module: cim_complaints_channel_website
#: model:ir.ui.view,arch_db:cim_complaints_channel_website.complaints_channel_page
msgid "<span style=\"color: rgb(11, 46, 89);\">Al interponer tu denuncia se generará un código único y personal. Es fundamental que anotes este código para el seguimiento de su tramitación, especialmente si tu denuncia es anónima.</span>"
msgstr ""

#. module: cim_complaints_channel_website
#: model:ir.ui.view,arch_db:cim_complaints_channel_website.complaints_channel_page
msgid "<span style=\"color: rgb(11, 46, 89);\">El canal de Denuncias no es el buzón adecuado para interponer reclamaciones a otros comuneros, a la entidad o relacionadas con las Ordenanzas. Es el medio para informar de infracciones reguladas en la Ley 2/2023.</span>"
msgstr ""

#. module: cim_complaints_channel_website
#: model:ir.ui.view,arch_db:cim_complaints_channel_website.info_complaints_channel_page
msgid "<span style=\"color: rgb(186, 60, 61);\">ATENCIÓN: Este Canal no es la vía adecuada para reclamaciones entre comuneros o para comunicar incumplimientos de las Ordenanzas de la entidad, para lo cual es preciso dirigir escrito formal al Presidente o a la Junta de Gobierno. Tampoco es la vía adecuada para comunicarse o accionar en relación a la protección de datos de la entidad</span>"
msgstr ""

