#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>start_date</code>: Initial sync date (default: last reading or current year start)"
msgstr "<code>start_date</code>: Fecha de sincronización inicial (por defecto: última lectura o inicio del año actual)"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>table</code>: Table name (e.g., \"historico_iru\", \"CAUDALES\")"
msgstr "<code>table</code>: Nombre de la tabla (ej., \"historico_iru\", \"CAUDALES\")"

