#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>\"m³/h\"</code> → Converts from cubic meters per hour: value × (1000 / 3600) = value × 0.277778"
msgstr "<code>\"m³/h\"</code> → Convierte de metros cúbicos por hora: valor × (1000 / 3600) = valor × 0.277778"

