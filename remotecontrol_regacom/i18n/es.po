msgstr "<code>\"m³/s\"</code> → Convierte de metros cúbicos por segundo: valor × 1000"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>driver_name</code>: \"SQL Server\", \"FreeTDS\", etc. - ODBC driver name"
msgstr "<code>driver_name</code>: \"SQL Server\", \"FreeTDS\", etc. - Nombre del controlador ODBC"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>null</code> in pk_values → filled from device's remotecontrol_params using pk_fields name as key"
msgstr "<code>null</code> en pk_values → se rellena desde remotecontrol_params del dispositivo usando el nombre de pk_fields como clave"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>pk_fields</code>: Array of column names for WHERE clause"
msgstr "<code>pk_fields</code>: Array de nombres de columnas para la cláusula WHERE"

