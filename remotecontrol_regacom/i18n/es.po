#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>trusted_connection</code>: true/false - Use Windows authentication"
msgstr "<code>trusted_connection</code>: true/false - Usar autenticación de Windows"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>unit</code>: Unit of measurement for automatic conversion (see below)"
msgstr "<code>unit</code>: Unidad de medida para conversión automática (ver abajo)"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>value_field</code>: Column with measurement value"
msgstr "<code>value_field</code>: Columna con valor de medición"

