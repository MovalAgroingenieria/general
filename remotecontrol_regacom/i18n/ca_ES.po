"HIRU_nConsumo        : Consumption since last reading"
msgstr "HIRU_idPK            : Clau primària\n"
"HIRU_nDirUM          : ID d'unitat de gestió\n"
"HIRU_nDirIRU         : ID d'hidrant/dispositiu\n"
"HIRU_nFechaHora      : Marca temporal de lectura\n"
"HIRU_nNumero_contador: Número de comptador (1, 2, 3...)\n"
"HIRU_nTotal          : Total acumulat (m³)\n"
"HIRU_nConsumo        : Consum des de l'última lectura"

