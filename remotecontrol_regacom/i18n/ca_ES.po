#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>\"l/s\"</code> or omitted → No conversion (already in l/s)"
msgstr "<code>\"l/s\"</code> o omès → Sense conversió (ja està en l/s)"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>\"m³/h\"</code> → Converts from cubic meters per hour: value × (1000 / 3600) = value × 0.277778"
msgstr "<code>\"m³/h\"</code> → Converteix de metres cúbics per hora: valor × (1000 / 3600) = valor × 0.277778"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>\"m³/s\"</code> → Converts from cubic meters per second: value × 1000"
msgstr "<code>\"m³/s\"</code> → Converteix de metres cúbics per segon: valor × 1000"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>driver_name</code>: \"SQL Server\", \"FreeTDS\", etc. - ODBC driver name"
msgstr "<code>driver_name</code>: \"SQL Server\", \"FreeTDS\", etc. - Nom del controlador ODBC"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>null</code> in pk_values → filled from device's remotecontrol_params using pk_fields name as key"
msgstr "<code>null</code> en pk_values → s'omple des de remotecontrol_params del dispositiu usant el nom de pk_fields com a clau"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>pk_fields</code>: Array of column names for WHERE clause"
msgstr "<code>pk_fields</code>: Array de noms de columnes per a la clàusula WHERE"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>pk_values</code>: Array of values (use <code>null</code> for device-level fields)"
msgstr "<code>pk_values</code>: Array de valors (usar <code>null</code> per a camps a nivell de dispositiu)"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>start_date</code>: Initial sync date (default: last reading or current year start)"
msgstr "<code>start_date</code>: Data de sincronització inicial (per defecte: última lectura o inici de l'any actual)"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>table</code>: Table name (e.g., \"historico_iru\", \"CAUDALES\")"
msgstr "<code>table</code>: Nom de la taula (p. ex., \"historico_iru\", \"CAUDALES\")"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>time_field</code>: Column with timestamp"
msgstr "<code>time_field</code>: Columna amb marca temporal"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>trusted_connection</code>: true/false - Use Windows authentication"
msgstr "<code>trusted_connection</code>: true/false - Usar autenticació de Windows"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>unit</code>: Unit of measurement for automatic conversion (see below)"
msgstr "<code>unit</code>: Unitat de mesura per a conversió automàtica (veure més avall)"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<code>value_field</code>: Column with measurement value"
msgstr "<code>value_field</code>: Columna amb valor de mesurament"

#. module: remotecontrol_regacom
#: model:remotecontrol,remotecontrol_help:remotecontrol_regacom.remotecontrol_regacom
msgid "<strong>Connection closed unexpectedly</strong> → Add tds_version for old SQL Server"
msgstr "<strong>Connexió tancada inesperadament</strong> → Afegir tds_version per a SQL Server antic"

