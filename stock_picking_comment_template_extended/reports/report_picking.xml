<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Inherit picking document report to inject top and bottom comments -->
    <template id="report_picking_document_comments"
              inherit_id="stock_picking_comment_template.report_picking_document_comments">

        <!-- Hide the original top comment placeholder -->
        <xpath expr="//t[@t-as='comment_template_top']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <!-- Insert rendered top comment right after -->
        <xpath expr="//t[@t-as='comment_template_top']" position="after">
            <!-- Render stored HTML from the top_comment field -->
            <t t-raw="o.top_comment"/>
            <!-- Alternative:
            <span t-field="o.top_comment" t-options='{"widget": "html"}'/>
            -->
        </xpath>

        <!-- Hide the original bottom comment placeholder -->
        <xpath expr="//t[@t-as='comment_template_bottom']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <!-- Insert rendered bottom comment right after -->
        <xpath expr="//t[@t-as='comment_template_bottom']" position="after">
            <!-- Render stored HTML from the bottom_comment field -->
            <t t-raw="o.bottom_comment"/>
            <!-- Alternative:
            <span t-field="o.bottom_comment" t-options='{"widget": "html"}'/>
            -->
        </xpath>

    </template>
</odoo>
