<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_picking_document_comments"
              inherit_id="stock_picking_comment_template.report_picking_document_comments"
              priority="99">

        <!-- TOP: replace the original dynamic rendering (before_lines) -->
        <xpath expr="//div[@t-out='o.render_comment(comment_template_top)']/ancestor::t[1]"
               position="replace">
            <t t-if="o.top_comment">
                <div class="mt-2" t-out="o.top_comment"/>
            </t>
        </xpath>

        <!-- BOTTOM: remove the original dynamic rendering (after_lines) -->
        <xpath expr="//div[@t-out='o.render_comment(comment_template_bottom)']/ancestor::t[1]"
               position="replace">
            <t/>
        </xpath>

        <!-- BOTTOM: inject stored HTML right after the move lines table -->
        <xpath expr="//table[@t-if='o.move_line_ids and o.move_ids_without_package']"
               position="after">
            <t t-if="o.bottom_comment">
                <div class="mt-2" t-out="o.bottom_comment"/>
            </t>
        </xpath>

    </template>
</odoo>
