<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Form view -->
    <record id="nrs_template_view_form" model="ir.ui.view">
        <field name="name">NRS Template Form</field>
        <field name="model">nrs.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="template_data">
                        <field name="template_from_wizard" invisible="1"/>
                        <group name="basic_info">
                            <field name="name"/>
                            <field name="type"/>
                            <field name="subject"/>
                            <field name="template" placeholder="The invoice number {{ invoice.number }} dated {{ invoice.date_invoice }} is about to expire."/>
                        </group>
                        <group name="resolved_info">
                            <group style="width: 70%;">
                                <div colspan="4">
                                    <div style="background-color: #F8F8F8; margin-bottom: 2%; margin-right:2%; padding: 10px;
                                        border-top-right-radius: 15px; border-top-left-radius: 15px; border-bottom-left-radius: 15px;">
                                        <field name="template_resolved" nolabel="1"/>
                                    </div>
                                </div>
                                    <button name="action_resolve_template" type="object" class="oe_highlight" attrs="{'invisible':[('template_from_wizard','=',True)]}" help="Try to resolve the template using a random item (partner or invoice).                                         Note that not all error are catch by the system.">
                                        <div class="o_form_field">
                                            <span class="fa fa-retweet fa-lg"/>
                                            <span style="margin-left:8px;">Resolve </span>
                                        </div>
                                    </button>
                            </group>
                            <group style="width: 30%;">
                                <field name="number_of_characters"/>
                                <field name="sms_encoding"/>
                                <field name="number_of_sms"/>
                            </group>
                        </group>
                    </group>
                    <group name="help" attrs="{'invisible':[('template_from_wizard','=',True)]}">
                        <group style="width: 70%;">
                            <div name="help_invoice" style="margin-top: 0px;" class="oe_edit_only">
                                Templates use jinja2 variables: {{ object.attribute }}. The available objects are 'partner' for partner templates and
                                'partner' and 'invoice' for invoice templates. The object 'datetime' is also available to regionally format dates.
                                Limit to 160 (GSM 7) or 70 (UTF 16) characters per SMS after solving the variables.<br/>
                                <br/>
                                Commonly used expressions and variables:<br/>
                                <table style="border-style: hidden; margin-left:8px;padding: 4px 0px;">
                                    <tr name="partner_full_name">
                                        <td>Partner full name</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ partner.display_name }}</td>
                                    </tr>
                                    <tr name="partner_lastname">
                                        <td>Partner lastname</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ partner.lastname }}</td>
                                    </tr>
                                    <tr name="partner_fixed_lenght">
                                        <td>Partner name fixed length (40 chars)</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ partner.display_name[:40] }}</td>
                                    </tr>
                                    <tr name="partner_initial_letter">
                                        <td>Partner firstname initial letter</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ partner.firstname[:1]. }}</td>
                                    </tr>
                                    <tr name="partner_if_exists">
                                        <td>Partner data if exists</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td> {{ partner.phone or "" }} {{ partner.mobile or "" }} {{ partner.email or "" }}</td>
                                    </tr>
                                    <tr name="partner_vat">
                                        <td>Partner VAT</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ partner.vat }}</td>
                                    </tr>
                                    <tr name="invoice_number" attrs="{'invisible': [('type','!=','invoice')]}">
                                        <td>Invoice number</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ invoice.number }}</td>
                                    </tr>
                                    <tr name="invoice_amount" attrs="{'invisible': [('type','!=','invoice')]}">
                                        <td>Invoice amount</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ invoice.amount_total }}</td>
                                    </tr>
                                    <tr name="invoice_surcharge" attrs="{'invisible': [('type','!=','invoice')]}">
                                        <td>Invoice amount plus surcharge (20%)</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ invoice.amount_total + (0.20 * invoice.amount_total) }}</td>
                                    </tr>
                                    <tr name="invoice_date" attrs="{'invisible': [('type','!=','invoice')]}">
                                        <td>Invoice date (dd-mm-yyyy)</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ datetime.strptime(<i>invoice.date_invoice</i>, '%Y-%m-%d').strftime(<i>'%d-%m-%Y'</i>) }}</td>
                                    </tr>
                                    <tr name="invoice_date_due" attrs="{'invisible': [('type','!=','invoice')]}">
                                        <td>Invoice due date (dd/mm/yyyy)</td>
                                        <td style="padding: 0px 4px"> -> </td>
                                        <td>{{ datetime.strptime(<i>invoice.date_due</i>, '%Y-%m-%d').strftime(<i>'%d/%m/%Y'</i>) }}</td>
                                    </tr>
                                </table>
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <!-- Tree view -->
    <record id="nrs_template_view_tree" model="ir.ui.view">
        <field name="name">NRS Template Tree</field>
        <field name="model">nrs.template</field>
        <field name="arch" type="xml">
            <tree string="Templates" class="o_nrs_template_view_tree">
                <field name="name"/>
                <field name="type"/>
                <field name="subject"/>
                <field name="template"/>
            </tree>
        </field>
    </record>

    <!-- Search view -->
    <record id="nrs_template_view_search" model="ir.ui.view">
        <field name="name">NRS Template Search</field>
        <field name="model">nrs.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type"/>
                <field name="subject"/>
                <field name="template"/>
            </search>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_nrs_template_tree" model="ir.actions.act_window">
        <field name="name">SMS Templates</field>
        <field name="res_model">nrs.template</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field ref="nrs_template_view_tree" name="view_id"/>
        <field name="search_view_id" ref="nrs_template_view_search"/>
    </record>

    <!-- Menuentry -->
    <menuitem name="Templates" id="nrs_template_menu" parent="nrs_root_menu"
        action="action_nrs_template_tree" sequence="2"/>

</odoo>