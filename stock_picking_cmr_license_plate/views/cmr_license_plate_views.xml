<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cmr_license_plate_view_tree" model="ir.ui.view">
        <field name="name">cmr.license.plate.tree</field>
        <field name="model">cmr.license.plate</field>
        <field name="arch" type="xml">
            <tree string="License plates" editable="bottom">
                <field name="name"/>
                <field name="note"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="cmr_license_plate_view_form" model="ir.ui.view">
        <field name="name">cmr.license.plate.form</field>
        <field name="model">cmr.license.plate</field>
        <field name="arch" type="xml">
            <form string="License plate">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="cmr_license_plate_view_search" model="ir.ui.view">
        <field name="name">cmr.license.plate.search</field>
        <field name="model">cmr.license.plate</field>
        <field name="arch" type="xml">
            <search string="License plates">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_cmr_license_plate" model="ir.actions.act_window">
        <field name="name">CMR License Plates</field>
        <field name="res_model">cmr.license.plate</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_cmr_license_plate"
              name="CMR License Plates"
              parent="stock.menu_stock_config_settings"
              action="action_cmr_license_plate"
              sequence="80"/>

</odoo>
