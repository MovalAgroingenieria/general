<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="board_grafana_config_settings_view_form" model="ir.ui.view">
        <field name="name">Parameters</field>
        <field name="model">board.grafana.configuration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Apply" type="object" name="execute" class="oe_highlight"/>
                    <button string="Cancel" type="object" name="cancel" class="oe_link"/>
                </header>
                <group string="Grafana configuration" name="grafana_configuration_group">
                    <group name="server">
                        <field name="grafana_url_raw"/>
                        <field name="grafana_api_key" password="True"/>
                        <field name="grafana_default_datasource"/>
                    </group>
                    <group name="defaults">
                        <field name="grafana_dashboard_height"/>
                        <field name="grafana_dashboard_uid" />
                        <field name="grafana_show_navbar_button"/>
                    </group>
                </group>
                <group string="Automatic login (JWT)" name="grafana_jwt_group">
                    <field name="grafana_jwt_login" placeholder="odooreader"/>
                </group>
                <div name="grafana_jwt_key_value" attrs="{'invisible': [('grafana_jwt_key_value', '=', False)]}">
                    <p class="oe_grey">
                        Public key to set in grafana.ini. Regenerating it stops the automatic login until grafana.ini is updated.
                    </p>
                    <field name="grafana_jwt_key_value" class="o_grafana_jwt_key_value"/>
                    <button string="Regenerate key" type="object" name="action_generate_grafana_jwt_key" class="oe_link" confirm="The current key will stop working. Are you sure you want to regenerate it?"/>
                </div>
            </form>
        </field>
    </record>

    <record id="grafana_configuration_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">board.grafana.configuration</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>

</odoo>
