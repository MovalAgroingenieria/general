<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="board_grafana_integration.SystrayItem">
        <li class="o_grafana_systray_item">
            <a href="#" title="Grafana">
                <i class="fa-grafana-logo"/>
            </a>
        </li>
    </t>

    <t t-name="board_grafana_integration.Panel">
        <div class="o_grafana_panel o_hidden">
            <div class="o_grafana_panel_resizer" title="Drag to resize"/>
            <div class="o_grafana_panel_header">
                <span class="o_grafana_panel_title">Grafana</span>
                <div class="o_grafana_panel_buttons">
                    <button type="button" class="btn btn-sm btn-link o_grafana_panel_reload" title="Reload">
                        <i class="fa fa-refresh"/>
                    </button>
                    <button type="button" class="btn btn-sm btn-link o_grafana_panel_new_tab" title="Open in a new tab">
                        <i class="fa fa-external-link"/>
                    </button>
                    <button type="button" class="btn btn-sm btn-link o_grafana_panel_close" title="Close">
                        <i class="fa fa-times"/>
                    </button>
                </div>
            </div>
            <div class="o_grafana_panel_body"/>
        </div>
    </t>

    <t t-name="board_grafana_integration.PanelLoading">
        <div class="o_grafana_panel_loading">
            <i class="fa fa-circle-o-notch fa-spin fa-2x"/>
        </div>
    </t>

</templates>
