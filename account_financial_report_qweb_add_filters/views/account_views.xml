<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_form_group_by" model="ir.ui.view">
      <field name="name">account.account.form.inherit.group_by</field>
      <field name="model">account.account</field>
      <field name="inherit_id" ref="account.view_account_form"/>
      <field name="arch" type="xml">
        <field name="account_type" position="after">
          <field name="group_by" string="Group By"/>
        </field>
      </field>
    </record>

    <record id="view_account_list_group_by" model="ir.ui.view">
      <field name="name">account.account.list.inherit.group_by</field>
      <field name="model">account.account</field>
      <field name="inherit_id" ref="account.view_account_list"/>
      <field name="arch" type="xml">
        <field name="account_type" position="after">
          <field name="group_by" string="Group By"/>
        </field>
      </field>
    </record>

    <record id="view_account_group_form" model="ir.ui.view">
      <field name="name">account.group.form.inherit</field>
      <field name="model">account.group</field>
      <field name="inherit_id" ref="account.view_account_group_form"/>
      <field name="arch" type="xml">
        <field name="company_id" position="after">
          <field name="account_group_01_id" string="Group Level 1"/>
        </field>
      </field>
    </record>

</odoo>