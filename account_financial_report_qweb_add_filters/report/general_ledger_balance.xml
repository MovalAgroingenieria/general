<odoo>
    <record id="general_ledger_report_qweb_paperformat" model="report.paperformat">
        <field name="name">General Ledger report qweb paperformat</field>
        <field name="default" eval="True"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">210</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">110</field>
    </record>

    <record id="report_general_ledger_balance_grouped_action" model="ir.actions.report">
        <field name="name">Trial Balance Report Grouped</field>
        <field name="model">trial.balance.report.grouped.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_financial_report_qweb_add_filters.template_report_trial_balance</field>
        <field name="report_file">account_financial_report_qweb_add_filters.template_report_trial_balance</field>
        <field name="print_report_name">'Trial_Balance_%s_%s' % (object.date_from or '', object.date_to or '')</field>
        <field name="paperformat_id" ref="general_ledger_report_qweb_paperformat"/>
        <field name="binding_model_id" ref="model_trial_balance_report_grouped_wizard"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
