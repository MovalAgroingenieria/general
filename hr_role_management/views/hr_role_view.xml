<odoo>
    <record id="view_hr_role_tree" model="ir.ui.view">
        <field name="name">hr.role.tree</field>
        <field name="model">hr.role</field>
        <field name="arch" type="xml">
            <tree string="Roles" class="o_view_hr_role_tree">
                <field name="name"/>
                <field name="department_id"/>
                <field name="level"/>
                <field name="employee_count" string="Employees Assigned"/>
            </tree>
        </field>
    </record>


    <record id="view_hr_role_form" model="ir.ui.view">
        <field name="name">hr.role.form</field>
        <field name="model">hr.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="department_id"/>
                        <field name="level"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html" options="{'toolbar': 'full'}"/>
                        </page>
                        <page string="Tasks and Responsibilities">
                            <field name="tasks_desc" widget="html" options="{'toolbar': 'full'}"/>
                        </page>
                        <page string="Recommended Competencies">
                            <field name="competencies_desc" widget="html" options="{'toolbar': 'full'}"/>
                        </page>
                        <page string="Assignments">
                            <field name="assignment_ids">
                                <tree editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="date_start"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_role_kanban" model="ir.ui.view">
        <field name="name">hr.role.kanban</field>
        <field name="model">hr.role</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_example">
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record">
                            <div class="o_kanban_primary_left">
                                <strong>Role: </strong>
                                <field name="name"/>
                                <div>
                                    <strong>Department: </strong>
                                    <field name="department_id"/>
                                </div>
                                <div>
                                    <strong>Level: </strong>
                                    <field name="level"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <odoo>
        <record id="view_hr_role_search" model="ir.ui.view">
            <field name="name">hr.role.search</field>
            <field name="model">hr.role</field>
            <field name="arch" type="xml">
                <search string="Role Search">
                    <field name="name" string="Role Name"/>
                    <field name="department_id" string="Department"/>
                    <filter name="level_junior" string="Junior" domain="[('level', '=', 'junior')]"/>
                    <filter name="level_senior" string="Senior" domain="[('level', '=', 'senior')]"/>
                    <filter name="level_lead" string="Lead" domain="[('level', '=', 'lead')]"/>
                    <group expand="1" string="Group By">
                        <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                        <filter string="Level" name="group_by_level" context="{'group_by': 'level'}"/>
                    </group>
                </search>
            </field>
        </record>
    </odoo>

</odoo>