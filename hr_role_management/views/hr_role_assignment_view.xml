<odoo>
    <record id="view_hr_role_assignment_tree" model="ir.ui.view">
        <field name="name">hr.role.assignment.tree</field>
        <field name="model">hr.role.assignment</field>
        <field name="arch" type="xml">
            <tree string="Role Assignments" default_order="date_start desc" class="o_view_hr_role_assignment_tree">
                <field name="employee_id"/>
                <field name="display_name_with_dept" string="Role"/>
                <field name="date_start"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_hr_role_assignment_form" model="ir.ui.view">
        <field name="name">hr.role.assignment.form</field>
        <field name="model">hr.role.assignment</field>
        <field name="arch" type="xml">
            <form string="Role Assignment">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="role_id"/>
                        <field name="date_start"/>
                        <field name="assigned_by" readonly="1"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="note" widget="textarea"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                    <field name="activity_ids" widget="mail_activity"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_hr_role_assignment_kanban" model="ir.ui.view">
        <field name="name">hr.role.assignment.kanban</field>
        <field name="model">hr.role.assignment</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_example" create="false">
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record">
                            <div class="o_kanban_primary_left">
                                <strong><field name="employee_id"/></strong>
                                <div>
                                    <strong>Role: </strong>
                                    <field name="display_name_with_dept"/>
                                </div>
                                <div>
                                    <strong>Start Date: </strong>
                                    <field name="date_start"/>
                                </div>
                                <div>
                                    <strong>Status: </strong>
                                    <field name="state"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_role_assignment_search" model="ir.ui.view">
        <field name="name">hr.role.assignment.search</field>
        <field name="model">hr.role.assignment</field>
        <field name="arch" type="xml">
            <search string="Role Assignments Search">
                <field name="employee_id" string="Employee"/>
                <field name="display_name_with_dept" string="Role"/>
                <field name="date_start" string="Start Date"/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <filter name="state_assigned" string="Assigned" domain="[('state', '=', 'assigned')]"/>
                <group expand="1" string="Group By">
                    <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Role" name="group_by_role" context="{'group_by': 'display_name_with_dept'}"/>
                    <filter string="Start Date" name="group_by_date_start" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
