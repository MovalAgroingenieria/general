<odoo>
    <record id="res_users_form_inherit_role_assignments_table" model="ir.ui.view">
      <field name="name">res.users.form.inherit.role.assignments.table</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="hr.res_users_view_form_profile"/>
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
          <page string="Role Assignments">
            <field name="employee_role_assignment_ids">
              <tree>
                <field name="role_id"/>
                <field name="date_start"/>
                <field name="state"/>
              </tree>
            </field>
          </page>
        </xpath>
      </field>
    </record>
  </odoo>
