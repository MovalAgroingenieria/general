<odoo>
    <record id="view_hr_level_tree" model="ir.ui.view">
        <field name="name">hr.level.tree</field>
        <field name="model">hr.level</field>
        <field name="arch" type="xml">
            <tree string="Levels">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_level_form" model="ir.ui.view">
        <field name="name">hr.level.form</field>
        <field name="model">hr.level</field>
        <field name="arch" type="xml">
            <form string="Level">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html" options="{'toolbar': 'full'}"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
</odoo>
