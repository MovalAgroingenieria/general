#. module: remotecontrol_avamet
#: model:remotecontrol,remotecontrol_help:remotecontrol_avamet.remotecontrol_avamet
msgid "<strong>GET /historic/&lt;station_id&gt;</strong><br>\n"
"        Purpose: fetch historic points for each selected magnitude.<br>\n"
"        Query params: <code>api-key</code>, <code>start-timestamp</code>, <code>end-timestamp</code>.<br>\n"
"        Headers: <code>x-api-secret</code>.<br>\n"
"        Notes: requests are chunked in 6h windows and aggregated to one daily value per sensor/day."
msgstr ""

#. module: remotecontrol_avamet
#: model:remotecontrol,remotecontrol_help:remotecontrol_avamet.remotecontrol_avamet
msgid "<strong>GET /stations/&lt;station_id&gt;</strong><br>\n"
"        Purpose: fetch station metadata (municipality/province) during device creation.<br>\n"
"        Query params: <code>api-key</code>.<br>\n"
"        Headers: <code>x-api-secret</code>."
msgstr ""

#. module: remotecontrol_avamet
#: model:remotecontrol,remotecontrol_help:remotecontrol_avamet.remotecontrol_avamet
msgid "<strong>GET /stations</strong><br>\n"
"        Purpose: load station catalog in wizard reload.<br>\n"
"        Query params: <code>api-key</code>.<br>\n"
"        Headers: <code>x-api-secret</code>."
msgstr ""

