<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="remotecontrol_view_form" model="ir.ui.view">
        <field name="name">remotecontrol form (remotecontrol_avamet)</field>
        <field name="model">remotecontrol</field>
        <field name="inherit_id" ref="mdm_sensor_management_remotecontrol.view_remotecontrol_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='buttons']" position="inside">
                <button name="action_open_avamet_import_wizard"
                        type="object"
                        class="oe_stat_button"
                        string="AVAMET Stations"
                        icon="fa-cloud-download"
                        attrs="{'invisible': [('is_avamet', '=', False)]}"
                        groups="mdm_sensor_management.group_mdm_manager"/>
            </xpath>
            <xpath expr="//field[@name='backoff']" position="after">
                <field name="is_avamet" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
