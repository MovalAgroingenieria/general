<odoo noupdate="0">

    <!-- B1: Employee daily -->
    <record id="mail_template_timesheet_compliance_daily" model="mail.template">
        <field name="name">Timesheet compliance (daily)</field>
        <field name="model_id" ref="model_timesheet_compliance"/>

        <!-- IMPORTANT: single-line, no newlines -->
        <field name="email_from">
            ${(object.company_id.email_formatted or user.email_formatted or user.email or '').replace('\r', ' ').replace('\n', ' ').strip()}
        </field>
        <field name="email_to">${ctx.get('email_to_override') or object.user_id.email or ''}</field>
        <field name="lang">${object.user_id.lang or 'en_US'}</field>
        <field name="subject">Timesheet compliance - ${object.date}</field>
        <field name="auto_delete" eval="True"/>

        <field name="body_html" type="html">
            <div>
                <p>Hello<t t-esc="object.employee_id.name"/>,
                </p>

                <p>
                    Here is your timesheet compliance summary for
                    <b>
                        <t t-esc="object.date"/>
                    </b>
                    .
                </p>

                <h3>Summary</h3>
                <ul>
                    <li>
                        <b>Date:</b>
                        <t t-esc="object.date"/>
                    </li>
                    <li>
                        <b>Telework:</b>
                        <t t-esc="'Yes' if object.telework else 'No'"/>
                    </li>
                    <li>
                        <b>Attendance hours:</b>
                        <t t-esc="object.attendance_hours"/>
                    </li>
                    <li>
                        <b>Timesheet hours:</b>
                        <t t-esc="object.timesheet_hours"/>
                    </li>
                    <li>
                        <b>Timesheet entries:</b>
                        <t t-esc="ctx.get('timesheet_entries_count', 0)"/>
                    </li>
                    <li>
                        <b>Delta:</b>
                        <t t-esc="object.delta_hours"/>
                    </li>
                    <li>
                        <b>State:</b>
                        <t t-esc="object.state"/>
                    </li>
                </ul>

                <h3>Hours by project</h3>
                <table border="1" cellspacing="0" cellpadding="6">
                    <thead>
                        <tr>
                            <th align="left">Project</th>
                            <th align="right">Hours</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="project_rows" t-value="ctx.get('project_rows', [])"/>
                        <t t-if="project_rows">
                            <t t-foreach="project_rows" t-as="row">
                                <tr>
                                    <td>
                                        <t t-esc="row.get('project_name')"/>
                                    </td>
                                    <td align="right">
                                        <t t-esc="row.get('hours')"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="2">No timesheet data for this day.</td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <h3>Top tasks (max 10)</h3>
                <table border="1" cellspacing="0" cellpadding="6">
                    <thead>
                        <tr>
                            <th align="left">Task</th>
                            <th align="right">Hours</th>
                            <th align="left">Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="task_rows" t-value="ctx.get('task_rows', [])"/>
                        <t t-if="task_rows">
                            <t t-foreach="task_rows[:10]" t-as="row">
                                <tr>
                                    <td>
                                        <t t-esc="row.get('task_name')"/>
                                    </td>
                                    <td align="right">
                                        <t t-esc="row.get('hours')"/>
                                    </td>
                                    <td>
                                        <t t-esc="row.get('note')"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="3">No task details found.</td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <h3>Generic allocation ("drawer time")</h3>
                <t t-set="g_pct" t-value="object.generic_pct"/>
                <ul>
                    <li>
                        <b>Generic hours:</b>
                        <t t-esc="object.generic_hours"/>
                    </li>
                    <li>
                        <b>Generic %:</b>
                        <t t-if="g_pct and g_pct &lt;= 1">
                            <t t-esc="'%.2f' % (g_pct * 100.0)"/>%
                        </t>
                        <t t-else="">
                            <t t-esc="g_pct or 0"/>%
                        </t>
                    </li>
                    <li>
                        <b>Min hours to evaluate:</b>
                        <t t-esc="ctx.get('generic_min_hours', 0)"/>
                    </li>
                    <li>
                        <b>Warn threshold %:</b>
                        <t t-esc="ctx.get('generic_warn_pct', 0)"/>%
                    </li>
                    <li>
                        <b>Issue threshold %:</b>
                        <t t-esc="ctx.get('generic_issue_pct', 0)"/>%
                    </li>
                    <li>
                        <b>Generic state:</b>
                        <t t-esc="object.generic_state"/>
                    </li>
                </ul>

                <p>
                    <a t-att-href="ctx.get('my_timesheets_url') or '#'">Open “My timesheets for this day”</a>
                </p>

                <p>Regards,</p>
                <p>
                    <t t-esc="object.company_id.name"/>
                </p>
            </div>
        </field>
    </record>

    <!-- B2: Manager daily -->
    <record id="mail_template_timesheet_compliance_b2_manager" model="mail.template">
        <field name="name">Timesheet compliance (B2 manager daily)</field>
        <field name="model_id" ref="model_timesheet_compliance"/>

        <field name="email_from">
            ${(object.company_id.email_formatted or user.email_formatted or user.email or '').replace('\r', ' ').replace('\n', ' ').strip()}
        </field>
        <field name="email_to">${ctx.get('email_to_override', '')}</field>
        <field name="lang">
            ${(object.company_id.partner_id.lang if (object.company_id and object.company_id.partner_id and object.company_id.partner_id.lang) else (object.user_id.lang or 'en_US'))}
        </field>

        <!-- FIX: subject MUST be single-line and LF/CR-free -->
        <field name="subject">Timesheet compliance incidents</field>

        <field name="auto_delete" eval="True"/>

        <field name="body_html" type="html">
            <div>
                <p>Hello,</p>

                <p>
                    Here is the timesheet compliance incidents summary for
                    <b>
                        <t t-esc="ctx.get('department_name', '')"/>
                    </b>
                    on
                    <b>
                        <t t-esc="ctx.get('target_date', '')"/>
                    </b>
                    .
                </p>

                <h3>Incidents</h3>
                <table border="1" cellspacing="0" cellpadding="6">
                    <thead>
                        <tr>
                            <th align="left">Employee</th>
                            <th align="left">Telework</th>
                            <th align="right">Attendance</th>
                            <th align="right">Timesheet</th>
                            <th align="right">Delta</th>
                            <th align="left">State</th>
                            <th align="right">Generic %</th>
                            <th align="left">Generic state</th>
                            <th align="left">Detail</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="incident_rows" t-value="ctx.get('incident_rows', [])"/>
                        <t t-if="incident_rows">
                            <t t-foreach="incident_rows" t-as="row">
                                <tr>
                                    <td>
                                        <t t-esc="row.get('employee_name', '')"/>
                                    </td>
                                    <td>
                                        <t t-esc="row.get('telework', '')"/>
                                    </td>
                                    <td align="right">
                                        <t t-esc="row.get('attendance_hours', 0)"/>
                                    </td>
                                    <td align="right">
                                        <t t-esc="row.get('timesheet_hours', 0)"/>
                                    </td>
                                    <td align="right">
                                        <t t-esc="row.get('delta_hours', 0)"/>
                                    </td>
                                    <td>
                                        <t t-esc="row.get('state', '')"/>
                                    </td>
                                    <td align="right">
                                        <t t-set="gp" t-value="row.get('generic_pct', 0)"/>
                                        <t t-if="gp and gp &lt;= 1">
                                            <t t-esc="'%.2f' % (gp * 100.0)"/>%
                                        </t>
                                        <t t-else="">
                                            <t t-esc="gp or 0"/>%
                                        </t>
                                    </td>
                                    <td>
                                        <t t-esc="row.get('generic_state', '')"/>
                                    </td>
                                    <td>
                                        <t t-if="row.get('detail_url')">
                                            <a t-att-href="row.get('detail_url')">Open</a>
                                        </t>
                                        <t t-else="">-</t>
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="9">No incidents.</td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <p>
                    <t t-if="ctx.get('department_timesheets_url')">
                        <a t-att-href="ctx.get('department_timesheets_url')">Open department timesheets (filtered)</a>
                    </t>
                </p>

                <p>Regards,</p>
                <p>
                    <t t-esc="object.company_id.name"/>
                </p>
            </div>
        </field>
    </record>

    <!-- B3: Escalation -->
    <record id="mail_template_timesheet_compliance_b3_escalation" model="mail.template">
        <field name="name">Timesheet compliance (B3 escalation)</field>
        <field name="model_id" ref="model_timesheet_compliance"/>

        <field name="email_from">
            ${(object.company_id.email_formatted or user.email_formatted or user.email or '').replace('\r', ' ').replace('\n', ' ').strip()}
        </field>
        <field name="email_to">${ctx.get('email_to_override', '')}</field>
        <field name="lang">
            ${(object.company_id.partner_id.lang if (object.company_id and object.company_id.partner_id and object.company_id.partner_id.lang) else (object.user_id.lang or 'en_US'))}
        </field>
        <field name="subject">Timesheet compliance escalation - ${object.employee_id.name} - ${object.date}</field>
        <field name="auto_delete" eval="True"/>

        <field name="body_html" type="html">
            <div>
                <p>Hello,</p>

                <p>This is an escalation for an unresolved timesheet compliance incident older than 48 hours.</p>

                <h3>Summary</h3>
                <ul>
                    <li>
                        <b>Employee:</b>
                        <t t-esc="object.employee_id.name"/>
                    </li>
                    <li>
                        <b>Date:</b>
                        <t t-esc="object.date"/>
                    </li>
                    <li>
                        <b>Department:</b>
                        <t t-esc="object.department_id.display_name or ''"/>
                    </li>
                    <li>
                        <b>Telework:</b>
                        <t t-esc="'Yes' if object.telework else 'No'"/>
                    </li>
                    <li>
                        <b>Attendance hours:</b>
                        <t t-esc="object.attendance_hours"/>
                    </li>
                    <li>
                        <b>Timesheet hours:</b>
                        <t t-esc="object.timesheet_hours"/>
                    </li>
                    <li>
                        <b>Delta:</b>
                        <t t-esc="object.delta_hours"/>
                    </li>
                    <li>
                        <b>State:</b>
                        <t t-esc="object.state"/>
                    </li>
                </ul>

                <p>
                    <t t-if="ctx.get('detail_url')">
                        <a t-att-href="ctx.get('detail_url')">Open “My timesheets for this day”</a>
                    </t>
                </p>

                <p>Regards,</p>
                <p>
                    <t t-esc="object.company_id.name"/>
                </p>
            </div>
        </field>
    </record>

    <!-- E3: Weekly -->
    <record id="mail_template_timesheet_compliance_e3_weekly" model="mail.template">
        <field name="name">Timesheet compliance (E3 weekly generic quality)</field>
        <field name="model_id" ref="model_timesheet_compliance"/>

        <field name="email_from">
            ${(object.company_id.email_formatted or user.email_formatted or user.email or '').replace('\r', ' ').replace('\n', ' ').strip()}
        </field>
        <field name="email_to">
            ${ctx.get('email_to_override') or (object.department_id.manager_id.user_id.email if object.department_id and object.department_id.manager_id and object.department_id.manager_id.user_id else '')}
        </field>
        <field name="subject">Timesheet generic allocation</field>
        <field name="auto_delete" eval="True"/>

        <field name="body_html" type="html">
            <div>
                <p>Hello,</p>

                <p>
                    Weekly generic allocation quality for
                    <b>
                        <t t-esc="ctx.get('department_name','')"/>
                    </b>
                    (
                    <t t-esc="ctx.get('date_from','')"/>
                    →<t t-esc="ctx.get('date_to','')"/>).
                </p>

                <h3>By employee</h3>
                <table border="1" cellspacing="0" cellpadding="6">
                    <thead>
                        <tr>
                            <th align="left">Employee</th>
                            <th align="right">Total hours</th>
                            <th align="right">Generic hours</th>
                            <th align="right">Generic %</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="employee_rows" t-value="ctx.get('employee_rows', [])"/>
                        <t t-if="employee_rows">
                            <t t-foreach="employee_rows" t-as="row">
                                <tr>
                                    <td>
                                        <t t-esc="row.get('employee_name')"/>
                                    </td>
                                    <td align="right">
                                        <t t-esc="row.get('total_hours')"/>
                                    </td>
                                    <td align="right">
                                        <t t-esc="row.get('generic_hours')"/>
                                    </td>
                                    <td align="right"><t t-esc="row.get('generic_pct')"/>%
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="4">No data.</td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <p>
                    <t t-if="ctx.get('pivot_url')">
                        <a t-att-href="ctx.get('pivot_url')">Open compliance view (filtered)</a>
                    </t>
                </p>

                <p>Regards,</p>
                <p>
                    <t t-esc="object.company_id.name"/>
                </p>
            </div>
        </field>
    </record>

</odoo>
