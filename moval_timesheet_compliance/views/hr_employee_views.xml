<odoo>
    <record id="view_hr_employee_form_timesheet_compliance" model="ir.ui.view">
        <field name="name">hr.employee.form.timesheet.compliance</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Timesheet Compliance" attrs="{'invisible': [('user_id', '=', False)]}">
                    <field name="x_timesheet_compliance_excluded"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
