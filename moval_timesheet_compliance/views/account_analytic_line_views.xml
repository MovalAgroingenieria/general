<odoo>
    <data>

        <record id="action_moval_my_timesheets_by_date" model="ir.actions.act_window">
            <field name="name">My timesheets (by date)</field>
            <field name="res_model">account.analytic.line</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[
                ('date', '=', context.get('moval_timesheet_date')),
                ('user_id', '=', uid)
            ]</field>
            <field name="context">{}</field>
        </record>

        <menuitem
            id="menu_moval_my_timesheets_by_date"
            name="My timesheets (by date)"
            parent="moval_timesheet_compliance.menu_moval_timesheet_compliance_root"
            action="moval_timesheet_compliance.action_moval_my_timesheets_by_date"
            sequence="10"
            groups="moval_timesheet_compliance.group_timesheet_compliance_user,moval_timesheet_compliance.group_timesheet_compliance_manager"
        />

    </data>
</odoo>
