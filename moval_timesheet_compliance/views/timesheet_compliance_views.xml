<odoo>

        <record id="view_moval_timesheet_compliance_tree" model="ir.ui.view">
            <field name="name">timesheet.compliance.tree</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <list string="Timesheet compliance"
                      default_order="date desc, employee_id"
                      create="0"
                      decoration-info="state in ('ok', 'fixed', 'justified')"
                      decoration-warning="state in ('warn',) or generic_state in ('warn',)"
                      decoration-danger="state in ('issue', 'escalated') or generic_state in ('issue',)">
                    <field name="date"/>
                    <field name="employee_id" optional="show"/>
                    <field name="department_id" optional="show"/>
                    <field name="state" optional="show"/>
                    <field name="generic_state" optional="show"/>
                    <field name="telework" optional="hide"/>
                    <field name="attendance_hours" sum="Total"/>
                    <field name="timesheet_hours" sum="Total"/>
                    <field name="delta_hours" sum="Total"/>
                    <field name="generic_pct" optional="show"/>
                    <field name="generic_hours" optional="hide"/>
                    <field name="email_sent_at" optional="hide" groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>
                    <field name="escalated_at" optional="hide" groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>
                    <field name="resolved_at" optional="hide" groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>
                    <field name="resolved_from_state" optional="hide" groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>
                </list>
            </field>
        </record>

        <record id="view_moval_timesheet_compliance_form" model="ir.ui.view">
            <field name="name">timesheet.compliance.form</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="ok,warn,issue,justified,fixed,escalated"/>
                        <button name="action_mark_justified"
                                type="object"
                                string="Mark as justified"
                                class="btn-primary"
                                attrs="{'invisible': [('state','not in',('warn','issue'))]}"
                                groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>
                        <button name="action_open_timesheets"
                                type="object"
                                string="View timesheet lines"
                                class="btn-secondary"
                                help="Open analytic lines (timesheet data) for this day"/>
                        <button name="action_open_attendances"
                                type="object"
                                string="View attendances"
                                class="btn-secondary"
                                help="Open check-ins for this day"/>
                    </header>

                    <div class="alert alert-warning" role="alert" attrs="{'invisible': [('state','not in',('warn','issue'))]}">
                        This record has a pending compliance incident. Review the hours and the employee information below.
                    </div>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="date" readonly="1"/>
                            </group>
                            <group>
                                <field name="telework" readonly="1"/>
                                <field name="generic_state" readonly="1"/>
                                <field name="email_sent_at" readonly="1"/>
                                <field name="incident_open_since" readonly="1" groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>
                                <field name="escalated_at" readonly="1"/>
                                <field name="resolved_at" readonly="1" groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>
                                <field name="resolved_from_state" readonly="1" groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>
                            </group>
                        </group>

                        <group string="Hours">
                            <field name="attendance_hours" readonly="1"/>
                            <field name="timesheet_hours" readonly="1"/>
                            <field name="delta_hours" readonly="1"/>
                        </group>

                        <group string="Generic allocation quality">
                            <field name="generic_hours" readonly="1"/>
                            <field name="generic_pct" readonly="1"
                                   attrs="{'invisible': [('generic_state','=', False)]}"/>
                        </group>

                        <group string="Employee email (B1)" groups="moval_timesheet_compliance.group_timesheet_compliance_manager">
                            <field name="b1_last_log_at" readonly="1"/>
                            <field name="b1_last_log" readonly="1" nolabel="0"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_moval_timesheet_compliance_search" model="ir.ui.view">
            <field name="name">timesheet.compliance.search</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <search string="Search compliance">
                    <field name="date"/>
                    <field name="department_id"/>
                    <field name="employee_id"/>
                    <field name="user_id" groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>

                    <filter name="compliance_date" string="Date" date="date"/>

                    <separator/>

                    <filter name="open_incident" string="Open incidents" domain="[('state', 'in', ('warn', 'issue'))]"/>
                    <filter name="needs_attention" string="Open &amp; escalated" domain="[('state', 'in', ('warn', 'issue', 'escalated'))]"/>
                    <filter name="escalated_only" string="Escalated" domain="[('state', '=', 'escalated')]"/>

                    <filter name="telework" string="Telework" domain="[('telework', '=', True)]"/>
                    <separator/>
                    <filter name="g_warn_issue" string="Any generic alert" domain="[('generic_state', 'in', ('warn', 'issue'))]"/>
                    <filter name="g_ok" string="Generic state: OK" domain="[('generic_state', '=', 'ok')]"/>

                    <separator/>
                    <filter name="state_ok" string="State: OK" domain="[('state', '=', 'ok')]"/>
                    <filter name="state_warn" string="State: Warning" domain="[('state', '=', 'warn')]"/>
                    <filter name="state_issue" string="State: Issue" domain="[('state', '=', 'issue')]"/>
                    <filter name="state_justified" string="State: Justified" domain="[('state', '=', 'justified')]"/>
                    <filter name="state_fixed" string="Legacy fixed" domain="[('state', '=', 'fixed')]"/>

                    <group expand="0" string="Group by">
                        <filter name="groupby_date" string="Date (day)" context="{'group_by': 'date'}"/>
                        <filter name="groupby_date_week" string="Date (week)" context="{'group_by': 'date:week'}"/>
                        <filter name="groupby_emp" string="Employee" context="{'group_by': 'employee_id'}"/>
                        <filter name="groupby_dept" string="Department" context="{'group_by': 'department_id'}"/>
                        <filter name="groupby_state" string="State" context="{'group_by': 'state'}"/>
                        <filter name="groupby_gstate" string="Generic state" context="{'group_by': 'generic_state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_moval_timesheet_compliance_pivot" model="ir.ui.view">
            <field name="name">timesheet.compliance.pivot</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <pivot string="Timesheet compliance (analysis)">
                    <field name="date" type="row" interval="day"/>
                    <field name="employee_id" type="row"/>
                    <field name="department_id" type="row"/>
                    <field name="telework" type="col"/>
                    <field name="state" type="col"/>
                    <field name="generic_state" type="col"/>

                    <field name="attendance_hours" type="measure"/>
                    <field name="timesheet_hours" type="measure"/>
                    <field name="delta_hours" type="measure"/>
                    <field name="generic_hours" type="measure"/>

                    <field name="generic_pct" type="measure" operator="avg"/>
                </pivot>
            </field>
        </record>
        <record id="view_moval_timesheet_compliance_graph" model="ir.ui.view">
            <field name="name">timesheet.compliance.graph</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <graph string="Timesheet compliance (trends)" type="line" stacked="0">
                    <field name="date" type="row" interval="day"/>
                    <field name="timesheet_hours" type="measure"/>
                    <field name="generic_hours" type="measure"/>
                    <field name="generic_pct" type="measure" operator="avg"/>
                </graph>
            </field>
        </record>

</odoo>
