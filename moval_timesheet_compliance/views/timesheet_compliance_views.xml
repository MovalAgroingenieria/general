<odoo>
    <data>

        <record id="view_moval_timesheet_compliance_tree" model="ir.ui.view">
            <field name="name">timesheet.compliance.tree</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <tree default_order="date desc">
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="telework"/>
                    <field name="attendance_hours"/>
                    <field name="timesheet_hours"/>
                    <field name="delta_hours"/>
                    <field name="state"/>
                    <field name="generic_hours"/>
                    <field name="generic_pct"/>
                    <field name="generic_state"/>
                    <field name="email_sent_at"/>
                    <field name="escalated_at"/>
                </tree>
            </field>
        </record>

        <record id="view_moval_timesheet_compliance_form" model="ir.ui.view">
            <field name="name">timesheet.compliance.form</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <header>
                            <button name="action_mark_justified"
                                    type="object"
                                    string="Mark as justified"
                                    class="btn-primary"
                                    attrs="{'invisible': [('state','not in',('warn','issue'))]}"
                                    groups="moval_timesheet_compliance.group_timesheet_compliance_manager"/>
                        </header>

                        <group>
                            <group>
                                <field name="employee_id" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                                <field name="department_id" readonly="1"/>
                                <field name="date" readonly="1"/>
                            </group>
                            <group>
                                <field name="telework" readonly="1"/>
                                <field name="state"/>
                                <field name="email_sent_at" readonly="1"/>
                                <field name="escalated_at" readonly="1"/>
                            </group>
                        </group>

                        <group string="Hours">
                            <field name="attendance_hours" readonly="1"/>
                            <field name="timesheet_hours" readonly="1"/>
                            <field name="delta_hours" readonly="1"/>
                        </group>

                        <group string="Generic Allocation Quality">
                            <field name="generic_hours" readonly="1"/>
                            <field name="generic_pct" readonly="1"/>
                            <field name="generic_state" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_moval_timesheet_compliance_search" model="ir.ui.view">
            <field name="name">timesheet.compliance.search</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <search string="Timesheet Compliance">

                    <field name="date"/>
                    <field name="department_id"/>
                    <field name="employee_id"/>

                    <filter string="Telework" name="telework" domain="[('telework','=',True)]"/>

                    <filter string="Pending incidents" name="pending"
                            domain="[('state','in',('warn','issue'))]"/>

                    <separator/>

                    <filter string="OK" name="state_ok" domain="[('state','=','ok')]"/>
                    <filter string="Warning" name="state_warn" domain="[('state','=','warn')]"/>
                    <filter string="Issue" name="state_issue" domain="[('state','=','issue')]"/>
                    <filter string="Justified" name="state_justified" domain="[('state','=','justified')]"/>
                    <filter string="Fixed" name="state_fixed" domain="[('state','=','fixed')]"/>
                    <filter string="Escalated" name="state_escalated" domain="[('state','=','escalated')]"/>

                    <separator/>

                    <filter string="Generic OK" name="g_ok" domain="[('generic_state','=','ok')]"/>
                    <filter string="Generic Warning" name="g_warn" domain="[('generic_state','=','warn')]"/>
                    <filter string="Generic Issue" name="g_issue" domain="[('generic_state','=','issue')]"/>

                    <group expand="0" string="Group By">
                        <filter string="Date" name="groupby_date" context="{'group_by':'date'}"/>
                        <filter string="Department" name="groupby_dept" context="{'group_by':'department_id'}"/>
                        <filter string="Employee" name="groupby_emp" context="{'group_by':'employee_id'}"/>
                        <filter string="State" name="groupby_state" context="{'group_by':'state'}"/>
                        <filter string="Generic state" name="groupby_gstate" context="{'group_by':'generic_state'}"/>
                    </group>

                </search>
            </field>
        </record>
        <record id="view_moval_timesheet_compliance_pivot" model="ir.ui.view">
            <field name="name">timesheet.compliance.pivot</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <pivot string="Timesheet Compliance Analysis">
                    <!-- Dimensions -->
                    <field name="date" type="row" interval="day"/>
                    <field name="employee_id" type="row"/>
                    <field name="department_id" type="row"/>
                    <field name="telework" type="col"/>
                    <field name="state" type="col"/>
                    <field name="generic_state" type="col"/>

                    <!-- Measures -->
                    <field name="attendance_hours" type="measure"/>
                    <field name="timesheet_hours" type="measure"/>
                    <field name="delta_hours" type="measure"/>
                    <field name="generic_hours" type="measure"/>

                    <!-- generic_pct is a ratio (0..1). avg makes the most sense in pivot. -->
                    <field name="generic_pct" type="measure" operator="avg"/>
                </pivot>
            </field>
        </record>
        <record id="view_moval_timesheet_compliance_graph" model="ir.ui.view">
            <field name="name">timesheet.compliance.graph</field>
            <field name="model">timesheet.compliance</field>
            <field name="arch" type="xml">
                <graph string="Timesheet Compliance Trends" type="line">
                    <field name="date" type="row" interval="day"/>
                    <field name="timesheet_hours" type="measure"/>
                    <field name="generic_hours" type="measure"/>
                    <field name="generic_pct" type="measure" operator="avg"/>
                    <field name="department_id" type="col"/>
                </graph>
            </field>
        </record>


        <record id="action_moval_timesheet_compliance_manager" model="ir.actions.act_window">
            <field name="name">Daily Timesheet Compliance</field>
            <field name="res_model">timesheet.compliance</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_moval_timesheet_compliance_tree"/>
            <field name="search_view_id" ref="view_moval_timesheet_compliance_search"/>
            <field name="context">{}</field>
            <field name="domain">[]</field>
        </record>
        <record id="action_moval_timesheet_compliance_pivot" model="ir.actions.act_window">
            <field name="name">Compliance Analysis</field>
            <field name="res_model">timesheet.compliance</field>
            <field name="view_mode">pivot,graph,tree,form</field>
            <field name="view_id" ref="view_moval_timesheet_compliance_pivot"/>
            <field name="search_view_id" ref="view_moval_timesheet_compliance_search"/>
            <field name="context">
                {
                "search_default_groupby_dept": 1,
                "search_default_groupby_date": 0
                }
            </field>
            <field name="domain">[]</field>
            <field name="groups_id" eval="[(4, ref('moval_timesheet_compliance.group_timesheet_compliance_manager'))]"/>
        </record>
        <menuitem
                id="menu_moval_timesheet_compliance_root"
                name="Timesheet Compliance"
                parent="hr.menu_hr_root"
                sequence="80"
                groups="moval_timesheet_compliance.group_timesheet_compliance_user,moval_timesheet_compliance.group_timesheet_compliance_manager"
        />
        <menuitem
                id="menu_moval_timesheet_compliance_pivot"
                name="Compliance Analysis"
                parent="moval_timesheet_compliance.menu_moval_timesheet_compliance_root"
                action="moval_timesheet_compliance.action_moval_timesheet_compliance_pivot"
                sequence="30"
                groups="moval_timesheet_compliance.group_timesheet_compliance_manager"
        />
        <menuitem
                id="menu_moval_timesheet_compliance"
                name="Daily Compliance"
                parent="moval_timesheet_compliance.menu_moval_timesheet_compliance_root"
                action="moval_timesheet_compliance.action_moval_timesheet_compliance_manager"
                sequence="20"
                groups="moval_timesheet_compliance.group_timesheet_compliance_user,moval_timesheet_compliance.group_timesheet_compliance_manager"
        />

        <menuitem
                id="menu_moval_timesheet_compliance_manager"
                name="Compliance Records"
                parent="moval_timesheet_compliance.menu_moval_timesheet_compliance_root"
                action="moval_timesheet_compliance.action_moval_timesheet_compliance_manager"
                groups="moval_timesheet_compliance.group_timesheet_compliance_manager"
                sequence="30"
        />

    </data>
</odoo>
