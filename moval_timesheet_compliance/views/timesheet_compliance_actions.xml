<odoo>
        <record id="action_moval_timesheet_compliance_manager" model="ir.actions.act_window">
            <field name="name">Timesheet compliance (records)</field>
            <field name="res_model">timesheet.compliance</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_moval_timesheet_compliance_tree"/>
            <field name="search_view_id" ref="view_moval_timesheet_compliance_search"/>
            <field name="context">{}</field>
            <field name="domain">[]</field>
        </record>
        <record id="action_moval_timesheet_compliance_pivot" model="ir.actions.act_window">
            <field name="name">Timesheet compliance (analysis)</field>
            <field name="res_model">timesheet.compliance</field>
            <field name="view_mode">pivot,graph,tree,form</field>
            <field name="view_id" ref="view_moval_timesheet_compliance_pivot"/>
            <field name="search_view_id" ref="view_moval_timesheet_compliance_search"/>
            <field name="context" eval="{'search_default_groupby_dept': 1, 'search_default_compliance_date': 1}"/>
            <field name="domain">[]</field>
            <field name="groups_id" eval="[(4, ref('moval_timesheet_compliance.group_timesheet_compliance_manager'))]"/>
        </record>
        <record id="action_moval_compliance_today_list" model="ir.actions.server">
            <field name="name">Today (list)</field>
            <field name="model_id" ref="model_timesheet_compliance"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_compliance_today()</field>
        </record>
        <record id="action_compliance_analysis_today" model="ir.actions.server">
            <field name="name">Today (analysis)</field>
            <field name="model_id" ref="model_timesheet_compliance"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_analysis_today()</field>
            <field name="binding_model_id" ref="model_timesheet_compliance"/>
            <field name="binding_view_types">list,pivot,graph</field>
        </record>
        <record id="action_compliance_analysis_yesterday" model="ir.actions.server">
            <field name="name">Yesterday (analysis)</field>
            <field name="model_id" ref="model_timesheet_compliance"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_analysis_yesterday()</field>
            <field name="binding_model_id" ref="model_timesheet_compliance"/>
            <field name="binding_view_types">list,pivot,graph</field>
        </record>
        <record id="action_compliance_analysis_this_week" model="ir.actions.server">
            <field name="name">This week (analysis)</field>
            <field name="model_id" ref="model_timesheet_compliance"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_analysis_this_week()</field>
            <field name="binding_model_id" ref="model_timesheet_compliance"/>
            <field name="binding_view_types">list,pivot,graph</field>
        </record>
        <record id="action_compliance_analysis_this_month" model="ir.actions.server">
            <field name="name">This month (analysis)</field>
            <field name="model_id" ref="model_timesheet_compliance"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_analysis_this_month()</field>
            <field name="binding_model_id" ref="model_timesheet_compliance"/>
            <field name="binding_view_types">list,pivot,graph</field>
        </record>
        <record id="action_moval_timesheet_compliance_daily" model="ir.actions.server">
            <field name="name">Daily (yesterday &amp; today)</field>
            <field name="model_id" ref="model_timesheet_compliance"/>
            <field name="state">code</field>
            <field name="code">action = model.action_open_daily_compliance()</field>
        </record>
</odoo>
