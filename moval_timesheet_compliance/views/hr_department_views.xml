<odoo>
    <record id="view_hr_department_form_timesheet_compliance" model="ir.ui.view">
        <field name="name">hr.department.form.timesheet.compliance</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Timesheet Compliance">
                    <field name="x_generic_warn_pct"/>
                    <field name="x_generic_issue_pct"/>
                </group>
                <group string="Timer Watchdog (overrides)">
                    <field name="x_timer_max_active_hours" placeholder="Company default"/>
                    <field name="x_timer_notify_cooldown_hours" placeholder="Company default"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
