<odoo>
    <record id="view_hr_department_form_timesheet_compliance" model="ir.ui.view">
        <field name="name">hr.department.form.timesheet.compliance</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group" position="inside">
                <group string="Timesheet Compliance">
                    <field name="x_generic_warn_pct"/>
                    <field name="x_generic_issue_pct"/>
                </group>
                <group name="moval_hr_dept_timer_watchdog" string="Timer Watchdog">
                    <separator
                        name="moval_hr_dept_timer_watchdog_hint"
                        string="Empty fields use the company default (see Timesheet Compliance in Settings &gt; Human Resources)."/>
                    <field name="x_timer_max_active_hours"/>
                    <field name="x_timer_notify_cooldown_hours"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
