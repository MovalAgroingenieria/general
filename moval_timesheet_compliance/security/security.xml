<odoo>
    <data noupdate="1">
        <record id="group_timesheet_compliance_manager" model="res.groups">
            <field name="name">Timesheet Compliance Manager</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_manager'))]"/>
        </record>

        <record id="group_timesheet_compliance_user" model="res.groups">
            <field name="name">Timesheet Compliance User</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
    </data>
    <data>

        <record id="rule_timesheet_compliance_manager_all" model="ir.rule">
            <field name="name">Timesheet Compliance: managers see all</field>
            <field name="model_id" ref="model_timesheet_compliance"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[(4, ref('moval_timesheet_compliance.group_timesheet_compliance_manager'))]"/>
        </record>

        <record id="rule_timesheet_compliance_user_own" model="ir.rule">
            <field name="name">Timesheet Compliance: users see own</field>
            <field name="model_id" ref="model_timesheet_compliance"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups"
                   eval="[(4, ref('moval_timesheet_compliance.group_timesheet_compliance_user'))]"/>
        </record>

        <record id="rule_aal_own_timesheets_for_compliance_users" model="ir.rule">
            <field name="name">Timesheets: only own (Timesheet Compliance User)</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('moval_timesheet_compliance.group_timesheet_compliance_user'))]"/>
        </record>

         <record id="rule_aal_all_for_compliance_managers" model="ir.rule">
            <field name="name">Timesheets: all (Timesheet Compliance Manager)</field>
            <field name="model_id" ref="analytic.model_account_analytic_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('moval_timesheet_compliance.group_timesheet_compliance_manager'))]"/>
        </record>


    </data>
</odoo>
