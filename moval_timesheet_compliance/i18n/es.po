#. module: moval_timesheet_compliance
#: model:mail.template,body_html:moval_timesheet_compliance.mail_template_timesheet_compliance_b2_manager
msgid ""
"<div>\n"
"                <p>Hello,</p>\n"
"\n"
"                <p>\n"
"                    Here is the timesheet compliance incidents summary for\n"
"                    <b>\n"
"                        <t t-esc=\"ctx.get('department_name', '')\"></t>\n"
"                    </b>\n"
"                    on\n"
"                    <b>\n"
"                        <t t-esc=\"ctx.get('target_date', '')\"></t>\n"
"                    </b>\n"
"                    .\n"
"                </p>\n"
"\n"
"                <h3>Incidents</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Employee</th>\n"
"                            <th align=\"left\">Telework</th>\n"
"                            <th align=\"right\">Attendance</th>\n"
"                            <th align=\"right\">Timesheet</th>\n"
"                            <th align=\"right\">Delta</th>\n"
"                            <th align=\"left\">State</th>\n"
"                            <th align=\"right\">Generic %</th>\n"
"                            <th align=\"left\">Generic state</th>\n"
"                            <th align=\"left\">Detail</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <t t-set=\"incident_rows\" t-value=\"ctx.get('incident_rows', [])\"></t>\n"
"                        <t t-if=\"incident_rows\">\n"
"                            <t t-foreach=\"incident_rows\" t-as=\"row\">\n"
"                                <t t-set=\"row_state\" t-value=\"row.get('state', '')\"></t>\n"
"                                <t t-set=\"row_style\" t-value=\"'background-color: #fff3cd' if row_state == 'warn' else ('background-color: #f8d7da' if row_state == 'issue' else '')\"></t>\n"
"                                <tr t-att-style=\"row_style\">\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('employee_name', '')\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('telework', '')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('attendance_hours_fmt', row.get('attendance_hours', 0))\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('timesheet_hours_fmt', row.get('timesheet_hours', 0))\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('delta_hours_fmt', row.get('delta_hours', 0))\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('state', '')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('generic_pct_fmt', row.get('generic_pct', 0))\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('generic_state', '')\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-if=\"row.get('detail_url')\">\n"
"                                            <a t-att-href=\"row.get('detail_url')\">Open</a>\n"
"                                        </t>\n"
"                                        <t t-else=\"\">-</t>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <tr>\n"
"                                <td colspan=\"9\">No incidents.</td>\n"
"                            </tr>\n"
"                        </t>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <p>\n"
"                    <t t-if=\"ctx.get('department_timesheets_url')\">\n"
"                        <a t-att-href=\"ctx.get('department_timesheets_url')\">Open department timesheets (filtered)</a>\n"
"                    </t>\n"
"                </p>\n"
"\n"
"                <p>Regards,</p>\n"
"                <p>\n"
"                    <t t-esc=\"object.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>Hola,</p>\n"
"\n"
"                <p>\n"
"                    A continuación se muestra el resumen de incidencias de cumplimiento de partes de horas del\n"
"                    <b>{{ ctx.get('department_name', '') }}</b>\n"
"                    correspondientes al día <b>{{ ctx.get('target_date', '') }}</b>.\n"
"                </p>\n"
"\n"
"                <h3>Incidencias</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Empleado</th>\n"
"                            <th align=\"left\">Teletrabajo</th>\n"
"                            <th align=\"right\">Asistencia</th>\n"
"                            <th align=\"right\">Parte de horas</th>\n"
"                            <th align=\"right\">Diferencia</th>\n"
"                            <th align=\"left\">Estado</th>\n"
"                            <th align=\"right\">% genérico</th>\n"
"                            <th align=\"left\">Estado genérico</th>\n"
"                            <th align=\"left\">Detalle</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        {% for row in ctx.get('incident_rows', []) %}\n"
"                        <tr>\n"
"                            <td>{{ row.get('employee_name', '') }}</td>\n"
"                            <td>{{ row.get('telework', '') }}</td>\n"
"                            <td align=\"right\">{{ row.get('attendance_hours', 0) }}</td>\n"
"                            <td align=\"right\">{{ row.get('timesheet_hours', 0) }}</td>\n"
"                            <td align=\"right\">{{ row.get('delta_hours', 0) }}</td>\n"
"                            <td>{{ row.get('state', '') }}</td>\n"
"                            <td align=\"right\">\n"
"                                {% set gp = row.get('generic_pct', 0) %}\n"
"                                \n"
"                                {% if gp and gp &lt;= 1 %}\n"
"                                    {{ '%.2f' % (gp * 100.0) }}%\n"
"                                {% else %}\n"
"                                    {{ gp or 0 }}%\n"
"                                {% endif %}\n"
"                            </td>\n"
"                            <td>{{ row.get('generic_state', '') }}</td>\n"
"                            <td>\n"
"                                {% if row.get('detail_url') %}\n"
"                                <a href=\"%7B%7B%20row.get('detail_url')%20%7D%7D\">Abrir</a>\n"
"                                {% else %}\n"
"                                -\n"
"                                {% endif %}\n"
"                            </td>\n"
"                        </tr>\n"
"                        {% endfor %}\n"
"\n"
"                        {% if not ctx.get('incident_rows') %}\n"
"                        <tr>\n"
"                            <td colspan=\"9\">No hay incidencias.</td>\n"
"                        </tr>\n"
"                        {% endif %}\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <p>\n"
"                    {% if ctx.get('department_timesheets_url') %}\n"
"                    <a href=\"%7B%7B%20ctx.get('department_timesheets_url')%20%7D%7D\">Abrir partes de horas del departamento (filtrados)</a>\n"
"                    {% endif %}\n"
"                </p>\n"
"\n"
"                <p>Un saludo,</p>\n"
"                <p>{{ object.company_id.name }}</p>\n"
"            </div>\n"
"        "

#. module: moval_timesheet_compliance
#: model:mail.template,body_html:moval_timesheet_compliance.mail_template_timesheet_compliance_e3_weekly
msgid ""
"<div>\n"
"                <p>Hello,</p>\n"
"\n"
"                <p>\n"
"                    Weekly generic allocation quality for\n"
"                    <b>\n"
"                        <t t-esc=\"ctx.get('department_name','')\"></t>\n"
"                    </b>\n"
"                    (\n"
"                    <t t-esc=\"ctx.get('date_from','')\"></t>\n"
"                    →<t t-esc=\"ctx.get('date_to','')\"></t>).\n"
"                </p>\n"
"\n"
"                <h3>By employee</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Employee</th>\n"
"                            <th align=\"right\">Total hours</th>\n"
"                            <th align=\"right\">Generic hours</th>\n"
"                            <th align=\"right\">Generic %</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <t t-set=\"employee_rows\" t-value=\"ctx.get('employee_rows', [])\"></t>\n"
"                        <t t-if=\"employee_rows\">\n"
"                            <t t-foreach=\"employee_rows\" t-as=\"row\">\n"
"                                <tr>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('employee_name')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('total_hours')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('generic_hours')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\"><t t-esc=\"row.get('generic_pct')\"></t>%\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <tr>\n"
"                                <td colspan=\"4\">No data.</td>\n"
"                            </tr>\n"
"                        </t>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <p>\n"
"                    <t t-if=\"ctx.get('pivot_url')\">\n"
"                        <a t-att-href=\"ctx.get('pivot_url')\">Open compliance view (filtered)</a>\n"
"                    </t>\n"
"                </p>\n"
"\n"
"                <p>Regards,</p>\n"
"                <p>\n"
"                    <t t-esc=\"object.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>Hola,</p>\n"
"\n"
"                <p>\n"
"                    Calidad semanal de la asignación genérica para\n"
"                    <b>{{ ctx.get('department_name','') }}</b>\n"
"                    ({{ ctx.get('date_from','') }} → {{ ctx.get('date_to','') }}).\n"
"                </p>\n"
"\n"
"                <h3>Por empleado</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Empleado</th>\n"
"                            <th align=\"right\">Horas totales</th>\n"
"                            <th align=\"right\">Horas genéricas</th>\n"
"                            <th align=\"right\">% genérico</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        {% for row in ctx.get('employee_rows', []) %}\n"
"                        <tr>\n"
"                            <td>{{ row.get('employee_name') }}</td>\n"
"                            <td align=\"right\">{{ row.get('total_hours') }}</td>\n"
"                            <td align=\"right\">{{ row.get('generic_hours') }}</td>\n"
"                            <td align=\"right\">{{ row.get('generic_pct') }}%</td>\n"
"                        </tr>\n"
"                        {% endfor %}\n"
"                        {% if not ctx.get('employee_rows') %}\n"
"                        <tr>\n"
"                            <td colspan=\"4\">Sin datos.</td>\n"
"                        </tr>\n"
"                        {% endif %}\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <p>\n"
"                    {% if ctx.get('pivot_url') %}\n"
"                    <a href=\"%7B%7B%20ctx.get('pivot_url')%20%7D%7D\">Abrir vista de cumplimiento (filtrada)</a>\n"
"                    {% endif %}\n"
"                </p>\n"
"\n"
"                <p>Un saludo,</p>\n"
"                <p>{{ object.company_id.name }}</p>\n"
"            </div>\n"
"        "

#. module: moval_timesheet_compliance
#: model:mail.template,body_html:moval_timesheet_compliance.mail_template_timesheet_compliance_b3_escalation
msgid ""
"<div>\n"
"                <p>Hello,</p>\n"
"\n"
"                <p>This is an escalation for an unresolved timesheet compliance incident older than 48 hours.</p>\n"
"\n"
"                <h3>Summary</h3>\n"
"                <ul>\n"
"                    <li>\n"
"                        <b>Employee:</b>\n"
"                        <t t-esc=\"object.employee_id.name\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Date:</b>\n"
"                        <t t-esc=\"object.date\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Department:</b>\n"
"                        <t t-esc=\"object.department_id.display_name or ''\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Telework:</b>\n"
"                        <t t-esc=\"'Yes' if object.telework else 'No'\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Attendance hours:</b>\n"
"                        <t t-esc=\"object.attendance_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Timesheet hours:</b>\n"
"                        <t t-esc=\"object.timesheet_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Delta:</b>\n"
"                        <t t-esc=\"object.delta_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>State:</b>\n"
"                        <t t-esc=\"object.state\"></t>\n"
"                    </li>\n"
"                </ul>\n"
"\n"
"                <p>\n"
"                    <t t-if=\"ctx.get('detail_url')\">\n"
"                        <a t-att-href=\"ctx.get('detail_url')\">Open “My timesheets for this day”</a>\n"
"                    </t>\n"
"                </p>\n"
"\n"
"                <p>Regards,</p>\n"
"                <p>\n"
"                    <t t-esc=\"object.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>Hola,</p>\n"
"\n"
"                <p>\n"
"                    Esta es una escalada de una incidencia de cumplimiento de partes de horas no resuelta con una antigüedad superior a 48 horas.\n"
"                </p>\n"
"\n"
"                <h3>Resumen</h3>\n"
"                <ul>\n"
"                    <li>\n"
"                        <b>Empleado:</b>\n"
"                        {{ object.employee_id.name }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Fecha:</b>\n"
"                        {{ object.date }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Departamento:</b>\n"
"                        {{ object.department_id.display_name or '' }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Teletrabajo:</b>\n"
"                        {{ 'Sí' if object.telework else 'No' }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Horas de asistencia:</b>\n"
"                        {{ object.attendance_hours }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Horas imputadas:</b>\n"
"                        {{ object.timesheet_hours }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Diferencia:</b>\n"
"                        {{ object.delta_hours }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Estado:</b>\n"
"                        {{ object.state }}\n"
"                    </li>\n"
"                </ul>\n"
"\n"
"                <p>\n"
"                    {% if ctx.get('detail_url') %}\n"
"                    <a href=\"%7B%7B%20ctx.get('detail_url')%20%7D%7D\">Abrir “Mis partes de horas de este día”</a>\n"
"                    {% endif %}\n"
"                </p>\n"
"\n"
"                <p>Un saludo,</p>\n"
"                <p>{{ object.company_id.name }}</p>\n"
"            </div>\n"
"        "

#. module: moval_timesheet_compliance
#: model:mail.template,body_html:moval_timesheet_compliance.mail_template_timesheet_compliance_daily
msgid ""
"<div>\n"
"                <p>Hello<t t-esc=\"object.employee_id.name\"></t>,\n"
"                </p>\n"
"\n"
"                <p>\n"
"                    Here is your timesheet compliance summary for\n"
"                    <b>\n"
"                        <t t-esc=\"object.date\"></t>\n"
"                    </b>\n"
"                    .\n"
"                </p>\n"
"\n"
"                <h3>Summary</h3>\n"
"                <ul>\n"
"                    <li>\n"
"                        <b>Date:</b>\n"
"                        <t t-esc=\"object.date\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Telework:</b>\n"
"                        <t t-esc=\"'Yes' if object.telework else 'No'\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Attendance hours:</b>\n"
"                        <t t-esc=\"ctx.get('attendance_hours_fmt', object.attendance_hours)\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Timesheet hours:</b>\n"
"                        <t t-esc=\"ctx.get('timesheet_hours_fmt', object.timesheet_hours)\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Timesheet entries:</b>\n"
"                        <t t-esc=\"ctx.get('timesheet_entries_count', 0)\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Delta:</b>\n"
"                        <t t-esc=\"ctx.get('delta_hours_fmt', object.delta_hours)\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>State:</b>\n"
"                        <t t-esc=\"object.state\"></t>\n"
"                    </li>\n"
"                </ul>\n"
"\n"
"                <h3>Hours by project</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Project</th>\n"
"                            <th align=\"right\">Hours</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <t t-set=\"project_rows\" t-value=\"ctx.get('project_rows', [])\"></t>\n"
"                        <t t-if=\"project_rows\">\n"
"                            <t t-foreach=\"project_rows\" t-as=\"row\">\n"
"                                <tr>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('project_name')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('hours_fmt', row.get('hours'))\"></t>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <tr>\n"
"                                <td colspan=\"2\">No timesheet data for this day.</td>\n"
"                            </tr>\n"
"                        </t>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <h3>Top tasks (max 10)</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Task</th>\n"
"                            <th align=\"right\">Hours</th>\n"
"                            <th align=\"left\">Note</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <t t-set=\"task_rows\" t-value=\"ctx.get('task_rows', [])\"></t>\n"
"                        <t t-if=\"task_rows\">\n"
"                            <t t-foreach=\"task_rows[:10]\" t-as=\"row\">\n"
"                                <tr>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('task_name')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('hours_fmt', row.get('hours'))\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('note')\"></t>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <tr>\n"
"                                <td colspan=\"3\">No task details found.</td>\n"
"                            </tr>\n"
"                        </t>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <h3>Generic allocation (\"drawer time\")</h3>\n"
"                <t t-set=\"g_pct\" t-value=\"object.generic_pct\"></t>\n"
"                <ul>\n"
"                    <li>\n"
"                        <b>Generic hours:</b>\n"
"                        <t t-esc=\"ctx.get('generic_hours_fmt', object.generic_hours)\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Generic %:</b>\n"
"                        <t t-esc=\"ctx.get('generic_pct_fmt', g_pct)\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Min hours to evaluate:</b>\n"
"                        <t t-esc=\"ctx.get('generic_min_hours', 0)\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Warn threshold %:</b>\n"
"                        <t t-esc=\"ctx.get('generic_warn_pct', 0)\"></t>%\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Issue threshold %:</b>\n"
"                        <t t-esc=\"ctx.get('generic_issue_pct', 0)\"></t>%\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Generic state:</b>\n"
"                        <t t-esc=\"object.generic_state\"></t>\n"
"                    </li>\n"
"                </ul>\n"
"\n"
"                <p>\n"
"                    <a t-att-href=\"ctx.get('my_timesheets_url') or '#'\">Open “My timesheets for this day”</a>\n"
"                </p>\n"
"\n"
"                <p>Regards,</p>\n"
"                <p>\n"
"                    <t t-esc=\"object.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>Hola {{ object.employee_id.name }},</p>\n"
"\n"
"                <p>A continuación tienes el resumen de cumplimiento de partes de horas del día <b>{{ object.date }}</b>.\n"
"                </p>\n"
"\n"
"                <h3>Resumen</h3>\n"
"                <ul>\n"
"                    <li>\n"
"                        <b>Fecha:</b>\n"
"                        {{ object.date }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Teletrabajo:</b>\n"
"                        {{ 'Sí' if object.telework else 'No' }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Horas de asistencia:</b>\n"
"                        {{ object.attendance_hours }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Horas imputadas:</b>\n"
"                        {{ object.timesheet_hours }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Número de imputaciones:</b>\n"
"                        {{ ctx.get('timesheet_entries_count', 0) }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Diferencia:</b>\n"
"                        {{ object.delta_hours }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Estado:</b>\n"
"                        {{ object.state }}\n"
"                    </li>\n"
"                </ul>\n"
"\n"
"                <h3>Horas por proyecto</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Proyecto</th>\n"
"                            <th align=\"right\">Horas</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        {% for row in ctx.get('project_rows', []) %}\n"
"                        <tr>\n"
"                            <td>{{ row.get('project_name') }}</td>\n"
"                            <td align=\"right\">{{ row.get('hours') }}</td>\n"
"                        </tr>\n"
"                        {% endfor %}\n"
"                        {% if not ctx.get('project_rows') %}\n"
"                        <tr>\n"
"                            <td colspan=\"2\">No hay datos de partes de horas para este día.</td>\n"
"                        </tr>\n"
"                        {% endif %}\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <h3>Tareas principales (máx. 10)</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Tarea</th>\n"
"                            <th align=\"right\">Horas</th>\n"
"                            <th align=\"left\">Nota</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        {% for row in ctx.get('task_rows', [])[:10] %}\n"
"                        <tr>\n"
"                            <td>{{ row.get('task_name') }}</td>\n"
"                            <td align=\"right\">{{ row.get('hours') }}</td>\n"
"                            <td>{{ row.get('note') }}</td>\n"
"                        </tr>\n"
"                        {% endfor %}\n"
"                        {% if not ctx.get('task_rows') %}\n"
"                        <tr>\n"
"                            <td colspan=\"3\">No se han encontrado detalles de tareas.</td>\n"
"                        </tr>\n"
"                        {% endif %}\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <h3>Asignación genérica (\"tiempo cajón\")</h3>\n"
"                {% set g_pct = object.generic_pct %}\n"
"                <ul>\n"
"                    <li>\n"
"                        <b>Horas genéricas:</b>\n"
"                        {{ object.generic_hours }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>% genérico:</b>\n"
"                        \n"
"                        {% if g_pct and g_pct &lt;= 1 %}\n"
"                            {{ '%.2f' % (g_pct * 100.0) }}%\n"
"                        {% else %}\n"
"                            {{ g_pct or 0 }}%\n"
"                        {% endif %}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Horas mínimas para evaluar:</b>\n"
"                        {{ ctx.get('generic_min_hours', 0) }}\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Umbral de aviso (%):</b>\n"
"                        {{ ctx.get('generic_warn_pct', 0) }}%\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Umbral de incidencia (%):</b>\n"
"                        {{ ctx.get('generic_issue_pct', 0) }}%\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Estado genérico:</b>\n"
"                        {{ object.generic_state }}\n"
"                    </li>\n"
"                </ul>\n"
"\n"
"                <p>\n"
"                    <a href=\"%7B%7B%20ctx.get('my_timesheets_url',%20'#')%20%7D%7D\">Abrir “Mis partes de horas de este día”</a>\n"
"                </p>\n"
"\n"
"                <p>Un saludo,</p>\n"
"                <p>{{ object.company_id.name }}</p>\n"
"            </div>\n"
"        "

