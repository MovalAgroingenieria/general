#. module: moval_timesheet_compliance
#: model:mail.template,body_html:moval_timesheet_compliance.mail_template_timesheet_compliance_b2_manager
msgid ""
"<div>\n"
"                <p>Hello,</p>\n"
"\n"
"                <p>\n"
"                    Here is the timesheet compliance incidents summary for\n"
"                    <b>\n"
"                        <t t-esc=\"ctx.get('department_name', '')\"></t>\n"
"                    </b>\n"
"                    on\n"
"                    <b>\n"
"                        <t t-esc=\"ctx.get('target_date', '')\"></t>\n"
"                    </b>\n"
"                    .\n"
"                </p>\n"
"\n"
"                <h3>Incidents</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Employee</th>\n"
"                            <th align=\"left\">Telework</th>\n"
"                            <th align=\"right\">Attendance</th>\n"
"                            <th align=\"right\">Timesheet</th>\n"
"                            <th align=\"right\">Delta</th>\n"
"                            <th align=\"left\">State</th>\n"
"                            <th align=\"right\">Generic %</th>\n"
"                            <th align=\"left\">Generic state</th>\n"
"                            <th align=\"left\">Detail</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <t t-set=\"incident_rows\" t-value=\"ctx.get('incident_rows', [])\"></t>\n"
"                        <t t-if=\"incident_rows\">\n"
"                            <t t-foreach=\"incident_rows\" t-as=\"row\">\n"
"                                <tr>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('employee_name', '')\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('telework', '')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('attendance_hours', 0)\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('timesheet_hours', 0)\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('delta_hours', 0)\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('state', '')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-set=\"gp\" t-value=\"row.get('generic_pct', 0)\"></t>\n"
"                                        <t t-if=\"gp and gp &lt;= 1\">\n"
"                                            <t t-esc=\"'%.2f' % (gp * 100.0)\"></t>%\n"
"                                        </t>\n"
"                                        <t t-else=\"\">\n"
"                                            <t t-esc=\"gp or 0\"></t>%\n"
"                                        </t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('generic_state', '')\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-if=\"row.get('detail_url')\">\n"
"                                            <a t-att-href=\"row.get('detail_url')\">Open</a>\n"
"                                        </t>\n"
"                                        <t t-else=\"\">-</t>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <tr>\n"
"                                <td colspan=\"9\">No incidents.</td>\n"
"                            </tr>\n"
"                        </t>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <p>\n"
"                    <t t-if=\"ctx.get('department_timesheets_url')\">\n"
"                        <a t-att-href=\"ctx.get('department_timesheets_url')\">Open department timesheets (filtered)</a>\n"
"                    </t>\n"
"                </p>\n"
"\n"
"                <p>Regards,</p>\n"
"                <p>\n"
"                    <t t-esc=\"object.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: moval_timesheet_compliance
#: model:mail.template,body_html:moval_timesheet_compliance.mail_template_timesheet_compliance_e3_weekly
msgid ""
"<div>\n"
"                <p>Hello,</p>\n"
"\n"
"                <p>\n"
"                    Weekly generic allocation quality for\n"
"                    <b>\n"
"                        <t t-esc=\"ctx.get('department_name','')\"></t>\n"
"                    </b>\n"
"                    (\n"
"                    <t t-esc=\"ctx.get('date_from','')\"></t>\n"
"                    →<t t-esc=\"ctx.get('date_to','')\"></t>).\n"
"                </p>\n"
"\n"
"                <h3>By employee</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Employee</th>\n"
"                            <th align=\"right\">Total hours</th>\n"
"                            <th align=\"right\">Generic hours</th>\n"
"                            <th align=\"right\">Generic %</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <t t-set=\"employee_rows\" t-value=\"ctx.get('employee_rows', [])\"></t>\n"
"                        <t t-if=\"employee_rows\">\n"
"                            <t t-foreach=\"employee_rows\" t-as=\"row\">\n"
"                                <tr>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('employee_name')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('total_hours')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('generic_hours')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\"><t t-esc=\"row.get('generic_pct')\"></t>%\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <tr>\n"
"                                <td colspan=\"4\">No data.</td>\n"
"                            </tr>\n"
"                        </t>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <p>\n"
"                    <t t-if=\"ctx.get('pivot_url')\">\n"
"                        <a t-att-href=\"ctx.get('pivot_url')\">Open compliance view (filtered)</a>\n"
"                    </t>\n"
"                </p>\n"
"\n"
"                <p>Regards,</p>\n"
"                <p>\n"
"                    <t t-esc=\"object.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: moval_timesheet_compliance
#: model:mail.template,body_html:moval_timesheet_compliance.mail_template_timesheet_compliance_b3_escalation
msgid ""
"<div>\n"
"                <p>Hello,</p>\n"
"\n"
"                <p>This is an escalation for an unresolved timesheet compliance incident older than 48 hours.</p>\n"
"\n"
"                <h3>Summary</h3>\n"
"                <ul>\n"
"                    <li>\n"
"                        <b>Employee:</b>\n"
"                        <t t-esc=\"object.employee_id.name\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Date:</b>\n"
"                        <t t-esc=\"object.date\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Department:</b>\n"
"                        <t t-esc=\"object.department_id.display_name or ''\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Telework:</b>\n"
"                        <t t-esc=\"'Yes' if object.telework else 'No'\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Attendance hours:</b>\n"
"                        <t t-esc=\"object.attendance_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Timesheet hours:</b>\n"
"                        <t t-esc=\"object.timesheet_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Delta:</b>\n"
"                        <t t-esc=\"object.delta_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>State:</b>\n"
"                        <t t-esc=\"object.state\"></t>\n"
"                    </li>\n"
"                </ul>\n"
"\n"
"                <p>\n"
"                    <t t-if=\"ctx.get('detail_url')\">\n"
"                        <a t-att-href=\"ctx.get('detail_url')\">Open “My timesheets for this day”</a>\n"
"                    </t>\n"
"                </p>\n"
"\n"
"                <p>Regards,</p>\n"
"                <p>\n"
"                    <t t-esc=\"object.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: moval_timesheet_compliance
#: model:mail.template,body_html:moval_timesheet_compliance.mail_template_timesheet_compliance_daily
msgid ""
"<div>\n"
"                <p>Hello<t t-esc=\"object.employee_id.name\"></t>,\n"
"                </p>\n"
"\n"
"                <p>\n"
"                    Here is your timesheet compliance summary for\n"
"                    <b>\n"
"                        <t t-esc=\"object.date\"></t>\n"
"                    </b>\n"
"                    .\n"
"                </p>\n"
"\n"
"                <h3>Summary</h3>\n"
"                <ul>\n"
"                    <li>\n"
"                        <b>Date:</b>\n"
"                        <t t-esc=\"object.date\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Telework:</b>\n"
"                        <t t-esc=\"'Yes' if object.telework else 'No'\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Attendance hours:</b>\n"
"                        <t t-esc=\"object.attendance_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Timesheet hours:</b>\n"
"                        <t t-esc=\"object.timesheet_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Timesheet entries:</b>\n"
"                        <t t-esc=\"ctx.get('timesheet_entries_count', 0)\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Delta:</b>\n"
"                        <t t-esc=\"object.delta_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>State:</b>\n"
"                        <t t-esc=\"object.state\"></t>\n"
"                    </li>\n"
"                </ul>\n"
"\n"
"                <h3>Hours by project</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Project</th>\n"
"                            <th align=\"right\">Hours</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <t t-set=\"project_rows\" t-value=\"ctx.get('project_rows', [])\"></t>\n"
"                        <t t-if=\"project_rows\">\n"
"                            <t t-foreach=\"project_rows\" t-as=\"row\">\n"
"                                <tr>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('project_name')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('hours')\"></t>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <tr>\n"
"                                <td colspan=\"2\">No timesheet data for this day.</td>\n"
"                            </tr>\n"
"                        </t>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <h3>Top tasks (max 10)</h3>\n"
"                <table border=\"1\" cellspacing=\"0\" cellpadding=\"6\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th align=\"left\">Task</th>\n"
"                            <th align=\"right\">Hours</th>\n"
"                            <th align=\"left\">Note</th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <t t-set=\"task_rows\" t-value=\"ctx.get('task_rows', [])\"></t>\n"
"                        <t t-if=\"task_rows\">\n"
"                            <t t-foreach=\"task_rows[:10]\" t-as=\"row\">\n"
"                                <tr>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('task_name')\"></t>\n"
"                                    </td>\n"
"                                    <td align=\"right\">\n"
"                                        <t t-esc=\"row.get('hours')\"></t>\n"
"                                    </td>\n"
"                                    <td>\n"
"                                        <t t-esc=\"row.get('note')\"></t>\n"
"                                    </td>\n"
"                                </tr>\n"
"                            </t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <tr>\n"
"                                <td colspan=\"3\">No task details found.</td>\n"
"                            </tr>\n"
"                        </t>\n"
"                    </tbody>\n"
"                </table>\n"
"\n"
"                <h3>Generic allocation (\"drawer time\")</h3>\n"
"                <t t-set=\"g_pct\" t-value=\"object.generic_pct\"></t>\n"
"                <ul>\n"
"                    <li>\n"
"                        <b>Generic hours:</b>\n"
"                        <t t-esc=\"object.generic_hours\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Generic %:</b>\n"
"                        <t t-if=\"g_pct and g_pct &lt;= 1\">\n"
"                            <t t-esc=\"'%.2f' % (g_pct * 100.0)\"></t>%\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <t t-esc=\"g_pct or 0\"></t>%\n"
"                        </t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Min hours to evaluate:</b>\n"
"                        <t t-esc=\"ctx.get('generic_min_hours', 0)\"></t>\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Warn threshold %:</b>\n"
"                        <t t-esc=\"ctx.get('generic_warn_pct', 0)\"></t>%\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Issue threshold %:</b>\n"
"                        <t t-esc=\"ctx.get('generic_issue_pct', 0)\"></t>%\n"
"                    </li>\n"
"                    <li>\n"
"                        <b>Generic state:</b>\n"
"                        <t t-esc=\"object.generic_state\"></t>\n"
"                    </li>\n"
"                </ul>\n"
"\n"
"                <p>\n"
"                    <a t-att-href=\"ctx.get('my_timesheets_url') or '#'\">Open “My timesheets for this day”</a>\n"
"                </p>\n"
"\n"
"                <p>Regards,</p>\n"
"                <p>\n"
"                    <t t-esc=\"object.company_id.name\"></t>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""

