<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Template override removed to avoid XPath conflicts -->

        <template id="booking_validated_custom_template" inherit_id="appointment_booking_ce.booking_validated">
            <xpath expr="//div[hasclass('col-sm-8')]" position="replace">
                <div class="col-sm-8">
                    <div class="mt-4 mb-4">
                        <div class="alert alert-success" role="status">
                            <h3 class="alert-heading">
                                <i class="fa fa-check-circle me-2"></i>Cita confirmada
                            </h3>
                            <p class="mb-0">
                                <strong>Su cita ha sido reservada exitosamente!</strong>
                            </p>
                        </div>
                        <div class="card shadow-sm">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0">
                                    <i class="fa fa-calendar me-2"></i>Detalles de la cita
                                </h4>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-3 fw-bold">Cita:</div>
                                    <div class="col-sm-9"><t t-esc="event.booking_type_id.name"/></div>
                                </div>
                                <div class="row mb-3" t-if="event.attendee_ids">
                                    <div class="col-sm-3 fw-bold">Participantes:</div>
                                    <div class="col-sm-9">
                                        <t t-foreach="event.attendee_ids" t-as="attendee">
                                            <div class="mb-2">
                                                <t t-esc="attendee.common_name"/>
                                                <br/>
                                                <small class="text-muted" t-if="attendee.email">
                                                    <i class="fa fa-envelope me-1"></i><t t-esc="attendee.email"/>
                                                </small>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-3 fw-bold">Cuándo:</div>
                                    <div class="col-sm-9">
                                        <t t-esc="datetime_start"/>
                                        <br/>
                                        <small class="text-muted">
                                            <i class="fa fa-clock-o me-1"></i>
                                            Duración: <t t-esc="int(event.duration)"/> hora<t t-if="event.duration>=2">s</t>
                                            <br/>
                                            <i class="fa fa-globe me-1"></i>
                                            Zona horaria: <t t-esc="request.session.timezone"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="row mb-3" t-if="event.booking_type_id.location">
                                    <div class="col-sm-3 fw-bold">Ubicación:</div>
                                    <div class="col-sm-9">
                                        <i class="fa fa-map-marker me-1"></i>
                                        <t t-esc="event.booking_type_id.location"/>
                                    </div>
                                </div>
                                <div class="row mb-3" t-if="event.google_meet_url">
                                    <div class="col-sm-3 fw-bold">Google Meet:</div>
                                    <div class="col-sm-9">
                                        <a t-att-href="event.google_meet_url"
                                           class="btn btn-primary btn-sm me-2"
                                           style="text-decoration: none;">
                                            <i class="fa fa-video-camera me-1"></i>Unirse a la reunión
                                        </a>
                                        <br/>
                                        <small class="text-muted mt-1">
                                            Enlace: <a t-att-href="event.google_meet_url" t-esc="event.google_meet_url"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="row mb-3" t-if="event.description">
                                    <div class="col-sm-3 fw-bold">Notas:</div>
                                    <div class="col-sm-9">
                                        <div class="alert alert-light border">
                                            <t t-esc="event.description"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>