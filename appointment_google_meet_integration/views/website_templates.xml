<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="booking_validated_custom_template" inherit_id="appointment_booking_ce.booking_validated">
            <xpath expr="//div[hasclass('col-sm-8')]" position="replace">
                <div class="col-sm-8">
                    <div class="mt-4 mb-4" style="font-family: Arial, sans-serif;">
                        <div class="alert alert-success" style="border-left: 5px solid #2E7D32; background-color: #f1f8e9;">
                            <h3 style="color: #2E7D32; margin-bottom: 15px;">
                                <i class="fa fa-check-circle me-2"></i>Appointment Confirmation
                            </h3>
                            <p class="mb-0">
                                <strong>
                                    <t t-if="event.partner_ids" t-esc="event.partner_ids[0].name"/>
                                    <t t-else="">Valued Client</t>
                                </strong>, your appointment has been successfully booked!
                            </p>
                        </div>
                        <div class="card shadow-sm">
                            <div class="card-header" style="background-color: #1E4C3D; color: white;">
                                <h4 class="mb-0">
                                    <i class="fa fa-calendar me-2"></i>Appointment Details
                                </h4>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-sm-3"><strong>Event:</strong></div>
                                    <div class="col-sm-9"><t t-esc="event.name"/></div>
                                </div>
                                <div class="row mb-3" t-if="event.partner_ids">
                                    <div class="col-sm-3"><strong>Attendee:</strong></div>
                                    <div class="col-sm-9">
                                        <t t-esc="event.partner_ids[0].name"/>
                                        <br/>
                                        <small class="text-muted">
                                            <i class="fa fa-envelope me-1"></i><t t-esc="event.partner_ids[0].email"/>
                                        </small>
                                        <t t-if="event.partner_ids[0].phone">
                                            <br/>
                                            <small class="text-muted">
                                                <i class="fa fa-phone me-1"></i><t t-esc="event.partner_ids[0].phone"/>
                                            </small>
                                        </t>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-sm-3"><strong>When:</strong></div>
                                    <div class="col-sm-9">
                                        <t t-esc="datetime_start"/>
                                        <br/>
                                        <small class="text-muted">
                                            <i class="fa fa-clock-o me-1"></i>
                                            Duration: <t t-esc="int(event.duration)"/> hour<t t-if="event.duration>=2">s</t>
                                            <br/>
                                            <i class="fa fa-globe me-1"></i>
                                            Timezone: <t t-esc="request.session.timezone"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="row mb-3" t-if="event.booking_type_id.location">
                                    <div class="col-sm-3"><strong>Location:</strong></div>
                                    <div class="col-sm-9">
                                        <i class="fa fa-map-marker me-1"></i>
                                        <t t-esc="event.booking_type_id.location"/>
                                    </div>
                                </div>
                                <div class="row mb-3" t-if="event.google_meet_url">
                                    <div class="col-sm-3"><strong>Google Meet:</strong></div>
                                    <div class="col-sm-9">
                                        <a t-att-href="event.google_meet_url"
                                           class="btn btn-primary btn-sm me-2"
                                           style="text-decoration: none;">
                                            <i class="fa fa-video-camera me-1"></i>Join Meeting
                                        </a>
                                        <br/>
                                        <small class="text-muted mt-1">
                                            Link: <a t-att-href="event.google_meet_url" t-esc="event.google_meet_url"/>
                                        </small>
                                    </div>
                                </div>
                                <div class="row mb-3" t-if="event.description">
                                    <div class="col-sm-3"><strong>Notes:</strong></div>
                                    <div class="col-sm-9">
                                        <div class="alert alert-light border-left" style="border-left: 4px solid #2E7D32;">
                                            <t t-esc="event.description"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>