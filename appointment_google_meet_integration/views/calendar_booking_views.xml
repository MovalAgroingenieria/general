<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_calendar_booking_type_form_google_meet" model="ir.ui.view">
            <field name="name">calendar.booking.type.form.inherit.google.meet</field>
            <field name="model">calendar.booking.type</field>
            <field name="inherit_id" ref="appointment_booking_ce.calendar_booking_type_view_form"/>
            <field name="arch" type="xml">

                <field name="location" position="after">
                    <separator string="Video Conference Settings" colspan="2"/>
                    <group colspan="2" col="2">
                        <field name="use_google_meet" widget="boolean_toggle"/>
                    </group>
                    <field name="meeting_base_url"
                           attrs="{'invisible': [('use_google_meet', '=', True)]}"
                           string="Custom Meeting URL (when not using Google Meet)"/>
                </field>
            </field>
        </record>

        <record id="view_calendar_booking_type_tree_google_meet" model="ir.ui.view">
            <field name="name">calendar.booking.type.tree.inherit.google.meet</field>
            <field name="model">calendar.booking.type</field>
            <field name="inherit_id" ref="appointment_booking_ce.calendar_booking_type_view_tree"/>
            <field name="arch" type="xml">
                <field name="location" position="after">
                    <field name="use_google_meet" widget="boolean_toggle" optional="show"/>
                </field>
            </field>
        </record>

    </data>
</odoo>