<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Google Meet Duplicate Cleanup Cron Job -->
        <record id="cron_cleanup_google_meet_duplicates" model="ir.cron">
            <field name="name">Cleanup Google Meet Duplicate Events</field>
            <field name="model_id" ref="model_calendar_event"/>
            <field name="state">code</field>
            <field name="code">model.cleanup_duplicate_google_events()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>