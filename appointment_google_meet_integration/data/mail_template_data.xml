                        Cómo unirse:
                        <t t-if="object.get_base_url() in object.event_id.videocall_location"> Unirse con Conversaciones de Odoo</t>
                        <t t-else=""> Unirse a través de</t><br/>
                        <a t-att-href="object.event_id.videocall_location" target="_blank" t-out="object.event_id.videocall_location or ''" style="text-decoration: none; box-sizing: border-box; color: #495057;">www.mycompany.com/calendar/join_videocall/xyz</a>
                    </li>
                </t>
                <t t-if="not is_html_empty(object.event_id.description)">
                    <li>Descripción del evento:
                    <t t-out="object.event_id.description">Reunión interna para hablar de los nuevos precios de los productos y servicios.</t></li>
                </t>
            </ul>
        </td>
    </tr></tbody></table>
</div>
            </field>
        </record>

        <!-- Automated Action to send notification when new booking is created -->
        <record id="base_automation_booking_notification" model="base.automation">
            <field name="name">Send notification on new appointment booking</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="trigger">on_create</field>
            <field name="state">mail_post</field>
            <field name="template_id" ref="mail_template_appointment_booking_notification"/>
            <field name="filter_pre_domain">[('booking_type_id', '!=', False), ('user_id', '!=', False), ('user_id.partner_id.email', '!=', False), ('user_id.partner_id.email', '!=', '')]</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>