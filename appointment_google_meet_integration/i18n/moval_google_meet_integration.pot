#. module: appointment_google_meet_integration
#: model:mail.template,body_html:appointment_google_meet_integration.google_meet_appointment_booking_confirmation_mail_template
msgid ""
"<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n"
"                    <h2 style=\"color: #2E7D32;\">Appointment Confirmation</h2>\n"
"\n"
"                    <p>\n"
"                        <t t-if=\"object.partner_ids\" t-esc=\"object.partner_ids[0].name\"></t>\n"
"                        <t t-else=\"\">Valued Client</t>,\n"
"                    </p>\n"
"\n"
"                    <p><strong>Your appointment has been successfully booked!</strong></p>\n"
"\n"
"                    <div style=\"background-color: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n"
"                        <h3 style=\"margin-top: 0; color: #1976D2;\">Appointment Details</h3>\n"
"\n"
"                        <table style=\"width: 100%; border-collapse: collapse;\">\n"
"                            <tr>\n"
"                                <td style=\"padding: 8px 0; font-weight: bold; width: 120px;\">Event:</td>\n"
"                                <td style=\"padding: 8px 0;\"><t t-esc=\"object.name\"></t></td>\n"
"                            </tr>\n"
"                            <tr t-if=\"object.partner_ids\">\n"
"                                <td style=\"padding: 8px 0; font-weight: bold;\">Attendee:</td>\n"
"                                <td style=\"padding: 8px 0;\"><t t-esc=\"object.partner_ids[0].name\"></t></td>\n"
"                            </tr>\n"
"                            <tr>\n"
"                                <td style=\"padding: 8px 0; font-weight: bold;\">When:</td>\n"
"                                <td style=\"padding: 8px 0;\">\n"
"                                    <t t-esc=\"object._format_meet_description().split('Date &amp; Time: ')[1].split('Duration:')[0]\" t-if=\"'Date &amp; Time:' in object._format_meet_description()\"></t>\n"
"                                    <t t-else=\"\" t-esc=\"object.start\"></t>\n"
"                                    <br>\n"
"                                    <small style=\"color: #666;\">\n"
"                                        Duration: <t t-esc=\"object.booking_type_id.booking_duration or 1\"></t> hour(s)\n"
"                                    </small>\n"
"                                </td>\n"
"                            </tr>\n"
"                            <tr t-if=\"object.booking_type_id.location\">\n"
"                                <td style=\"padding: 8px 0; font-weight: bold;\">Location:</td>\n"
"                                <td style=\"padding: 8px 0;\"><t t-esc=\"object.booking_type_id.location\"></t></td>\n"
"                            </tr>\n"
"                            <tr t-if=\"object.google_meet_url\">\n"
"                                <td style=\"padding: 8px 0; font-weight: bold;\">Google Meet:</td>\n"
"                                <td style=\"padding: 8px 0;\">\n"
"                                    <a t-att-href=\"object.google_meet_url\" style=\"color: #1976D2; text-decoration: none; background-color: #e3f2fd; padding: 8px 16px; border-radius: 4px; display: inline-block;\">\n"
"                                        Join Meeting\n"
"                                    </a>\n"
"                                    <br>\n"
"                                    <small style=\"color: #666; font-size: 11px;\">\n"
"                                        Link: <t t-esc=\"object.google_meet_url\"></t>\n"
"                                    </small>\n"
"                                </td>\n"
"                            </tr>\n"
"                        </table>\n"
"                    </div>\n"
"\n"
"                    <div t-if=\"object.description\" style=\"margin: 20px 0;\">\n"
"                        <h4>Additional Information:</h4>\n"
"                        <div style=\"background-color: #fafafa; padding: 15px; border-left: 4px solid #2E7D32;\">\n"
"                            <t t-esc=\"object.description\"></t>\n"
"                        </div>\n"
"                    </div>\n"
"                </div>\n"
"            "
msgstr ""

