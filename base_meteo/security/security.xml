<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="module_category_meteo" model="ir.module.category">
        <field name="name">Meteo</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_meteo_user" model="res.groups">
        <field name="name">Meteo / User</field>
        <field name="category_id" ref="module_category_meteo"/>
        <field name="implied_ids"
               eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_meteo_manager" model="res.groups">
        <field name="name">Meteo / Manager</field>
        <field name="category_id" ref="module_category_meteo"/>
        <field name="implied_ids"
               eval="[(4, ref('group_meteo_user'))]"/>
    </record>
</odoo>
