<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Group for KPI management -->
    <record id="group_chatbot_kpi_manager" model="res.groups">
        <field name="name">Chatbot KPI Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Allows viewing and managing KPI data in the chatbot.</field>
    </record>

    <!-- Group for Token limitation management -->
    <record id="group_chatbot_token_manager" model="res.groups">
        <field name="name">Chatbot Token Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Allows viewing and managing token limitations in the chatbot.</field>
    </record>
</odoo>
