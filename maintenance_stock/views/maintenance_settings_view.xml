<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="maintenance_config_settings_view_form" model="ir.ui.view">
        <field name="name">Settings</field>
        <field name="model">maintenance.config.settings</field>
        <field name="inherit_id" ref="base_maintenance_config.view_maintenance_config_settings" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <group name="maintenance_stock_parameters" string="Stock Management">
                    <field name="default_stock_picking_type" options="{'no_quick_create':True,'no_create_edit':True}" style="width:300px" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>