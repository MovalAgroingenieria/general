<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 300-305 Número de convocatoria BDNS [overwrite] -->
    <function model="aeat.model.export.config.line" name="write">
        <value eval="[(ref('l10n_es_aeat_mod347.aeat_mod347_partner_export_line_32'))]"/>
        <value eval="{
            'sequence': 32,
            'size': 6,
            'expression': &quot;${object.bdns_number if object.bdns_number else '000000' if object.report_id.year &gt; 2024 else '      '}&quot;
        }"/>
    </function>

    <!-- 306-500 Blancos [new] -->
    <record id="aeat_mod347_partner_export_line_33" model="aeat.model.export.config.line">
        <field name="sequence">33</field>
        <field name="export_config_id" ref="l10n_es_aeat_mod347.aeat_mod347_partner_export_config"/>
        <field name="name">Blancos</field>
        <field name="export_type">string</field>
        <field name="size">195</field>
        <field name="alignment">left</field>
    </record>

</odoo>
