<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Simply inherit the move line tree view to show date_maturity -->
    <record id="view_move_line_tree_show_date_maturity" model="ir.ui.view">
        <field name="name">account.move.line.tree.show.date.maturity</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="date_maturity" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>

</odoo>