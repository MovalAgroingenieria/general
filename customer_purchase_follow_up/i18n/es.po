#. module: customer_purchase_follow_up
#: model:mail.template,body_html:customer_purchase_follow_up.mail_template_purchase_notification
msgid ""
"<div style=\"margin:0;padding:0;\">\n"
"                <p>Dear ${ctx.get('recipient_user').name or 'User'},</p>\n"
"\n"
"                <p>We inform you that the customer <strong>${object.name}</strong> has not made any purchases recently.\n"
"                </p>\n"
"\n"
"                <table style=\"border-collapse:collapse;width:100%;margin:20px 0;\">\n"
"                    <tr>\n"
"                        <td style=\"border:1px solid #ddd;padding:8px;background-color:#f2f2f2;\">\n"
"                            <strong>Customer:</strong>\n"
"                        </td>\n"
"                        <td style=\"border:1px solid #ddd;padding:8px;\">${object.name}</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"border:1px solid #ddd;padding:8px;background-color:#f2f2f2;\">\n"
"                            <strong>Last purchase:</strong>\n"
"                        </td>\n"
"                        <td style=\"border:1px solid #ddd;padding:8px;\">\n"
"                            % if object.last_purchase_date:\n"
"                            ${object.last_purchase_date.strftime('%d/%m/%Y')}\n"
"                            % else:\n"
"                            No purchases recorded\n"
"                            % endif\n"
"                        </td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"border:1px solid #ddd;padding:8px;background-color:#f2f2f2;\">\n"
"                            <strong>Days without purchase:</strong>\n"
"                        </td>\n"
"                        <td style=\"border:1px solid #ddd;padding:8px;\">${object.days_since_last_purchase} days</td>\n"
"                    </tr>\n"
"                    <tr>\n"
"                        <td style=\"border:1px solid #ddd;padding:8px;background-color:#f2f2f2;\">\n"
"                            <strong>Configured limit:</strong>\n"
"                        </td>\n"
"                        <td style=\"border:1px solid #ddd;padding:8px;\">${object.days_without_purchase_limit} days</td>\n"
"                    </tr>\n"
"                </table>\n"
"\n"
"                <p>We recommend contacting this customer to assess their current needs and offer products or services\n"
"                    that may interest them.\n"
"                </p>\n"
"\n"
"                % if object.email:\n"
"                <p>\n"
"                    <strong>Customer email:</strong>\n"
"                    <a href=\"mailto:%24%7Bobject.email%7D\">${object.email}</a>\n"
"                </p>\n"
"                % endif\n"
"\n"
"                % if object.phone:\n"
"                <p>\n"
"                    <strong>Customer phone:</strong>\n"
"                    ${object.phone}\n"
"                </p>\n"
"                % endif\n"
"\n"
"                <p>Best regards,<br/>Customer Follow-up System\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p>Estimado/a ${ctx.get('recipient_user').name or 'Usuario'},</p>\n"
"\n"
"                    <p>Le informamos que el cliente <strong>${object.name}</strong> no ha realizado compras recientemente.</p>\n"
"\n"
"                    <table style=\"border-collapse: collapse; width: 100%; margin: 20px 0;\">\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;\"><strong>Cliente:</strong></td>\n"
"                            <td style=\"border: 1px solid #ddd; padding: 8px;\">${object.name}</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;\"><strong>Última compra:</strong></td>\n"
"                            <td style=\"border: 1px solid #ddd; padding: 8px;\">\n"
"                                % if object.last_purchase_date:\n"
"                                    ${object.last_purchase_date.strftime('%d/%m/%Y')}\n"
"                                % else:\n"
"                                    No hay compras registradas\n"
"                                % endif\n"
"                            </td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;\"><strong>Días sin comprar:</strong></td>\n"
"                            <td style=\"border: 1px solid #ddd; padding: 8px;\">${object.days_since_last_purchase} días</td>\n"
"                        </tr>\n"
"                        <tr>\n"
"                            <td style=\"border: 1px solid #ddd; padding: 8px; background-color: #f2f2f2;\"><strong>Límite configurado:</strong></td>\n"
"                            <td style=\"border: 1px solid #ddd; padding: 8px;\">${object.days_without_purchase_limit} días</td>\n"
"                        </tr>\n"
"                    </table>\n"
"\n"
"                    <p>Se recomienda contactar con este cliente para evaluar sus necesidades actuales y ofrecerle productos o servicios que puedan interesarle.</p>\n"
"\n"
"                    % if object.email:\n"
"                    <p><strong>Email del cliente:</strong> <a href=\"mailto:${object.email}\">${object.email}</a></p>\n"
"                    % endif\n"
"\n"
"                    % if object.phone:\n"
"                    <p><strong>Teléfono del cliente:</strong> ${object.phone}</p>\n"
"                    % endif\n"
"\n"
"                    <p>Saludos cordiales,<br/>\n"
"                    Sistema de Seguimiento de Clientes</p>\n"
"                </div>\n"
"            "

