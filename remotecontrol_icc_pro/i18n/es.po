#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>Description</code>: Partner/location description"
msgstr "<code>Description</code>: Descripción del cliente/ubicación"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>FieldUnitId</code>: Field unit identifier"
msgstr "<code>FieldUnitId</code>: Identificador de unidad de campo"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>GET /api/accumulation/meters</code> → Get meter readings with parameters:"
msgstr "<code>GET /api/accumulation/meters</code> → Obtener lecturas de contadores con parámetros:"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>GET /api/mainlines</code> → List all mainlines (devices with meters)"
msgstr "<code>GET /api/mainlines</code> → Listar todas las líneas principales (dispositivos con contadores)"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>Id</code>: Mainline identifier"
msgstr "<code>Id</code>: Identificador de línea principal"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>Meter</code>: Meter ID (used for readings API)"
msgstr "<code>Meter</code>: ID del contador (usado para la API de lecturas)"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>MetersData[].AccVolume</code>: Accumulated volume (totalizer)"
msgstr "<code>MetersData[].AccVolume</code>: Volumen acumulado (totalizador)"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>MetersData[].Id</code>: Meter ID"
msgstr "<code>MetersData[].Id</code>: ID del contador"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>MetersData[].Volume</code>: Period volume"
msgstr "<code>MetersData[].Volume</code>: Volumen del período"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>Name</code>: Mainline name/code"
msgstr "<code>Name</code>: Nombre/código de línea principal"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>POST /token</code> → OAuth2 token endpoint"
msgstr "<code>POST /token</code> → Endpoint de token OAuth2"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>Time</code>: Timestamp in format YYYYMMDDHHmmss"
msgstr "<code>Time</code>: Marca de tiempo en formato YYYYMMDDHHmmss"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>client_id</code>: OAuth2 client identifier (e.g., \"Moval-Regadío\")"
msgstr "<code>client_id</code>: Identificador de cliente OAuth2 (ej., \"Moval-Regadío\")"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>client_secret</code>: OAuth2 client secret"
msgstr "<code>client_secret</code>: Secreto de cliente OAuth2"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>fromdatetime=YYYYMMDDHHmmss</code>"
msgstr "<code>fromdatetime=YYYYMMDDHHmmss</code>"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>mainline_id</code>: Mainline ID from ICC PRO"
msgstr "<code>mainline_id</code>: ID de línea principal de ICC PRO"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>meter_id</code>: Meter ID (can be inherited from device)"
msgstr "<code>meter_id</code>: ID del contador (puede heredarse del dispositivo)"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>meter_id</code>: Meter ID from ICC PRO (used for readings API)"
msgstr "<code>meter_id</code>: ID del contador de ICC PRO (usado para la API de lecturas)"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>mid={Meter}</code> (meter ID from mainlines)"
msgstr "<code>mid={Meter}</code> (ID del contador de líneas principales)"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>password</code>: ICC PRO account password"
msgstr "<code>password</code>: Contraseña de cuenta ICC PRO"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>resolution=2</code> (daily)"
msgstr "<code>resolution=2</code> (diario)"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>start_date</code>: Initial date for historical data retrieval"
msgstr "<code>start_date</code>: Fecha inicial para recuperación de datos históricos"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>todatetime=YYYYMMDDHHmmss</code>"
msgstr "<code>todatetime=YYYYMMDDHHmmss</code>"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>username</code>: ICC PRO account username (e.g., \"MOVAL\")"
msgstr "<code>username</code>: Nombre de usuario de cuenta ICC PRO (ej., \"MOVAL\")"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>utc=true</code>"
msgstr "<code>utc=true</code>"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<code>value_field</code>: \"AccVolume\" for totalizer, \"Volume\" for period consumption"
msgstr "<code>value_field</code>: \"AccVolume\" para totalizador, \"Volume\" para consumo del período"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<strong>401 Unauthorized</strong> → Token expired, run Get Token again"
msgstr "<strong>401 No autorizado</strong> → Token expirado, ejecute Obtener Token nuevamente"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<strong>Connection refused</strong> → Check host/port and firewall rules"
msgstr "<strong>Conexión rechazada</strong> → Verifique host/puerto y reglas de firewall"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<strong>Empty readings</strong> → Check meter_id exists and date range is valid"
msgstr "<strong>Lecturas vacías</strong> → Verifique que meter_id existe y el rango de fechas es válido"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<strong>ICC PRO: Daily Sync</strong> → Login + Build Sensor Plan + Get Readings for daily synchronization."
msgstr "<strong>ICC PRO: Sincronización Diaria</strong> → Login + Construir Plan de Sensores + Obtener Lecturas para sincronización diaria."

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<strong>ICC PRO: Get Last Readings</strong> → Login + Get last reading for each configured meter."
msgstr "<strong>ICC PRO: Obtener Últimas Lecturas</strong> → Login + Obtener última lectura para cada contador configurado."

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<strong>ICC PRO: Get Mainlines</strong> → Login + retrieves all mainlines (devices/meters) from ICC PRO."
msgstr "<strong>ICC PRO: Obtener Líneas Principales</strong> → Login + recupera todas las líneas principales (dispositivos/contadores) de ICC PRO."

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
msgid "<strong>Invalid client</strong> → Verify client_id/client_secret are correct"
msgstr "<strong>Cliente inválido</strong> → Verifique que client_id/client_secret sean correctos"

#. module: remotecontrol_icc_pro
#: model:remotecontrol,remotecontrol_help:remotecontrol_icc_pro.remotecontrol_icc_pro
