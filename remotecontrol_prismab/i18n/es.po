msgid "<em>Device configuration:</em>"
msgstr "<em>Configuración del dispositivo:</em>"

#. module: remotecontrol_prismab
#: model:remotecontrol,remotecontrol_help:remotecontrol_prismab.remotecontrol_prismab
msgid "<em>Get Token</em> calls <code>/api/auth/login</code> and stores <code>bag[\"token\"]</code> (JWT <code>access</code>)."
msgstr "<em>Get Token</em> llama a <code>/api/auth/login</code> y almacena <code>bag[\"token\"]</code> ( <code>acceso</code> JWT)."

#. module: remotecontrol_prismab
#: model:remotecontrol,remotecontrol_help:remotecontrol_prismab.remotecontrol_prismab
msgid "<em>Get devices (plan)</em> and <em>Get readings</em> send <code>Authorization: Bearer &lt;token&gt;</code>."
msgstr "<em>Obtener dispositivos (plan)</em> y <em>Obtener lecturas</em> envían <code>Autorización: Bearer &lt;token&gt;</code>"

#. module: remotecontrol_prismab
#: model:remotecontrol,remotecontrol_help:remotecontrol_prismab.remotecontrol_prismab
msgid "<em>Get devices (plan)</em> computes <code>initial_date</code> per sensor: last stored reading date → else <code>sensor.start_date</code> → else <code>device.start_date</code> → else Jan 1 of current year."
msgstr "<em>Obtener dispositivos (plan)</em> calcula <code>fecha_inicial</code> por sensor: última fecha de lectura almacenada → si no <code>sensor.fecha_inicial</code> → si no <code>dispositivo.fecha_inicial</code> → si no 1 de enero del año en curso."

#. module: remotecontrol_prismab
#: model:remotecontrol,remotecontrol_help:remotecontrol_prismab.remotecontrol_prismab
msgid "<em>Get readings</em> calls <code>/api/devices/{prisma_id}/data?startDate=YYYY-MM-DD&amp;endDate=YYYY-MM-DD</code>"
msgstr "Llamadas a <em>lecturas</em> <code>/api/devices/{prisma_id}</code> /data <code>?startDate=YYYY-MM-DD&amp;endDate=YYYY-MM-DD</code>"

