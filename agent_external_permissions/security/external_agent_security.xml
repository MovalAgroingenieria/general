<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_external_agent" model="res.groups">
        <field name="name">External Agent</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_internal_salesperson" model="res.groups">
        <field name="name">Internal Salesperson (CRM: Own Opportunities Only)</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_res_partner_external_agent" model="ir.rule">
        <field name="name">External Agent: Assigned Contacts Only</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="global" eval="False"/>
        <field name="domain_force">
            ['|', ('id', '=', user.partner_id.id), ('external_agent_ids', 'in', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('agent_external_permissions.group_external_agent'))]"/>
    </record>

    <record id="rule_crm_lead_external_agent" model="ir.rule">
        <field name="name">External Agent: Opportunities From Assigned Contacts Only</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="global" eval="False"/>
        <field name="domain_force">
            [
            ('type', '=', 'opportunity'),
            ('partner_id.external_agent_ids', 'in', user.id)
            ]
        </field>
        <field name="groups" eval="[(4, ref('agent_external_permissions.group_external_agent'))]"/>
    </record>

    <record id="rule_crm_lead_internal_salesperson" model="ir.rule">
        <field name="name">Internal Salesperson: Own Opportunities Only</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('type', '=', 'opportunity'), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('agent_external_permissions.group_internal_salesperson'))]"/>
    </record>

    <record id="rule_sale_order_external_agent" model="ir.rule">
        <field name="name">External Agent: No Sales Orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('id', '=', 0)]</field>
        <field name="groups" eval="[(4, ref('agent_external_permissions.group_external_agent'))]"/>
    </record>

</odoo>
