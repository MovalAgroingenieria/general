<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_agent_user" model="res.groups">
            <field name="name">Agent user</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
            <field name="comment">Users whose partner is an agent (agent=True). Record rules restrict access to associated documents.</field>
        </record>

        <record id="group_see_employees_menu" model="res.groups">
            <field name="name">See Employees menu</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
            <field name="comment">Users with this group can see the Employees (HR) menu. Removed from agent users.</field>
        </record>
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('agent_external_permissions.group_see_employees_menu'))]"/>
        </record>
        <record id="hr.menu_hr_root" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('agent_external_permissions.group_see_employees_menu'))]"/>
        </record>

        <record id="rule_res_partner_agent_user" model="ir.rule">
            <field name="name">Agent user: own partner or contacts where agent is assigned</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="global" eval="False"/>
            <field name="domain_force">['|', ('id', '=', user.partner_id.id), ('agent_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('agent_external_permissions.group_agent_user'))]"/>
        </record>

        <record id="rule_crm_lead_agent_user" model="ir.rule">
            <field name="name">Agent user: opportunities of contacts where agent is assigned</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('type', '=', 'opportunity'), ('partner_id.agent_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('agent_external_permissions.group_agent_user'))]"/>
        </record>

        <record id="rule_sale_order_agent_user" model="ir.rule">
            <field name="name">Agent user: sale orders of contacts where agent is assigned</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('partner_id.agent_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('agent_external_permissions.group_agent_user'))]"/>
        </record>

        <record id="rule_hr_expense_agent_user" model="ir.rule">
            <field name="name">Agent user: own expenses only</field>
            <field name="model_id" ref="hr_expense.model_hr_expense"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('agent_external_permissions.group_agent_user'))]"/>
        </record>

        <record id="rule_hr_expense_sheet_agent_user" model="ir.rule">
            <field name="name">Agent user: own expense sheets only</field>
            <field name="model_id" ref="hr_expense.model_hr_expense_sheet"/>
            <field name="global" eval="False"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('agent_external_permissions.group_agent_user'))]"/>
        </record>
    </data>
</odoo>
