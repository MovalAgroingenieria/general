<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add agent field to opportunity form view -->
    <record id="view_crm_opportunity_form_external_agent" model="ir.ui.view">
        <field name="name">crm.lead.form.external.agent</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('external_agent_ids', 'in', uid)]</attribute>
                <attribute name="groups">agent_external_permissions.group_external_agent</attribute>
            </xpath>
            <!-- Insert after Salesperson (user_id) -->
            <xpath expr="//field[@name='user_id']" position="after">
                <group string="External Agents" invisible="type == 'lead'">
                    <field name="external_agent_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <div class="text-muted">
                        Agents are automatically copied from the Contact.
                    </div>
                </group>
            </xpath>

        </field>
    </record>


</odoo>
