<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add fields to user form view -->
    <record id="view_users_form_external_agent" model="ir.ui.view">
        <field name="name">res.users.form.external.agent</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Agent Configuration">
                    <field name="is_external_agent"/>
                    <field name="is_internal_salesperson"/>

                    <!-- Show assigned contacts only for external agents -->
                    <field name="agent_contacts"
                           widget="many2many_tags"
                           invisible="not is_external_agent"/>
                    <div class="text-muted" invisible="not is_external_agent">
                        These contacts are linked from the Contact form (External Agents field).
                    </div>
                </group>
            </xpath>

        </field>
    </record>
</odoo>
