<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="view_update_agents_wizard_form" model="ir.ui.view">
        <field name="name">update.agents.wizard.form</field>
        <field name="model">update.agents.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Agents on Opportunities">
                <sheet>
                    <div class="oe_title">
                        <h1>Update External Agents</h1>
                        <div class="text-muted">
                            Propagate external agents from contact to opportunities
                        </div>
                    </div>

                    <group>
                        <group>
                            <field name="partner_id"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="opportunity_count" readonly="1"/>
                        </group>

                        <group>
                            <field name="update_existing"/>
                            <field name="create_new_opportunities"
                                   invisible="opportunity_count &gt; 0"/>
                        </group>
                    </group>

                    <div class="alert alert-info mt-4" role="alert">
                        <strong>Current Agents:</strong>
                        <span class="text-muted">
                            Check the contact to see assigned agents.
                        </span>
                    </div>

                    <footer>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                        <button name="action_update_agents"
                                string="Update Opportunities"
                                type="object"
                                class="btn-primary"
                                invisible="not partner_id"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="action_update_agents_wizard" model="ir.actions.act_window">
        <field name="name">Update Agents on Opportunities</field>
        <field name="res_model">update.agents.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form</field>
        <field name="context">{'default_partner_id': active_id}</field>
    </record>

</odoo>
