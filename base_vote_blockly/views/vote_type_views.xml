<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vote_type_view_form_blockly" model="ir.ui.view">
        <field name="name">vote.type.form.blockly</field>
        <field name="model">vote.type</field>
        <field name="inherit_id" ref="base_vote.vote_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='formula']" position="replace">
                <page string="Fórmula" name="formula">
                    <group>
                        <field name="formula_type" widget="radio"/>
                        <field name="formula_fixed_value" invisible="formula_type != 'fixed'"/>
                        <field name="formula_relation_name" placeholder="ej. ter_parcel_ids" invisible="formula_type not in ('count_relation', 'sum_relation')"/>
                        <field name="formula_attribute" placeholder="ej. surface" invisible="formula_type != 'sum_relation'"/>
                        <field name="formula_divisor" invisible="formula_type != 'sum_relation'"/>
                        <field name="formula_blockly_xml" nolabel="1" invisible="formula_type != 'blockly'" widget="blockly_formula"/>
                        <field name="formula" placeholder="ej. partner.ter_parcel_ids | length" nolabel="1" invisible="formula_type != 'custom'" widget="formula_editor"/>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="formula_type != 'custom'">
                        <p><strong>Fórmula avanzada:</strong> variable <code>partner</code>. Ejemplos: <code>partner.ter_parcel_ids | length</code>; <code>partner.ter_parcel_ids | map(attribute='surface') | sum / 10</code>.</p>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="formula_type != 'blockly'">
                        <p><strong>Blockly:</strong> arrastra bloques para montar la fórmula.</p>
                    </div>
                    <div class="alert alert-secondary" role="alert" invisible="formula_type == 'custom'">
                        <p><strong>Valor fijo:</strong> mismo número de votos para todos.</p>
                        <p><strong>Cantidad de registros:</strong> un voto por elemento (ej. parcelas).</p>
                        <p><strong>Suma de un campo:</strong> sumar campo y dividir (ej. superficie ÷ 10).</p>
                        <p><strong>Blockly:</strong> editor visual por bloques.</p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
