<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="base_vote_blockly.TestFormulaDialog">
        <Dialog title="title" size="'md'">
            <div class="mb-3">
                <label class="form-label">Contacto</label>
                <select class="form-select" t-att-disabled="state.loading"
                    t-att-data-value="state.partnerId"
                    t-on-change="onPartnerChange">
                    <t t-foreach="state.partners" t-as="p" t-key="p.id">
                        <option t-att-value="p.id" t-att-selected="p.id === state.partnerId" t-esc="p.display_name or p.name"/>
                    </t>
                </select>
            </div>
            <t t-if="state.result">
                <div t-if="state.result.error" class="alert alert-danger" role="alert">
                    <t t-esc="state.result.error"/>
                </div>
                <div t-else="" class="alert alert-success" role="alert">
                    <t t-esc="state.result.detail"/>
                </div>
            </t>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary"
                    t-att-disabled="!canTest or state.loading"
                    t-on-click="onTest">
                    <t t-esc="state.loading ? 'Procesando…' : 'Probar'"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="onClose">Cerrar</button>
            </t>
        </Dialog>
    </t>

    <t t-name="base_vote_blockly.FormulaEditorField">
        <t t-if="props.readonly">
            <pre class="o_form_text_pasted mb-0" style="white-space: pre-wrap;"><t t-esc="props.record.data[props.name] or ''"/></pre>
        </t>
        <t t-else="">
            <div class="d-flex flex-column gap-1">
                <textarea
                    class="o_input form-control font-monospace"
                    style="min-height: 120px;"
                    t-att-id="props.id"
                    t-att-placeholder="props.placeholder"
                    t-ref="textarea"
                    rows="6"
                />
                <div class="d-flex justify-content-end">
                    <button type="button" class="btn btn-secondary btn-sm"
                        t-att-disabled="!canTest"
                        t-att-title="canTest ? 'Probar fórmula con un contacto' : 'Guardar el tipo de votación para poder probar'"
                        t-on-click="onTestFormula">
                        Probar fórmula
                    </button>
                </div>
            </div>
        </t>
    </t>
</templates>
