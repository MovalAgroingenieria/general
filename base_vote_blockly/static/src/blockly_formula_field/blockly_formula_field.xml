<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="base_vote_blockly.BlocklyFormulaField">
        <div class="o_field_blockly_formula">
            <div class="o_blockly_toolbar mb-2 d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    <t t-esc="'Arrastra bloques desde la izquierda.'"/>
                </span>
                <div class="d-flex gap-1">
                    <button type="button" class="btn btn-secondary btn-sm"
                        t-att-disabled="!canTestFormula"
                        t-on-click="onTestFormula"
                        t-att-title="'Probar la fórmula con un contacto y ver el resultado'">
                        <t t-esc="'Probar fórmula'"/>
                    </button>
                    <button type="button" class="btn btn-primary btn-sm"
                        t-att-disabled="!canSaveFormula"
                        t-on-click="onSaveFormula"
                        t-att-title="'Guardar la fórmula en el servidor'">
                        <t t-esc="'Guardar fórmula'"/>
                    </button>
                </div>
            </div>
            <t t-if="blocklyReady.value and toolbox.value">
                <BlocklyWorkspace
                    :value="props.record.data.formula_blockly_xml ?? ''"
                    :toolbox="toolbox.value"
                    :getCode="getCode"
                    :onValueChange="onValueChange"
                />
            </t>
            <div class="o_blockly_formula_preview mt-2 pt-2 border-top">
                <span class="text-muted small"><t t-esc="'Fórmula que se aplica:'"/></span>
                <code class="d-block mt-1 p-2 bg-light rounded font-monospace small" t-esc="displayFormula"/>
            </div>
        </div>
    </t>
</templates>
