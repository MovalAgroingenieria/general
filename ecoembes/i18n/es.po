msgstr "<strong>No se han encontrado datos</strong>"

#. module: ecoembes
#: model_terms:ir.ui.view,arch_db:ecoembes.report_scrap_annual_document
msgid ""
"<strong>Note:</strong> This report shows the SCRAP (Extended Producer Responsibility System) contributions\n"
"                           calculated based on the packaging materials used in products sold during the selected year."
msgstr ""
"<strong>Nota:</strong> Este informe muestra las contribuciones al SCRAP (Sistema de Responsabilidad Ampliada del Productor)\n"
"                           calculadas a partir de los materiales de envasado utilizados en los productos vendidos durante el año seleccionado."

