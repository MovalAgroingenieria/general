#. module: ecoembes
#: model:ir.actions.report,print_report_name:ecoembes.action_report_scrap_annual
msgid "'SCRAP annual report - %s' % (object.year)"
msgstr "'Informe anual SCRAP - %s' % (object.year)"

#. module: ecoembes
#: model_terms:ir.ui.view,arch_db:ecoembes.report_invoice_document_scrap_notice
msgid "<span style=\"font-weight: bold;\">SCRAP contribution:</span>"
msgstr "<span style=\"font-weight: bold;\">Contribución SCRAP:</span>"

#. module: ecoembes
#: model_terms:ir.ui.view,arch_db:ecoembes.report_scrap_annual_document
msgid ""
"<strong>Calculation:</strong> Weight (kg) * Official fee per kg = "
"Contribution amount"
msgstr ""
"<strong>Cálculo:</strong> Peso (kg) * Tarifa oficial por kg = Importe de la "
"contribución"

