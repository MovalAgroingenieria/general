<odoo>
    <!-- Tree (list) view -->
    <record id="view_submaterial_type_tree" model="ir.ui.view">
        <field name="name">submaterial.type.list</field>
        <field name="model">submaterial.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="submaterial_id"/>
                <field name="name"/>
                <field name="fee_per_kg"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_submaterial_type_form" model="ir.ui.view">
        <field name="name">submaterial.type.form</field>
        <field name="model">submaterial.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="submaterial_id"/>
                        <field name="fee_per_kg"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- (Optional) Search view for quick filtering -->
    <record id="view_submaterial_type_search" model="ir.ui.view">
        <field name="name">submaterial.type.search</field>
        <field name="model">submaterial.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name"/>
                <field name="code" string="Code"/>
                <field name="submaterial_id" string="Submaterial"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_submaterial_type" model="ir.actions.act_window">
        <field name="name">Submaterial Types</field>
        <field name="res_model">submaterial.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_submaterial_type_search"/>
    </record>
    <menuitem
            id="menu_product_submaterial_type"
            name="Submaterial Types"
            parent="menu_product_main"
            sequence="30"
            action="action_submaterial_type"/>
</odoo>
