<odoo>
    <record id="product_template_form_view_ecoembes" model="ir.ui.view">
        <field name="name">product.template.form.ecoembes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Insert a new page inside the main notebook of the product form -->
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Ecoembes">
                    <group>
                        <field name="is_manufactured"/>
                    </group>

                    <group>
                        <field name="product_component_line_ids" nolabel="1"
                               context="{'list_view_ref': 'ecoembes.view_product_component_list_product',
                               'form_view_ref': 'ecoembes.view_product_component_form_product'}"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
