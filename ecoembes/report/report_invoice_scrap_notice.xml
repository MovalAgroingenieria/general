<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- SCRAP contribution notice on the invoice PDF -->
    <template id="report_invoice_document_scrap_notice"
              inherit_id="account.report_invoice_document">
        <!-- Insert just before the payment communication paragraph -->
        <xpath expr="//p[@name='payment_communication']" position="before">
            <t t-set="scrap_total" t-value="o.scrap_contribution_total or 0.0"/>
            <t t-if="scrap_total > 0.0">
                <p name="scrap_contribution_notice"
                   class="scrap-notice"
                   style="margin-bottom: 10px;">
                    <span style="font-weight: bold;">SCRAP contribution:</span>
                    <strong style="float: right;">
                        <span t-esc="scrap_total"
                              t-options='{"widget": "monetary",
                                          "display_currency": o.currency_id}'/>
                    </strong>
                </p>
            </t>
        </xpath>
    </template>
</odoo>
