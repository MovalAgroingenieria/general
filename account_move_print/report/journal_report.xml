<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Document template (called per record) -->
    <template id="journal_entries_report_document">
        <div class="page">
            <div>
                <h2>
                    <span t-field="o.name" />
                </h2>
            </div>
            <div id="information" class="row mt32 mb32">
                <div class="col-xs-3" name="date">
                    <strong>Accounting Date:</strong>
                    <p t-field="o.date" />
                </div>
                <div class="col-xs-3" name="ref">
                    <strong>Reference:</strong>
                    <p t-esc="o.ref or ''" />
                </div>
                <div
                    class="col-xs-3"
                    name="company"
                    groups="base.group_multi_company"
                >
                    <strong>Company:</strong>
                    <p t-esc="o.company_id.name" />
                </div>
                <div class="col-xs-3" name="journal">
                    <strong>Journal:</strong>
                    <p t-esc="o.journal_id.name" />
                </div>
                <div
                    class="col-xs-3"
                    name="partner"
                    t-if="o.partner_id"
                >
                    <strong>Partner:</strong>
                    <p t-esc="o.partner_id.name" />
                </div>
            </div>
            <t t-set="move_data" t-value="moves_data.get(o.id, {})" />
            <div class="row">
                <table
                    name="lines_content"
                    width="100%"
                    class="table table-condensed o_main_table"
                >
                    <thead>
                        <tr>
                            <th name="th_account" class="text-left">Account</th>
                            <th name="th_partner" class="text-left">Partner</th>
                            <th name="th_label" class="text-left">Label</th>
                            <th
                                name="th_analytic_account"
                                class="text-left"
                                groups="analytic.group_analytic_accounting"
                            >Analytic Account</th>
                            <th
                                name="th_amount_currency"
                                class="text-left"
                                groups="base.group_multi_currency"
                            >Amount in Currency</th>
                            <th name="th_debit" class="text-left" style="white-space: nowrap;">Debit</th>
                            <th name="th_credit" class="text-left" style="white-space: nowrap;">Credit</th>
                            <th name="th_tax_id" class="text-left">Originator Tax</th>
                            <th name="th_tax_ids" class="text-left">Taxes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="move_data.get('lines', [])" t-as="line">
                            <tr style="page-break-before: always; page-break-after: auto; page-break-inside: avoid;">
                                <td name="tb_account">
                                    <span t-esc="line['account_name']" />
                                </td>
                                <td name="tb_partner">
                                    <span t-esc="line['partner_name'] or ''" />
                                </td>
                                <td name="tb_line_name">
                                    <span t-esc="line['line_name'] or ''" />
                                </td>
                                <td
                                    name="tb_analytic"
                                    groups="analytic.group_analytic_accounting"
                                >
                                    <span t-esc="line['analytic_name'] or ''" />
                                </td>
                                <td
                                    name="tb_amount_currency"
                                    groups="base.group_multi_currency"
                                >
                                    <span t-if="line['amount_currency_fmt']"
                                        t-esc="line['amount_currency_fmt']" />
                                </td>
                                <td name="tb_debit" style="white-space: nowrap;">
                                    <span t-esc="line['debit_fmt']" />
                                </td>
                                <td name="tb_credit" style="white-space: nowrap;">
                                    <span t-esc="line['credit_fmt']" />
                                </td>
                                <td name="tb_originator_tax">
                                    <span t-esc="line['tax_line_name'] or ''" />
                                </td>
                                <td name="tb_taxes">
                                    <span t-esc="line['tax_names'] or ''" />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td name="tf_account" />
                            <td name="tf_partner" />
                            <td name="tf_line_name" />
                            <td
                                name="tf_analytic"
                                groups="analytic.group_analytic_accounting"
                            />
                            <td
                                name="tf_amount_currency"
                                groups="base.group_multi_currency"
                            />
                            <td name="tf_debit" style="white-space: nowrap;">
                                <strong><span t-esc="move_data.get('total_debit_fmt', '')" /></strong>
                            </td>
                            <td name="tf_credit" style="white-space: nowrap;">
                                <strong><span t-esc="move_data.get('total_credit_fmt', '')" /></strong>
                            </td>
                            <td name="tf_originator_tax" />
                            <td name="tf_taxes" />
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <p style="page-break-after:always;"/>
    </template>

    <!-- Wrapper template (entry point) -->
    <template id="journal_entries_report_id">
        <t t-call="report.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="base_wua_report.wua_external_layout">
                    <t t-call="account_move_print.journal_entries_report_document"/>
                </t>
            </t>
        </t>
    </template>

    <report
        id="journal_entries_move_print_id"
        model="account.move"
        string="Journal Entries"
        report_type="qweb-pdf"
        name="account_move_print.journal_entries_report_id"
        file="account_move_print.journal_entries_report_id"
    />

</odoo>
