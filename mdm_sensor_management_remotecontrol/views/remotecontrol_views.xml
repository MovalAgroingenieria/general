<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_remotecontrol_form" model="ir.ui.view">
        <field name="name">remotecontrol.form.inherited</field>
        <field name="model">remotecontrol</field>
        <field name="inherit_id" ref="base_remotecontrol.view_remotecontrol_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_procedures']" position="after">
                <button name="action_view_devices"
                                type="object"
                                class="oe_stat_button"
                                string="Devices"
                                icon="fa-hdd-o"/>
            </xpath>
        </field>
    </record>

    <record id="view_remotecontrol_procedure_form" model="ir.ui.view">
        <field name="name">remotecontrol.procedure.form.inherited</field>
        <field name="model">remotecontrol.procedure</field>
        <field name="inherit_id" ref="base_remotecontrol.view_remotecontrol_procedure_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='remote_id']" position="after">
                <field name="procedure_for_readings"
                       string="Readings Proc."/>
            </xpath>
        </field>
    </record>

    <record id="view_remotecontrol_procedure_tree" model="ir.ui.view">
        <field name="name">remotecontrol.procedure.tree.inherited</field>
        <field name="model">remotecontrol.procedure</field>
        <field name="inherit_id" ref="base_remotecontrol.view_remotecontrol_procedure_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='remote_id']" position="after">
                <field name="procedure_for_readings"
                       string="Readings Proc."/>
            </xpath>
        </field>
    </record>

</odoo>