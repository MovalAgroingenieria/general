<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mdm_device_view_form" model="ir.ui.view">
        <field name="name">Measurement Device Form</field>
        <field name="model">mdm.measurement.device</field>
        <field name="inherit_id" ref="mdm_sensor_management.mdm_device_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='serial_number']" position="after">
                <field name="remotecontrol_id"/>
                <field name="remotecontrol_params" widget="ace" options="{'mode': 'json', 'theme': 'monokai'}" placeholder="{'device_id': 1234}" attrs="{'invisible': [('remotecontrol_id', '=', False)]}"/>
            </xpath>
        </field>
    </record>

    <record id="mdm_device_view_tree" model="ir.ui.view">
        <field name="name">Measurement Device Tree</field>
        <field name="model">mdm.measurement.device</field>
        <field name="inherit_id" ref="mdm_sensor_management.mdm_device_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='brand']" position="after">
                <field name="remotecontrol_id"/>
            </xpath>
        </field>
    </record>

</odoo>
