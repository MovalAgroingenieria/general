<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mdm_device_view_form" model="ir.ui.view">
        <field name="name">Measurement Device Form</field>
        <field name="model">mdm.measurement.device</field>
        <field name="inherit_id" ref="mdm_sensor_management.mdm_device_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger" role="alert"
                     attrs="{'invisible': ['|', ('remotecontrol_params_valid', '=', True), ('remotecontrol_id', '=', False)]}">
                    <strong>Configuration Error:</strong> The Remotecontrol Parameters field contains invalid JSON format.
                    Please correct the syntax before saving.
                </div>
                <header>
                    <field name="readings_procedure_id" invisible="1"/>
                    <button name="action_run_readings_procedure" type="object"
                            string="Get readings"
                            style="width: 150px;"
                            icon="fa-download"
                            attrs="{'invisible': [('readings_procedure_id','=',False)]}"
                            groups="mdm_sensor_management.group_mdm_manager"
                            confirm="This action will retrieve pending readings. Proceed?"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='serial_number']" position="after">
                <field name="remotecontrol_id"/>
                <field name="remotecontrol_params_valid" invisible="1"/>
                <field name="remotecontrol_params"
                       widget="ace"
                       options="{'mode': 'json', 'theme': 'monokai'}"
                       placeholder="{'device_id': 1234}"
                       class="oe_edit_only"
                       attrs="{'invisible': [('remotecontrol_id', '=', False)]}"
                       style="border: 3px solid;"/>
            </xpath>
        </field>
    </record>

    <record id="mdm_device_view_tree" model="ir.ui.view">
        <field name="name">Measurement Device Tree</field>
        <field name="model">mdm.measurement.device</field>
        <field name="inherit_id" ref="mdm_sensor_management.mdm_device_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='brand']" position="after">
                <field name="remotecontrol_id"/>
            </xpath>
        </field>
    </record>

    <record id="mdm_device_view_search" model="ir.ui.view">
        <field name="name">Measurement Device Search</field>
        <field name="model">mdm.measurement.device</field>
        <field name="inherit_id" ref="mdm_sensor_management.mdm_device_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='model']" position="after">
                <filter string="Telecontrol" name="telecontrol" context="{'group_by':'remotecontrol_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_mdm_device_run_readings_multi" model="ir.actions.server">
        <field name="name">Get readings</field>
        <field name="model_id" ref="mdm_sensor_management.model_mdm_measurement_device"/>
        <field name="state">code</field>
        <field name="code">records.action_run_readings_procedure_multi()</field>
        <field name="groups_id" eval="[(4, ref('mdm_sensor_management.group_mdm_manager'))]"/>
    </record>

    <record id="action_mdm_device_run_readings_multi_binding" model="ir.values">
        <field name="name">Get readings</field>
        <field name="key">action</field>
        <field name="key2">client_action_multi</field>
        <field name="model">mdm.measurement.device</field>
        <field name="value" eval="'ir.actions.server,' + str(ref('action_mdm_device_run_readings_multi'))"/>
    </record>

</odoo>
