#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Note:</strong> <code>value</code> is a string (must be cast to float). <code>timestamp</code>\n"
"is in <strong>milliseconds</strong> since epoch (UTC). The response returns all published\n"
"variables for the device regardless of the <code>variableLabel</code> query parameter."
msgstr ""

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Readings Import</strong> (daily / scheduled):\n"
"    Build plan from Odoo devices → getValues per device → Upsert readings.\n"
"    Handles date ranges and structured error recovery."
