msgstr "8) Notas Técnicas"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>apikey</code>: <strong>Required.</strong> Qampo API key. Must be sent in the <code>apikey</code> HTTP header for every request."
msgstr "<code>apikey</code>: <strong>Obligatorio.</strong> Clave API de Qampo. Debe enviarse en la cabecera HTTP <code>apikey</code> en cada petición."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>node_id</code>: <strong>Required.</strong> Qampo device ID (string)."
msgstr "<code>node_id</code>: <strong>Obligatorio.</strong> Identificador del dispositivo Qampo (cadena)."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>nodeid</code>, <code>ts_start</code>, <code>ts_end</code>, [<code>variableLabel</code>]"
msgstr "<code>nodeid</code>, <code>ts_start</code>, <code>ts_end</code>, [<code>variableLabel</code>]"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>start_date</code>: Optional. Overrides device start_date if provided."
msgstr "<code>start_date</code>: Opcional. Sobreescribe la start_date del dispositivo si se indica."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>start_date</code>: Optional. Start date for first data retrieval (YYYY-MM-DD). Defaults to Jan 1st of current year."
msgstr "<code>start_date</code>: Opcional. Fecha de inicio para la primera recuperación de datos (YYYY-MM-DD). Por defecto, 1 de enero del año en curso."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>timezone</code>: Default IANA timezone for timestamp conversion (default: <code>Europe/Madrid</code>)."
msgstr "<code>timezone</code>: Zona horaria IANA por defecto para la conversión de marcas de tiempo (predeterminado: <code>Europe/Madrid</code>)."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>variable_label</code>: <strong>Required.</strong> Label of the published variable (used as key in getValues response)."
msgstr "<code>variable_label</code>: <strong>Obligatorio.</strong> Etiqueta de la variable publicada (usada como clave en la respuesta de getValues)."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Catalog Sync</strong> (run once / periodically):\n"
"    Health check → Fetch devices → Auto-create mdm.measurement.device and\n"
"    mdm.measurement.device.sensor records. Idempotent.\n"
"    Produces a JSON attachment with the full device catalog."
msgstr "<strong>Sincronización de Catálogo</strong> (ejecutar una vez / periódicamente):\n"
"    Health check → Obtener dispositivos → Auto-crear registros mdm.measurement.device y\n"
"    mdm.measurement.device.sensor. Idempotente.\n"
"    Genera un adjunto JSON con el catálogo completo de dispositivos."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Minimum (required):</strong>"
msgstr "<strong>Mínimo (obligatorio):</strong>"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Note:</strong> <code>value</code> is a string (must be cast to float). <code>timestamp</code>\n"
"is in <strong>milliseconds</strong> since epoch (UTC). The response returns all published\n"
"variables for the device regardless of the <code>variableLabel</code> query parameter."
msgstr "<strong>Nota:</strong> <code>value</code> es una cadena (debe convertirse a float). <code>timestamp</code>\n"
"está en <strong>milisegundos</strong> desde epoch (UTC). La respuesta devuelve todas las variables\n"
"publicadas del dispositivo independientemente del parámetro <code>variableLabel</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Readings Import</strong> (daily / scheduled):\n"
"    Build plan from Odoo devices → getValues per device → Upsert readings.\n"
"    Handles date ranges and structured error recovery."
msgstr "<strong>Importación de Lecturas</strong> (diaria / programada):\n"
"    Construir plan desde dispositivos Odoo → getValues por dispositivo → Upsert de lecturas.\n"
"    Gestiona rangos de fechas y recuperación estructurada de errores."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>With optional fields:</strong>"
msgstr "<strong>Con campos opcionales:</strong>"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>connection_params</strong> (JSON):"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Audit JSON attachment created after each execution."
msgstr "Se crea un adjunto JSON de auditoría después de cada ejecución."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Authentication is via <code>apikey</code> header on every request. No session management."
msgstr "La autenticación se realiza mediante la cabecera <code>apikey</code> en cada petición. Sin gestión de sesión."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Description"
msgstr "Descripción"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Device (<code>mdm.measurement.device</code>) remotecontrol_params:"
msgstr "Dispositivo (<code>mdm.measurement.device</code>) remotecontrol_params:"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Each device represents a Qampo <strong>station</strong> (node)."
msgstr "Cada dispositivo representa una <strong>estación</strong> (nodo) de Qampo."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Each sensor represents a Qampo <strong>published variable</strong> within a device."
msgstr "Cada sensor representa una <strong>variable publicada</strong> de Qampo dentro de un dispositivo."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Endpoint"
msgstr "Endpoint"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "GET"
msgstr "GET"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "GPS coordinates are stored in the device <code>location</code> field. Other metadata (owner, etc.) goes into <code>description</code>."
msgstr "Las coordenadas GPS se almacenan en el campo <code>location</code> del dispositivo. Otros metadatos (propietario, etc.) van en <code>description</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Get sensor readings. Timestamps are in <strong>milliseconds</strong> (epoch).\n"
"    Returns all published variables for the device regardless of variableLabel filter."
msgstr "Obtener lecturas de sensores. Las marcas de tiempo están en <strong>milisegundos</strong> (epoch).\n"
"    Devuelve todas las variables publicadas del dispositivo independientemente del filtro variableLabel."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Health check. Returns <code>{\"code\": 200, \"status\": \"OK\"}</code>."
msgstr "Comprobación de estado. Devuelve <code>{\"code\": 200, \"status\": \"OK\"}</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Idempotent readings via <code>upsert(sensor_id, measurement_time)</code>."
msgstr "Lecturas idempotentes mediante <code>upsert(sensor_id, measurement_time)</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "List all devices (stations) with their sensors and published variables."
msgstr "Listar todos los dispositivos (estaciones) con sus sensores y variables publicadas."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "List configured crops."
msgstr "Listar cultivos configurados."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Method"
msgstr "Método"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Other metadata (variable type, primary sensor, etc.) is stored in the sensor <code>description</code> field."
msgstr "Otros metadatos (tipo de variable, sensor primario, etc.) se almacenan en el campo <code>description</code> del sensor."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Parameters"
msgstr "Parámetros"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Qampo REST API v2 · Odoo Integration"
msgstr "Qampo REST API v2 · Integración con Odoo"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Qampo uses <strong>API key authentication</strong>. The key is sent in every request via the\n"
"<code>apikey</code> HTTP header. No login/session step is needed."
msgstr "Qampo utiliza <strong>autenticación por clave API</strong>. La clave se envía en cada petición mediante la\n"
"cabecera HTTP <code>apikey</code>. No es necesario un paso de login/sesión."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Sensor (<code>mdm.measurement.device.sensor</code>) remotecontrol_params:"
msgstr "Sensor (<code>mdm.measurement.device.sensor</code>) remotecontrol_params:"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Timestamps in the API are in <strong>milliseconds</strong> (epoch UTC)."
msgstr "Las marcas de tiempo en la API están en <strong>milisegundos</strong> (epoch UTC)."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Type: <code>REST</code>. Base URL: <code>https://api.qampo.es/apiv2/api</code>."
msgstr "Tipo: <code>REST</code>. URL base: <code>https://api.qampo.es/apiv2/api</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Values in getValues response are <strong>strings</strong> (e.g. <code>\"31.09\"</code>)."
msgstr "Los valores en la respuesta de getValues son <strong>cadenas</strong> (p. ej. <code>\"31.09\"</code>)."

