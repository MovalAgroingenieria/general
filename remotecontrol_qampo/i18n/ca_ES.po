msgstr "8) Notes Tècniques"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>apikey</code>: <strong>Required.</strong> Qampo API key. Must be sent in the <code>apikey</code> HTTP header for every request."
msgstr "<code>apikey</code>: <strong>Obligatori.</strong> Clau API de Qampo. S'ha d'enviar a la capçalera HTTP <code>apikey</code> a cada petició."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>node_id</code>: <strong>Required.</strong> Qampo device ID (string)."
msgstr "<code>node_id</code>: <strong>Obligatori.</strong> Identificador del dispositiu Qampo (cadena)."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>nodeid</code>, <code>ts_start</code>, <code>ts_end</code>, [<code>variableLabel</code>]"
msgstr "<code>nodeid</code>, <code>ts_start</code>, <code>ts_end</code>, [<code>variableLabel</code>]"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>start_date</code>: Optional. Overrides device start_date if provided."
msgstr "<code>start_date</code>: Opcional. Sobreescriu la start_date del dispositiu si s'indica."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>start_date</code>: Optional. Start date for first data retrieval (YYYY-MM-DD). Defaults to Jan 1st of current year."
msgstr "<code>start_date</code>: Opcional. Data d'inici per a la primera recuperació de dades (YYYY-MM-DD). Per defecte, 1 de gener de l'any en curs."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>timezone</code>: Default IANA timezone for timestamp conversion (default: <code>Europe/Madrid</code>)."
msgstr "<code>timezone</code>: Zona horària IANA per defecte per a la conversió de marques de temps (predeterminat: <code>Europe/Madrid</code>)."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<code>variable_label</code>: <strong>Required.</strong> Label of the published variable (used as key in getValues response)."
msgstr "<code>variable_label</code>: <strong>Obligatori.</strong> Etiqueta de la variable publicada (usada com a clau a la resposta de getValues)."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Catalog Sync</strong> (run once / periodically):\n"
"    Health check → Fetch devices → Auto-create mdm.measurement.device and\n"
"    mdm.measurement.device.sensor records. Idempotent.\n"
"    Produces a JSON attachment with the full device catalog."
msgstr "<strong>Sincronització de Catàleg</strong> (executar un cop / periòdicament):\n"
"    Health check → Obtenir dispositius → Auto-crear registres mdm.measurement.device i\n"
"    mdm.measurement.device.sensor. Idempotent.\n"
"    Genera un adjunt JSON amb el catàleg complet de dispositius."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Minimum (required):</strong>"
msgstr "<strong>Mínim (obligatori):</strong>"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Note:</strong> <code>value</code> is a string (must be cast to float). <code>timestamp</code>\n"
"is in <strong>milliseconds</strong> since epoch (UTC). The response returns all published\n"
"variables for the device regardless of the <code>variableLabel</code> query parameter."
msgstr "<strong>Nota:</strong> <code>value</code> és una cadena (s'ha de convertir a float). <code>timestamp</code>\n"
"està en <strong>mil·lisegons</strong> des de epoch (UTC). La resposta retorna totes les variables\n"
"publicades del dispositiu independentment del paràmetre <code>variableLabel</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>Readings Import</strong> (daily / scheduled):\n"
"    Build plan from Odoo devices → getValues per device → Upsert readings.\n"
"    Handles date ranges and structured error recovery."
msgstr "<strong>Importació de Lectures</strong> (diària / programada):\n"
"    Construir pla des de dispositius Odoo → getValues per dispositiu → Upsert de lectures.\n"
"    Gestiona rangs de dates i recuperació estructurada d'errors."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>With optional fields:</strong>"
msgstr "<strong>Amb camps opcionals:</strong>"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>connection_params</strong> (JSON):"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Audit JSON attachment created after each execution."
msgstr "Es crea un adjunt JSON d'auditoria després de cada execució."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Authentication is via <code>apikey</code> header on every request. No session management."
msgstr "L'autenticació es fa mitjançant la capçalera <code>apikey</code> a cada petició. Sense gestió de sessió."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Description"
msgstr "Descripció"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Device (<code>mdm.measurement.device</code>) remotecontrol_params:"
msgstr "Dispositiu (<code>mdm.measurement.device</code>) remotecontrol_params:"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Each device represents a Qampo <strong>station</strong> (node)."
msgstr "Cada dispositiu representa una <strong>estació</strong> (node) de Qampo."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Each sensor represents a Qampo <strong>published variable</strong> within a device."
msgstr "Cada sensor representa una <strong>variable publicada</strong> de Qampo dins d'un dispositiu."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Endpoint"
msgstr "Endpoint"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "GET"
msgstr "GET"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "GPS coordinates are stored in the device <code>location</code> field. Other metadata (owner, etc.) goes into <code>description</code>."
msgstr "Les coordenades GPS s'emmagatzemen al camp <code>location</code> del dispositiu. Altres metadades (propietari, etc.) van a <code>description</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Get sensor readings. Timestamps are in <strong>milliseconds</strong> (epoch).\n"
"    Returns all published variables for the device regardless of variableLabel filter."
msgstr "Obtenir lectures de sensors. Les marques de temps estan en <strong>mil·lisegons</strong> (epoch).\n"
"    Retorna totes les variables publicades del dispositiu independentment del filtre variableLabel."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Health check. Returns <code>{\"code\": 200, \"status\": \"OK\"}</code>."
msgstr "Comprovació d'estat. Retorna <code>{\"code\": 200, \"status\": \"OK\"}</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Idempotent readings via <code>upsert(sensor_id, measurement_time)</code>."
msgstr "Lectures idempotents mitjançant <code>upsert(sensor_id, measurement_time)</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "List all devices (stations) with their sensors and published variables."
msgstr "Llistar tots els dispositius (estacions) amb els seus sensors i variables publicades."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "List configured crops."
msgstr "Llistar cultius configurats."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Method"
msgstr "Mètode"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Other metadata (variable type, primary sensor, etc.) is stored in the sensor <code>description</code> field."
msgstr "Altres metadades (tipus de variable, sensor primari, etc.) s'emmagatzemen al camp <code>description</code> del sensor."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Parameters"
msgstr "Paràmetres"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Qampo REST API v2 · Odoo Integration"
msgstr "Qampo REST API v2 · Integració amb Odoo"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Qampo uses <strong>API key authentication</strong>. The key is sent in every request via the\n"
"<code>apikey</code> HTTP header. No login/session step is needed."
msgstr "Qampo utilitza <strong>autenticació per clau API</strong>. La clau s'envia a cada petició mitjançant la\n"
"capçalera HTTP <code>apikey</code>. No cal un pas de login/sessió."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Sensor (<code>mdm.measurement.device.sensor</code>) remotecontrol_params:"
msgstr "Sensor (<code>mdm.measurement.device.sensor</code>) remotecontrol_params:"

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Timestamps in the API are in <strong>milliseconds</strong> (epoch UTC)."
msgstr "Les marques de temps a l'API estan en <strong>mil·lisegons</strong> (epoch UTC)."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Type: <code>REST</code>. Base URL: <code>https://api.qampo.es/apiv2/api</code>."
msgstr "Tipus: <code>REST</code>. URL base: <code>https://api.qampo.es/apiv2/api</code>."

#. module: remotecontrol_qampo
#: model:remotecontrol,remotecontrol_help:remotecontrol_qampo.remotecontrol_qampo
msgid "Values in getValues response are <strong>strings</strong> (e.g. <code>\"31.09\"</code>)."
msgstr "Els valors a la resposta de getValues són <strong>cadenes</strong> (p. ex. <code>\"31.09\"</code>)."

