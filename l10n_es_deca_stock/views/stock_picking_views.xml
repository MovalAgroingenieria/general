<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_picking_form_deca" model="ir.ui.view">
        <field name="name">stock.picking.form.deca</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_deca"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-truck"
                    invisible="deca_count == 0"
                >
                    <field name="deca_count" widget="statinfo" string="DECA" />
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button
                    name="action_prepare_deca"
                    type="object"
                    string="Prepare DECA"
                    groups="l10n_es_deca.group_deca_user"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="DECA" name="page_deca" invisible="deca_count == 0">
                    <group>
                        <field name="deca_qr_image" widget="image" readonly="1" />
                    </group>
                    <div class="text-muted">
                        DECA document QR
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_deca_document_form_stock" model="ir.ui.view">
        <field name="name">deca.document.form.stock</field>
        <field name="model">deca.document</field>
        <field name="inherit_id" ref="l10n_es_deca.view_deca_document_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='goods_description']" position="before">
                <field name="picking_id" readonly="1" />
            </xpath>
        </field>
    </record>

</odoo>
