<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Weekly Timesheet Generation Cron -->
    <record id="ir_cron_generate_weekly_timesheets" model="ir.cron">
        <field name="name">Generate Weekly Timesheets</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model.cron_generate_weekly_timesheets()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="doall" eval="False"/>
        <field name="nextcall">2025-10-26 05:00:00</field>
    </record>

  </data>
</odoo>
