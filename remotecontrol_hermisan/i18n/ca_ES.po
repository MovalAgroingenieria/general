#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "/API1/BOMBEOCHECK"
msgstr "/API1/BOMBEOCHECK"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "/API1/BOMBEOSTATS"
msgstr "/API1/BOMBEOSTATS"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "1) Connection (Remote Control)"
msgstr "1) Connexió (Telecontrol)"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "2) Authentication"
msgstr "2) Autenticació"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "3) Rate Limiting"
msgstr "3) Limitació de freqüència"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "4) API Endpoints"
msgstr "4) Endpoints de l'API"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "5) BOMBEOCHECK Response Structure"
msgstr "5) Estructura de resposta BOMBEOCHECK"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "6) BOMBEOSTATS Response Structure"
msgstr "6) Estructura de resposta BOMBEOSTATS"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "7) Odoo Configuration"
msgstr "7) Configuració a Odoo"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "8) Operational Flow"
msgstr "8) Flux operatiu"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "9) Technical Notes"
msgstr "9) Notes tècniques"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Agua</code>: Total water volume in m³ for the cycle."
msgstr "<code>Agua</code>: Volum total d'aigua en m³ del cicle."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Altura embalses</code>: Reservoir level in mca (meters of water column)."
msgstr "<code>Altura embalses</code>: Nivell de l'embassament en mca (metres de columna d'aigua)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Caudal impulsión</code>: Average flow in m³/h."
msgstr "<code>Caudal impulsión</code>: Cabal mitjà en m³/h."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Marcha</code>: Duration string HH:MM:SS."
msgstr "<code>Marcha</code>: Cadena de duració HH:MM:SS."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Potencia Consumida</code>: Total power in kW·h for the cycle."
msgstr "<code>Potencia Consumida</code>: Potència total en kW·h del cicle."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Presión impulsión</code>: Average pressure (bar or mca)."
msgstr "<code>Presión impulsión</code>: Pressió mitjana (bar o mca)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>_bombas</code>: Per-pump power breakdown."
msgstr "<code>_bombas</code>: Desglossament de potència per bomba."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>_timeStart</code> / <code>_timeEnd</code>: Epoch milliseconds (pumping cycle boundaries)."
msgstr "<code>_timeStart</code> / <code>_timeEnd</code>: Mil·lisegons epoch (límits del cicle de bombament)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>_timeStart</code>/<code>_timeEnd</code> are epoch ms (local time, not UTC)."
msgstr "<code>_timeStart</code>/<code>_timeEnd</code> són ms epoch (hora local, no UTC)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>balsa_id</code>: Numeric _balsa id from BOMBEOSTATS."
msgstr "<code>balsa_id</code>: ID numèric _balsa de BOMBEOSTATS."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>bomba</code>: Optional. Pump name (for per-pump breakdown sensors)."
msgstr "<code>bomba</code>: Opcional. Nom de la bomba (per a sensors de desglossament per bomba)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>endpoint_key</code>: <strong>Required.</strong> Key in the remotecontrol endpoints dict."
msgstr "<code>endpoint_key</code>: <strong>Obligatori.</strong> Clau del diccionari d'endpoints del telecontrol."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>endpoints</code>: <strong>Required.</strong> Dictionary of endpoint keys to\n"
"  connection details. Each Hermisan physical server (PLC/SCADA) is one endpoint.\n"
"  A single installation may have multiple servers (e.g. one per pumping station group)."
msgstr "<code>endpoints</code>: <strong>Obligatori.</strong> Diccionari de claus d'endpoint a\n"
"  detalls de connexió. Cada servidor físic Hermisan (PLC/SCADA) és un endpoint.\n"
"  Una instal·lació pot tenir múltiples servidors (ex. un per grup d'estacions de bombament)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>from</code>, <code>to</code> (format: YYYY.MM.DD-HH.MM.SS)"
msgstr "<code>from</code>, <code>to</code> (format: YYYY.MM.DD-HH.MM.SS)"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>pozo_id</code>: Numeric _pozo id from BOMBEOSTATS."
msgstr "<code>pozo_id</code>: ID numèric _pozo de BOMBEOSTATS."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>pozo_key</code>: <strong>Required.</strong> Name of the pumping station as returned by the API."
msgstr "<code>pozo_key</code>: <strong>Obligatori.</strong> Nom de l'estació de bombament segons l'API."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>start_date</code>: Optional. Start date for first data retrieval (YYYY-MM-DD)."
msgstr "<code>start_date</code>: Opcional. Data d'inici per a la primera obtenció de dades (YYYY-MM-DD)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>timezone</code>: Default IANA timezone for timestamp conversion (default: <code>Europe/Madrid</code>)."
msgstr "<code>timezone</code>: Zona horària IANA per defecte per a conversió de timestamps (default: <code>Europe/Madrid</code>)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>url</code>: Base URL of the Hermisan server (e.g. <code>https://crtorrecotillas.hermisan.es</code>)."
msgstr "<code>url</code>: URL base del servidor Hermisan (ex. <code>https://crtorrecotillas.hermisan.es</code>)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>username</code> / <code>password</code>: Basic Auth credentials."
msgstr "<code>username</code> / <code>password</code>: Credencials d'autenticació bàsica."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>variable</code>: <strong>Required.</strong> Name of the variable as returned by the API."
msgstr "<code>variable</code>: <strong>Obligatori.</strong> Nom de la variable segons l'API."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>zone_key</code>: Zone/reservoir name this station belongs to."
msgstr "<code>zone_key</code>: Nom de la zona/embassament a la qual pertany aquesta estació."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>1 request per minute</strong> per endpoint. The system enforces this automatically."
msgstr "<strong>1 petició per minut</strong> per endpoint. El sistema ho gestiona automàticament."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>Catalog Sync</strong>:\n"
"    Health check → Call BOMBEOCHECK on each endpoint → Auto-detect zones,\n"
"    pumping stations, pumps → Auto-create mdm.measurement.device and\n"
"    mdm.measurement.device.sensor records. Idempotent."
msgstr "<strong>Sincronització de catàleg</strong>:\n"
"    Health check → Cridar BOMBEOCHECK a cada endpoint → Auto-detectar zones,\n"
"    estacions de bombament, bombes → Auto-crear registres mdm.measurement.device i\n"
"    mdm.measurement.device.sensor. Idempotent."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>Fields:</strong>"
msgstr "<strong>Camps:</strong>"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>Readings Import</strong>:\n"
"    Health check → Build plan → Call BOMBEOSTATS per endpoint/date-range\n"
"    → Upsert readings per sensor (using _timeStart as measurement_time)."
msgstr "<strong>Importació de lectures</strong>:\n"
"    Health check → Construir pla → Cridar BOMBEOSTATS per endpoint/rang de dates\n"
"    → Upsert de lectures per sensor (usant _timeStart com a measurement_time)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>connection_params</strong> (JSON):"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Description"
msgstr "Descripció"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Device (<code>mdm.measurement.device</code>) remotecontrol_params:"
msgstr "Dispositiu (<code>mdm.measurement.device</code>) remotecontrol_params:"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Each device represents a Hermisan <strong>pumping station</strong> (Pozo)."
msgstr "Cada dispositiu representa una <strong>estació de bombament</strong> Hermisan (Pozo)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Each sensor represents a measurable variable within a pumping station."
msgstr "Cada sensor representa una variable mesurable dins d'una estació de bombament."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Endpoint"
msgstr "Endpoint"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Fail2ban active on servers: avoid rapid retries with wrong credentials."
msgstr "Fail2ban actiu als servidors: evitar reintents ràpids amb credencials incorrectes."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "For per-pump sensors:"
msgstr "Per a sensors per bomba:"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "GET"
msgstr "GET"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Hermisan REST API · Odoo Integration"
msgstr "API REST Hermisan · Integració amb Odoo"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Hermisan uses <strong>HTTP Basic Auth</strong>. Credentials are sent with every request.\n"
"<strong>WARNING:</strong> Hermisan has strict fail2ban rules. Avoid sending wrong credentials repeatedly."
msgstr "Hermisan utilitza <strong>HTTP Basic Auth</strong>. Les credencials s'envien amb cada petició.\n"
"<strong>AVÍS:</strong> Hermisan té regles fail2ban estrictes. Evitar enviar credencials incorrectes repetidament."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Hierarchical: Zone → (zone-level sensors + Pumping Stations) → (station-level sensors + Pumps) → pump sensors."
msgstr "Jeràrquic: Zona → (sensors de zona + Estacions de bombament) → (sensors d'estació + Bombes) → sensors de bomba."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Historical pumping cycles. Returns rows with per-cycle statistics including\n"
"    water volume, power consumption, flow, pressure, and timestamps."
msgstr "Cicles històrics de bombament. Retorna files amb estadístiques per cicle incloent\n"
"    volum d'aigua, consum de potència, cabal, pressió i marques de temps."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Idempotent readings via <code>upsert(sensor_id, measurement_time)</code>."
msgstr "Lectures idempotents mitjançant <code>upsert(sensor_id, measurement_time)</code>."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Instantaneous data. Returns hierarchical JSON with current sensor values\n"
"    for all zones, pumping stations and pumps."
msgstr "Dades instantànies. Retorna JSON jeràrquic amb valors actuals de sensors\n"
"    per a totes les zones, estacions de bombament i bombes."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Method"
msgstr "Mètode"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Multiple endpoints supported: one per physical Hermisan server/PLC."
msgstr "Múltiples endpoints suportats: un per servidor/PLC físic Hermisan."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Not all variables appear in every row (depends on station sensors)."
msgstr "No totes les variables apareixen a cada fila (depèn dels sensors de l'estació)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Parameters"
msgstr "Paràmetres"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Rate limit: <strong>1 request per minute per endpoint</strong>. Module enforces waits."
msgstr "Límit: <strong>1 petició per minut per endpoint</strong>. El mòdul gestiona les esperes."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Sensor (<code>mdm.measurement.device.sensor</code>) remotecontrol_params:"
msgstr "Sensor (<code>mdm.measurement.device.sensor</code>) remotecontrol_params:"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Type: <code>REST</code>. Base URL: placeholder (real URLs are per-endpoint)."
msgstr "Tipus: <code>REST</code>. URL base: placeholder (les URLs reals són per endpoint)."

