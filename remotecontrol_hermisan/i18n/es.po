msgstr "4) Endpoints de la API"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "5) BOMBEOCHECK Response Structure"
msgstr "5) Estructura de respuesta BOMBEOCHECK"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "6) BOMBEOSTATS Response Structure"
msgstr "6) Estructura de respuesta BOMBEOSTATS"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "7) Odoo Configuration"
msgstr "7) Configuración en Odoo"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "8) Operational Flow"
msgstr "8) Flujo operativo"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "9) Technical Notes"
msgstr "9) Notas técnicas"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Agua</code>: Total water volume in m³ for the cycle."
msgstr "<code>Agua</code>: Volumen total de agua en m³ del ciclo."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Altura embalses</code>: Reservoir level in mca (meters of water column)."
msgstr "<code>Altura embalses</code>: Nivel del embalse en mca (metros de columna de agua)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Caudal impulsión</code>: Average flow in m³/h."
msgstr "<code>Caudal impulsión</code>: Caudal medio en m³/h."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Marcha</code>: Duration string HH:MM:SS."
msgstr "<code>Marcha</code>: Cadena de duración HH:MM:SS."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Potencia Consumida</code>: Total power in kW·h for the cycle."
msgstr "<code>Potencia Consumida</code>: Potencia total en kW·h del ciclo."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>Presión impulsión</code>: Average pressure (bar or mca)."
msgstr "<code>Presión impulsión</code>: Presión media (bar o mca)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>_bombas</code>: Per-pump power breakdown."
msgstr "<code>_bombas</code>: Desglose de potencia por bomba."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>_timeStart</code> / <code>_timeEnd</code>: Epoch milliseconds (pumping cycle boundaries)."
msgstr "<code>_timeStart</code> / <code>_timeEnd</code>: Milisegundos epoch (límites del ciclo de bombeo)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>_timeStart</code>/<code>_timeEnd</code> are epoch ms (local time, not UTC)."
msgstr "<code>_timeStart</code>/<code>_timeEnd</code> son ms epoch (hora local, no UTC)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>balsa_id</code>: Numeric _balsa id from BOMBEOSTATS."
msgstr "<code>balsa_id</code>: ID numérico _balsa de BOMBEOSTATS."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>bomba</code>: Optional. Pump name (for per-pump breakdown sensors)."
msgstr "<code>bomba</code>: Opcional. Nombre de la bomba (para sensores de desglose por bomba)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>endpoint_key</code>: <strong>Required.</strong> Key in the remotecontrol endpoints dict."
msgstr "<code>endpoint_key</code>: <strong>Obligatorio.</strong> Clave del diccionario de endpoints del telecontrol."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>endpoints</code>: <strong>Required.</strong> Dictionary of endpoint keys to\n"
"  connection details. Each Hermisan physical server (PLC/SCADA) is one endpoint.\n"
"  A single installation may have multiple servers (e.g. one per pumping station group)."
msgstr "<code>endpoints</code>: <strong>Obligatorio.</strong> Diccionario de claves de endpoint a\n"
"  datos de conexión. Cada servidor físico Hermisan (PLC/SCADA) es un endpoint.\n"
"  Una instalación puede tener múltiples servidores (ej. uno por grupo de estaciones de bombeo)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>from</code>, <code>to</code> (format: YYYY.MM.DD-HH.MM.SS)"
msgstr "<code>from</code>, <code>to</code> (format: YYYY.MM.DD-HH.MM.SS)"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>pozo_id</code>: Numeric _pozo id from BOMBEOSTATS."
msgstr "<code>pozo_id</code>: ID numérico _pozo de BOMBEOSTATS."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>pozo_key</code>: <strong>Required.</strong> Name of the pumping station as returned by the API."
msgstr "<code>pozo_key</code>: <strong>Obligatorio.</strong> Nombre de la estación de bombeo según la API."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>start_date</code>: Optional. Start date for first data retrieval (YYYY-MM-DD)."
msgstr "<code>start_date</code>: Opcional. Fecha de inicio para la primera obtención de datos (YYYY-MM-DD)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>timezone</code>: Default IANA timezone for timestamp conversion (default: <code>Europe/Madrid</code>)."
msgstr "<code>timezone</code>: Zona horaria IANA por defecto para conversión de timestamps (default: <code>Europe/Madrid</code>)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>url</code>: Base URL of the Hermisan server (e.g. <code>https://crtorrecotillas.hermisan.es</code>)."
msgstr "<code>url</code>: URL base del servidor Hermisan (ej. <code>https://crtorrecotillas.hermisan.es</code>)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>username</code> / <code>password</code>: Basic Auth credentials."
msgstr "<code>username</code> / <code>password</code>: Credenciales de autenticación básica."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>variable</code>: <strong>Required.</strong> Name of the variable as returned by the API."
msgstr "<code>variable</code>: <strong>Obligatorio.</strong> Nombre de la variable según la API."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<code>zone_key</code>: Zone/reservoir name this station belongs to."
msgstr "<code>zone_key</code>: Nombre de la zona/embalse al que pertenece esta estación."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>1 request per minute</strong> per endpoint. The system enforces this automatically."
msgstr "<strong>1 petición por minuto</strong> por endpoint. El sistema lo gestiona automáticamente."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>Catalog Sync</strong>:\n"
"    Health check → Call BOMBEOCHECK on each endpoint → Auto-detect zones,\n"
"    pumping stations, pumps → Auto-create mdm.measurement.device and\n"
"    mdm.measurement.device.sensor records. Idempotent."
msgstr "<strong>Sincronización de catálogo</strong>:\n"
"    Health check → Llamar a BOMBEOCHECK en cada endpoint → Auto-detectar zonas,\n"
"    estaciones de bombeo, bombas → Auto-crear registros mdm.measurement.device y\n"
"    mdm.measurement.device.sensor. Idempotente."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>Fields:</strong>"
msgstr "<strong>Campos:</strong>"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>Readings Import</strong>:\n"
"    Health check → Build plan → Call BOMBEOSTATS per endpoint/date-range\n"
"    → Upsert readings per sensor (using _timeStart as measurement_time)."
msgstr "<strong>Importación de lecturas</strong>:\n"
"    Health check → Construir plan → Llamar a BOMBEOSTATS por endpoint/rango de fechas\n"
"    → Upsert de lecturas por sensor (usando _timeStart como measurement_time)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>connection_params</strong> (JSON):"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Description"
msgstr "Descripción"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Device (<code>mdm.measurement.device</code>) remotecontrol_params:"
msgstr "Dispositivo (<code>mdm.measurement.device</code>) remotecontrol_params:"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Each device represents a Hermisan <strong>pumping station</strong> (Pozo)."
msgstr "Cada dispositivo representa una <strong>estación de bombeo</strong> Hermisan (Pozo)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Each sensor represents a measurable variable within a pumping station."
msgstr "Cada sensor representa una variable medible dentro de una estación de bombeo."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Endpoint"
msgstr "Endpoint"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Fail2ban active on servers: avoid rapid retries with wrong credentials."
msgstr "Fail2ban activo en los servidores: evitar reintentos rápidos con credenciales incorrectas."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "For per-pump sensors:"
msgstr "Para sensores por bomba:"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "GET"
msgstr "GET"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Hermisan REST API · Odoo Integration"
msgstr "API REST Hermisan · Integración con Odoo"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Hermisan uses <strong>HTTP Basic Auth</strong>. Credentials are sent with every request.\n"
"<strong>WARNING:</strong> Hermisan has strict fail2ban rules. Avoid sending wrong credentials repeatedly."
msgstr "Hermisan utiliza <strong>HTTP Basic Auth</strong>. Las credenciales se envían con cada petición.\n"
"<strong>AVISO:</strong> Hermisan tiene reglas fail2ban estrictas. Evitar enviar credenciales incorrectas repetidamente."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Hierarchical: Zone → (zone-level sensors + Pumping Stations) → (station-level sensors + Pumps) → pump sensors."
msgstr "Jerárquico: Zona → (sensores de zona + Estaciones de bombeo) → (sensores de estación + Bombas) → sensores de bomba."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Historical pumping cycles. Returns rows with per-cycle statistics including\n"
"    water volume, power consumption, flow, pressure, and timestamps."
msgstr "Ciclos históricos de bombeo. Devuelve filas con estadísticas por ciclo incluyendo\n"
"    volumen de agua, consumo de potencia, caudal, presión y marcas de tiempo."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Idempotent readings via <code>upsert(sensor_id, measurement_time)</code>."
msgstr "Lecturas idempotentes mediante <code>upsert(sensor_id, measurement_time)</code>."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Instantaneous data. Returns hierarchical JSON with current sensor values\n"
"    for all zones, pumping stations and pumps."
msgstr "Datos instantáneos. Devuelve JSON jerárquico con valores actuales de sensores\n"
"    para todas las zonas, estaciones de bombeo y bombas."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Method"
msgstr "Método"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Multiple endpoints supported: one per physical Hermisan server/PLC."
msgstr "Múltiples endpoints soportados: uno por servidor/PLC físico de Hermisan."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Not all variables appear in every row (depends on station sensors)."
msgstr "No todas las variables aparecen en cada fila (depende de los sensores de la estación)."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Parameters"
msgstr "Parámetros"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Rate limit: <strong>1 request per minute per endpoint</strong>. Module enforces waits."
msgstr "Límite: <strong>1 petición por minuto por endpoint</strong>. El módulo gestiona las esperas."

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Sensor (<code>mdm.measurement.device.sensor</code>) remotecontrol_params:"
msgstr "Sensor (<code>mdm.measurement.device.sensor</code>) remotecontrol_params:"

#. module: remotecontrol_hermisan
#: model:remotecontrol,remotecontrol_help:remotecontrol_hermisan.remotecontrol_hermisan
msgid "Type: <code>REST</code>. Base URL: placeholder (real URLs are per-endpoint)."
msgstr "Tipo: <code>REST</code>. URL base: placeholder (las URLs reales son por endpoint)."

