<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="sale_order_form_add_comment_extended" model="ir.ui.view">
        <field name="name">comment_template.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_comment_template.sale_order_form_add_comment"/>
        <field name="arch" type="xml">

            <!-- Insert our controls right after the template m2m on the Comments page -->
            <xpath expr="//page[contains(@name, 'comment')]/field[@name='comment_template_ids']" position="after">
                <div attrs="{'invisible': [('state', '!=', 'draft')]}">
                    <hr/>
                    <button name="action_insert_comments"
                            string="Insert comments"
                            type="object"
                            class="oe_highlight"/>
                    <p class="text-muted"
                       style="margin-top:10px; margin-left:14px; display:inline-block; font-size:0.8em;">
                        The selected templates will be added to the top or bottom comment.
                        You can edit the inserted text here without changing the original template.
                    </p>
                </div>

                <group string="Top Comments">
                    <field name="top_comment"
                           nolabel="1"
                           attrs="{'readonly': [('state', '!=', 'draft')]}"
                           style="min-height: 140px;"
                           help="Free HTML inserted from templates positioned 'before lines'. You can edit it for this order only."/>
                </group>

                <group string="Bottom Comments">
                    <field name="bottom_comment"
                           nolabel="1"
                           attrs="{'readonly': [('state', '!=', 'draft')]}"
                           style="min-height: 140px;"
                           help="Free HTML inserted from templates positioned 'after lines'. You can edit it for this order only."/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
