#. module: display_decimal_precision
#: model:ir.model,name:display_decimal_precision.model_res_currency
msgid "Currency"
msgstr "Divisa"

#. module: display_decimal_precision
#: model_terms:ir.ui.view,arch_db:display_decimal_precision.res_config_settings_view_form_stock
msgid "Decimal places for product price display."
msgstr "Posicions decimals per mostrar el preu del producte."

#. module: display_decimal_precision
#: model_terms:ir.ui.view,arch_db:display_decimal_precision.res_config_settings_view_form_stock
msgid "Decimal places for quantity display."
msgstr "Posicions decimals per mostrar la quantitat."

#. module: display_decimal_precision
#: model:ir.model.fields,help:display_decimal_precision.field_res_currency__display_decimal_places
msgid ""
"Derived number of decimals used for display: ceil(log10(1/display_rounding))"
" when 0 < display_rounding < 1; otherwise falls back to the currency's "
"decimal_places (or 0 if rounding >= 1)."
msgstr ""
"Nombre derivat de decimals utilitzats per a la visualització: "
"ceil(log10(1/display_rounding)) quan 0 < display_rounding < 1; en cas "
"contrari, s'utilitza el nombre de decimals de la divisa (o 0 si "
"l'arrodoniment és >= 1)."

#. module: display_decimal_precision
#: model:ir.model.fields,field_description:display_decimal_precision.field_res_currency__display_decimal_places
msgid "Display Decimal Places"
msgstr "Mostrar Posicions Decimals"

#. module: display_decimal_precision
#: model_terms:ir.ui.view,arch_db:display_decimal_precision.res_config_settings_view_form_stock
msgid "Display Precision"
msgstr "Precisió de Visualització"

#. module: display_decimal_precision
#: model:ir.model.fields,field_description:display_decimal_precision.field_res_currency__display_rounding
msgid "Display Rounding"
msgstr "Arrodoniment Visual"

#. module: display_decimal_precision
#: model:ir.model,name:display_decimal_precision.model_ir_http
msgid "HTTP Routing"
msgstr "Enrutament HTTP"

#. module: display_decimal_precision
#: model:ir.model.fields,help:display_decimal_precision.field_res_currency__display_rounding
msgid ""
"Optional visual rounding. If set between 0 and 1 (e.g. 0.01), the UI will "
"prefer that many decimal places for display. If empty or 0, the currency's "
"own decimal places are used."
msgstr ""
"Arrodoniment visual opcional. Si s'estableix entre 0 i 1 (per exemple, "
"0.01), la interfície mostrarà aquesta quantitat de posicions decimals. Si "
"està buit o és 0, s'utilitzen les posicions decimals pròpies de la divisa."

#. module: display_decimal_precision
#: model:ir.model.fields,field_description:display_decimal_precision.field_res_config_settings__dp_product_price
msgid "Product Price Display Digits"
msgstr "Dígits per Mostrar el Preu del Producte"

#. module: display_decimal_precision
#: model:ir.model.fields,field_description:display_decimal_precision.field_res_config_settings__dp_product_uom
msgid "Product UoM Display Digits"
msgstr "Dígits per Mostrar la UdM del Producte"

#. module: display_decimal_precision
#: model:ir.model.fields,help:display_decimal_precision.field_res_config_settings__dp_product_price
msgid "Scale (number of decimals) for displaying product prices."
msgstr "Escala (nombre de decimals) per mostrar els preus dels productes."

#. module: display_decimal_precision
#: model:ir.model.fields,help:display_decimal_precision.field_res_config_settings__dp_product_uom
msgid "Scale (number of decimals) for displaying product quantities."
msgstr ""
"Escala (nombre de decimals) per mostrar les quantitats dels productes."

#. module: display_decimal_precision
#: model:ir.model,name:display_decimal_precision.model_res_config_settings
msgid "Street type settings"
msgstr "Configuració del Tipus de Carrer"

#. module: display_decimal_precision
#: model_terms:ir.ui.view,arch_db:display_decimal_precision.res_config_settings_view_form_stock
msgid "When to start shipping"
msgstr "Quan començar a enviar"
