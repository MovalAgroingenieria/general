<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_display_decimal_precision" model="ir.ui.view">
        <field name="name">Display Decimal Precision Settings</field>
        <field name="model">res.config.settings</field>
        <!-- In Odoo 18, settings form is in base_setup -->
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block"
                     data-string="Decimal display precision"
                     string="Decimal display precision"
                     name="display_decimal_precision_settings_block">
                    <h2>Decimal display precision</h2>

                    <div class="row mt16 o_settings_container" name="display_decimal_precision_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box" id="dp_product_price_box">
                            <div class="o_setting_right_pane" id="dp_product_price_settings">
                                <div class="o_form_label">Product Price</div>
                                <div class="text-muted">
                                    Configure how many decimals are shown for product prices.
                                </div>
                                <div class="mt8">
                                    <field name="dp_product_price"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6 o_setting_box" id="dp_product_uom_box">
                            <div class="o_setting_right_pane" id="dp_product_uom_settings">
                                <div class="o_form_label">Product Quantity</div>
                                <div class="text-muted">
                                    Configure how many decimals are shown for product quantities.
                                </div>
                                <div class="mt8">
                                    <field name="dp_product_uom"/>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </xpath>
        </field>
    </record>
</odoo>