<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- (Optional) category to group module permissions -->
    <record id="module_category_prl" model="ir.module.category">
        <field name="name">PRL</field>
        <field name="description">Occupational risk prevention</field>
        <field name="sequence" eval="30"/>
    </record>

    <record id="group_prl_manager" model="res.groups">
        <field name="name">PRL Manager</field>
        <field name="category_id" ref="module_category_prl"/>
        <!-- Add implied_ids if this group should inherit permissions from others -->
        <!-- <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/> -->
    </record>
</odoo>
