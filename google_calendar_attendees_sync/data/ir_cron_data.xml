<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Cron Job for Automatic Attendee Events Synchronization -->
    <record id="ir_cron_sync_attendee_events" model="ir.cron">
        <field name="name">Google Calendar: Synchronize Attendee Events</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_attendee_events_all_users()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">5</field>
    </record>

    <!-- Alternative Cron Job for Individual Synchronization -->
    <record id="ir_cron_sync_individual_attendee_events" model="ir.cron">
        <field name="name">Google Calendar: Synchronize Individual Events</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_attendee_events()</field>
        <field name="interval_number">4</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
        <field name="priority">6</field>
    </record>

    <!-- Cron Job for cleaning old errors -->
    <record id="ir_cron_cleanup_sync_errors" model="ir.cron">
        <field name="name">Google Calendar: Clean Synchronization Errors</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">model._cleanup_sync_errors()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
        <field name="priority">10</field>
    </record>
</odoo>
