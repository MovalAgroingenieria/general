<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extended Form View for Calendar Events -->
    <record id="view_calendar_event_form_attendee_sync" model="ir.ui.view">
        <field name="name">calendar.event.form.attendee.sync</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='privacy']" position="after">
                <field name="attendee_sync_enabled"/>
            </xpath>

            <xpath expr="//field[@name='attendee_ids']" position="after">
                <group string="Attendee Synchronization" attrs="{'invisible': [('attendee_sync_enabled', '=', False)]}">
                    <field name="last_attendee_sync" readonly="1"/>
                    <field name="sync_errors" readonly="1" attrs="{'invisible': [('sync_errors', '=', False)]}"/>
                    <button name="action_sync_attendees"
                            string="Synchronize Manually"
                            type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('attendee_ids', '=', [])]}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extended List View for Events -->
    <record id="view_calendar_event_tree_attendee_sync" model="ir.ui.view">
        <field name="name">calendar.event.tree.attendee.sync</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='privacy']" position="after">
                <field name="attendee_sync_enabled"/>
                <field name="last_attendee_sync"/>
            </xpath>
        </field>
    </record>

    <!-- Action for Manual Event Synchronization -->
    <record id="action_sync_attendees_wizard" model="ir.actions.server">
        <field name="name">Synchronize with Attendees</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_model_id" ref="calendar.model_calendar_event"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records[0].action_mass_sync_attendees()
        </field>
    </record>

</odoo>