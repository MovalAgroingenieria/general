<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extended User Preferences View -->
    <record id="view_users_form_attendee_sync" model="ir.ui.view">
        <field name="name">res.users.form.attendee.sync</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="google_calendar.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='google_calendar_token']" position="after">
                <separator string="Attendee Configuration"/>
                <field name="google_calendar_attendee_sync"/>
                <field name="attendee_events_synced" readonly="1"/>

                <separator string="Synchronization Errors" attrs="{'invisible': [('google_calendar_sync_errors', '=', False)]}"/>
                <field name="google_calendar_sync_errors" readonly="1"
                       attrs="{'invisible': [('google_calendar_sync_errors', '=', False)]}"
                       widget="text"/>

                <div class="oe_button_box">
                    <button name="action_test_google_calendar_connection"
                            string="Test Connection"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-google"/>
                    <button name="action_sync_my_attendee_events"
                            string="Synchronize Events"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-calendar"
                            attrs="{'invisible': [('google_calendar_attendee_sync', '=', False)]}"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Simplified Preferences View -->
    <record id="view_users_preference_form_attendee_sync" model="ir.ui.view">
        <field name="name">res.users.preference.form.attendee.sync</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']" position="inside">
                <group string="Google Calendar Synchronization">
                    <field name="google_calendar_attendee_sync"/>
                    <field name="attendee_events_synced" readonly="1"/>
                    <button name="action_sync_my_attendee_events"
                            string="Synchronize My Events"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('google_calendar_attendee_sync', '=', False)]}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Configuration Menu -->
    <menuitem id="menu_google_calendar_attendee_config"
              name="Attendee Synchronization"
              parent="calendar.menu_calendar_configuration"
              sequence="20"/>

    <!-- Action to view users with synchronization enabled -->
    <record id="action_users_attendee_sync" model="ir.actions.act_window">
        <field name="name">Users with Synchronization</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('google_calendar_attendee_sync', '=', True)]</field>
        <field name="context">{'search_default_google_calendar_attendee_sync': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No users with synchronization enabled!
            </p>
            <p>
                Users can enable automatic synchronization of events
                where they are attendees in their Preferences → Google Calendar Synchronization.
            </p>
        </field>
    </record>

    <menuitem id="menu_users_attendee_sync"
              name="Synchronized Users"
              parent="menu_google_calendar_attendee_config"
              action="action_users_attendee_sync"
              sequence="10"/>

</odoo>
