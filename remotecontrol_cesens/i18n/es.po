#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>/datos/{location_id}/{sensor_id}/{YYYYMMDD-YYYYMMDD}</code> → retrieve readings for a given sensor (GET)."
msgstr "<code>/datos/{location_id}</code> / <code>{sensor_id}/</code> <code>{YYYYMMDD-YYYYMMDD} → recuperar las lecturas de un sensor determinado (GET).</code> "

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>/metricas</code> → list all available metrics (GET)."
msgstr "<code>/metricas</code> → listar todas las métricas disponibles (GET)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>/ubicaciones/cliente</code> → list all stations and their connected sensors (GET)."
msgstr "<code>/ubicaciones/cliente</code> → listar todas las estaciones y sus sensores conectados (GET)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>GET /metricas</code> → retrieves available metrics (humidity, temperature, etc.)."
msgstr "<code>GET /metricas</code> → recupera las métricas disponibles (humedad, temperatura, etc.)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>GET /ubicaciones/cliente</code> → retrieves Cesens stations and their sensors."
msgstr "<code>GET /ubicaciones/cliente</code> → recupera las estaciones Cesens y sus sensores."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>location_id</code>: Cesens station identifier where the device is installed."
msgstr "<code>location_id</code>: Identificador de la estación Cesens donde está instalado el dispositivo."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>sensor_id</code>: Cesens metric identifier (e.g., temperature, humidity)."
msgstr "<code>sensor_id</code>: Identificador de la métrica Cesens (por ejemplo, temperatura, humedad)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>start_date</code>: Default start date if the sensor has no readings."
msgstr "<code>start_date</code>: Fecha de inicio por defecto si el sensor no tiene lecturas."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>start_date</code>: Overrides the device start date if provided."
msgstr "<code>start_date</code>: Anula la fecha de inicio del dispositivo si se proporciona."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<em>Get Token</em> → performs <code>POST /usuarios/login</code> and stores <code>bag[\"token\"]</code>."
msgstr "<em>Get Token</em> → realiza <code>POST /usuarios/login</code> y almacena <code>bag[\"token\"]</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<em>Logout</em> → optional, invalidates the token using <code>POST /usuarios/logout</code>."
msgstr "<em>Logout</em> → opcional, invalida el token mediante <code>POST /usuarios/logout</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Cesens: Daily Sync</strong> → automatic daily synchronization of readings: obtains token, builds the sensor plan, and downloads new readings."
msgstr "<strong>Cesens: Daily Sync</strong> → sincronización diaria automática de las lecturas: obtiene el token, construye el plan de sensores y descarga las nuevas lecturas."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Cesens: Import Devices and Metrics</strong> → retrieves all Cesens locations, sensors, and metrics, generates a JSON attachment with the data, and shows a summary count."
msgstr "<strong>Cesens: Import Devices and Metrics</strong> → recupera todas las ubicaciones, sensores y métricas de Cesens, genera un archivo adjunto JSON con los datos y muestra un recuento resumido."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Get Devices (Plan)</strong> → builds <code>bag[\"sensors_plan\"]</code> with (sensor_id, metric_id, location)."
msgstr "<strong>Get Devices (Plan)</strong> → construye <code>bag[\"sensores_plan\"]</code> con (sensor_id, metric_id, ubicación)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Get Readings</strong> → executes:\n"
msgstr "<strong>Get Readings</strong> → ejecuta:\n"

