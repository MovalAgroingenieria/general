#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Run <strong>Import Devices and Metrics</strong> first to ensure correct sensor mapping."
msgstr "Ejecute primero <strong>Importar dispositivos y métricas</strong> para garantizar la correcta asignación de los sensores."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Subsequent requests must include the header: <code>Authentication: Token &lt;token&gt;</code>."
msgstr "Las solicitudes posteriores deben incluir la cabecera: <code>Autenticación: Token &lt;token&gt;.</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The JSON attachment <code>cesens_devices_metrics_YYYYMMDD_HHMMSS.json</code> contains:"
msgstr "El archivo adjunto JSON <code>cesens_devices_metrics_YYYMMDD_HHMMSS.json</code> contiene:"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The JSON attachment can be downloaded from the attachments list of the <code>remotecontrol</code> record."
msgstr "El archivo adjunto JSON puede descargarse de la lista de archivos adjuntos del registro <code>remotecontrol</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The following predefined procedures are included in this module:"
msgstr "En este módulo se incluyen los siguientes procedimientos predefinidos:"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The numeric value is stored in the <code>value</code> field."
msgstr "El valor numérico se almacena en el campo de <code>valor</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The reading flow executes <code>GET /datos/{location_id}/{sensor_id}/{YYYYMMDD-YYYYMMDD}</code> and stores results in <code>mdm.measurement.device.sensor.reading</code>."
msgstr "El flujo de lectura ejecuta <code>GET /datos/{location_id}/{sensor_id}/</code> <code>{YYYYMMDD-YYYYMMDD}</code> y almacena los resultados en</code> <code>mdm.measurement.device.sensor.reading</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Timestamps are converted to <code>YYYY-MM-DD HH:MM:SS</code>."
msgstr "Las marcas de tiempo se convierten a <code>AAAA-MM-DD HH:MM:SS</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Type: <code>REST</code> · Base URL: <code>https://app.cesens.com/api</code>"
msgstr "Tipo: <code>REST</code> - URL base: <code>https://app.cesens.com/api</code>"
#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Verify that each sensor in Odoo has the proper <code>sensor_id</code> and <code>location_id</code> defined."
msgstr "Verificar que cada sensor en odoo tiene su correspondiente <code>sensor_id</code> y <code>location_id</code> definidos."

