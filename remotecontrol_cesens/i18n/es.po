#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "In Sensor (<code>mdm.measurement.device.sensor</code>):"
msgstr "En Sensor<code>(mdm.measurement.device.sensor</code>):"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Key: <code>(sensor_id, measurement_time)</code> (updates if already exists)."
msgstr "Clave: <code>(sensor_id, measurement_time)</code> (se actualiza si ya existe)."

