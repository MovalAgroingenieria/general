#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Generates a JSON attachment with all information: <code>cesens_devices_metrics_YYYYMMDD_HHMMSS.json</code>."
msgstr "Genera un archivo adjunto JSON con toda la información: <code>cesens_devices_metrics_YYYMMDD_HHMMSS.json</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "In Device (<code>mdm.measurement.device</code>):"
msgstr "En Dispositivo<code>(mdm.measurement.device</code>):"

