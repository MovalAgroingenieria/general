#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>/datos/{location_id}/{sensor_id}/{YYYYMMDD-YYYYMMDD}</code> → retrieve readings for a given sensor (GET)."
msgstr "<code>/datos/{location_id}</code> / <code>{sensor_id}/</code> <code>{YYYYMMDD-YYYYMMDD} → recupera les lectures d’un sensor determinat (GET).</code>"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>/metricas</code> → list all available metrics (GET)."
msgstr "<code>/metricas</code> → llista totes les mètriques disponibles (GET)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>/ubicaciones/cliente</code> → list all stations and their connected sensors (GET)."
msgstr "<code>/ubicaciones/cliente</code> → llista totes les estacions i els sensors connectats (GET)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>GET /metricas</code> → retrieves available metrics (humidity, temperature, etc.)."
msgstr "<code>GET /metricas</code> → recupera les mètriques disponibles (humitat, temperatura, etc.)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>GET /ubicaciones/cliente</code> → retrieves Cesens stations and their sensors."
msgstr "<code>GET /ubicaciones/cliente</code> → recupera les estacions Cesens i els seus sensors."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>location_id</code>: Cesens station identifier where the device is installed."
msgstr "<code>location_id</code>: Identificador de l’estació Cesens on està instal·lat el dispositiu."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>sensor_id</code>: Cesens metric identifier (e.g., temperature, humidity)."
msgstr "<code>sensor_id</code>: Identificador de la mètrica Cesens (per exemple, temperatura, humitat)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>start_date</code>: Default start date if the sensor has no readings."
msgstr "<code>start_date</code>: Data d’inici per defecte si el sensor no té lectures."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>start_date</code>: Overrides the device start date if provided."
msgstr "<code>start_date</code>: Substitueix la data d’inici del dispositiu si s’especifica."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<em>Get Token</em> → performs <code>POST /usuarios/login</code> and stores <code>bag[\"token\"]</code>."
msgstr "<em>Obtenir token</em> → fa <code>POST /usuarios/login</code> i desa <code>bag[\"token\"]</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<em>Logout</em> → optional, invalidates the token using <code>POST /usuarios/logout</code>."
msgstr "<em>Logout</em> → opcional, invalida el token utilitzant <code>POST /usuarios/logout</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Cesens: Daily Sync</strong> → automatic daily synchronization of readings: obtains token, builds the sensor plan, and downloads new readings."
msgstr "<strong>Cesens: Sincronització diària</strong> → sincronització automàtica diària de lectures: obté el token, construeix el pla de sensors i descarrega les noves lectures."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Cesens: Import Devices and Metrics</strong> → retrieves all Cesens locations, sensors, and metrics, generates a JSON attachment with the data, and shows a summary count."
msgstr "<strong>Cesens: Importar dispositius i mètriques</strong> → recupera totes les ubicacions, sensors i mètriques de Cesens, genera un fitxer adjunt JSON amb les dades i mostra un resum de recompte."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Get Devices (Plan)</strong> → builds <code>bag[\"sensors_plan\"]</code> with (sensor_id, metric_id, location)."
msgstr "<strong>Obtenir dispositius (pla)</strong> → construeix <code>bag[\"sensors_plan\"]</code> amb (sensor_id, metric_id, ubicació)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Get Readings</strong> → executes:\n"
msgstr "<strong>Obtenir lectures</strong> → executa:\n"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Get Token</strong> → authenticates the user and stores <code>bag[\"token\"]</code>."
msgstr "<strong>Obtenir token</strong> → autentica l’usuari i desa <code>bag[\"token\"]</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<strong>Import Devices and Metrics</strong> → calls:"
msgstr "<strong>Importar dispositius i mètriques</strong> → crida:"

