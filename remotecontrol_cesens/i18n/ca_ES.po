#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Authentication: Token &lt;token&gt;"
msgstr "Autenticació: Token &lt;token&gt;"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Cesens · Odoo Integration"
msgstr "Cesens · Integració amb Odoo"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Generates a JSON attachment with all information: <code>cesens_devices_metrics_YYYYMMDD_HHMMSS.json</code>."
msgstr "Genera un fitxer adjunt JSON amb tota la informació: <code>cesens_devices_metrics_YYYYMMDD_HHMMSS.json</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "In Device (<code>mdm.measurement.device</code>):"
msgstr "En Dispositiu (<code>mdm.measurement.device</code>):"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "In Sensor (<code>mdm.measurement.device.sensor</code>):"
msgstr "En Sensor (<code>mdm.measurement.device.sensor</code>):"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Key: <code>(sensor_id, measurement_time)</code> (updates if already exists)."
msgstr "Clau: <code>(sensor_id, measurement_time)</code> (s’actualitza si ja existeix)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Required header:"
msgstr "Capçalera obligatòria:"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Run <strong>Import Devices and Metrics</strong> first to ensure correct sensor mapping."
msgstr "Executa primer <strong>Importar dispositius i mètriques</strong> per assegurar l’assignació correcta dels sensors."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Subsequent requests must include the header: <code>Authentication: Token &lt;token&gt;</code>."
msgstr "Les peticions posteriors han d’incloure la capçalera: <code>Autenticació: Token &lt;token&gt;</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The JSON attachment <code>cesens_devices_metrics_YYYYMMDD_HHMMSS.json</code> contains:"
msgstr "El fitxer adjunt JSON <code>cesens_devices_metrics_YYYYMMDD_HHMMSS.json</code> conté:"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The JSON attachment can be downloaded from the attachments list of the <code>remotecontrol</code> record."
msgstr "El fitxer adjunt JSON es pot descarregar des de la llista d’adjunts del registre <code>remotecontrol</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The following predefined procedures are included in this module:"
msgstr "Aquest mòdul inclou els següents procediments predefinits:"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The numeric value is stored in the <code>value</code> field."
msgstr "El valor numèric s’emmagatzema al camp <code>value</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "The reading flow executes <code>GET /datos/{location_id}/{sensor_id}/{YYYYMMDD-YYYYMMDD}</code> and stores results in <code>mdm.measurement.device.sensor.reading</code>."
msgstr "El flux de lectura executa <code>GET /datos/{location_id}/{sensor_id}/{YYYYMMDD-YYYYMMDD}</code> i desa els resultats a <code>mdm.measurement.device.sensor.reading</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Timestamps are converted to <code>YYYY-MM-DD HH:MM:SS</code>."
msgstr "Les marques de temps es converteixen a <code>YYYY-MM-DD HH:MM:SS</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Type: <code>REST</code> · Base URL: <code>https://app.cesens.com/api</code>"
msgstr "Tipus: <code>REST</code> · URL base: <code>https://app.cesens.com/api</code>"

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "Verify that each sensor in Odoo has the proper <code>sensor_id</code> and <code>location_id</code> defined."
msgstr "Verifica que cada sensor a Odoo tingui correctament definits el <code>sensor_id</code> i el <code>location_id</code>."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>/usuarios/login</code> → obtain authentication token (POST)."
msgstr "<code>/usuarios/login</code> → obté el token d’autenticació (POST)."

#. module: remotecontrol_cesens
#: model:remotecontrol,remotecontrol_help:remotecontrol_cesens.remotecontrol_cesens
msgid "<code>/usuarios/logout</code> → close the current session (POST)."
msgstr "<code>/usuarios/logout</code> → tanca la sessió actual (POST)."
