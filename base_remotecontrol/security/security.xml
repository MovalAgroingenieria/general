<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <data noupdate="0">
    <record id="module_category_remotecontrol" model="ir.module.category">
      <field name="name">Remote Control</field>
      <field name="description">Helps you manage remote control connections and operations</field>
      <field name="sequence">20</field>
    </record>
  </data>

  <data noupdate="1">
    <record id="group_remotecontrol_user" model="res.groups">
      <field name="name">User</field>
      <field name="category_id" ref="module_category_remotecontrol"/>
    </record>

    <record id="group_remotecontrol_manager" model="res.groups">
      <field name="name">Manager</field>
      <field name="category_id" ref="module_category_remotecontrol"/>
      <field name="implied_ids" eval="[(4, ref('group_remotecontrol_user'))]"/>
    </record>
  </data>

</odoo>