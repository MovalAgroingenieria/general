"users = response.json()\n"
"\n"
"processed_users = []\n"
"for user in users:\n"
"    if user.get('active', False):\n"
"        processed_users.append({\n"
"            'name': user['name'],\n"
"            'email': user['email'],\n"
"            'external_id': user['id']\n"
"        })\n"
"\n"
"bag['processed_users'] = processed_users\n"
"bag['total_active'] = len(processed_users)"
