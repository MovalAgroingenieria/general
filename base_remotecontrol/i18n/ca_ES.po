#. module: base_remotecontrol
#: model:ir.ui.view,arch_db:base_remotecontrol.view_remotecontrol_form
msgid "# Parse and generate XML\n"
"import xml.etree.ElementTree as ET\n"
"from xml.dom import minidom\n"
"\n"
"# Parse XML response\n"
"response = request_retry('GET', base_url + '/api/xml-data')\n"
"root = ET.fromstring(response.text)\n"
"\n"
"# Extract data\n"
"items = []\n"
"for item in root.findall('./item'):\n"
"    items.append({\n"
"        'id': item.get('id'),\n"
"        'name': item.find('name').text,\n"
"        'value': float(item.find('value').text)\n"
"    })\n"
"bag['xml_items'] = items\n"
"\n"
"# Generate XML\n"
"new_root = ET.Element('request')\n"
"data = ET.SubElement(new_root, 'data')\n"
"ET.SubElement(data, 'type').text = 'update'\n"
"ET.SubElement(data, 'id').text = '12345'\n"
"\n"
"# Convert to string with pretty formatting\n"
"xml_str = minidom.parseString(ET.tostring(new_root)).toprettyxml(indent=\"  \")\n"
"bag['generated_xml'] = xml_str"
msgstr "# Parse and generate XML\n"
