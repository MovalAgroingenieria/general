#. module: base_remotecontrol
#: model:ir.ui.view,arch_db:base_remotecontrol.view_remotecontrol_form
msgid "# Convert between data formats\n"
"import csv\n"
"from io import StringIO\n"
"\n"
"# Get CSV data from API\n"
"response = request_retry('GET', base_url + '/api/export')\n"
"csv_data = response.text\n"
"\n"
"# Parse CSV\n"
"csv_file = StringIO(csv_data)\n"
"reader = csv.DictReader(csv_file)\n"
"records = list(reader)\n"
"\n"
"# Transform to Odoo format\n"
"odoo_records = []\n"
"for record in records:\n"
"    odoo_records.append({\n"
"        'name': record['Name'],\n"
"        'amount': float(record['Amount']),\n"
"        'date': record['Date']\n"
"    })\n"
"bag['transformed_records'] = odoo_records"
