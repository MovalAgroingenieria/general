#. module: base_remotecontrol
#: model:ir.ui.view,arch_db:base_remotecontrol.view_remotecontrol_form
msgid "# Upload file via API\n"
"import tempfile\n"
"import os\n"
"\n"
"# Create a temporary file\n"
"temp_file = tempfile.NamedTemporaryFile(delete=False, suffix='.csv')\n"
"try:\n"
"    # Write data to file\n"
"    with open(temp_file.name, 'w') as f:\n"
"        f.write('id,name,value1,test,1232,test2,456')\n"
"\n"
"    # Upload file\n"
"    with open(temp_file.name, 'rb') as f:\n"
"        files = {'file': ('data.csv', f, 'text/csv')}\n"
"        response = request_retry('POST', base_url + '/api/upload',\n"
"                                files=files)\n"
"bag['upload_result'] = response.json()\n"
"finally:\n"
"    # Clean up\n"
"    os.unlink(temp_file.name)"
msgstr "# Upload file via API\n"
"import tempfile\n"
"import os\n"
"\n"
"# Create a temporary file\n"
"temp_file = tempfile.NamedTemporaryFile(delete=False, suffix='.csv')\n"
"try:\n"
"    # Write data to file\n"
"    with open(temp_file.name, 'w') as f:\n"
"        f.write('id,name,value1,test,1232,test2,456')\n"
"\n"
"    # Upload file\n"
"    with open(temp_file.name, 'rb') as f:\n"
"        files = {'file': ('data.csv', f, 'text/csv')}\n"
"        response = request_retry('POST', base_url + '/api/upload',\n"
"                                files=files)\n"
"bag['upload_result'] = response.json()\n"
"finally:\n"
"    # Clean up\n"
"    os.unlink(temp_file.name)"

