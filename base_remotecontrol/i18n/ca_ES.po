#. module: base_remotecontrol
#: model:ir.ui.view,arch_db:base_remotecontrol.view_remotecontrol_form
msgid "# Working with timezones\n"
"from datetime import datetime, timedelta\n"
"\n"
"# Get current time in user's timezone\n"
"user_tz = pytz.timezone(self.env.user.tz or 'UTC')\n"
"now_utc = datetime.now(pytz.UTC)\n"
"now_user_tz = now_utc.astimezone(user_tz)\n"
"\n"
"# Format for display or API\n"
"formatted_date = now_user_tz.strftime('%Y-%m-%d %H:%M:%S')\n"
"bag['current_time'] = formatted_date\n"
"\n"
"# Date calculations\n"
"tomorrow = now_utc + timedelta(days=1)\n"
"bag['tomorrow'] = tomorrow.strftime('%Y-%m-%d')"
msgstr "# Working with timezones\n"
"from datetime import datetime, timedelta\n"
"\n"
"# Get current time in user's timezone\n"
"user_tz = pytz.timezone(self.env.user.tz or 'UTC')\n"
"now_utc = datetime.now(pytz.UTC)\n"
"now_user_tz = now_utc.astimezone(user_tz)\n"
"\n"
"# Format for display or API\n"
"formatted_date = now_user_tz.strftime('%Y-%m-%d %H:%M:%S')\n"
"bag['current_time'] = formatted_date\n"
"\n"
"# Date calculations\n"
"tomorrow = now_utc + timedelta(days=1)\n"
"bag['tomorrow'] = tomorrow.strftime('%Y-%m-%d')"

