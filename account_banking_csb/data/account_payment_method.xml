<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1" forcecreate="True">
    <record id="csb_direct_debit_payments" model="account.payment.method">
        <field name="name">CSB Direct Debit</field>
        <field name="code">csb_direct_debit_payments</field>
        <!-- Direct debit is money incoming to you (you charge your customers) -->
        <field name="payment_type">outbound</field>
        <field name="payment_order_only" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
