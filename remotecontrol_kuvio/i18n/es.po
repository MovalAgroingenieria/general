#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "1) Connection Configuration"
msgstr "1) Configuracion de la conexion"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "1) Last reading timestamp of the device (any sensor), plus 1 ms"
msgstr "1) Ultima lectura (cualquier sensor), mas 1 ms"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "2) Authentication Flow"
msgstr "2) Flujo de autenticacion"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "2) Device <code>start_date</code> (if no previous readings)"
msgstr "2) <code>start_date</code> del dispositivo (si no hay lecturas previas)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "3) Available Procedures"
msgstr "3) Procedimientos disponibles"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "3) January 1st of current year (fallback)"
msgstr "3) 1 de enero del año actual (fallback)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "4) Device Configuration"
msgstr "4) Configuración del dispositivo"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "5) Sensor Configuration"
msgstr "5) Configuración de los sensores"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "6) API Endpoints Used"
msgstr "6) Endpoints de API usados"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "7) Security &amp; Performance"
msgstr "7) Seguridad y rendimiento"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "8) Readings Storage Behavior"
msgstr "8) Comportamiento de almacenamiento de lecturas"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "9) Troubleshooting"
msgstr "9) Solucion de problemas"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>GET /auth/user</code> - Get current user profile (customerId)"
msgstr "<code>GET /auth/user</code> - Obtener el perfil del usuario actual (customerId)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>GET /customer/{customerId}/devices?pageSize=100&amp;page=N</code> - List paginated devices"
msgstr "<code>GET /customer/{customerId}/devices?pageSize=100&amp;page=N</code> - Listar dispositivos paginados"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>GET /plugins/telemetry/DEVICE/{deviceId}/values/timeseries?keys={sensor_id}&amp;startTs={ms}&amp;endTs={ms}&amp;orderBy=DESC</code> - Get historical readings"
msgstr "<code>GET /plugins/telemetry/DEVICE/{deviceId}/values/timeseries?keys={sensor_id}&amp;startTs={ms}&amp;endTs={ms}&amp;orderBy=DESC</code> - Obtener lecturas historicas"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>POST /auth/login</code> - Authenticate and get token"
msgstr "<code>POST /auth/login</code> - Autenticar y obtener token"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>consumo_mensual</code> - Monthly consumption"
msgstr "<code>consumo_mensual</code> - Consumo mensual"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>consumo_total</code> - Total accumulated consumption"
msgstr "<code>consumo_total</code> - Consumo total acumulado"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>delta</code> - Consumption since last reading"
msgstr "<code>delta</code> - Consumo desde la ultima lectura"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>401 Unauthorized</strong> - Check username/password in connection_params"
msgstr "<strong>401 Unauthorized</strong> - Revisar usuario/contrasena en connection_params"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>404 Device Not Found</strong> - Verify device_id in device remotecontrol_params"
msgstr "<strong>404 Device Not Found</strong> - Verificar device_id en remotecontrol_params del dispositivo"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Create Sensor Plan</strong> - Builds plan from existing Odoo sensors/devices"
msgstr "<strong>Create Sensor Plan</strong> - Construye el plan desde sensores/dispositivos existentes en Odoo"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Empty readings</strong> - Verify sensor key (sensor_id) and reporting period"
msgstr "<strong>Empty readings</strong> - Verificar clave del sensor (sensor_id) y periodo consultado"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Get Devices</strong> - Authenticates if needed, resolves customerId, paginates devices, and creates attachment."
msgstr "<strong>Get Devices</strong> - Autentica si hace falta, resuelve customerId, pagina dispositivos y crea adjunto."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Get Historical Readings</strong> - Downloads and upserts all returned points"
msgstr "<strong>Get Historical Readings</strong> - Descarga y hace upsert de todos los puntos devueltos"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Login</strong> - Obtain authentication token"
msgstr "<strong>Login</strong> - Obtener token de autenticacion"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Missing base URL</strong> - Configure URL Base field in remotecontrol"
msgstr "<strong>Missing base URL</strong> - Configurar el campo URL Base en remotecontrol"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Platform:</strong> Kuvio IoT telemetry platform for water monitoring devices"
msgstr "<strong>Plataforma:</strong> Plataforma de telemetria IoT de Kuvio para dispositivos de monitorizacion de agua"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Type:</strong> HTTP REST API Connection"
msgstr "<strong>Tipo:</strong> Conexion HTTP REST API"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>remotecontrol_id</strong> = Kuvio remote control"
msgstr "<strong>remotecontrol_id</strong> = telecontrol Kuvio"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>remotecontrol_params</strong> (JSON) with <code>device_id</code> and optional <code>start_date</code>"
msgstr "<strong>remotecontrol_params</strong> (JSON) con <code>device_id</code> y <code>start_date</code> opcional"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>remotecontrol_params</strong> with telemetry key in <code>sensor_id</code> (or <code>key</code> for backward compatibility)"
msgstr "<strong>remotecontrol_params</strong> con la clave de telemetria en <code>sensor_id</code> (o <code>key</code> por compatibilidad)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "A) Kuvio: Get Devices"
msgstr "A) Kuvio: Obtener dispositivos"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "All points returned by the telemetry endpoint are processed (not only the latest one)"
msgstr "Se procesan todos los puntos devueltos por el endpoint de telemetria (no solo el ultimo)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Automatic retry on network failures"
msgstr "Reintento automatico ante fallos de red"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "B) Kuvio: Daily Telemetry Sync"
msgstr "B) Kuvio: Sincronizacion diaria de telemetria"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Common telemetry keys (update sensor remotecontrol_params to use):"
msgstr "Claves de telemetria comunes (actualizar remotecontrol_params del sensor):"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Connection uses HTTP REST API with token authentication."
msgstr "La conexion usa API HTTP REST con autenticacion por token."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Creates a JSON attachment on the remotecontrol record"
msgstr "Crea un adjunto JSON en el registro de remotecontrol"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Devices and sensors must exist in Odoo and be configured with remotecontrol parameters."
msgstr "Los dispositivos y sensores deben existir en Odoo y estar configurados con parametros de remotecontrol."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Each <strong>mdm.measurement.device.sensor</strong> stores:"
msgstr "Cada <strong>mdm.measurement.device.sensor</strong> guarda:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Each <strong>mdm.measurement.device</strong> stores:"
msgstr "Cada <strong>mdm.measurement.device</strong> guarda:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Each device entry is filtered to: <code>id</code> and <code>name</code>"
msgstr "Cada entrada de dispositivo se filtra a: <code>id</code> y <code>name</code>"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Each point is upserted into <code>mdm.measurement.device.sensor.reading</code> using key: <code>sensor_id + measurement_time</code>"
msgstr "Cada punto se guarda con upsert en <code>mdm.measurement.device.sensor.reading</code> usando la clave: <code>sensor_id + measurement_time</code>"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Example device params:"
msgstr "Ejemplo de parametros del dispositivo:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Example sensor params:"
msgstr "Ejemplo de parametros del sensor:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Fetches all devices from Kuvio and generates a JSON attachment."
msgstr "Obtiene todos los dispositivos de Kuvio y genera un adjunto JSON."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Follows pagination using <code>hasNext</code> / <code>totalPages</code>"
msgstr "Sigue la paginacion usando <code>hasNext</code> / <code>totalPages</code>"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "HTTPS only (enforced by Kuvio platform)"
msgstr "Solo HTTPS (obligatorio en la plataforma Kuvio)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Kuvio · Odoo Integration Help"
msgstr "Kuvio · Ayuda de integracion con Odoo"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Manual procedure to fetch the device catalog from all API pages."
msgstr "Procedimiento manual para obtener el catalogo de dispositivos de todas las paginas de la API."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Only credentials are required in connection_params:"
msgstr "En connection_params solo se requieren credenciales:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Per-sensor savepoint isolation to avoid aborting the full sync on a single error"
msgstr "Aislamiento por sensor con savepoint para evitar abortar toda la sincronizacion por un error puntual"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Procedure 1: Get Devices (Manual)"
msgstr "Procedimiento 1: Obtener dispositivos (manual)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Procedure 2: Daily Telemetry Sync (Scheduled)"
msgstr "Procedimiento 2: Sincronizacion diaria de telemetria (programada)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Rate limiting between requests (configurable in remotecontrol)"
msgstr "Limite de frecuencia entre peticiones (configurable en remotecontrol)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Scheduled procedure to retrieve readings and store them idempotently."
msgstr "Procedimiento programado para obtener lecturas y guardarlas de forma idempotente."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Sensors are taken from existing Odoo sensor records linked to the device."
msgstr "Los sensores se toman de registros de sensor existentes en Odoo vinculados al dispositivo."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Start date/time priority used in telemetry sync"
msgstr "Prioridad de fecha/hora usada en la sincronizacion de telemetria"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Synchronizes historical telemetry readings for configured sensors."
msgstr "Sincroniza lecturas historicas de telemetria para sensores configurados."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "The connector logs in at <code>POST /auth/login</code> and stores the token during execution."
msgstr "El conector inicia sesion en <code>POST /auth/login</code> y guarda el token durante la ejecucion."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "The connector reads the API base URL from the remote control field <strong>URL Base</strong>."
msgstr "El conector lee la URL base de la API desde el campo <strong>URL Base</strong> del remotecontrol."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Token-based authentication (expires and is refreshed per run)"
msgstr "Autenticacion basada en token (caduca y se renueva en cada ejecucion)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "URL Base field"
msgstr "Campo URL Base"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Uses endpoint: <code>GET /customer/{customerId}/devices?pageSize=100&amp;page=N</code>"
msgstr "Usa el endpoint: <code>GET /customer/{customerId}/devices?pageSize=100&amp;page=N</code>"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Value scaling applied: API value / 1000, rounded to 3 decimals before upsert"
msgstr "Escalado aplicado al valor: valor API / 1000, redondeado a 3 decimales antes del upsert"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
