#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "1) Connection Configuration"
msgstr "1) Configuracio de la connexio"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "1) Last reading timestamp of the device (any sensor), plus 1 ms"
msgstr "1) Ultima marca temporal de lectura del dispositiu (qualsevol sensor), mes 1 ms"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "2) Authentication Flow"
msgstr "2) Flux d'autenticacio"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "2) Device <code>start_date</code> (if no previous readings)"
msgstr "2) <code>start_date</code> del dispositiu (si no hi ha lectures previes)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "3) Available Procedures"
msgstr "3) Procediments disponibles"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "3) January 1st of current year (fallback)"
msgstr "3) 1 de gener de l'any actual (reserva)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "4) Device Configuration"
msgstr "4) Configuracio del dispositiu"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "5) Sensor Configuration"
msgstr "5) Configuracio del sensor"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "6) API Endpoints Used"
msgstr "6) Endpoints API utilitzats"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "7) Security &amp; Performance"
msgstr "7) Seguretat i rendiment"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "8) Readings Storage Behavior"
msgstr "8) Comportament d'emmagatzematge de lectures"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "9) Troubleshooting"
msgstr "9) Resolucio de problemes"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>GET /auth/user</code> - Get current user profile (customerId)"
msgstr "<code>GET /auth/user</code> - Obtenir el perfil de l'usuari actual (customerId)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>GET /customer/{customerId}/devices?pageSize=100&amp;page=N</code> - List paginated devices"
msgstr "<code>GET /customer/{customerId}/devices?pageSize=100&amp;page=N</code> - Llistar dispositius paginats"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>GET /plugins/telemetry/DEVICE/{deviceId}/values/timeseries?keys={sensor_id}&amp;startTs={ms}&amp;endTs={ms}&amp;orderBy=DESC</code> - Get historical readings"
msgstr "<code>GET /plugins/telemetry/DEVICE/{deviceId}/values/timeseries?keys={sensor_id}&amp;startTs={ms}&amp;endTs={ms}&amp;orderBy=DESC</code> - Obtenir lectures historiques"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>POST /auth/login</code> - Authenticate and get token"
msgstr "<code>POST /auth/login</code> - Autenticar i obtenir token"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>consumo_mensual</code> - Monthly consumption"
msgstr "<code>consumo_mensual</code> - Consum mensual"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>consumo_total</code> - Total accumulated consumption"
msgstr "<code>consumo_total</code> - Consum total acumulat"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<code>delta</code> - Consumption since last reading"
msgstr "<code>delta</code> - Consum des de l'ultima lectura"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>401 Unauthorized</strong> - Check username/password in connection_params"
msgstr "<strong>401 Unauthorized</strong> - Revisa usuari/contrasenya a connection_params"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>404 Device Not Found</strong> - Verify device_id in device remotecontrol_params"
msgstr "<strong>404 Device Not Found</strong> - Verifica device_id a remotecontrol_params del dispositiu"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Create Sensor Plan</strong> - Builds plan from existing Odoo sensors/devices"
msgstr "<strong>Create Sensor Plan</strong> - Construeix el pla des de sensors/dispositius existents a Odoo"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Empty readings</strong> - Verify sensor key (sensor_id) and reporting period"
msgstr "<strong>Empty readings</strong> - Verifica la clau del sensor (sensor_id) i el periode consultat"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Get Devices</strong> - Authenticates if needed, resolves customerId, paginates devices, and creates attachment."
msgstr "<strong>Get Devices</strong> - Autentica si cal, resol customerId, pagina dispositius i crea adjunt."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Get Historical Readings</strong> - Downloads and upserts all returned points"
msgstr "<strong>Get Historical Readings</strong> - Descarrega i fa upsert de tots els punts retornats"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Login</strong> - Obtain authentication token"
msgstr "<strong>Login</strong> - Obtenir token d'autenticacio"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Missing base URL</strong> - Configure URL Base field in remotecontrol"
msgstr "<strong>Missing base URL</strong> - Configura el camp URL Base a remotecontrol"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Platform:</strong> Kuvio IoT telemetry platform for water monitoring devices"
msgstr "<strong>Plataforma:</strong> Plataforma de telemetria IoT de Kuvio per a dispositius de monitoratge d'aigua"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>Type:</strong> HTTP REST API Connection"
msgstr "<strong>Tipus:</strong> Connexio HTTP REST API"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>remotecontrol_id</strong> = Kuvio remote control"
msgstr "<strong>remotecontrol_id</strong> = telecontrol Kuvio"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>remotecontrol_params</strong> (JSON) with <code>device_id</code> and optional <code>start_date</code>"
msgstr "<strong>remotecontrol_params</strong> (JSON) amb <code>device_id</code> i <code>start_date</code> opcional"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "<strong>remotecontrol_params</strong> with telemetry key in <code>sensor_id</code> (or <code>key</code> for backward compatibility)"
msgstr "<strong>remotecontrol_params</strong> amb la clau de telemetria a <code>sensor_id</code> (o <code>key</code> per compatibilitat)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "A) Kuvio: Get Devices"
msgstr "A) Kuvio: Obtenir dispositius"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "All points returned by the telemetry endpoint are processed (not only the latest one)"
msgstr "Es processen tots els punts retornats per l'endpoint de telemetria (no nomes l'ultim)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Automatic retry on network failures"
msgstr "Reintent automatic davant errors de xarxa"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "B) Kuvio: Daily Telemetry Sync"
msgstr "B) Kuvio: Sincronitzacio diaria de telemetria"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Common telemetry keys (update sensor remotecontrol_params to use):"
msgstr "Claus de telemetria comunes (actualitza remotecontrol_params del sensor):"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Connection uses HTTP REST API with token authentication."
msgstr "La connexio usa API HTTP REST amb autenticacio per token."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Creates a JSON attachment on the remotecontrol record"
msgstr "Crea un adjunt JSON al registre de remotecontrol"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Devices and sensors must exist in Odoo and be configured with remotecontrol parameters."
msgstr "Els dispositius i sensors han d'existir a Odoo i estar configurats amb parametres de remotecontrol."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Each <strong>mdm.measurement.device.sensor</strong> stores:"
msgstr "Cada <strong>mdm.measurement.device.sensor</strong> desa:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Each <strong>mdm.measurement.device</strong> stores:"
msgstr "Cada <strong>mdm.measurement.device</strong> desa:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Each device entry is filtered to: <code>id</code> and <code>name</code>"
msgstr "Cada entrada de dispositiu es filtra a: <code>id</code> i <code>name</code>"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Each point is upserted into <code>mdm.measurement.device.sensor.reading</code> using key: <code>sensor_id + measurement_time</code>"
msgstr "Cada punt es desa amb upsert a <code>mdm.measurement.device.sensor.reading</code> usant la clau: <code>sensor_id + measurement_time</code>"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Example device params:"
msgstr "Exemple de parametres del dispositiu:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Example sensor params:"
msgstr "Exemple de parametres del sensor:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Fetches all devices from Kuvio and generates a JSON attachment."
msgstr "Obte tots els dispositius de Kuvio i genera un adjunt JSON."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Follows pagination using <code>hasNext</code> / <code>totalPages</code>"
msgstr "Segueix la paginacio usant <code>hasNext</code> / <code>totalPages</code>"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "HTTPS only (enforced by Kuvio platform)"
msgstr "Nomes HTTPS (obligatori a la plataforma Kuvio)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Kuvio · Odoo Integration Help"
msgstr "Kuvio · Ajuda d'integracio amb Odoo"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Manual procedure to fetch the device catalog from all API pages."
msgstr "Procediment manual per obtenir el cataleg de dispositius de totes les pagines de l'API."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Only credentials are required in connection_params:"
msgstr "A connection_params nomes calen credencials:"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Per-sensor savepoint isolation to avoid aborting the full sync on a single error"
msgstr "Aillament per sensor amb savepoint per evitar avortar tota la sincronitzacio per un error puntual"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Procedure 1: Get Devices (Manual)"
msgstr "Procediment 1: Obtenir dispositius (manual)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Procedure 2: Daily Telemetry Sync (Scheduled)"
msgstr "Procediment 2: Sincronitzacio diaria de telemetria (programada)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Rate limiting between requests (configurable in remotecontrol)"
msgstr "Limit de frequencia entre peticions (configurable a remotecontrol)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Scheduled procedure to retrieve readings and store them idempotently."
msgstr "Procediment programat per obtenir lectures i desar-les de manera idempotent."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Sensors are taken from existing Odoo sensor records linked to the device."
msgstr "Els sensors es prenen dels registres de sensor existents a Odoo vinculats al dispositiu."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Start date/time priority used in telemetry sync"
msgstr "Prioritat de data/hora usada a la sincronitzacio de telemetria"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Synchronizes historical telemetry readings for configured sensors."
msgstr "Sincronitza lectures historiques de telemetria per als sensors configurats."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "The connector logs in at <code>POST /auth/login</code> and stores the token during execution."
msgstr "El connector inicia sessio a <code>POST /auth/login</code> i desa el token durant l'execucio."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "The connector reads the API base URL from the remote control field <strong>URL Base</strong>."
msgstr "El connector llegeix la URL base de l'API des del camp <strong>URL Base</strong> del remotecontrol."

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Token-based authentication (expires and is refreshed per run)"
msgstr "Autenticacio basada en token (caduca i es renova a cada execucio)"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "URL Base field"
msgstr "Camp URL Base"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Uses endpoint: <code>GET /customer/{customerId}/devices?pageSize=100&amp;page=N</code>"
msgstr "Usa l'endpoint: <code>GET /customer/{customerId}/devices?pageSize=100&amp;page=N</code>"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "Value scaling applied: API value / 1000, rounded to 3 decimals before upsert"
msgstr "Escalat aplicat al valor: valor API / 1000, arrodonit a 3 decimals abans de l'upsert"

#. module: remotecontrol_kuvio
#: model:remotecontrol,remotecontrol_help:remotecontrol_kuvio.remotecontrol_kuvio
msgid "connection_params (JSON)"
msgstr "connection_params (JSON)"

