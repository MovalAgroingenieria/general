<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_sms_alternatives" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sms.alternatives</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//setting[@id='sms']" position="inside">
                <setting id="sms_alternatives"
                         string="SMS Alternatives"
                         help="Configure which SMS service to use.">
                    <field name="sms_service" required="1"/>
                </setting>
            </xpath>

        </field>
    </record>

</odoo>
