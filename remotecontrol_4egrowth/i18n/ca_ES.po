#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "{\n"
"  \"growth_id\": \"DEVICE_ID_FROM_4EGROWTH\",\n"
"  \"start_date\": \"2025-01-01\"   // optional fallback if the sensor doesn't define it and no prior readings exist\n"
"}"
msgstr "{\n"
"  \"growth_id\": \"DEVICE_ID_FROM_4EGROWTH\",\n"
"  \"start_date\": \"2025-01-01\"   // opcional, usat si el sensor no ho defineix i no existeixen lectures prèvies\n"
"}"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "{\n"
"  \"parameter\": \"humedad\",           // query filter name (see list below)\n"
"  \"parameter_value\": 30,            // depth or selector (e.g., 30 cm)\n"
"  \"group\": \"Humedad suelo\",         // payload group\n"
"  \"key\": \"Humedad suelo 30 cm\",     // entry under the group with a \"data\" array\n"
"  \"start_date\": \"2025-01-01\"        // optional; else device.start_date; else Jan 1 of current year\n"
"}"
msgstr "{\n"
"  \"parameter\": \"humedad\",           // nom del filtre de consulta (veure llista a sota)\n"
"  \"parameter_value\": 30,            // profunditat o selector (p. ex., 30 cm)\n"
"  \"group\": \"Humedad suelo\",         // grup de càrrega útil\n"
"  \"key\": \"Humedad suelo 30 cm\",     // entrada sota el grup amb una matriu \"data\"\n"
"  \"start_date\": \"2025-01-01\"        // opcional; si no device.start_date; si no 1 de gener de l'any actual\n"
"}"

