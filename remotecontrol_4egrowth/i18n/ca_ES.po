#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "5) Time Window"
msgstr "5) Finestra de Temps"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>clima</code> (Weather): variable selector, e.g. <code>eto</code>, <code>temperatura</code>, or <code>all</code>."
msgstr "<code>clima</code> (Clima): selector de variable, p. ex. <code>eto</code>, <code>temperatura</code>, o <code>all</code>."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>group</code> and <code>key</code> must match exactly what the endpoint returns in <code>all_data</code>."
msgstr "<code>group</code> i <code>key</code> han de coincidir exactament amb el que retorna el punt final a <code>all_data</code>."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>group</code>: <code>Clima</code>"
msgstr "<code>group</code>: <code>Clima</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>group</code>: <code>Humedad suelo</code>"
msgstr "<code>group</code>: <code>Humedad suelo</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>group</code>: <code>Potencial matricial</code>"
msgstr "<code>group</code>: <code>Potencial matricial</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>group</code>: <code>Temperatura suelo</code>"
msgstr "<code>group</code>: <code>Temperatura suelo</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>humedad</code> (Soil moisture): depth selector. Example values: <code>20</code>, <code>30</code>, <code>40</code>, <code>all</code>, or comma separated (API accepts lists)."
msgstr "<code>humedad</code> (Humitat del sòl): selector de profunditat. Valors d'exemple: <code>20</code>, <code>30</code>, <code>40</code>, <code>all</code>, o separats per comes (l'API accepta llistes)."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>key</code>: <code>Humedad suelo 30 cm</code>"
msgstr "<code>key</code>: <code>Humedad suelo 30 cm</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>key</code>: <code>Potencial matricial 20 cm</code>"
msgstr "<code>key</code>: <code>Potencial matricial 20 cm</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>key</code>: <code>Temperatura suelo 20 cm</code>"
msgstr "<code>key</code>: <code>Temperatura suelo 20 cm</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>key</code>: <code>eto</code> (or the exact variable name returned by the API)"
msgstr "<code>key</code>: <code>eto</code> (o el nom exacte de la variable retornada per l'API)"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>parameter</code>: <code>clima</code>"
msgstr "<code>parameter</code>: <code>clima</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>parameter</code>: <code>humedad</code>"
msgstr "<code>parameter</code>: <code>humedad</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>parameter</code>: <code>potencial</code>"
msgstr "<code>parameter</code>: <code>potencial</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>parameter</code>: <code>temperatura</code>"
msgstr "<code>parameter</code>: <code>temperatura</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>parameter_value</code> may be <em>0</em> and is considered valid."
msgstr "<code>parameter_value</code> pot ser <em>0</em> i es considera vàlid."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>parameter_value</code>: <code>20</code>"
msgstr "<code>parameter_value</code>: <code>20</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>parameter_value</code>: <code>30</code>"
msgstr "<code>parameter_value</code>: <code>30</code>"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>parameter_value</code>: <code>eto</code> (or <code>all</code>)"
msgstr "<code>parameter_value</code>: <code>eto</code> (o <code>all</code>)"

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>potencial</code> (Matric potential): depth selector, similar semantics."
msgstr "<code>potencial</code> (Potencial matricial): selector de profunditat, semàntica similar."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<code>temperatura</code> (Soil temperature): depth selector, similar semantics to <em>humedad</em>."
msgstr "<code>temperatura</code> (Temperatura del sòl): selector de profunditat, semàntica similar a <em>humedad</em>."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<em>Get Token</em> calls <code>/api/login/</code> and stores <code>bag[\"token\"]</code> (JWT <code>access</code>)."
msgstr "<em>Obtenir Token</em> crida a <code>/api/login/</code> i emmagatzema <code>bag[\"token\"]</code> (JWT <code>access</code>)."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<em>Get devices (plan)</em> and <em>Get readings</em> send <code>Authorization: Bearer &lt;token&gt;</code>."
msgstr "<em>Obtenir dispositius (pla)</em> i <em>Obtenir lectures</em> envien <code>Authorization: Bearer &lt;token&gt;</code>."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<em>Get devices (plan)</em> computes <code>initial_date</code> per sensor: last stored reading date → else <code>sensor.start_date</code> → else <code>device.start_date</code> → else Jan 1 of current year."
msgstr "<em>Obtenir dispositius (pla)</em> calcula <code>initial_date</code> per sensor: data de l'última lectura emmagatzemada → si no <code>sensor.start_date</code> → si no <code>device.start_date</code> → si no 1 de gener de l'any actual."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<em>Get readings</em> uses <code>initial_date</code> → <code>final_date = today</code> and filters points by <code>YYYY-MM-DD HH:MM:SS</code>."
msgstr "<em>Obtenir lectures</em> utilitza <code>initial_date</code> → <code>final_date = today</code> i filtra punts per <code>YYYY-MM-DD HH:MM:SS</code>."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<strong>Get Token</strong> → obtain JWT and store it in the bag."
msgstr "<strong>Obtenir Token</strong> → obtenir JWT i emmagatzemar-lo a la bossa."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<strong>Get devices (plan)</strong> → build <code>bag[\"sensors_plan\"]</code> from device/sensor config."
msgstr "<strong>Obtenir dispositius (pla)</strong> → construir <code>bag[\"sensors_plan\"]</code> a partir de la configuració de dispositiu/sensor."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
msgid "<strong>Get readings</strong> → call <code>/api/data_device/{growth_id}/all_data/</code> with filters and upsert readings."
msgstr "<strong>Obtenir lectures</strong> → cridar a <code>/api/data_device/{growth_id}/all_data/</code> amb filtres i actualitzar/inserir lectures."

#. module: remotecontrol_4egrowth
#: model:remotecontrol,remotecontrol_help:remotecontrol_4egrowth.remotecontrol_4egrowth
