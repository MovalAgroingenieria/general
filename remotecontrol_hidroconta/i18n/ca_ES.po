#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "Generates a JSON attachment with all information grouped by installation: <code>hidroconta_devices_YYYYMMDD_HHMMSS.json</code>."
msgstr "Genera un adjunt JSON amb tota la informació agrupada por instalación: <code>hidroconta_devices_YYYYMMDD_HHMMSS.json</code>."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
