#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>GET /Demeter2/v2/installations</code> → list all installations with codes and descriptions."
msgstr "<code>GET /Demeter2/v2/installations</code> → lista todas las instalaciones con sus códigos y descripciones."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>GET /Demeter2/v2/installations</code> → retrieves all installations with their codes and descriptions."
msgstr "<code>GET /Demeter2/v2/installations</code> → obtiene todas las instalaciones con sus códigos y descripciones."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>POST /Demeter2/v2/history/data</code> → retrieve historical readings for specific devices."
msgstr "<code>POST /Demeter2/v2/history/data</code> → obtiene lecturas históricas para dispositivos específicos."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>POST /Demeter2/v2/login</code> → obtain JSESSIONID cookie for authentication."
msgstr "<code>POST /Demeter2/v2/login</code> → obtiene la cookie JSESSIONID para autenticación."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>POST /Demeter2/v2/search</code> → retrieves devices by type (counters, valves, hydrants, analogInputs, digitalInputs, digitalOutputs, iris, rtus)."
msgstr "<code>POST /Demeter2/v2/search</code> → obtiene dispositivos por tipo (counters, valves, hydrants, analogInputs, digitalInputs, digitalOutputs, iris, rtus)."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>POST /Demeter2/v2/search</code> → search devices by type and status (payload: <code>{\"status\": \"enabled\", \"types\": [\"counters\"]}</code>)."
msgstr "<code>POST /Demeter2/v2/search</code> → busca dispositivos por tipo y estado (payload: <code>{\"status\": \"enabled\", \"types\": [\"counters\"]}</code>)."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>analogInputs</code> → Analog input sensors"
msgstr "<code>analogInputs</code> → Sensores de entrada analógica"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>counters</code> → Water meters and consumption counters"
msgstr "<code>counters</code> → Contadores de agua y consumo"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>digitalInputs</code> → Digital input sensors"
msgstr "<code>digitalInputs</code> → Sensores de entrada digital"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>digitalOutputs</code> → Digital output controls"
msgstr "<code>digitalOutputs</code> → Controles de salida digital"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>element_id</code>: Device identifier in Hidroconta API"
msgstr "<code>element_id</code>: Identificador del dispositivo en la API de Hidroconta"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>hydrants</code> → Hydrant devices"
msgstr "<code>hydrants</code> → Dispositivos hidrante"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>iris</code> → IRIS communication devices"
msgstr "<code>iris</code> → Dispositivos de comunicación IRIS"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>rtus</code> → Remote Terminal Units"
msgstr "<code>rtus</code> → Unidades terminales remotas (RTU)"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>start_date</code>: Initial date for historical data retrieval (YYYY-MM-DD)"
msgstr "<code>start_date</code>: Fecha inicial para la obtención de datos históricos (YYYY-MM-DD)"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>subcode</code>: Data subtype (0 for default, varies by device type)"
msgstr "<code>subcode</code>: Subtipo de dato (0 por defecto, varía según el tipo de dispositivo)"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>subtype</code>: Data type (4 for standard readings)"
msgstr "<code>subtype</code>: Tipo de dato (4 para lecturas estándar)"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<code>valves</code> → Control valves"
msgstr "<code>valves</code> → Válvulas de control"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<em>Login</em> → performs <code>POST /Demeter2/v2/login</code> with username and password in JSON body, stores JSESSIONID cookie."
msgstr "<em>Login</em> → ejecuta <code>POST /Demeter2/v2/login</code> con usuario y contraseña en el cuerpo JSON y almacena la cookie JSESSIONID."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<strong>Build Sensor Plan</strong> → builds <code>bag[\"sensor_plan\"]</code> with (element_id, subtype, subcode, start_date) for each configured sensor."
msgstr "<strong>Construir plan de sensores</strong> → construye <code>bag[\"sensor_plan\"]</code> con (element_id, subtype, subcode, start_date) para cada sensor configurado."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<strong>Get Devices</strong> → calls:"
msgstr "<strong>Obtener dispositivos</strong> → llama a:"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<strong>Get Readings</strong> → executes <code>POST /Demeter2/v2/history/data</code> for each sensor in the plan and updates readings in Odoo."
msgstr "<strong>Obtener lecturas</strong> → ejecuta <code>POST /Demeter2/v2/history/data</code> para cada sensor del plan y actualiza las lecturas en Odoo."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<strong>Hidroconta: Daily Sync</strong> → Login + Build Sensor Plan + Get Readings for automatic daily synchronization."
msgstr "<strong>Hidroconta: Sincronización diaria</strong> → Login + Construir plan de sensores + Obtener lecturas para la sincronización diaria automática."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<strong>Hidroconta: Get Devices</strong> → Login + retrieves installations and all devices grouped by type and installation."
msgstr "<strong>Hidroconta: Obtener dispositivos</strong> → Login + obtiene las instalaciones y todos los dispositivos agrupados por tipo e instalación."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<strong>Login endpoint:</strong>"
msgstr "<strong>Endpoint de login:</strong>"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<strong>Login</strong> → authenticates the user and stores <code>bag[\"jsessionid\"]</code>."
msgstr "<strong>Login</strong> → autentica al usuario y almacena <code>bag[\"jsessionid\"]</code>."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<strong>Response:</strong> JSESSIONID cookie in Set-Cookie header"
msgstr "<strong>Respuesta:</strong> cookie JSESSIONID en la cabecera Set-Cookie"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>connection_params</strong> (JSON):"

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "All requests require a valid JSESSIONID cookie obtained from the Login action."
msgstr "Todas las peticiones requieren una cookie JSESSIONID válida obtenida en la acción de Login."

#. module: remotecontrol_hidroconta
#: model:remotecontrol,remotecontrol_help:remotecontrol_hidroconta.remotecontrol_hidroconta
msgid "Cookie: JSESSIONID=&lt;session_id&gt;"
msgstr "Cookie: JSESSIONID=&lt;session_id&gt;"

