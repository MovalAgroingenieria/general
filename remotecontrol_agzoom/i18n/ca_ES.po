#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>Pluviometria</strong></code> - Precipitation / Rainfall"
msgstr "<code><strong>Pluviometria</strong></code> - Precipitacions / Precipitacions"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>conductivity</strong></code> - Electrical conductivity"
msgstr "<code><strong>conductivity</strong></code> - conductivitat elèctrica"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>electrical_conductivity</strong></code> - Electrical conductivity (alternative)"
msgstr "<code><strong>electrical_conductivity</strong></code> - Conductivitat elèctrica (alternativa)"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>pressure</strong></code> - Atmospheric pressure"
msgstr "<code><strong>pressure</strong></code> - Pressió atmosfèrica"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>temperature_soil</strong></code> - Soil temperature"
msgstr "<code><strong>temperature_soil</strong></code> - Temperatura del sòl"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>temperature_water</strong></code> - Water temperature"
msgstr "<code><strong>temperature_water</strong></code> - Temperatura de l'aigua"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>water_level</strong></code> - Water level / Soil moisture"
msgstr "<code><strong>water_level</strong></code> - Nivell d'aigua / Humitat del sòl"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>water_level_relative</strong></code> - Relative water level"
msgstr "<code><strong>water_level_relative</strong></code> - Nivell d'aigua relatiu"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Device configuration:</em>"
msgstr "<em>Configuració del dispositiu:</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Get Token</em> calls <code>/oauth/v2/token</code> using OAuth2 password grant and stores <code>bag[\"access_token\"]</code>."
msgstr "<em>Get Token</em> calls <code>/oauth/v2/token</code> using OAuth2 password grant and stores <code>bag[\"access_token\"]</code>."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Get devices (plan)</em> and <em>Get readings</em> send <code>Authorization: Bearer &lt;access_token&gt;</code>."
msgstr "<em>Get devices (plan)</em> and <em>Get readings</em> send <code>Authorization: Bearer &lt;access_token&gt;</code>."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Get devices (plan)</em> calculates <code>initial_date</code> per sensor: last reading date → else <code>sensor.start_date</code> → else <code>device.start_date</code> → else January 1st of current year."
msgstr "<em>Get devices (plan)</em> calculates <code>initial_date</code> per sensor: last reading date → else <code>sensor.start_date</code> → else <code>device.start_date</code> → else January 1st of current year."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Get readings</em> calls <code>/api/getsensordata/{deviceId}/date/{endDate}/{startDate}</code>"
msgstr "<em>Get readings</em> calls <code>/api/getsensordata/{deviceId}/date/{endDate}/{startDate}</code>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Note: Specific <code>unit</code> values depend on your AgZoom configuration and installed sensors. Use the \"List Devices\" procedure and check the complete API response from <code>/api/getsensordata</code> to see which units are available for your specific sensors.</em>"
msgstr "<em>Nota: Els valors <code>unit</code> específiques depenen de la configuració d'AgZoom i dels sensors instal·lats. Feu servir el procediment \"Llista de dispositius\" i comproveu la resposta completa de l'API de <code>/api/getsensordata</code> per veure quines unitats estan disponibles per als vostres sensors específics.</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Sensor 1 (soil moisture - VP-4 sensor, port 5, depth 30cm):</em>"
msgstr "<em>Sensor 1 (soil moisture - VP-4 sensor, port 5, depth 30cm):</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Sensor 2 (soil temperature - same physical sensor):</em>"
msgstr "<em>Sensor 2 (soil temperature - same physical sensor):</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>This procedure only reads data from AgZoom - it does not create or modify anything in Odoo.</em>"
msgstr "<em>Aquest procediment només llegeix dades d'AgZoom; no crea ni modifica res a Odoo.</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Attaches</strong> the JSON to the Remote Control record for download"
msgstr "<strong>Adjunta</strong> el JSON al registre de control remot per a la seva descàrrega."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Authenticates</strong> with AgZoom API using your OAuth2 credentials"
msgstr "<strong>S'autentica</strong> amb l'API d'AgZoom utilitzant les teves credencials d'OAuth2"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Configuration Mapping:</strong>"
msgstr "<strong>Mapatge de configuració:</strong>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Date format error:</strong> AgZoom requires YYYYMMDDHHIISS format (e.g., 20240529000000)"
msgstr "<strong>Error de format de data:</strong> AgZoom requereix el format YYYYYMDDHHIISS (per exemple, 20240529000000)"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Example: Soil moisture sensors</strong>"
msgstr "<strong>Exemple: Sensors d'humitat del sòl</strong>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Extracts</strong> device name, ID, location, sensors, and all available measurement units"
msgstr "<strong>Extreu</strong> el nom del dispositiu, l'ID, la ubicació, els sensors i totes les unitats de mesura disponibles"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Fetches</strong> detailed sensor data for each device including sensor codes and available units"
msgstr "<strong>Obté</strong> dades detallades del sensor per a cada dispositiu, inclosos els codis del sensor i les unitats disponibles"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Generates</strong> a comprehensive JSON file with complete device and sensor configuration"
msgstr "<strong>Genera</strong> un fitxer JSON complet amb la configuració completa del dispositiu i del sensor"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Get Token</strong> → obtain OAuth2 token and store it in the bag."
msgstr "<strong>Obtén el token</strong> → obté el token OAuth2 i guardeu-lo a la bossa."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Get devices (plan)</strong> → build <code>bag[\"sensors_plan\"]</code> from device/sensor configuration."
msgstr "<strong>Obtén dispositius (pla)</strong> → crea <code>bag[\"sensors_plan\"]</code> des de la configuració del dispositiu/sensor."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Get readings</strong> → call <code>/api/getsensordata/{deviceId}/date/{endDate}/{startDate}</code> with date filters and upsert readings."
msgstr "<strong>Obtén lectures</strong> → crida <code>/api/getsensordata/{deviceId}/date/{endDate}/{startDate}</code> amb filtres de data i lectures inverses."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Important note:</strong> The <code>variables[]</code> array contains multiple readings with different dates for the same sensor"
msgstr "<strong>Nota important:</strong> La matriu <code>variables[]</code> conté diverses lectures amb dates diferents per al mateix sensor."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Missing OAuth2 credentials:</strong> Make sure to configure client_id, client_secret, username and password in connection_params"
msgstr "<strong>Falten les credencials d'OAuth2:</strong> assegureu-vos de configurar client_id, client_secret, username i password a connection_params."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Missing token error:</strong> Ensure \"Get Token\" action is active and runs first (sequence = 10)"
msgstr "<strong>Error de testimoni que falta:</strong> assegureu-vos que l'acció \"Obtenir testimoni\" estigui activa i s'executi primer (seqüència = 10)"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>No readings inserted:</strong> Verify date window filters, sensor_code and unit values"
msgstr "<strong>No s'han inserit lectures:</strong> Verifiqueu els filtres de la finestra de data, el sensor_code i els valors de la unitat"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>No sensors found:</strong> Check that sensors have valid <code>remotecontrol_params</code> and are linked to devices"
msgstr "<strong>No s'han trobat sensors:</strong> comproveu que els sensors tinguin <code>remotecontrol_params</code> vàlids i que estiguin vinculats a dispositius."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Official API documentation:</strong>"
msgstr "<strong>Documentació oficial de l'API:</strong>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Response format:</strong> Dates in the response come in ISO 8601 format with UTC: <code>2025-10-17T08:00:07Z</code>"
msgstr "<strong>Format de resposta:</strong> Les dates de la resposta vénen en format ISO 8601 amb UTC: <code>2025-10-17T08:00:07Z</code>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Retrieves</strong> all devices available in your AgZoom account from <code>/api/userdevices</code>"
msgstr "<strong>Recupera</strong> tots els dispositius disponibles al vostre compte d'AgZoom des de <code>/api/userdevices</code>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Sequence order:</strong> Get Token (10) → Get devices (20) → Get readings (30)"
msgstr "<strong>Ordre de seqüència:</strong> Obtenir token (10) → Obtenir dispositius (20) → Obtenir lectures (30)"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>paràmetres_de_connexió</strong> (JSON):"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>sensor_code</strong> → identifies the physical sensor (e.g., \"36546\")"
msgstr "<strong>sensor_code</strong> → identifica el sensor físic (per exemple, \"36546\")"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>unit</strong> → identifies the specific unit within that sensor (e.g., \"water_level\", \"temperature_water\")"
msgstr "<strong>unit</strong> → identifies the specific unit within that sensor (e.g., \"water_level\", \"temperature_water\")"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "AG Zoom · Odoo Integration"
msgstr "AG Zoom · Integració amb Odoo"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "AgZoom returns data in this format:"
msgstr "AgZoom retorna dades en aquest format:"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "Available Units in Sensor Data"
msgstr "Unitats disponibles a les dades del sensor"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "Common Measurement Units"
msgstr "Unitats de mesura comunes"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "Complete Configuration Examples"
msgstr "Exemples de configuració complets"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "Date format for URL is: YYYYMMDDHHIISS (e.g., 20251017083007)"
msgstr "El format de data per a l'URL és: AAAAMMDDHHIISS (per exemple, 20251017083007)"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "Dates are automatically converted to Odoo format for storage: <code>2025-10-17 08:00:07</code>"
msgstr "Les dates es converteixen automàticament al format Odoo per emmagatzemar-les: <code>2025-10-17 08:00:07</code>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "For initial setup or when adding new AgZoom devices, use the <strong>List Devices procedure</strong> to discover available devices and configure them manually in Odoo."
msgstr "Per a la configuració inicial o quan afegiu nous dispositius AgZoom, utilitzeu el <strong>procediment Llista de dispositius</strong> per descobrir els dispositius disponibles i configurar-los manualment a Odoo."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "In each <strong>Device</strong> (<code>mdm.measurement.device</code>) set <em>remotecontrol_params</em>:"
msgstr "A cada <strong>dispositiu</strong> ( <code>mdm.measurement.device</code> ) definiu <em>remotecontrol_params</em> :"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "In each <strong>Sensor</strong> (<code>mdm.measurement.device.sensor</code>) set <em>remotecontrol_params</em>:"
msgstr "A cada <strong>Sensor</strong> ( <code>mdm.measurement.device.sensor</code> ) definiu <em>remotecontrol_params</em> :"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "The <strong>\"AgZoom: List Devices for Support\"</strong> procedure performs the following actions:"
msgstr "El procediment <strong>\"AgZoom: Llista de dispositius per a assistència\"</strong> realitza les accions següents:"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "The system searches for the sensor by <code>code</code> and then extracts all variables that match the specified <code>unit</code>"
msgstr "El sistema busca el sensor per <code>code</code> i després extreu totes les variables que coincideixen amb la <code>unit</code> especificada."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "Type: <code>REST</code> · Base URL: <code>http://visor.ag-zoom.com</code>"
msgstr "Tipus: <code>REST</code> · URL base: <code>http://visor.ag-zoom.com</code>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "Use these values in the <code>\"unit\"</code> field of sensor configuration. These are the unit names returned by the AgZoom API:"
msgstr "Feu servir aquests valors al camp <code>\"unit\"</code> de la configuració del sensor. Aquests són els noms de les unitats que retorna l'API d'AgZoom:"

