#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>temperature_water</strong></code> - Water temperature"
msgstr "<code><strong>temperature_water</strong></code> - Water temperature"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>water_level</strong></code> - Water level / Soil moisture"
msgstr "<code><strong>water_level</strong></code> - Water level / Soil moisture"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<code><strong>water_level_relative</strong></code> - Relative water level"
msgstr "<code><strong>water_level_relative</strong></code> - Relative water level"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Device configuration:</em>"
msgstr "<em>Configuración del dispositivo:</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Get Token</em> calls <code>/oauth/v2/token</code> using OAuth2 password grant and stores <code>bag[\"access_token\"]</code>."
msgstr "<em>Get Token</em> llamadas <code>/oauth/v2/token</code> utilizando la concesión de contraseñas OAuth2 y almacenando <code>bag[\"access_token\"]</code>."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Get devices (plan)</em> and <em>Get readings</em> send <code>Authorization: Bearer &lt;access_token&gt;</code>."
msgstr "<em>Get devices (plan)</em> y <em>Get readings</em> envia <code>Authorization: Bearer &lt;access_token&gt;</code>."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Get devices (plan)</em> calculates <code>initial_date</code> per sensor: last reading date → else <code>sensor.start_date</code> → else <code>device.start_date</code> → else January 1st of current year."
msgstr "<em>Get devices (plan)</em> calcula <code>initial_date</code> por sensor: última fecha lectura → sino <code>sensor.start_date</code> → sino <code>device.start_date</code> → sino 1 de Enero del año actual."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Get readings</em> calls <code>/api/getsensordata/{deviceId}/date/{endDate}/{startDate}</code>"
msgstr "<em>Get readings</em> calls <code>/api/getsensordata/{deviceId}/date/{endDate}/{startDate}</code>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Note: Specific <code>unit</code> values depend on your AgZoom configuration and installed sensors. Use the \"List Devices\" procedure and check the complete API response from <code>/api/getsensordata</code> to see which units are available for your specific sensors.</em>"
msgstr "<em>Nota: Los valores específicos <code>de las unidades</code> dependen de la configuración de AgZoom y de los sensores instalados. Utilice el procedimiento «Listar dispositivos» y compruebe la respuesta API completa de <code>/api/getsensordata</code> para ver qué unidades están disponibles para sus sensores específicos.</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Sensor 1 (soil moisture - VP-4 sensor, port 5, depth 30cm):</em>"
msgstr "<em>Sensor 1 (soil moisture - VP-4 sensor, port 5, depth 30cm):</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>Sensor 2 (soil temperature - same physical sensor):</em>"
msgstr "<em>Sensor 2 (soil temperature - same physical sensor):</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<em>This procedure only reads data from AgZoom - it does not create or modify anything in Odoo.</em>"
msgstr "<em>Este procedimiento solo lee datos de AgZoom; no crea ni modifica nada en Odoo.</em>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Attaches</strong> the JSON to the Remote Control record for download"
msgstr "<strong>Adjunta</strong> el JSON al registro de Control Remoto para su descarga"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Authenticates</strong> with AgZoom API using your OAuth2 credentials"
msgstr "<strong>Autentica</strong> con la API de AgZoom utilizando tus credenciales OAuth2."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Configuration Mapping:</strong>"
msgstr "<strong>Mapeo de configuración:</strong>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Date format error:</strong> AgZoom requires YYYYMMDDHHIISS format (e.g., 20240529000000)"
msgstr "<strong>Error en el formato de la fecha:</strong> AgZoom requiere el formato AAAAAMMDDHHIISS (por ejemplo, 20240529000000)."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Example: Soil moisture sensors</strong>"
msgstr "<strong>Ejemplo: Sensores de humedad del suelo</strong>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Extracts</strong> device name, ID, location, sensors, and all available measurement units"
msgstr "<strong>Extrae</strong> el nombre del dispositivo, el ID, la ubicación, los sensores y todas las unidades de medida disponibles."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Fetches</strong> detailed sensor data for each device including sensor codes and available units"
msgstr "<strong>Obtiene</strong> datos detallados de los sensores de cada dispositivo, incluidos los códigos de los sensores y las unidades disponibles."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Generates</strong> a comprehensive JSON file with complete device and sensor configuration"
msgstr "<strong>Genera</strong> un archivo JSON completo con la configuración completa del dispositivo y los sensores."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Get Token</strong> → obtain OAuth2 token and store it in the bag."
msgstr "<strong>Get Token</strong> → obtain OAuth2 token and store it in the bag."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Get devices (plan)</strong> → build <code>bag[\"sensors_plan\"]</code> from device/sensor configuration."
msgstr "<strong>Get devices (plan)</strong> → build <code>bag[\"sensors_plan\"]</code> from device/sensor configuration."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Get readings</strong> → call <code>/api/getsensordata/{deviceId}/date/{endDate}/{startDate}</code> with date filters and upsert readings."
msgstr "<strong>Get readings</strong> → call <code>/api/getsensordata/{deviceId}/date/{endDate}/{startDate}</code> with date filters and upsert readings."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Important note:</strong> The <code>variables[]</code> array contains multiple readings with different dates for the same sensor"
msgstr "<strong>Nota importante:</strong> La matriz <code>variables[]</code> contiene múltiples lecturas con diferentes fechas para el mismo sensor."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Missing OAuth2 credentials:</strong> Make sure to configure client_id, client_secret, username and password in connection_params"
msgstr "<strong>Faltan las credenciales OAuth2:</strong> asegúrese de configurar client_id, client_secret, username y password en connection_params."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Missing token error:</strong> Ensure \"Get Token\" action is active and runs first (sequence = 10)"
msgstr "<strong>Error de token ausente:</strong> Asegúrese de que la acción \"Obtener Token\" está activa y se ejecuta primero (secuencia = 10)"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>No readings inserted:</strong> Verify date window filters, sensor_code and unit values"
msgstr "<strong>No se han introducido lecturas:</strong> compruebe los filtros de la ventana de fecha, el código del sensor y los valores de la unidad."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>No sensors found:</strong> Check that sensors have valid <code>remotecontrol_params</code> and are linked to devices"
msgstr "<strong>No se han encontrado sensores:</strong> Compruebe que los sensores tienen <code>remotecontrol_params</code> válidos y están vinculados a dispositivos"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Official API documentation:</strong>"
msgstr "<strong>Documentación oficial de la API:</strong>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Response format:</strong> Dates in the response come in ISO 8601 format with UTC: <code>2025-10-17T08:00:07Z</code>"
msgstr "<strong>Formato de respuesta:</strong> Las fechas en la respuesta se presentan en formato ISO 8601 con UTC: <code>2025-10-17T08:00:07Z</code>"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Retrieves</strong> all devices available in your AgZoom account from <code>/api/userdevices</code>"
msgstr "<strong>Recupera</strong> todos los dispositivos disponibles en tu cuenta de AgZoom desde <code>/api/userdevices</code>."

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>Sequence order:</strong> Get Token (10) → Get devices (20) → Get readings (30)"
msgstr "<strong>Orden de secuencia:</strong> Obtener ficha (10) → Obtener dispositivos (20) → Obtener lecturas (30)"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>connection_params</strong> (JSON):"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>sensor_code</strong> → identifies the physical sensor (e.g., \"36546\")"
msgstr "<strong>sensor_code</strong> → identifies the physical sensor (e.g., \"36546\")"

#. module: remotecontrol_agzoom
#: model:remotecontrol,remotecontrol_help:remotecontrol_agzoom.remotecontrol_agzoom
msgid "<strong>unit</strong> → identifies the specific unit within that sensor (e.g., \"water_level\", \"temperature_water\")"
msgstr "<strong>unit</strong> → identifies the specific unit within that sensor (e.g., \"water_level\", \"temperature_water\")"

