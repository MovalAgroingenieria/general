<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mdm_config_settings_view_form" model="ir.ui.view">
        <field name="name">mdm.config.settings.form</field>
        <field name="model">mdm.config.settings</field>
        <field name="inherit_id" ref="mdm_sensor_management.mdm_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <separator string="GIS Configuration"/>
                <group>
                    <label for="default_gis_devices_refresh_interval"/>
                    <div>
                        <field name="default_gis_devices_refresh_interval" class="oe_inline"/>
                        <span> seconds</span>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
