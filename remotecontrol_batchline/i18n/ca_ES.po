#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<code>tag</code> must match the “Nombre” of a <code>Tag</code> entry returned by the device’s <code>/api/elementos</code> response."
msgstr "<code>tag</code> ha de coincidir amb el “Nombre” d’una entrada <code>Tag</code> retornada per la resposta de <code>/api/elementos</code> del dispositiu."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<em>Get Token</em> calls <code>/token</code> using form data (<code>grant_type=password</code>) and stores <code>bag[\"token\"]</code> (Bearer access token)."
msgstr "<em>Get Token</em> crida <code>/token</code> utilitzant dades de formulari (<code>grant_type=password</code>) i desa <code>bag[\"token\"]</code> (token d’accés Bearer)."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<em>Get devices (plan)</em> and <em>Get readings</em> send <code>Authorization: Bearer &lt;token&gt;</code> in headers."
msgstr "<em>Get devices (plan)</em> i <em>Get readings</em> envien <code>Authorization: Bearer &lt;token&gt;</code> a les capçaleres."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<em>Get devices (plan)</em> computes <code>initial_date</code> for each sensor:\n"
"    last stored reading → else <code>sensor.start_date</code> → else <code>device.start_date</code> → else Jan 1 of current year."
msgstr "<em>Get devices (plan)</em> calcula <code>initial_date</code> per a cada sensor:\n"
"    última lectura desada → sinó <code>sensor.start_date</code> → sinó <code>device.start_date</code> → sinó 1 de gener de l’any actual."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<em>Get readings</em> uses <code>inicio</code> = <code>initial_date</code> and <code>fin</code> = today, calling:"
msgstr "<em>Get readings</em> utilitza <code>inicio</code> = <code>initial_date</code> i <code>fin</code> = avui, cridant:"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<em>device_id</em> corresponds to the “Identificador” returned by the <code>/api/elementos</code> endpoint."
msgstr "<em>device_id</em> correspon a l’“Identificador” retornat per l’endpoint <code>/api/elementos</code>."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get Token</strong>"
msgstr "<strong>Obtenir token</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get Token</strong> → authenticate and store token in <code>bag[\"token\"]</code>."
msgstr "<strong>Obtenir token</strong> → autentica i desa el token a <code>bag[\"token\"]</code>."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get Token</strong> → obtain access token and store it in <code>bag[\"token\"]</code>."
msgstr "<strong>Obtenir token</strong> → obté el token d’accés i desa’l a <code>bag[\"token\"]</code>."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get devices (plan)</strong> → build <code>bag[\"sensors_plan\"]</code> from Odoo sensors linked to devices with valid <code>remotecontrol_params</code>."
msgstr "<strong>Get devices (plan)</strong> → construeix <code>bag[\"sensors_plan\"]</code> a partir dels sensors d’Odoo vinculats a dispositius amb <code>remotecontrol_params</code> vàlids."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get hydrants</strong>"
msgstr "<strong>Obtenir hidrants</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get readings</strong>"
msgstr "<strong>Obtenir lectures</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get readings</strong> → iterate through plan and call <code>/api/elementos/historico</code> with filters by date, device, and tag to upsert readings into Odoo."
msgstr "<strong>Obtenir lectures</strong> → itera pel pla i crida <code>/api/elementos/historico</code> amb filtres per data, dispositiu i etiqueta per inserir o actualitzar les lectures a Odoo."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Import elements</strong>"
msgstr "<strong>Importar elements</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Import elements</strong> → call <code>/api/elementos</code> and store the resulting JSON list in an attachment. Each element includes <code>Identificador</code>, <code>Descripción</code>, and a list of <code>Tags</code> with <code>Nombre</code> and <code>Unidad</code>."
msgstr "<strong>Importar elements</strong> → crida <code>/api/elementos</code> i desa la llista JSON resultant en un adjunt. Cada element inclou <code>Identificador</code>, <code>Descripció</code> i una llista de <code>Tags</code> amb <code>Nom</code> i <code>Unitat</code>."

#. module: remotecontrol_batchline
