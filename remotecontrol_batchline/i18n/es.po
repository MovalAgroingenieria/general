#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get Token</strong>"
msgstr "<strong>Obtener Token</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get Token</strong> → authenticate and store token in <code>bag[\"token\"]</code>."
msgstr "<strong>Obtener Token</strong> → autentica y guarda el token en <code>bag[\"token\"]</code>."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get Token</strong> → obtain access token and store it in <code>bag[\"token\"]</code>."
msgstr "<strong>Obtener Token</strong> → obtiene el token de acceso y lo guarda en <code>bag[\"token\"]</code>."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get devices (plan)</strong> → build <code>bag[\"sensors_plan\"]</code> from Odoo sensors linked to devices with valid <code>remotecontrol_params</code>."
msgstr "<strong>Obtener dispositivos (plan)</strong> → construye <code>bag[\"sensors_plan\"]</code> a partir de los sensores de Odoo vinculados a dispositivos con <code>remotecontrol_params</code> válidos."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get hydrants</strong>"
msgstr "<strong>Obtener hidrantes</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get pressure devices (plan)</strong> → build <code>bag[\"pressure_sensors_plan\"]</code> from Odoo sensors with <code>sensor_type</code> defined in their parameters."
msgstr "<strong>Obtener dispositivos presión (plan)</strong> → se construye <code>bag[\"pressure_sensors_plan\"]</code> desde los sensores de odoo con <code>sensor_type</code> definido en sus parámetros"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get pressure readings</strong>"
msgstr "<strong>Obtener lecturas de presión</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get pressure readings</strong> → iterate through plan and call <code>/api/presiones/historico</code> with filters by date, hidrante, electronica, and canal to upsert pressure readings into Odoo."
msgstr "<strong>Obtener lecturas de presión</strong> → itera a través del plan y llama <code>/api/presiones/historico</code> con filtros por fecha, hidrante, electronica, y canal para actualizar lecturas dentro de odoo."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get readings</strong>"
msgstr "<strong>Obtener lecturas</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Get readings</strong> → iterate through plan and call <code>/api/elementos/historico</code> with filters by date, device, and tag to upsert readings into Odoo."
msgstr "<strong>Obtener lecturas</strong> → itera sobre el plan y llama a <code>/api/elementos/historico</code> con filtros por fecha, dispositivo y etiqueta para insertar o actualizar lecturas en Odoo."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Import elements</strong>"
msgstr "<strong>Importar elementos</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Import elements</strong> → call <code>/api/elementos</code> and store the resulting JSON list in an attachment. Each element includes <code>Identificador</code>, <code>Descripción</code>, and a list of <code>Tags</code> with <code>Nombre</code> and <code>Unidad</code>."
msgstr "<strong>Importar elementos</strong> → llama a <code>/api/elementos</code> y almacena la lista JSON resultante en un adjunto. Cada elemento incluye <code>Identificador</code>, <code>Descripción</code> y una lista de <code>Tags</code> con <code>Nombre</code> y <code>Unidad</code>."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Import pressure devices</strong>"
msgstr "<strong>Importar dispositivos de presión</strong>"

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<strong>Import pressure devices</strong> → call <code>/api/presiones</code> and store the resulting JSON list in an attachment. Each device includes <code>Hidrante</code>, <code>Electronica</code>, <code>Canal</code>, <code>Alias</code>, <code>Unidad</code>, and current <code>Valor</code>."
msgstr "<strong>Importar dispositivos de presión</strong> → llama a <code>/api/presiones</code> y guarda el resultado en una lista JSON. Cada dispositivo incluye <code>Hidrante</code>, <code>Electronica</code>, <code>Canal</code>, <code>Alias</code>, <code>Unidad</code>, y el actual <code>Valor</code>."

