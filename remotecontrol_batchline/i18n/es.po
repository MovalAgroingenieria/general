#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<code>tag</code> must match the \"Nombre\" of a <code>Tag</code> entry returned by the device's <code>/api/elementos</code> response."
msgstr "La etiqueta <code>tag</code> debe coincidir con el “Nombre” de una entrada <code>Tag</code> devuelta por la respuesta del dispositivo en <code>/api/elementos</code>."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<em>Get Token</em> calls <code>/token</code> using form data (<code>grant_type=password</code>) and stores <code>bag[\"token\"]</code> (Bearer access token)."
msgstr "<em>Obtener Token</em> llama a <code>/token</code> usando datos de formulario (<code>grant_type=password</code>) y guarda <code>bag[\"token\"]</code> (token de acceso Bearer)."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<em>Get devices (plan)</em> and <em>Get pressure devices (plan)</em> compute <code>initial_date</code> for each sensor:\n"
"    last stored reading → else <code>sensor.start_date</code> → else <code>device.start_date</code> → else Jan 1 of current year."
msgstr "<em>Obtener dispositivos (plan)</em> calcula <code>initial_date</code> para cada sensor:\n"
"    última lectura almacenada → si no, <code>sensor.start_date</code> → si no, <code>device.start_date</code> → si no, 1 de enero del año actual."

#. module: remotecontrol_batchline
#: model:remotecontrol,remotecontrol_help:remotecontrol_batchline.remotecontrol_batchline
msgid "<em>Get devices (plan)</em> and <em>Get readings</em> send <code>Authorization: Bearer &lt;token&gt;</code> in headers."
msgstr "<em>Obtener dispositivos (plan)</em> y <em>Obtener lecturas</em> envían <code>Authorization: Bearer &lt;token&gt;</code> en las cabeceras."

