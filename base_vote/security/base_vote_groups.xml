<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_base_vote" model="ir.module.category">
        <field name="name">Base Vote</field>
        <field name="description">Vote configuration and operations</field>
    </record>

    <record id="group_vote_user" model="res.groups">
        <field name="name">Vote User</field>
        <field name="category_id" ref="base_vote.module_category_base_vote"/>
    </record>

    <record id="group_vote_manager" model="res.groups">
        <field name="name">Vote Manager</field>
        <field name="category_id" ref="base_vote.module_category_base_vote"/>
        <field name="implied_ids" eval="[(4, ref('base_vote.group_vote_user'))]"/>
    </record>

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('base_vote.group_vote_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('base_vote.group_vote_manager'))]"/>
    </record>
</odoo>
