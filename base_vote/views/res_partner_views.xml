<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.vote</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Votes" name="votes">
                    <field name="total_votes_display" readonly="1"/>
                    <button name="action_recompute_my_votes" string="Recompute my votes" type="object" class="btn-link"/>
                    <field name="partner_vote_ids" readonly="1" nolabel="1" domain="[('vote_type_id.active','=',True)]"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
