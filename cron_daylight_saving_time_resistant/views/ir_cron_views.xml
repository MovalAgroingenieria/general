<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_view_daylight_resistant" model="ir.ui.view">
        <field name="name">ir.cron.form.daylight.saving.resistant</field>
        <field name="model">ir.cron</field>
        <field name="inherit_id" ref="base.ir_cron_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='priority']" position="after">
                <field name="daylight_saving_time_resistant"/>
            </xpath>
        </field>
    </record>
</odoo>
