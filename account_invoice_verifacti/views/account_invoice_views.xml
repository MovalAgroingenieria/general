<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_invoice_form_verifacti" model="ir.ui.view">
        <field name="name">account.invoice.form.verifacti</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_form"/>
        <field name="arch" type="xml">
            <!-- Add computed field (invisible) for attrs evaluation -->
            <xpath expr="//field[@name='type']" position="after">
                <field name="verifacti_journal_enabled" invisible="1"/>
                <field name="verifacti_state" invisible="1"/>
            </xpath>

            <!-- Replace cancel button for invoices (group_no_one) to hide it when invoice has been sent to Verifacti -->
            <xpath expr="//button[@name='action_invoice_cancel'][@groups='base.group_no_one']" position="replace">
                <button name="action_invoice_cancel" type="object" states="draft,proforma2,open" string="Cancel Invoice" groups="base.group_no_one" attrs="{'invisible': ['&amp;', ('verifacti_journal_enabled', '=', True), ('verifacti_state', '=', 'sent')]}"/>
            </xpath>

            <!-- Add Verifacti page in notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Verifacti" attrs="{'invisible': ['|', ('type', 'not in', ['out_invoice', 'out_refund']), ('verifacti_journal_enabled', '=', False)]}">
                    <group>
                        <group string="Verifactu Status">
                            <field name="verifacti_state"/>
                            <field name="verifacti_id" attrs="{'invisible': [('verifacti_id', '=', False)]}"/>
                        </group>
                        <group string="QR Code">
                            <field name="verifacti_qr_code" widget="image" attrs="{'invisible': [('verifacti_qr_code', '=', False)]}"/>
                            <field name="verifacti_url" widget="url" string="Ver en Verifacti" attrs="{'invisible': [('verifacti_url', '=', False)]}"/>
                        </group>
                    </group>
                    <separator string="Transaction Logs"/>
                    <field name="verifacti_log_ids" readonly="1" nolabel="1">
                        <tree>
                            <field name="create_date"/>
                            <field name="state"/>
                            <field name="verifacti_id"/>
                            <field name="error_message"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
