<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Verifacti field to journal form view -->
    <record id="view_account_journal_form_verifacti" model="ir.ui.view">
        <field name="name">account.journal.form.verifacti</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence_id']" position="after">
                <field name="verifacti_enabled" attrs="{'invisible': [('type', '!=', 'sale')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
