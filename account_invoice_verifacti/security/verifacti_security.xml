<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="verifacti_config_company_rule" model="ir.rule">
        <field name="name">Verifacti Config: multi-company</field>
        <field name="model_id" ref="model_verifacti_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="verifacti_nif_company_rule" model="ir.rule">
        <field name="name">Verifacti NIF: multi-company</field>
        <field name="model_id" ref="model_verifacti_nif"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="verifacti_log_company_rule" model="ir.rule">
        <field name="name">Verifacti Log: multi-company</field>
        <field name="model_id" ref="model_verifacti_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', user.company_ids.ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
