<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="worker_activity_self_monitoring.TaskIcon" owl="1">
        <li class="o_systray_task_icon" t-on-click="navigateToTask">
            <div class="d-flex align-items-center">
                <i t-if="state.taskRunning" class="fa fa-tasks icon-with-background task-active" title="Ver tarea actual" />
                <i t-else="state.taskRunning" class="fa fa-tasks icon-with-background task-inactive" title="Ver tareas" />
                <span t-if="state.taskRunning" class="task-name text-white">
                    <t t-esc="state.taskName" />
                </span>
            </div>
        </li>
    </t>
</templates>