<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_deca_revise_form" model="ir.ui.view">
        <field name="name">deca.revise.form</field>
        <field name="model">deca.revise</field>
        <field name="arch" type="xml">
            <form>
                <field name="deca_id" invisible="1" />
                <group>
                    <field name="reason" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm Revision"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
