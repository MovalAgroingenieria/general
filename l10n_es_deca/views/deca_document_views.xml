<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_deca_document_form" model="ir.ui.view">
        <field name="name">deca.document.form</field>
        <field name="model">deca.document</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_issue"
                        type="object"
                        string="Issue"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_print_report"
                        type="object"
                        string="Print DECA"
                        invisible="state != 'issued'"
                    />
                    <button
                        name="action_open_revise_wizard"
                        type="object"
                        string="Revise"
                        invisible="state != 'issued'"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state == 'cancelled'"
                        groups="l10n_es_deca.group_deca_manager"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_versions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-history"
                            invisible="version_count == 0"
                        >
                            <field
                                name="version_count"
                                widget="statinfo"
                                string="Versions"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Transport">
                            <field name="transport_date" readonly="state != 'draft'" />
                            <field name="origin" readonly="state != 'draft'" />
                            <field name="destination" readonly="state != 'draft'" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group string="Vehicle">
                            <field name="vehicle_plate" readonly="state != 'draft'" />
                            <field name="trailer_plate" readonly="state != 'draft'" />
                            <field
                                name="special_authorization"
                                readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                    <group>
                        <group string="Loading Party">
                            <field
                                name="loading_partner_id"
                                readonly="state != 'draft'"
                            />
                            <field name="loading_name" readonly="state != 'draft'" />
                            <field name="loading_vat" readonly="state != 'draft'" />
                            <field name="loading_address" readonly="state != 'draft'" />
                        </group>
                        <group string="Effective Carrier">
                            <field
                                name="carrier_partner_id"
                                readonly="state != 'draft'"
                            />
                            <field name="carrier_name" readonly="state != 'draft'" />
                            <field name="carrier_vat" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <group>
                        <group string="Goods">
                            <field name="goods_description" readonly="state != 'draft'" />
                            <field name="weight_kg" readonly="state != 'draft'" />
                            <field
                                name="alternative_measure"
                                readonly="state != 'draft'"
                            />
                        </group>
                        <group string="Driver">
                            <field
                                name="driver_partner_id"
                                readonly="state != 'draft'"
                            />
                            <field name="driver_name" readonly="state != 'draft'" />
                            <field name="driver_vat" readonly="state != 'draft'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Goods Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name" />
                                    <field name="quantity" />
                                    <field name="uom_name" />
                                    <field name="weight_kg" />
                                </list>
                            </field>
                        </page>
                        <page string="Observations" name="observations">
                            <field name="observations" readonly="state != 'draft'" />
                        </page>
                        <page
                            string="Public Access"
                            name="public_access"
                            invisible="state != 'issued'"
                        >
                            <group>
                                <field name="public_url" widget="url" readonly="1" />
                                <field name="issued_date" readonly="1" />
                                <field
                                    name="qr_image"
                                    widget="image"
                                    options="{'size': [120, 120]}"
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_deca_document_list" model="ir.ui.view">
        <field name="name">deca.document.list</field>
        <field name="model">deca.document</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="transport_date" />
                <field name="origin" />
                <field name="destination" />
                <field name="vehicle_plate" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_deca_document_search" model="ir.ui.view">
        <field name="name">deca.document.search</field>
        <field name="model">deca.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="origin" />
                <field name="destination" />
                <field name="vehicle_plate" />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_issued"
                    string="Issued"
                    domain="[('state', '=', 'issued')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_deca_document" model="ir.actions.act_window">
        <field name="name">DECA</field>
        <field name="res_model">deca.document</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
