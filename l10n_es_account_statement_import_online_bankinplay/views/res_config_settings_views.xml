<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bankinplay</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Insert into the Bank & Cash section (current form) -->
            <xpath expr="//form" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box"
                     id="bankinplay_integration_setting"
                     title="BankInPlay integration.">
                    <div class="o_setting_left_pane">
                        <field name="bankinplay_integration"/>
                    </div>

                    <div class="o_setting_right_pane">
                        <label for="bankinplay_integration">BankInPlay Integration</label>
                        <div class="text-muted">
                            Import account bank statements using BankInPlay services.
                        </div>

                        <!-- Callback base URL -->
                        <div class="content-group">
                            <attribute name="modifiers">{"invisible": [["bankinplay_integration","=",false]]}
                            </attribute>
                            <div class="mt16">
                                <label for="bankinplay_integration_url_for_callback" class="o_light_label">Callback
                                    URL:
                                </label>
                                <field name="bankinplay_integration_url_for_callback" class="oe_inline"/>
                                <span>/webhook/bankinplay_callback</span>
                            </div>
                        </div>

                        <!-- API Key -->
                        <div class="content-group">
                            <attribute name="modifiers">{"invisible": [["bankinplay_integration","=",false]]}
                            </attribute>
                            <div class="mt16">
                                <label for="bankinplay_integration_api_key" class="o_light_label">API Key:</label>
                                <field name="bankinplay_integration_api_key" password="True" class="oe_inline"/>
                            </div>
                        </div>

                        <!-- API Secret -->
                        <div class="content-group">
                            <attribute name="modifiers">{"invisible": [["bankinplay_integration","=",false]]}
                            </attribute>
                            <div class="mt16">
                                <label for="bankinplay_integration_api_secret" class="o_light_label">API Secret:</label>
                                <field name="bankinplay_integration_api_secret" password="True" class="oe_inline"/>
                            </div>
                        </div>

                        <!-- Register button -->
                        <button name="register_bankinplay_callbacks"
                                type="object"
                                string="Register Callbacks"
                                class="btn-primary">
                            <attribute name="modifiers">{"invisible": [["bankinplay_integration","=",false]]}
                            </attribute>
                        </button>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
