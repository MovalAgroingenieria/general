#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>ChartType</code>: Metric identifier"
msgstr "<code>ChartType</code>: Identificador de métrica"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>EndDate</code>: Epoch timestamp in milliseconds"
msgstr "<code>EndDate</code>: Timestamp Epoch en milisegundos"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>StartDate</code>: Epoch timestamp in milliseconds"
msgstr "<code>StartDate</code>: Timestamp Epoch en milisegundos"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>atlas_element_id</code>: Sensor identifier within the Atlas device"
msgstr "<code>atlas_element_id</code>: Identificador de sensor dentro del dispositivo Atlas"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>chart_type</code>: Metric type identifier"
msgstr "<code>chart_type</code>: Identificador de tipo de métrica"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>data_array_index</code>: Index of the variable array (0=first variable like humidity, 1=second variable like temperature)"
msgstr "<code>data_array_index</code>: Índice del array de variables (0=primera variable como humedad, 1=segunda variable como temperatura)"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>data_type</code>: Type of data field (sensor_data, flow_rate_data, accumulated_flow_data, output_data, digital_input_data)"
msgstr "<code>data_type</code>: Tipo de campo de datos (sensor_data, flow_rate_data, accumulated_flow_data, output_data, digital_input_data)"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>imei</code>: Atlas device identifier"
msgstr "<code>imei</code>: Identificador de dispositivo Atlas"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>start_date</code>: Default start date for data retrieval"
msgstr "<code>start_date</code>: Fecha de inicio predeterminada para obtención de datos"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>start_date</code>: Overrides device start date if provided"
msgstr "<code>start_date</code>: Sobrescribe la fecha de inicio del dispositivo si se proporciona"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>system_id</code>: Spherag system identifier"
msgstr "<code>system_id</code>: Identificador de sistema Spherag"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<code>value_index</code>: Position within the value array (0=10cm depth, 1=20cm depth, etc.)"
msgstr "<code>value_index</code>: Posición dentro del array de valores (0=profundidad 10cm, 1=profundidad 20cm, etc.)"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<em>Get Token</em> → performs <code>POST /Authentication/Login</code> and stores <code>bag[\"access_token\"]</code>."
msgstr "<em>Obtener Token</em> → ejecuta <code>POST /Authentication/Login</code> y almacena <code>bag[\"access_token\"]</code>."

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<strong>Data Types:</strong> sensorData, flowRateData, accumulatedFlowData, outputData, digitalInputData"
msgstr "<strong>Tipos de Datos:</strong> sensorData, flowRateData, accumulatedFlowData, outputData, digitalInputData"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<strong>Headers:</strong> <code>Authorization: Bearer {access_token}</code>"
msgstr "<strong>Cabeceras:</strong> <code>Authorization: Bearer {access_token}</code>"

#. module: remotecontrol_spherag
#: model:remotecontrol,remotecontrol_help:remotecontrol_spherag.remotecontrol_spherag
msgid "<strong>Important:</strong> Token is NOT persisted. Each execution requires a new login."
msgstr "<strong>Importante:</strong> El Token NO se persiste. Cada ejecución requiere un nuevo login."

