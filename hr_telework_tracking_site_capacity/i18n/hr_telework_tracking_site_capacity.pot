#. module: hr_telework_tracking_site_capacity
#: model:mail.template,body_html:hr_telework_tracking_site_capacity.mail_employee_weekly_assignments
msgid ""
"\n"
"        <div style=\"font-family: Arial, sans-serif; max-width: 800px; margin: 0 auto;\">\n"
"          <h2 style=\"color: #2c3e50;\">Asignaciones Confirmadas</h2>\n"
"          <p>Hola <strong>${employee_name}</strong>,</p>\n"
"          <p>Se han confirmado tus asignaciones de teletrabajo para la semana del <strong>${week_start}</strong> al <strong>${week_end}</strong>.</p>\n"
"          \n"
"          <h3 style=\"color: #34495e; margin-top: 20px;\">Tu planificación semanal:</h3>\n"
"          <table style=\"width: 100%; border-collapse: collapse; margin: 20px 0;\">\n"
"            <thead>\n"
"              <tr style=\"background-color: #3498db; color: white;\">\n"
"                <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd;\">Fecha</th>\n"
"                <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd;\">Día</th>\n"
"                <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd;\">Modo</th>\n"
"                <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd;\">Puesto</th>\n"
"              </tr>\n"
"            </thead>\n"
"            <tbody>\n"
"              ${assignments_table}\n"
"            </tbody>\n"
"          </table>\n"
"          \n"
"          <p style=\"margin-top: 20px;\">Adjunto encontrarás el informe completo de asignaciones de la oficina.</p>\n"
"          \n"
"          <p style=\"margin-top: 30px; color: #7f8c8d; font-size: 12px;\">\n"
"            Si tienes alguna duda o necesitas realizar cambios, contacta con tu responsable o el departamento de RRHH.\n"
"          </p>\n"
"        </div>\n"
"      "
msgstr ""

