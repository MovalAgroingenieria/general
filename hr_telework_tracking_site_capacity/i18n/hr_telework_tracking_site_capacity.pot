#. module: hr_telework_tracking_site_capacity
#: model:mail.template,body_html:hr_telework_tracking_site_capacity.mail_telework_overbooked
msgid ""
"\n"
"        <p>Se ha confirmado un registro <b>presencial</b> que supera la capacidad configurada.</p>\n"
"        <ul>\n"
"          <li>Empleado: ${object.employee_id.name}</li>\n"
