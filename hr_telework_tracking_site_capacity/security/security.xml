<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Category for telework with unique selection -->
    <record id="module_category_telework" model="ir.module.category">
      <field name="name">Telework</field>
      <field name="description">Telework management and workstation assignment</field>
      <field name="sequence">16</field>
      <field name="exclusive" eval="True"/>
    </record>

    <!-- Group for telework users -->
    <record id="group_telework_user" model="res.groups">
      <field name="name">User</field>
      <field name="category_id" ref="module_category_telework"/>
      <field name="comment">Can view and edit their own telework declarations</field>
    </record>

    <!-- Group for telework managers -->
    <record id="group_telework_manager" model="res.groups">
      <field name="name">Manager</field>
      <field name="category_id" ref="module_category_telework"/>
      <field name="implied_ids" eval="[(4, ref('group_telework_user'))]"/>
      <field name="comment">Full access to telework module, including configuration and management of all users</field>
    </record>
  </data>

  <!-- Record Rules -->
  <data>
    <!-- Telework User: Only sees own declarations -->
    <record id="rule_telework_day_user_own" model="ir.rule">
      <field name="name">Telework Declarations: User - Own Only</field>
      <field name="model_id" ref="model_hr_telework_day"/>
      <field name="groups" eval="[(4, ref('group_telework_user'))]"/>
      <field name="domain_force">[("employee_id.user_id","=",user.id)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Telework User: Can only edit own draft declarations -->
    <record id="rule_telework_day_user_edit_draft" model="ir.rule">
      <field name="name">Telework Declarations: User - Edit own drafts only</field>
      <field name="model_id" ref="model_hr_telework_day"/>
      <field name="groups" eval="[(4, ref('group_telework_user'))]"/>
      <field name="domain_force">[("employee_id.user_id","=",user.id), ("state","in",["draft","pending_review"])]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Telework Manager: Sees all declarations -->
    <record id="rule_telework_day_manager_all" model="ir.rule">
      <field name="name">Telework Declarations: Manager - All</field>
      <field name="model_id" ref="model_hr_telework_day"/>
      <field name="groups" eval="[(4, ref('group_telework_manager'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <!-- HR Manager: Sees records from their department -->
    <record id="rule_telework_day_hr_manager" model="ir.rule">
      <field name="name">Telework Declarations: HR Manager - Department</field>
      <field name="model_id" ref="model_hr_telework_day"/>
      <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
      <field name="domain_force">[("department_id.manager_id.user_id","=",user.id)]</field>
    </record>

    <!-- Telework User: Can only edit draft declarations -->
    <record id="rule_telework_day_user_edit" model="ir.rule">
      <field name="name">Telework Declarations: User - Edit own drafts only</field>
      <field name="model_id" ref="model_hr_telework_day"/>
      <field name="groups" eval="[(4, ref('group_telework_user'))]"/>
      <field name="domain_force">[("employee_id.user_id","=",user.id), ("state","in",["draft","pending_review"])]</field>
      <field name="perm_read" eval="False"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="True"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rules for Offices - Only managers can modify -->
    <record id="rule_office_location_manager" model="ir.rule">
      <field name="name">Offices: Only managers can administer</field>
      <field name="model_id" ref="model_office_location"/>
      <field name="groups" eval="[(4, ref('group_telework_manager'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <!-- Rules for Workstations - Only managers can modify -->
    <record id="rule_office_workstation_manager" model="ir.rule">
      <field name="name">Workstations: Only managers can administer</field>
      <field name="model_id" ref="model_office_workstation"/>
      <field name="groups" eval="[(4, ref('group_telework_manager'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
    </record>

    <!-- Users can view offices and workstations (read-only) -->
    <record id="rule_office_location_user_read" model="ir.rule">
      <field name="name">Offices: Users - Read only</field>
      <field name="model_id" ref="model_office_location"/>
      <field name="groups" eval="[(4, ref('group_telework_user'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_office_workstation_user_read" model="ir.rule">
      <field name="name">Workstations: Users - Read only</field>
      <field name="model_id" ref="model_office_workstation"/>
      <field name="groups" eval="[(4, ref('group_telework_user'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="False"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Rules for employees - Managers can edit telework preferences -->
    <record id="rule_hr_employee_manager_telework" model="ir.rule">
      <field name="name">Employees: Manager can edit telework preferences</field>
      <field name="model_id" ref="hr.model_hr_employee"/>
      <field name="groups" eval="[(4, ref('group_telework_manager'))]"/>
      <field name="domain_force">[(1,'=',1)]</field>
      <field name="perm_read" eval="True"/>
      <field name="perm_write" eval="True"/>
      <field name="perm_create" eval="False"/>
      <field name="perm_unlink" eval="False"/>
    </record>
  </data>
</odoo>
