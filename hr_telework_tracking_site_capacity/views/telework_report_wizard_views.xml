<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Telework report wizard view -->
  <record id="view_telework_report_wizard_form" model="ir.ui.view">
    <field name="name">telework.report.wizard.form</field>
    <field name="model">telework.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Telework Assignments Report">
        <group>
          <group string="Period">
            <field name="date_from"/>
            <field name="date_to"/>
          </group>
          <group string="Filters">
            <field name="office_ids" widget="many2many_tags"
                   options="{'no_create': True, 'no_open': True}"/>
          </group>
        </group>
        <footer>
          <button
              name="action_generate_report"
              string="Generate Report"
              type="object"
              class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- Wizard action -->
  <record id="action_telework_report_wizard" model="ir.actions.act_window">
    <field name="name">Assignments Report</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">telework.report.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</odoo>
