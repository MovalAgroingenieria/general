<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_bulk_preferences_wizard_form" model="ir.ui.view">
    <field name="name">hr.telework.bulk.preferences.wizard.form</field>
    <field name="model">hr.telework.bulk.preferences.wizard</field>
    <field name="arch" type="xml">
      <form string="Preferences massive configuration">
        <sheet>
          <group>
            <field name="employee_ids" widget="many2many_tags" placeholder="Select employees..."/>
          </group>

          <group string="General Configuration">
            <group>
              <field name="auto_generate_week"/>
            </group>
          </group>

          <group string="Daily Preferences">
            <group>
              <field name="monday_preference"/>
              <field name="tuesday_preference"/>
              <field name="wednesday_preference"/>
            </group>
            <group>
              <field name="thursday_preference"/>
              <field name="friday_preference"/>
            </group>
          </group>

          <group string="Generation Options">
            <field name="generate_current_week"/>
          </group>

        </sheet>

        <footer>
          <button name="action_apply_preferences" type="object"
                  string="Apply and Generate" class="btn-primary"
                  help="Save preferences and generate schedules"/>
          <button name="action_only_save_preferences" type="object"
                  string="Only Save Preferences" class="btn-secondary"
                  help="Save preferences without generating schedules"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_weekly_generation_wizard_form" model="ir.ui.view">
    <field name="name">hr.telework.weekly.generation.wizard.form</field>
    <field name="model">hr.telework.weekly.generation.wizard</field>
    <field name="arch" type="xml">
      <form string="Mass Weekly Generation">
        <sheet>
          <group>
            <field name="employee_ids" widget="many2many_tags" placeholder="Employees (empty = all with auto-generation)"/>
          </group>

          <group string="Generation Configuration">
            <group>
              <field name="start_date"/>
              <field name="weeks_count"/>
            </group>
            <group>
              <field name="override_existing"/>
            </group>
          </group>

          <div class="alert alert-warning" role="alert" attrs="{'invisible': [('override_existing', '=', False)]}">
            <p><strong>Warning!</strong> You have checked "Override Existing".</p>
            <p>This will delete existing schedules and replace them with new ones based on the current preferences.</p>
          </div>

        </sheet>

        <footer>
          <button name="action_generate_weeks" type="object"
                  string="Generate" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_bulk_preferences_wizard" model="ir.actions.act_window">
    <field name="name">Configure Mass Preferences</field>
    <field name="res_model">hr.telework.bulk.preferences.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="hr.model_hr_employee"/>
    <field name="binding_view_types">list</field>
  </record>

  <record id="action_weekly_generation_wizard" model="ir.actions.act_window">
    <field name="name">Generate Weekly Schedules</field>
    <field name="res_model">hr.telework.weekly.generation.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="context">{}</field>
  </record>

</odoo>
