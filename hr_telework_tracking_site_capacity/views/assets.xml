<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="telework_assets" name="Telework Assets">
        <script type="text/javascript" src="/hr_telework_tracking_site_capacity/static/src/js/telework_list_view.js"/>
        <link rel="stylesheet" href="/hr_telework_tracking_site_capacity/static/src/css/telework_groups.css"/>
    </template>

    <template id="assets_backend_telework" inherit_id="web.assets_backend" optional="enabled">
        <xpath expr="." position="inside">
            <t t-call="hr_telework_tracking_site_capacity.telework_assets"/>
        </xpath>
    </template>

    <template id="assets_web_telework" inherit_id="web.assets_web" optional="enabled">
        <xpath expr="." position="inside">
            <t t-call="hr_telework_tracking_site_capacity.telework_assets"/>
        </xpath>
    </template>
</odoo>
