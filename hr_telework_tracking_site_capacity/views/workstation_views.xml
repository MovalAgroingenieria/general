<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_office_workstation_tree" model="ir.ui.view">
        <field name="name">office.workstation.tree</field>
        <field name="model">office.workstation</field>
        <field name="arch" type="xml">
            <tree string="Workstations" editable="top"
                  decoration-danger="is_occupied">
                <field name="name"/>
                <field name="office_id" readonly="1"/>
                <field name="active" invisible="1"/>
                <field name="is_occupied" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_office_workstation_search" model="ir.ui.view">
        <field name="name">office.workstation.search</field>
        <field name="model">office.workstation</field>
        <field name="arch" type="xml">
            <search string="Workstations">
                <field name="name"/>
                <field name="office_id"/>
                <field name="department_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Office" name="group_office" context="{'group_by': 'office_id'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_office_workstation_form" model="ir.ui.view">
        <field name="name">office.workstation.form</field>
        <field name="model">office.workstation</field>
        <field name="arch" type="xml">
            <form string="Workstation">
                <header>
                    <button name="action_view_declarations" type="object"
                            string="View Declarations" class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="office_id"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_office_workstation" model="ir.actions.act_window">
        <field name="name">Workstations</field>
        <field name="res_model">office.workstation</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Workstations are automatically created from offices
            </p>
            <p>
                Each workstation can be assigned to a specific department
                and have employees with preferences towards it.
            </p>
        </field>
    </record>

</odoo>
