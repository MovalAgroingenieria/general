<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_hr_employee_telework_preferences_form" model="ir.ui.view">
    <field name="name">hr.employee.telework.preferences.form</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='personal_information']" position="after">
        <page string="Telework Preferences" name="telework_preferences">
          <div class="o_settings_container">
          <group>
            <group string="Automatic Configuration">
              <field name="auto_generate_week"/>
            </group>
          </group>

          <group string="Daily Preferences">
            <group>
              <field name="monday_preference"/>
              <field name="tuesday_preference"/>
              <field name="wednesday_preference"/>
            </group>
            <group>
              <field name="thursday_preference"/>
              <field name="friday_preference"/>
            </group>
          </group>

          <group string="Workstation Preferences">
            <group>
              <field name="primary_workstation_id"/>
            </group>
            <group>
              <field name="preferred_workstation_ids" widget="many2many_tags"/>
            </group>
          </group>
          </div>
        </page>
      </xpath>
    </field>
  </record>

  <!-- Preference action for the current employee -->
  <record id="action_my_telework_preferences" model="ir.actions.act_window">
    <field name="name">My Telework Preferences</field>
    <field name="res_model">hr.employee</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="hr.view_employee_form"/>
    <field name="target">current</field>
    <field name="context">{'form_view_initial_mode': 'edit', 'default_page': 'telework_preferences'}</field>
    <field name="domain">[('user_id', '=', uid)]</field>
  </record>

  <!-- Menu item for personal preferences -->
  <menuitem id="menu_my_telework_preferences"
            name="My Telework Preferences"
            parent="hr.menu_hr_employee_payroll"
            action="action_my_telework_preferences"
            sequence="10"/>

  <!-- Action for managers: view employees with preferences -->
  <record id="action_employees_telework_preferences" model="ir.actions.act_window">
    <field name="name">Employee Telework Preferences</field>
    <field name="res_model">hr.employee</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{'search_default_my_team': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Configure employee telework preferences
      </p>
      <p>
        Here you can view and configure your team's telework preferences.
        Preferences are used to automatically generate the weekly schedule.
      </p>
    </field>
  </record>

  <!-- Tree view for employee telework preferences -->
  <record id="view_hr_employee_telework_preferences_tree" model="ir.ui.view">
    <field name="name">hr.employee.telework.preferences.tree</field>
    <field name="model">hr.employee</field>
    <field name="arch" type="xml">
      <tree string="Employee Telework Preferences" default_order="department_id,name">
        <field name="name"/>
        <field name="department_id"/>
        <field name="auto_generate_week" widget="boolean_toggle"/>
        <field name="monday_preference"/>
        <field name="tuesday_preference"/>
        <field name="wednesday_preference"/>
        <field name="thursday_preference"/>
        <field name="friday_preference"/>
      </tree>
    </field>
  </record>

  <!-- Menu item for team preferences -->
  <menuitem id="menu_employees_telework_preferences"
            name="Team Preferences"
            parent="hr.menu_hr_employee_payroll"
            action="action_employees_telework_preferences"
            sequence="15"
            groups="hr.group_hr_manager,hr_telework_tracking_site_capacity.group_telework_manager"/>

  <!-- Tree view for employee telework preferences -->
  <record id="view_hr_employee_telework_tree" model="ir.ui.view">
    <field name="name">hr.employee.telework.preferences.tree</field>
    <field name="model">hr.employee</field>
    <field name="arch" type="xml">
      <tree string="Employee Telework Preferences" editable="top" default_order="department_id,name">
        <field name="name"/>
        <field name="company_id" invisible="1"/>
        <field name="department_id"/>
        <field name="primary_workstation_id"/>
        <field name="auto_generate_week"/>
        <field name="monday_preference"/>
        <field name="tuesday_preference"/>
        <field name="wednesday_preference"/>
        <field name="thursday_preference"/>
        <field name="friday_preference"/>
      </tree>
    </field>
  </record>

  <!-- Action for menu view of employee preferences -->
  <record id="action_hr_employee_preferences" model="ir.actions.act_window">
    <field name="name">Employee Preferences</field>
    <field name="res_model">hr.employee</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_hr_employee_telework_tree"/>
    <field name="target">current</field>
    <field name="domain">[('active', '=', True)]</field>
    <field name="context">{
      'default_auto_generate_week': True,
      'search_default_my_team': False,
    }</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Configure employee telework preferences
      </p>
      <p>
        Here you can view and configure the telework preferences of all employees.
        Preferences are used to automatically generate the weekly schedule.
      </p>
    </field>
  </record>

</odoo>
