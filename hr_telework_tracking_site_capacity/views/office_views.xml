<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_office_location_tree" model="ir.ui.view">
        <field name="name">office.location.tree</field>
        <field name="model">office.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="capacity"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_office_location_form" model="ir.ui.view">
        <field name="name">office.location.form</field>
        <field name="model">office.location</field>
        <field name="arch" type="xml">
            <form string="Office Location">
                <header>
                    <button name="action_create_workstations" type="object"
                            string="Create Workstations" class="btn-primary"/>
                    <button name="action_view_workstations" type="object"
                            string="View Workstations" class="btn-secondary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="image" widget="image" class="oe_avatar"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Workstations" name="workstations">
                            <field name="workstation_ids" nolabel="1"
                                   options="{'no_create': true, 'no_edit': true}">
                                <tree create="false" edit="false">
                                    <field name="name"/>
                                    <field name="department_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Telework Reviewers" name="reviewers">
                            <group>
                                <field name="reviewer_ids" widget="many2many_tags"
                                       placeholder="Select reviewer employees..."/>
                            </group>
                            <div class="o_form_label text-muted">
                                Reviewers will receive email notifications when there are
                                pending telework assignments for review in this office.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_office_location" model="ir.actions.act_window">
        <field name="name">Offices</field>
        <field name="res_model">office.location</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new office
            </p>
            <p>
                Offices contain workstations for employees.
                Define the total capacity of workstations that can be created.
            </p>
        </field>
    </record>

</odoo>
