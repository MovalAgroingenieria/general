<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_weekly_telework_declaration_form" model="ir.ui.view">
    <field name="name">weekly.telework.declaration.form</field>
    <field name="model">weekly.telework.declaration</field>
    <field name="arch" type="xml">
      <form string="Weekly Telework Declaration">
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="employee_id" options="{'no_create': True}" placeholder="Select employee..."/>
            </h1>
          </div>
          <group>
            <field name="week_start_date" string="Week of"/>
          </group>
          <group>
            <group string="Days">
              <label for="monday_mode" string="Monday"/>
              <field name="monday_mode" nolabel="1" widget="radio" options="{'horizontal': true}"/>

              <label for="tuesday_mode" string="Tuesday"/>
              <field name="tuesday_mode" nolabel="1" widget="radio" options="{'horizontal': true}"/>

              <label for="wednesday_mode" string="Wednesday"/>
              <field name="wednesday_mode" nolabel="1" widget="radio" options="{'horizontal': true}"/>

              <label for="thursday_mode" string="Thursday"/>
              <field name="thursday_mode" nolabel="1" widget="radio" options="{'horizontal': true}"/>

              <label for="friday_mode" string="Friday"/>
              <field name="friday_mode" nolabel="1" widget="radio" options="{'horizontal': true}"/>
            </group>
          </group>
        </sheet>
        <footer>
          <button string="Create Declarations" name="action_create_declarations" type="object" class="oe_highlight"/>
          <button string="Cancel" class="oe_link" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_weekly_telework_declaration" model="ir.actions.act_window">
    <field name="name">Weekly Declaration</field>
    <field name="res_model">weekly.telework.declaration</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

</odoo>
