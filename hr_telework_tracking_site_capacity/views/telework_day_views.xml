<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_hr_telework_day_tree" model="ir.ui.view">
    <field name="name">hr.telework.day.tree</field>
    <field name="model">hr.telework.day</field>
    <field name="priority">1</field>
    <field name="arch" type="xml">
  <tree decoration-info="state=='draft'"
    decoration-muted="state=='confirmed'"
    decoration-warning="has_workstation_conflict==True"
    decoration-danger="state=='pending_review'"
            default_order="date desc,employee_id"
            edit="true"
            create="true"
            delete="true">

        <field name="employee_id" string="Employee" options="{'no_create': True}"/>
        <field name="department_id" string="Department" readonly="1"/>
        <field name="state" string="State"/>

        <field name="mode" string="Work Mode" widget="telework_mode"/>

        <field name="workstation_id" string="Workstation"
               attrs="{'invisible': [('mode', '=', 'remote')], 'required': [('mode', '=', 'onsite')]}"
               options="{'no_create': True, 'no_quick_create': True}"
               context="{'show_address': False, 'date_context': date}"/>

        <field name="office_id" string="Office" optional="show"/>

        <field name="has_workstation_conflict" invisible="1"/>

        <field name="date" string="Date"/>

        <field name="total_availability" string="Availability" readonly="1"
               decoration-success="total_status_color=='green'"
               decoration-warning="total_status_color=='yellow'"
               decoration-danger="total_status_color=='red'"/>

        <field name="office_daily_availability" string="Office Avail." optional="hide"/>

        <field name="total_status_color" invisible="1"/>
        <field name="mode_icon" invisible="1"/>
      </tree>
    </field>
  </record>

  <record id="view_hr_telework_day_form" model="ir.ui.view">
    <field name="name">hr.telework.day.form</field>
    <field name="model">hr.telework.day</field>
    <field name="arch" type="xml">
      <form string="Work Mode Declaration">
        <header>
          <button
              name="action_confirm"
              type="object"
              string="Confirm"
              states="draft,pending_review"
              groups="hr_telework_tracking_site_capacity.group_telework_manager,hr.group_hr_manager"
              class="oe_highlight"/>
          <button
              name="action_set_draft"
              type="object"
              string="Set to Draft"
              states="confirmed"
              groups="hr_telework_tracking_site_capacity.group_telework_manager,hr.group_hr_manager"/>
        <field
          name="state"
          widget="statusbar"
          statusbar_visible="draft,pending_review,confirmed"/>
        </header>
        <sheet>
          <div class="alert alert-danger" role="alert"
               attrs="{'invisible': [('total_status_color','!=','red')]}">
            <strong>⚠️ WARNING:</strong> The total company capacity is exceeded for this day.
          </div>
          <group col="4">
            <field name="employee_id" options="{'no_create': True}" colspan="2"/>
            <field name="department_id" colspan="2"/>
            <field name="date" string="Date" colspan="2"/>
            <field name="mode" string="Work Mode" widget="telework_mode" colspan="2"/>
            <field name="workstation_id" string="Workstation" colspan="2"
                   attrs="{'invisible': [('mode', '=', 'remote')], 'required': [('mode', '=', 'onsite')]}"
                   options="{'no_create': True, 'no_quick_create': True}"
                   context="{'show_address': False, 'date_context': date}"/>
            <field name="office_id" string="Office" colspan="2" readonly="1" attrs="{'invisible': [('mode', '=', 'remote')]}"/>
            <field name="create_date" readonly="1" colspan="2"/>
          </group>

          <notebook attrs="{'invisible': [('mode','=','remote')]}">
            <page string="Office Capacity">
              <field name="office_availability" readonly="1" nolabel="1" widget="html"
                      colspan="4" style="border: 1px solid #dee2e6; padding: 15px; border-radius: 5px; background: #f8f9fa;"/>
              <field name="total_status_color" invisible="1"/>
            </page>
          </notebook>

          <div class="alert alert-warning" role="alert"
               attrs="{'invisible': ['|', '|', ('mode','=','remote'), ('has_workstation_conflict','=',False), ('workstation_id','=',False)]}">
            <strong>  WORKSTATION CONFLICT:</strong> This workstation is already occupied by other declarations on the same date.
            <field name="conflicting_declaration_ids" nolabel="1" readonly="1"
                   attrs="{'invisible': [('has_workstation_conflict','=',False)]}"
                   context="{'tree_view_ref': 'hr_telework_tracking_site_capacity.view_conflicting_declarations_tree'}">
              <tree create="false" edit="false" delete="false">
                <field name="employee_id"/>
                <field name="state"/>
                <field name="create_date"/>
              </tree>
            </field>
          </div>

          <group>
            <field name="note" colspan="2" placeholder="Notes about this declaration..."/>
            <field name="total_status_color" invisible="1"/>
            <field name="overbooked" readonly="1" invisible="1"/>
            <field name="has_workstation_conflict" invisible="1"/>
          </group>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div>
      </form>
    </field>
  </record>

  <record id="view_hr_telework_day_search" model="ir.ui.view">
    <field name="name">hr.telework.day.search</field>
    <field name="model">hr.telework.day</field>
    <field name="arch" type="xml">
      <search>
        <field name="date"/>
        <field name="employee_id"/>
        <field name="department_id"/>
        <field name="office_id"/>
        <field name="create_date"/>

        <filter string="Today" name="today"
                domain="[('date','=', context_today())]"/>
        <filter string="This Week" name="this_week"
                domain="[('is_this_week','=', True)]"/>
        <filter string="Next Week" name="next_week"
                domain="[('is_next_week','=', True)]"/>

        <separator/>

        <filter string="My Declarations" name="my_declarations"
                domain="[('employee_id.user_id','=',uid)]"/>

        <separator/>
        <filter string="Onsite" name="onsite" domain="[('mode','=','onsite')]"/>
        <filter string="Remote" name="remote" domain="[('mode','=','remote')]"/>
        <separator/>
        <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
        <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
        <separator/>
        <filter string="Overbooked" name="overbooked" domain="[('overbooked','=',True)]"/>
        <separator/>
        <filter string="Pending Review" name="pending_review" domain="[('state','=','pending_review')]"/>
        <filter string="Needs Workstation" name="needs_workstation"
                domain="[('mode','=','onsite'),('workstation_id','=',False)]"/>

        <group expand="0" string="Group By">
          <filter string="Date" name="group_date" context="{'group_by': 'date:day'}"/>
          <filter string="Week" name="group_week" context="{'group_by': 'date:week'}"/>
          <filter string="Month" name="group_month" context="{'group_by': 'date:month'}"/>
          <separator/>
          <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
          <filter string="Office" name="group_office" context="{'group_by': 'office_id'}"/>
          <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
          <separator/>
          <filter string="Mode" name="group_mode" context="{'group_by': 'mode'}"/>
          <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_hr_telework_day_calendar" model="ir.ui.view">
    <field name="name">hr.telework.day.calendar</field>
    <field name="model">hr.telework.day</field>
    <field name="arch" type="xml">
      <calendar date_start="date" color="mode" string="Telework Calendar">
        <field name="employee_id"/>
        <field name="mode"/>
      </calendar>
    </field>
  </record>

  <record id="view_hr_telework_day_graph" model="ir.ui.view">
    <field name="name">hr.telework.day.graph</field>
    <field name="model">hr.telework.day</field>
    <field name="arch" type="xml">
      <graph string="Telework Analysis" type="bar" stacked="True">
        <field name="date" interval="day"/>
        <field name="mode" type="col"/>
      </graph>
    </field>
  </record>

  <record id="view_hr_telework_day_pivot" model="ir.ui.view">
    <field name="name">hr.telework.day.pivot</field>
    <field name="model">hr.telework.day</field>
    <field name="arch" type="xml">
      <pivot string="Telework Table">
        <field name="office_id" type="row"/>
        <field name="department_id" type="row"/>
        <field name="employee_id" type="row"/>
        <field name="date" interval="day" type="col"/>
        <field name="mode" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="action_telework_day" model="ir.actions.act_window">
    <field name="name">Daily Declarations</field>
    <field name="res_model">hr.telework.day</field>
    <field name="view_mode">tree,form,calendar,graph,pivot</field>
    <field name="context">{
      'group_by': 'date:week',
      'search_default_group_week': 1,
    }</field>
    <field name="domain">[]</field>
  </record>

  <record id="action_server_mass_confirm" model="ir.actions.server">
    <field name="name">Confirm Selected</field>
    <field name="model_id" ref="model_hr_telework_day"/>
    <field name="state">code</field>
    <field name="code">
      for record in records:
          if record.state == 'draft':
              record.action_confirm()
    </field>
    <field name="binding_model_id" ref="model_hr_telework_day"/>
    <field name="binding_view_types">list</field>
  </record>

  <record id="action_server_refresh_availability" model="ir.actions.server">
    <field name="name">Refresh Availability</field>
    <field name="model_id" ref="model_hr_telework_day"/>
    <field name="state">code</field>
    <field name="code">
      records.force_refresh_availability()
    </field>
    <field name="binding_model_id" ref="model_hr_telework_day"/>
    <field name="binding_view_types">list</field>
  </record>

  <record id="action_server_mass_draft" model="ir.actions.server">
    <field name="name">Set to Draft</field>
    <field name="model_id" ref="model_hr_telework_day"/>
    <field name="state">code</field>
    <field name="code">
      for record in records:
          if record.state == 'confirmed':
              record.action_set_draft()
    </field>
    <field name="binding_model_id" ref="model_hr_telework_day"/>
    <field name="binding_view_types">list</field>
  </record>

  <record id="action_server_auto_assign_workstations" model="ir.actions.server">
    <field name="name">Auto Assign Workstations</field>
    <field name="model_id" ref="model_hr_telework_day"/>
    <field name="state">code</field>
    <field name="code">
# Only process draft onsite records without workstation assigned
records_to_process = records.filtered(lambda r: r.state == 'draft' and r.mode == 'onsite' and not r.workstation_id)
total_selected = len(records)
valid_records = len(records_to_process)

if records_to_process:
    records_to_process.action_auto_assign_workstations()
else:
    # Detailed analysis of why records cannot be processed
    draft_count = len(records.filtered(lambda r: r.state == 'draft'))
    onsite_count = len(records.filtered(lambda r: r.mode == 'onsite'))
    no_workstation_count = len(records.filtered(lambda r: not r.workstation_id))

    message = f'No valid records to assign workstations.\n\nAnalysis of {total_selected} selected records:\n• Draft: {draft_count}\n• Onsite mode: {onsite_count}\n• No workstation assigned: {no_workstation_count}\n\nOnly declarations meeting all 3 criteria can be assigned.'

    raise UserError(message)
    </field>
    <field name="binding_model_id" ref="model_hr_telework_day"/>
    <field name="binding_view_types">list</field>
  </record>

  <record id="view_conflicting_declarations_tree" model="ir.ui.view">
    <field name="name">conflicting.declarations.tree</field>
    <field name="model">hr.telework.day</field>
    <field name="arch" type="xml">
      <tree create="false" edit="false" delete="false" decoration-danger="state=='confirmed'">
        <field name="employee_id" string="Employee"/>
        <field name="state" string="State"/>
        <field name="create_date" string="Created"/>
        <button name="edit" type="edit" string="Edit" icon="fa-edit" class="btn-link"/>
      </tree>
    </field>
  </record>

</odoo>