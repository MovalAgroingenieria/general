<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_department_form_inherit_capacity" model="ir.ui.view">
    <field name="name">hr.department.form.inherit.capacity</field>
    <field name="model">hr.department</field>
    <field name="inherit_id" ref="hr.view_department_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/group" position="after">
        <group string="Telework Configuration">
          <field name="default_capacity_full_day"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
