<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Telework Manager Bot User -->
        <record id="user_telework_bot" model="res.users">
            <field name="name">Telework Manager</field>
            <field name="login">telework_manager_bot</field>
            <field name="password">telework_manager_bot_password_change_me</field>
            <field name="active">True</field>
            <field name="share">False</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
            <field name="notification_type">inbox</field>
            <field name="email"></field>
        </record>

        <!-- Partner for Telework Bot -->
        <record id="partner_telework_bot" model="res.partner">
            <field name="name">Telework Manager</field>
            <field name="is_company">False</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="email"></field>
        </record>

        <!-- Link partner to user -->
        <record id="user_telework_bot" model="res.users">
            <field name="partner_id" ref="partner_telework_bot"/>
        </record>

    </data>
</odoo>
