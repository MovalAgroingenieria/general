<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- Daily Cron: Generate next week declarations -->
    <record id="ir_cron_generate_weekly_declarations" model="ir.cron">
      <field name="name">Generate Weekly Telework Declarations</field>
      <field name="model_id" ref="hr.model_hr_employee"/>
      <field name="state">code</field>
      <field name="code">model.cron_generate_weekly_declarations()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">weeks</field>
      <field name="numbercall">-1</field>
      <field name="nextcall">2025-08-25 04:00:00</field>
      <field name="active">True</field>
    </record>

    <!-- Daily Cron: Auto-confirm Weekly Telework Declarations -->
    <record id="ir_cron_auto_confirm_weekly_declarations" model="ir.cron">
      <field name="name">Auto-confirm Weekly Telework Declarations</field>
      <field name="model_id" ref="hr_telework_tracking_site_capacity.model_hr_telework_day"/>
      <field name="state">code</field>
      <field name="code">model.cron_auto_confirm_weekly_declarations()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">weeks</field>
      <field name="numbercall">-1</field>
      <field name="nextcall">2025-08-25 05:00:00</field>
      <field name="active">True</field>
    </record>

  </data>
</odoo>
