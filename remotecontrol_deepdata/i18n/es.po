#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>date</code> in getMedidas response is a string in DD-MM-YYYY HH:MM:SS format (converted to YYYY-MM-DD for Odoo)."
msgstr "<code>date</code> en la respuesta de getMedidas es una cadena en formato DD-MM-YYYY HH:MM:SS (convertido a YYYY-MM-DD para Odoo)."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>idLanguage</code>: Language code for catalog labels (default: <code>es</code>). Use <code>getIdiomas</code> to find available values."
msgstr "<code>idLanguage</code>: Código de idioma para las etiquetas del catálogo (predeterminado: <code>es</code>). Use <code>getIdiomas</code> para encontrar los valores disponibles."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>installation_id</code>: <strong>Required.</strong> DeepData installation identifier."
msgstr "<code>installation_id</code>: <strong>Obligatorio.</strong> Identificador de instalación DeepData."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>installation_name</code>: Optional. Display name of the installation."
msgstr "<code>installation_name</code>: Opcional. Nombre para mostrar de la instalación."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>jsessionid</code> is returned in the JSON response body of <code>/rest/login</code> — <strong>not</strong> in a cookie."
msgstr "<code>jsessionid</code> se devuelve en el cuerpo de la respuesta JSON de <code>/rest/login</code> — <strong>no</strong> en una cookie."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>jsessionid</code>: session token (~30 min validity)."
msgstr "<code>jsessionid</code>: token de sesión (validez ~30 min)."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>max_vars_per_call</code>: Maximum number of variables per getMedidas API call (default: <code>5</code>).\n"
"    The API rejects requests with too many variables (REST0012) and that failed attempt\n"
"    triggers a 24 h cooldown (REST0013). Pre-splitting avoids hitting the limit."
msgstr "<code>max_vars_per_call</code>: Número máximo de variables por llamada a getMedidas (predeterminado: <code>5</code>).\n"
"    La API rechaza peticiones con demasiadas variables (REST0012) y ese intento fallido\n"
"    activa un bloqueo de 24 h (REST0013). Pre-dividir evita alcanzar el límite."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>measure_point_id</code>: <strong>Required.</strong> DeepData measure point identifier."
msgstr "<code>measure_point_id</code>: <strong>Obligatorio.</strong> Identificador de punto de medida DeepData."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>measure_point_name</code>: Optional. Display name of the measure point."
msgstr "<code>measure_point_name</code>: Opcional. Nombre para mostrar del punto de medida."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>name</code>: display name of the authenticated user."
msgstr "<code>name</code>: nombre para mostrar del usuario autenticado."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>password</code>: DeepData login password."
msgstr "<code>password</code>: Contraseña de acceso DeepData."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>start_date</code>: Optional. Overrides device start_date if provided."
msgstr "<code>start_date</code>: Opcional. Sobrescribe el start_date del dispositivo si se proporciona."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>start_date</code>: Optional. Start date for first data retrieval. Defaults to Jan 1st of current year."
msgstr "<code>start_date</code>: Opcional. Fecha de inicio para la primera recuperación de datos. Por defecto es el 1 de enero del año actual."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>timezone</code>: Default IANA timezone. Can be overridden per installation."
msgstr "<code>timezone</code>: Zona horaria IANA predeterminada. Se puede sobrescribir por instalación."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>timezone</code>: Optional. IANA timezone for this installation. Defaults to the one in connection_params."
msgstr "<code>timezone</code>: Opcional. Zona horaria IANA para esta instalación. Por defecto la de connection_params."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>username</code>: DeepData login user."
msgstr "<code>username</code>: Usuario de acceso DeepData."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>variable_id</code>: <strong>Required.</strong> DeepData variable identifier."
msgstr "<code>variable_id</code>: <strong>Obligatorio.</strong> Identificador de variable DeepData."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>variable_name</code>: Optional. Display name of the variable."
msgstr "<code>variable_name</code>: Opcional. Nombre para mostrar de la variable."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>variable_type</code>: Optional. DeepData variable type (Acumulativa, Demandada, etc.)."
msgstr "<code>variable_type</code>: Opcional. Tipo de variable DeepData (Acumulativa, Demandada, etc.)."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>variable_unit</code>: Optional. Measurement unit (kWh, kVArh, etc.)."
msgstr "<code>variable_unit</code>: Opcional. Unidad de medida (kWh, kVArh, etc.)."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>{\"idLanguage\":\"es\",\"idInstallation\":1,\"idMeasurePoint\":10}</code>"
msgstr "<code>{\"idLanguage\":\"es\",\"idInstallation\":1,\"idMeasurePoint\":10}</code>"

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>{\"idLanguage\":\"es\",\"idInstallation\":1}</code>"
msgstr "<code>{\"idLanguage\":\"es\",\"idInstallation\":1}</code>"

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<code>{\"idLanguage\":\"es\"}</code>"
msgstr "<code>{\"idLanguage\":\"es\"}</code>"

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<strong>Catalog Sync</strong> (run once / periodically):\n"
"    Login → getIdiomas → getInstalaciones → getCategorias →\n"
"    getPuntosMedida (loop per installation) → getVariables (loop per measure point).\n"
"    Produces a hierarchy JSON attachment for reference."
msgstr "<strong>Sincronización de Catálogo</strong> (ejecutar una vez / periódicamente):\n"
"    Login → getIdiomas → getInstalaciones → getCategorias →\n"
"    getPuntosMedida (bucle por instalación) → getVariables (bucle por punto de medida).\n"
"    Genera un adjunto JSON con la jerarquía completa para referencia."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<strong>Full (with optional fields):</strong>"
msgstr "<strong>Completo (con campos opcionales):</strong>"

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<strong>Measure Import</strong> (daily / scheduled):\n"
"    Login → Build plan from Odoo devices → getMedidas (per installation, all variables batched) → Upsert readings.\n"
"    Handles automatic re-login, variable splitting and structured error recovery."
msgstr "<strong>Importación de Medidas</strong> (diaria / programada):\n"
"    Login → Construir plan desde dispositivos Odoo → getMedidas (por instalación, todas las variables agrupadas) → Upsert de lecturas.\n"
"    Gestiona re-login automático, división de variables y recuperación estructurada de errores."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<strong>Minimum (required):</strong>"
msgstr "<strong>Mínimo (obligatorio):</strong>"

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<strong>Note:</strong> <code>date</code> is a string in DD-MM-YYYY HH:MM:SS format.\n"
"<code>idInstallation</code>, <code>idMeasurePoint</code> and <code>idVariable</code> are strings (not integers)."
msgstr "<strong>Nota:</strong> <code>date</code> es una cadena en formato DD-MM-YYYY HH:MM:SS.\n"
"<code>idInstallation</code>, <code>idMeasurePoint</code> e <code>idVariable</code> son cadenas (no enteros)."

#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "<strong>Note:</strong> Dates are sent in the local timezone of the request, without UTC conversion.\n"
"<code>timeZone</code> per measure point is optional (defaults to the installation timezone)."
msgstr "<strong>Nota:</strong> Las fechas se envían en la zona horaria local de la petición, sin conversión UTC.\n"
"<code>timeZone</code> por punto de medida es opcional (por defecto la zona horaria de la instalación)."

