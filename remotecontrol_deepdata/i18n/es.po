#. module: remotecontrol_deepdata
#: model:remotecontrol,remotecontrol_help:remotecontrol_deepdata.remotecontrol_deepdata
msgid "POST /rest/getMedidas\n"
"Content-Type: text/plain\n"
"Cookie: JSESSIONID=&lt;value&gt;\n"
"\n"
"{\n"
"  \"startDate\": \"YYYY-MM-DD HH:mm:SS\",\n"
"  \"endDate\":   \"YYYY-MM-DD HH:mm:SS\",\n"
"  \"idLanguage\": \"es\",\n"
"  \"listInstallation\": [\n"
"    {\n"
"      \"idInstallation\": 105,\n"
"      \"listMeasurePoint\": [\n"
"        {\n"
"          \"idMeasurePoint\": 1165,\n"
"          \"timeZone\": \"Atlantic/Canary\",\n"
"          \"listVariables\": [1, 2, 3]\n"
"        }\n"
"      ]\n"
"    }\n"
"  ]\n"
"}"
msgstr "POST /rest/getMedidas\n"
"Content-Type: text/plain\n"
"Cookie: JSESSIONID=&lt;value&gt;\n"
"\n"
"{\n"
"  \"startDate\": \"YYYY-MM-DD HH:mm:SS\",\n"
"  \"endDate\":   \"YYYY-MM-DD HH:mm:SS\",\n"
"  \"idLanguage\": \"es\",\n"
"  \"listInstallation\": [\n"
"    {\n"
