<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Tree view for Censuses -->
    <record id="view_general_entity_census_tree" model="ir.ui.view">
        <field name="name">general.entity.census.tree</field>
        <field name="model">general.entity.census</field>
        <field name="arch" type="xml">
            <list
                editable="bottom"
                decoration-muted="state == 'locked'"
                default_order="period_date desc"
            >
                <button
                    name="action_open_form"
                    type="object"
                    string="Open"
                    icon="fa-external-link"
                    class="btn-link"
                />
                <field name="period_name" />
                <field name="primary_partner_id" readonly="id" />
                <field name="period_date" readonly="line_count > 0" />
                <field name="line_count" optional="show" />
                <field name="total_shares" optional="show" />
                <field
                    name="distribution_amount_day"
                    optional="show"
                    readonly="state == 'locked'"
                />
                <field name="period_days" optional="show" />
                <field
                    name="distribution_amount_period"
                    optional="show"
                    readonly="state == 'locked'"
                />
                <field name="distribution_total" optional="show" />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'locked'"
                    decoration-info="state == 'draft'"
                    optional="show"
                />
            </list>
        </field>
    </record>

    <!-- Form view for Censuses -->
    <record id="view_general_entity_census_form" model="ir.ui.view">
        <field name="name">general.entity.census.form</field>
        <field name="model">general.entity.census</field>
        <field name="arch" type="xml">
            <form string="Period Census">
                <header>
                    <button
                        name="%(action_census_generate_lines_wizard)d"
                        type="action"
                        string="Generate Lines"
                        class="btn-secondary"
                        invisible="state == 'locked'"
                    />
                    <button
                        name="action_copy_to_next_period"
                        type="object"
                        string="Copy to Next Period"
                        class="btn-secondary"
                        invisible="state == 'draft' and line_count == 0"
                    />
                    <button
                        name="%(action_census_partial_copy_wizard)d"
                        type="action"
                        string="Partial Copy"
                        class="btn-secondary"
                        invisible="line_count == 0"
                    />
                    <button
                        name="action_validate_all_lines"
                        type="object"
                        string="Validate All"
                        class="btn-success"
                        invisible="state != 'draft' or line_count == 0"
                    />
                    <button
                        name="action_unvalidate_all_lines"
                        type="object"
                        string="Unvalidate All"
                        class="btn-secondary"
                        invisible="state != 'draft' or line_count == 0"
                    />
                    <button
                        name="action_lock"
                        type="object"
                        string="Lock"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />
                    <button
                        name="action_unlock"
                        type="object"
                        string="Unlock"
                        class="btn-warning"
                        invisible="state != 'locked'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title" name="title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group name="main_info">
                        <group name="main_info_left">
                            <field
                                name="primary_partner_id"
                                readonly="state == 'locked'"
                            />
                            <field name="period_date" readonly="state == 'locked'" />
                            <field name="period_type" readonly="state == 'locked'" />
                            <field
                                name="period_start_date"
                                readonly="state == 'locked'"
                                invisible="period_type != 'custom'"
                                required="period_type == 'custom'"
                            />
                            <field
                                name="period_end_date"
                                readonly="state == 'locked'"
                                invisible="period_type != 'custom'"
                                required="period_type == 'custom'"
                            />
                            <field name="period_name" />
                        </group>
                        <group name="main_info_right">
                            <field name="period_days" />
                            <field name="line_count" />
                            <field name="total_shares" />
                        </group>
                    </group>
                    <group name="distribution_config" string="Distribution Configuration">
                        <group name="distribution_config_left">
                            <field
                                name="distribution_product_id"
                                readonly="state == 'locked'"
                            />
                        </group>
                        <group name="distribution_config_right">
                            <field
                                name="distribution_amount_day"
                                readonly="state == 'locked'"
                            />
                            <field
                                name="distribution_amount_period"
                                readonly="state == 'locked'"
                            />
                            <field name="distribution_total" />
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Census Lines">
                            <field
                                name="line_ids"
                                context="{'default_census_id': id}"
                                readonly="state == 'locked'"
                            >
                                <list
                                    editable="bottom"
                                    decoration-muted="state == 'draft'"
                                    decoration-success="state == 'validated'"
                                    decoration-warning="shares_changed and state != 'validated'"
                                >
                                    <field name="state" column_invisible="1" />
                                    <field name="entity_global_code" optional="show" />
                                    <field
                                        name="member_partner_id"
                                        readonly="id"
                                        options="{'no_create': True, 'no_create_edit': True}"
                                    />
                                    <field name="previous_line_id" optional="hide" />
                                    <field name="shares" sum="Total" optional="show" />
                                    <field
                                        name="base_distributed_qty"
                                        sum="Total Base"
                                        optional="show"
                                    />
                                    <field
                                        name="qty_additional"
                                        sum="Total Additional"
                                        optional="show"
                                    />
                                    <field name="product_id" optional="hide" />
                                    <field
                                        name="distributed_qty"
                                        sum="Total Distributed"
                                        optional="show"
                                    />
                                    <field
                                        name="shares_changed"
                                        widget="boolean"
                                        optional="show"
                                    />
                                    <field name="note" optional="hide" />
                                    <button
                                        name="action_view_additional_movements"
                                        type="object"
                                        string="Extra"
                                        icon="fa-plus-square"
                                        class="btn-secondary"
                                    />
                                    <button
                                        name="action_validate"
                                        type="object"
                                        string="Validate"
                                        class="btn-success"
                                        invisible="state != 'draft' or census_state == 'locked'"
                                    />
                                    <button
                                        name="action_unvalidate"
                                        type="object"
                                        string="Unvalidate"
                                        class="btn-warning"
                                        invisible="state != 'validated' or census_state == 'locked'"
                                    />
                                    <field name="census_state" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="note" placeholder="Census notes..." />
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view for Censuses -->
    <record id="view_general_entity_census_search" model="ir.ui.view">
        <field name="name">general.entity.census.search</field>
        <field name="model">general.entity.census</field>
        <field name="arch" type="xml">
            <search string="Search Censuses">
                <field name="primary_partner_id" />
                <field name="period_date" />
                <field name="period_name" />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_locked"
                    string="Locked"
                    domain="[('state', '=', 'locked')]"
                />
                <separator />
                <filter
                    name="filter_current_year"
                    string="Current Year"
                    domain="[
                        ('period_date', '&gt;=', context_today().strftime('%Y-01-01')),
                        ('period_date', '&lt;=', context_today().strftime('%Y-12-31'))
                    ]"
                />
                <filter
                    name="filter_last_year"
                    string="Last Year"
                    domain="[
                        ('period_date', '&gt;=', (context_today() - relativedelta(years=1)).strftime('%Y-01-01')),
                        ('period_date', '&lt;=', (context_today() - relativedelta(years=1)).strftime('%Y-12-31'))
                    ]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_entity"
                        string="Entity"
                        domain="[]"
                        context="{'group_by': 'primary_partner_id'}"
                    />
                    <filter
                        name="group_by_period"
                        string="Period"
                        domain="[]"
                        context="{'group_by': 'period_date'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        domain="[]"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Censuses -->
    <record id="action_general_entity_census" model="ir.actions.act_window">
        <field name="name">Period Censuses</field>
        <field name="res_model">general.entity.census</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_filter_current_year': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Census
            </p>
            <p>
                Censuses allow you to manage member snapshots by period (monthly).
                You can copy the census from the previous period and adjust the quantities.
            </p>
        </field>
    </record>

    <!-- List view for Census Lines (standalone) -->
    <record id="view_general_entity_census_line_list" model="ir.ui.view">
        <field name="name">general.entity.census.line.list</field>
        <field name="model">general.entity.census.line</field>
        <field name="arch" type="xml">
            <list
                editable="bottom"
                decoration-muted="state == 'draft'"
                decoration-success="state == 'validated'"
                decoration-warning="shares_changed and state != 'validated'"
                default_order="period_date desc"
            >
                <field name="period_date" optional="show" />
                <field name="census_id" readonly="id" optional="hide" />
                <field
                    name="primary_partner_id"
                    column_invisible="context.get('hide_primary_partner')"
                    optional="show"
                />
                <field name="entity_global_code" optional="show" />
                <field
                    name="member_partner_id"
                    column_invisible="context.get('default_member_partner_id')"
                    readonly="id"
                    options="{'no_create': True, 'no_create_edit': True}"
                />
                <field name="previous_line_id" optional="hide" />
                <field name="shares" optional="show" />
                <field
                    name="base_distributed_qty"
                    sum="Total Base"
                    optional="show"
                />
                <field name="qty_additional" optional="show" />
                <field name="product_id" optional="hide" />
                <field
                    name="distributed_qty"
                    sum="Total Distributed"
                    optional="show"
                />
                <field
                    name="state"
                    widget="badge"
                    decoration-success="state == 'validated'"
                    decoration-info="state == 'draft'"
                    optional="show"
                />
                <field
                    name="shares_changed"
                    widget="boolean"
                    optional="show"
                />
                <field name="note" optional="hide" />
                <button
                    name="action_view_additional_movements"
                    type="object"
                    string="Extra"
                    icon="fa-plus-square"
                    class="btn-secondary"
                />
                <button
                    name="action_validate"
                    type="object"
                    string="Validate"
                    class="btn-success"
                    invisible="state != 'draft' or census_state == 'locked'"
                />
                <button
                    name="action_unvalidate"
                    type="object"
                    string="Unvalidate"
                    class="btn-warning"
                    invisible="state != 'validated' or census_state == 'locked'"
                />
                <field name="census_state" column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- Form view for Census Lines (standalone) -->
    <record id="view_general_entity_census_line_form" model="ir.ui.view">
        <field name="name">general.entity.census.line.form</field>
        <field name="model">general.entity.census.line</field>
        <field name="arch" type="xml">
            <form string="Census Line">
                <header>
                    <button
                        name="action_validate"
                        type="object"
                        string="Validate"
                        class="btn-primary"
                        invisible="state != 'draft' or census_state == 'locked'"
                    />
                    <button
                        name="action_unvalidate"
                        type="object"
                        string="Unvalidate"
                        class="btn-warning"
                        invisible="state != 'validated' or census_state == 'locked'"
                    />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <field name="census_state" invisible="1" />
                    <group name="line_main_info">
                        <group name="line_main_info_left">
                            <field name="census_id" />
                            <field name="period_date" />
                            <field name="primary_partner_id" />
                            <field name="entity_global_code" />
                            <field
                                name="member_partner_id"
                                options="{'no_create': True, 'no_create_edit': True}"
                            />
                        </group>
                        <group name="line_main_info_right">
                            <field name="previous_line_id" />
                            <field name="shares" readonly="census_state == 'locked'" />
                            <field
                                name="base_distributed_qty"
                                readonly="census_state == 'locked'"
                            />
                            <field name="qty_additional" />
                            <field name="distributed_qty" />
                            <field name="shares_changed" />
                            <field name="product_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Additional Movements" name="additional">
                            <field
                                name="additional_ids"
                                readonly="census_state == 'locked'"
                            >
                                <list editable="bottom">
                                    <field name="qty" />
                                    <field name="note" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group name="line_notes">
                        <field name="note" placeholder="Observations..." />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view for Census Lines -->
    <record id="view_general_entity_census_line_search" model="ir.ui.view">
        <field name="name">general.entity.census.line.search</field>
        <field name="model">general.entity.census.line</field>
        <field name="arch" type="xml">
            <search string="Search Census Lines">
                <field name="census_id" />
                <field
                    name="primary_partner_id"
                    filter_domain="[('primary_partner_id', 'child_of', self)]"
                />
                <field name="member_partner_id" />
                <field name="entity_global_code" />
                <field name="period_date" />
                <searchpanel>
                    <field
                        name="primary_partner_id"
                        icon="fa-building"
                        enable_counters="1"
                    />
                </searchpanel>
                <separator />
                <filter
                    name="filter_shares_changed"
                    string="Shares Changed"
                    domain="[('shares_changed', '=', True)]"
                />
                <filter
                    name="filter_draft"
                    string="Draft"
                    domain="[('state', '=', 'draft')]"
                />
                <filter
                    name="filter_validated"
                    string="Validated"
                    domain="[('state', '=', 'validated')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_quarter"
                        string="Quarter"
                        domain="[]"
                        context="{'group_by': 'period_date:quarter'}"
                    />
                    <filter
                        name="group_by_month"
                        string="Month"
                        domain="[]"
                        context="{'group_by': 'period_date:month'}"
                    />
                    <filter
                        name="group_by_census"
                        string="Census"
                        domain="[]"
                        context="{'group_by': 'census_id'}"
                    />
                    <filter
                        name="group_by_primary"
                        string="Primary Entity"
                        domain="[]"
                        context="{'group_by': 'primary_partner_id'}"
                    />
                    <filter
                        name="group_by_member"
                        string="Member"
                        domain="[]"
                        context="{'group_by': 'member_partner_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="State"
                        domain="[]"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot view for Census Lines -->
    <record id="view_general_entity_census_line_pivot" model="ir.ui.view">
        <field name="name">general.entity.census.line.pivot</field>
        <field name="model">general.entity.census.line</field>
        <field name="arch" type="xml">
            <pivot string="Census Lines Summary" sample="1">
                <field name="member_partner_id" type="row" />
                <field name="period_date" type="col" interval="month" />
                <field name="shares" type="measure" />
                <field name="base_distributed_qty" type="measure" />
                <field name="qty_additional" type="measure" />
                <field name="distributed_qty" type="measure" />
            </pivot>
        </field>
    </record>

    <!-- Graph view for Census Lines -->
    <record id="view_general_entity_census_line_graph" model="ir.ui.view">
        <field name="name">general.entity.census.line.graph</field>
        <field name="model">general.entity.census.line</field>
        <field name="arch" type="xml">
            <graph string="Census Lines" type="bar" sample="1">
                <field name="period_date" interval="month" />
                <field name="distributed_qty" type="measure" />
            </graph>
        </field>
    </record>

    <!-- Action for Census Lines -->
    <record id="action_general_entity_census_line" model="ir.actions.act_window">
        <field name="name">Census Lines</field>
        <field name="res_model">general.entity.census.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_general_entity_census_line_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No census lines found
            </p>
        </field>
    </record>

    <!-- List view for Additional Movements -->
    <record
        id="view_general_entity_census_additional_list"
        model="ir.ui.view"
    >
        <field name="name">general.entity.census.additional.list</field>
        <field name="model">general.entity.census.additional</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1">
                <header>
                    <button
                        name="unlink"
                        type="object"
                        string="Delete"
                        confirm="Are you sure you want to delete the selected records?"
                    />
                </header>
                <field name="census_state" column_invisible="1" />
                <field name="census_line_state" column_invisible="1" />
                <field
                    name="qty"
                    readonly="census_state == 'locked' or census_line_state == 'validated'"
                />
                <field
                    name="note"
                    readonly="census_state == 'locked' or census_line_state == 'validated'"
                />
            </list>
        </field>
    </record>

    <!-- Form view for Additional Movements -->
    <record
        id="view_general_entity_census_additional_form"
        model="ir.ui.view"
    >
        <field name="name">general.entity.census.additional.form</field>
        <field name="model">general.entity.census.additional</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="census_line_id" readonly="id" />
                        <field name="qty" />
                        <field name="note" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
