<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_census_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="census">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span>Period Census: </span>
                            <span t-field="census.name" />
                        </h2>

                        <!-- Header info -->
                        <div class="row mt-3 mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr>
                                        <td class="fw-bold">Entity:</td>
                                        <td>
                                            <span
                                                t-field="census.primary_partner_id"
                                            />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Period:</td>
                                        <td>
                                            <span t-field="census.period_name" />
                                            (<span t-field="census.period_type" />)
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Period Date:</td>
                                        <td>
                                            <span t-field="census.period_date" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Period Days:</td>
                                        <td>
                                            <span t-field="census.period_days" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">State:</td>
                                        <td>
                                            <span t-field="census.state" />
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr t-if="census.distribution_product_id">
                                        <td class="fw-bold">Distribution Product:</td>
                                        <td>
                                            <span
                                                t-field="census.distribution_product_id"
                                            />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Amount / Action / Day:</td>
                                        <td>
                                            <span
                                                t-field="census.distribution_amount_day"
                                            />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">
                                            Amount / Action / Period:
                                        </td>
                                        <td>
                                            <span
                                                t-field="census.distribution_amount_period"
                                            />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Total Shares:</td>
                                        <td>
                                            <span t-field="census.total_shares" />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Total Distributed:</td>
                                        <td>
                                            <span
                                                t-field="census.distribution_total"
                                            />
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Census lines table -->
                        <h3>Census Lines</h3>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Member</th>
                                    <th>Code</th>
                                    <th class="text-end">Shares</th>
                                    <th class="text-end">Base Distribution</th>
                                    <th class="text-end">Additional</th>
                                    <th class="text-end">Total Distribution</th>
                                    <th class="text-center">Changed</th>
                                    <th class="text-center">State</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="census.line_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <span t-field="line.member_partner_id" />
                                        </td>
                                        <td>
                                            <span t-field="line.entity_global_code" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.shares" />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-field="line.base_distributed_qty"
                                            />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.qty_additional" />
                                        </td>
                                        <td class="text-end fw-bold">
                                            <span t-field="line.distributed_qty" />
                                        </td>
                                        <td class="text-center">
                                            <t t-if="line.shares_changed">
                                                <span class="text-warning">●</span>
                                            </t>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="line.state" />
                                        </td>
                                    </tr>
                                    <!-- Additional movements sub-rows -->
                                    <t
                                        t-foreach="line.additional_ids"
                                        t-as="additional"
                                    >
                                        <tr class="text-muted small">
                                            <td class="ps-4">
                                                ↳ <span t-field="additional.note" />
                                            </td>
                                            <td />
                                            <td />
                                            <td />
                                            <td class="text-end">
                                                <span t-field="additional.qty" />
                                            </td>
                                            <td />
                                            <td />
                                            <td />
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="2">TOTALS</td>
                                    <td class="text-end">
                                        <span t-field="census.total_shares" />
                                    </td>
                                    <td />
                                    <td />
                                    <td class="text-end">
                                        <span t-field="census.distribution_total" />
                                    </td>
                                    <td />
                                    <td />
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Notes -->
                        <t t-if="census.note">
                            <h3 class="mt-4">Notes</h3>
                            <p t-field="census.note" />
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
