<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Multi-company rule for General Entity Census.
        Users only see censuses belonging to their active companies.
    -->
    <record id="rule_general_entity_census_company" model="ir.rule">
        <field name="name">General Entity Census: Multi-company</field>
        <field name="model_id" ref="model_general_entity_census" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <!--
        Multi-company rule for Census Lines.
        Inherited from the census header via company_id related field.
    -->
    <record id="rule_general_entity_census_line_company" model="ir.rule">
        <field name="name">Census Line: Multi-company</field>
        <field name="model_id" ref="model_general_entity_census_line" />
        <field name="domain_force">
            ['|', ('census_id.company_id', '=', False),
             ('census_id.company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>

    <!--
        Multi-company rule for Census Additional Movements.
    -->
    <record id="rule_general_entity_census_additional_company" model="ir.rule">
        <field name="name">Census Additional: Multi-company</field>
        <field name="model_id" ref="model_general_entity_census_additional" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
