msgid "SCADA Mula · Odoo Integration Help"
msgstr "SCADA Mula · Ayuda de integración con Odoo"

#. module: remotecontrol_scada_mula
#: model:remotecontrol,remotecontrol_help:remotecontrol_scada_mula.remotecontrol_scada_mula
msgid "SELECT Temperatura AS value, FechaHora AS timestamp\n"
"FROM estacion_meteorologica\n"
"WHERE EstacionNr = 0\n"
"  AND FechaHora &gt;= '2025-09-01 00:00:00'\n"
"  AND FechaHora &lt;= '2026-01-08 23:59:59'\n"
"  AND Temperatura IS NOT NULL\n"
"ORDER BY FechaHora ASC"
msgstr "SELECT Temperatura AS value, FechaHora AS timestamp\n"
"FROM estacion_meteorologica\n"
"WHERE EstacionNr = 0\n"
"  AND FechaHora &gt;= '2025-09-01 00:00:00'\n"
"  AND FechaHora &lt;= '2026-01-08 23:59:59'\n"
"  AND Temperatura IS NOT NULL\n"
"ORDER BY FechaHora ASC"

#. module: remotecontrol_scada_mula
#: model:remotecontrol,remotecontrol_help:remotecontrol_scada_mula.remotecontrol_scada_mula
msgid "Set <code>remotecontrol_id</code> to \"SCADA Mula\""
msgstr "Establecer <code>remotecontrol_id</code> a \"SCADA Mula\""

#. module: remotecontrol_scada_mula
#: model:remotecontrol,remotecontrol_help:remotecontrol_scada_mula.remotecontrol_scada_mula
msgid "System converts to incremental values (01:00→10mm, 03:00→30mm, 23:00→5mm)"
msgstr "El sistema convierte a valores incrementales (01:00→10mm, 03:00→30mm, 23:00→5mm)"

