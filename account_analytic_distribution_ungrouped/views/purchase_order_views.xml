<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Purchase Order Form View - Replace analytic_distribution with simple field -->
        <record id="view_purchase_order_form_analytic_simple" model="ir.ui.view">
            <field name="name">purchase.order.form.analytic.simple</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <!-- Hide the complex analytic_distribution field in order lines -->
                <xpath expr="//field[@name='order_line']//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Add our simple many2one field after the original -->
                <xpath expr="//field[@name='order_line']//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_account_single"
                           string="Analytic"
                           context="{'search_default_active': 1}"
                           options="{'no_create': False, 'no_create_edit': False}"
                           attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
