<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Also handle contract_line_ids if they exist in other views -->
        <record id="view_contract_lines_analytic_simple" model="ir.ui.view">
            <field name="name">contract.contract.lines.analytic.simple</field>
            <field name="model">contract.contract</field>
            <field name="inherit_id" ref="contract.contract_contract_customer_form_view"/>
            <field name="arch" type="xml">
                <!-- Hide the complex analytic_distribution field in contract lines -->
                <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Add our simple many2one field after the original -->
                <xpath expr="//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_account_single"
                           string="Analytic"
                           context="{'search_default_active': 1}"
                           domain="[('active', '=', True)]"
                           options="{'no_create': False, 'no_create_edit': False}"
                           groups="analytic.group_analytic_accounting"
                           attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"/>
                </xpath>
            </field>
        </record>

        <!-- Contract Line Form View - Replace analytic_distribution with simple field -->
        <record id="view_contract_line_form_analytic_simple" model="ir.ui.view">
            <field name="name">contract.line.form.analytic.simple</field>
            <field name="model">contract.line</field>
            <field name="inherit_id" ref="contract.contract_line_form_view"/>
            <field name="arch" type="xml">
                <!-- Hide the complex analytic_distribution field -->
                <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Add our simple many2one field after the original -->
                <xpath expr="//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_account_single"
                           string="Analytic Account"
                           context="{'search_default_active': 1}"
                           options="{'no_create': False, 'no_create_edit': False}"
                           groups="analytic.group_analytic_accounting"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
