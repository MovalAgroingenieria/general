<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sale Order Form View - Override analytic widget -->
        <record id="view_order_form_analytic_simple" model="ir.ui.view">
            <field name="name">sale.order.form.analytic.simple</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- The sale.order model already has analytic_account_id field,
                     we just need to ensure it's visible and easy to use -->
                <xpath expr="//field[@name='analytic_account_id']" position="attributes">
                    <attribute name="string">Analytic Account</attribute>
                    <attribute name="context">{'search_default_active': 1}</attribute>
                    <attribute name="options">{'no_create': False, 'no_create_edit': False}</attribute>
                </xpath>

                <!-- Sale Order Lines - Replace analytic_distribution with simple field -->
                <xpath expr="//field[@name='order_line']//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Add our simple many2one field after the original -->
                <xpath expr="//field[@name='order_line']//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_account_single"
                           string="Analytic"
                           context="{'search_default_active': 1, 'order_by': 'name'}"
                           options="{'no_create': False, 'no_create_edit': False}"
                           attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
