<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- HR Expense Form View - Replace analytic_distribution with simple field -->
        <record id="view_hr_expense_form_analytic_simple" model="ir.ui.view">
            <field name="name">hr.expense.form.analytic.simple</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
            <field name="arch" type="xml">
                <!-- Hide the complex analytic_distribution field -->
                <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Add our simple many2one field after the original -->
                <xpath expr="//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_account_single"
                           string="Analytic Account"
                           context="{'search_default_active': 1}"
                           options="{'no_create': False, 'no_create_edit': False}"
                           groups="analytic.group_analytic_accounting"/>
                </xpath>
            </field>
        </record>

        <!-- HR Expense Tree View - Replace analytic_distribution with simple field -->
        <record id="view_hr_expense_tree_analytic_simple" model="ir.ui.view">
            <field name="name">hr.expense.tree.analytic.simple</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.view_expenses_tree"/>
            <field name="arch" type="xml">
                <!-- Hide the complex analytic_distribution field -->
                <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Add our simple many2one field after the original -->
                <xpath expr="//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_account_single"
                           string="Analytic"
                           context="{'search_default_active': 1}"
                           options="{'no_create': False, 'no_create_edit': False}"
                           groups="analytic.group_analytic_accounting"
                           optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
