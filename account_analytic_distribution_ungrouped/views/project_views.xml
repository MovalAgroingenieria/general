<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Project Form View - Ensure analytic_account_id field is user-friendly -->
        <record id="view_project_project_form_analytic_simple" model="ir.ui.view">
            <field name="name">project.project.form.analytic.simple</field>
            <field name="model">project.project</field>
            <field name="inherit_id" ref="project.edit_project"/>
            <field name="arch" type="xml">
                <!-- Ensure the existing analytic_account_id field is visible and user-friendly -->
                <xpath expr="//field[@name='analytic_account_id']" position="attributes">
                    <attribute name="string">Analytic Account</attribute>
                    <attribute name="context">{'search_default_active': 1}</attribute>
                    <attribute name="options">{'no_create': False, 'no_create_edit': False}</attribute>
                </xpath>
            </field>
        </record>

        <!-- Project Task Form View - Ensure analytic_account_id field is user-friendly -->
        <record id="view_task_form_analytic_simple" model="ir.ui.view">
            <field name="name">project.task.form.analytic.simple</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2"/>
            <field name="arch" type="xml">
                <!-- Ensure the existing analytic_account_id field is visible and user-friendly -->
                <xpath expr="//field[@name='analytic_account_id']" position="attributes">
                    <attribute name="string">Analytic Account</attribute>
                    <attribute name="context">{'search_default_active': 1}</attribute>
                    <attribute name="options">{'no_create': False, 'no_create_edit': False}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
