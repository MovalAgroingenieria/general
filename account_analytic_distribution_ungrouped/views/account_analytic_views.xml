<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Account Analytic Line Form View - Ensure account_id field is user-friendly -->
        <record id="view_account_analytic_line_form_analytic_simple" model="ir.ui.view">
            <field name="name">account.analytic.line.form.analytic.simple</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_line_form"/>
            <field name="arch" type="xml">
                <!-- Ensure the existing account_id field is visible and user-friendly -->
                <xpath expr="//field[@name='account_id']" position="attributes">
                    <attribute name="string">Analytic Account</attribute>
                    <attribute name="context">{'search_default_active': 1}</attribute>
                    <attribute name="options">{'no_create': False, 'no_create_edit': False}</attribute>
                </xpath>
            </field>
        </record>

        <!-- Account Analytic Line Tree View -->
        <record id="view_account_analytic_line_tree_analytic_simple" model="ir.ui.view">
            <field name="name">account.analytic.line.tree.analytic.simple</field>
            <field name="model">account.analytic.line</field>
            <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
            <field name="arch" type="xml">
                <!-- Ensure the existing account_id field is visible and user-friendly -->
                <xpath expr="//field[@name='account_id']" position="attributes">
                    <attribute name="string">Analytic Account</attribute>
                    <attribute name="context">{'search_default_active': 1}</attribute>
                    <attribute name="options">{'no_create': False, 'no_create_edit': False}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
