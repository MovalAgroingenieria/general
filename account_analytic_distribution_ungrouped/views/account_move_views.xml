<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Reemplazar el campo analytic_distribution por nuestro campo many2one -->
        <record id="view_move_form_analytic_simple" model="ir.ui.view">
            <field name="name">account.move.form.analytic.simple</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Buscar el campo analytic_distribution en las líneas de factura -->
                <xpath expr="//field[@name='invoice_line_ids']//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Agregar nuestro campo many2one después del campo original -->
                <xpath expr="//field[@name='invoice_line_ids']//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_account_single"
                           string="Analítico"
                           context="{'search_default_active': 1}"
                           options="{'no_create': False, 'no_create_edit': False}"
                           attrs="{'invisible': [('display_type', 'in', ('line_section', 'line_note'))]}"/>
                </xpath>

                <!-- TAMBIÉN para los asientos contables (Journal Items) -->
                <xpath expr="//field[@name='line_ids']//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- Agregar nuestro campo many2one después del campo original en asientos -->
                <xpath expr="//field[@name='line_ids']//field[@name='analytic_distribution']" position="after">
                    <field name="analytic_account_single"
                           string="Analítico"
                           context="{'search_default_active': 1}"
                           options="{'no_create': False, 'no_create_edit': False}"
                           optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>