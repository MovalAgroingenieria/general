<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <report id="report_facturae"
            name="l10n_es_facturae.template_facturae"
            string="Factura-E sin firmar"
            report_type="qweb-xml"
            model="account.invoice"/>

    <template id="facturae_header">
        &lt;fe:Facturae xmlns:fe="http://www.facturae.gob.es/formato/Versiones/Facturaev3_2_2.xml" xmlns:ds="http://www.w3.org/2000/09/xmldsig#"&gt;
        <t t-raw="0" />
        &lt;/fe:Facturae&gt;
    </template>

    <template id="administrative_center">
        <AdministrativeCentre>
            <CentreCode t-length="10" t-esc="centre_code"/>
            <RoleTypeCode t-esc="role_type_code"/>
            <Name
                t-length="40"
                t-esc="partner.firstname"
                t-if="not partner.is_company and partner.firstname"
            />
            <FirstSurname
                t-length="40"
                t-esc="partner.lastname"
                t-if="not partner.is_company and partner.lastname"
            />
            <SecondSurname t-if="False"/>
            <t t-call="l10n_es_facturae.address_contact">
                <t t-set="partner" t-value="partner"/>
            </t>
            <PhysicalGLN t-if="False"/>
            <LogicalOperationalPoint t-if="False"/>
            <CentreDescription
                t-length="2500"
                t-esc="partner.name or ''"
            />
        </AdministrativeCentre>
    </template>

    <template id="entity">
        <t
            t-set="buyer_type"
            t-value="'J' if partner.vat and partner.is_company else 'F'"
        />
        <TaxIdentification>
            <PersonTypeCode t-esc="buyer_type"/>
            <ResidenceTypeCode t-esc="partner.get_facturae_residence()"/>
            <TaxIdentificationNumber
                t-minlength="3"
                t-length="30"
                t-esc="partner.vat or ''"
            />
        </TaxIdentification>
        <PartyIdentification t-if="False"/>
        <AdministrativeCentres t-if="partner.facturae">
            <t t-set="partner" t-value="partner"/>
            <t t-call="l10n_es_facturae.administrative_center">
                <t
                    t-set="centre_code"
                    t-value="partner.oficina_contable"
                />
                <t t-set="role_type_code" t-value="'01'"/>
            </t>
            <t t-call="l10n_es_facturae.administrative_center">
                <t
                    t-set="centre_code"
                    t-value="partner.organo_gestor"
                />
                <t t-set="role_type_code" t-value="'02'"/>
            </t>
            <t t-call="l10n_es_facturae.administrative_center">
                <t
                    t-set="centre_code"
                    t-value="partner.unidad_tramitadora"
                />
                <t t-set="role_type_code" t-value="'03'"/>
            </t>
            <t t-call="l10n_es_facturae.administrative_center" t-if="partner.organo_proponente">
                <t
                    t-set="centre_code"
                    t-value="partner.organo_proponente"
                />
                <t t-set="role_type_code" t-value="'04'"/>
            </t>
        </AdministrativeCentres>
        <LegalEntity t-if="buyer_type == 'J'">
            <CorporateName t-length="80" t-esc="partner.name or ''"/>
            <TradeName t-length="40" t-esc="partner.name or ''"/>
            <RegistrationData t-if="False"/>
            <t t-call="l10n_es_facturae.address_contact">
            </t>
        </LegalEntity>
        <Individual t-if="buyer_type == 'F'">
            <Name
                t-length="40"
                t-esc="partner.firstname or ''"
                t-if="partner.firstname"
            />
            <FirstSurname
                t-length="40"
                t-esc="partner.lastname or ''"
                t-if="partner.lastname"
            />
            <SecondSurname t-length="40" t-esc="''"/>
            <t t-call="l10n_es_facturae.address_contact">
            </t>
        </Individual>
    </template>

    <template id="address_contact">
        <AddressInSpain t-if="partner.country_id.code == 'ES'">
            <Address
                t-length="80"
                t-esc="(partner.street or '') + (partner.street2 or '')"
            />
            <PostCode t-length="5" t-esc="(partner.zip or '').zfill(5)"/>
            <Town t-length="50" t-esc="partner.city or ''"/>
            <Province t-length="20" t-esc="partner.state_id.name or ''"/>
            <CountryCode t-esc="partner.country_id.code_alpha3 or ''"/>
        </AddressInSpain>
        <OverseasAddress t-if="partner.country_id.code != 'ES'">
            <Address
                t-length="80"
                t-esc="(partner.street or '') + (partner.street2 or '')"
            />
            <PostCodeAndTown
                t-length="50"
                t-esc="(partner.zip or '') + (partner.city or '')"
            />
            <Province t-length="20" t-esc="partner.state_id.name or ''"/>
            <CountryCode t-esc="partner.country_id.code_alpha3 or ''"/>
        </OverseasAddress>
        <ContactDetails>
            <Telephone
                t-length="15"
                t-esc="partner.phone"
                t-if="partner.phone"
            />
            <TeleFax t-length="15" t-if="False"/>
            <WebAddress
                t-length="60"
                t-esc="partner.website"
                t-if="partner.website"
            />
            <ElectronicMail
                t-length="60"
                t-esc="partner.email"
                t-if="partner.email"
            />
            <ContactPersons
                t-length="40"
                t-esc="partner.name or ''"
                t-if="partner.name"
            />
            <CnoCnae t-if="False"/>
            <INETownCode t-if="False"/>
            <AdditionalContactDetails t-length="60" t-if="False"/>
        </ContactDetails>
    </template>

    <template id="template_facturae">
        <t t-set="invoice" t-value="docs[0]"/>
        <t t-set="company" t-value="invoice.company_id"/>
        <t t-set="company_partner" t-value="company.partner_id"/>
        <t t-set="invoice_partner" t-value="invoice.partner_id"/>
        <t
            t-set="euro"
            t-value="invoice.currency_id.search([('name', '=', 'EUR')]).ensure_one().with_context(company_id=company.id, date=invoice.move_id.date).get_current_rate()"
        />
        <t
            t-set="currency"
            t-value="invoice.currency_id.with_context(company_id=company.id, date=invoice.move_id.date).get_current_rate()"
        />
        <t t-set="currency_rate" t-value="currency.rate if currency else 1.0"/>
        <t t-set="euro_rate" t-value="euro.rate if euro else 1.0"/>
        <t t-set="facturae_invoice_vals" t-value="invoice.get_facturae_invoice_amounts()"/>

        <t t-call="l10n_es_facturae.facturae_header">
            <FileHeader>
                <SchemaVersion t-esc="'3.2.2'"/>
                <Modality t-esc="'I'"/>
                <InvoiceIssuerType t-esc="'EM'"/>
                <Batch>
                    <BatchIdentifier
                        t-length="70"
                        t-esc="(invoice.number or '') + (company_partner.vat or '')"
                    />
                    <InvoicesCount t-esc="'1'"/>
                    <!-- Modify by moval on 23.03.2026 -->
                    <TotalInvoicesAmount>
                        <TotalAmount
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['invoice_total'], 2)"
                        />
                        <EquivalentInEuros
                            t-esc="'%.2f' % (float(facturae_invoice_vals['invoice_total']) * euro_rate / currency_rate)"
                        />
                    </TotalInvoicesAmount>
                    <TotalOutstandingAmount>
                        <TotalAmount
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_outstanding_amount'], 2)"
                        />
                        <EquivalentInEuros
                            t-esc="'%.2f' % (float(facturae_invoice_vals['total_outstanding_amount']) * euro_rate / currency_rate)"
                        />
                    </TotalOutstandingAmount>
                    <TotalExecutableAmount>
                        <TotalAmount
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_executable_amount'], 2)"
                        />
                        <EquivalentInEuros
                            t-esc="'%.2f' % (float(facturae_invoice_vals['total_executable_amount']) * euro_rate / currency_rate)"
                        />
                    </TotalExecutableAmount>

                    <InvoiceCurrencyCode t-esc="invoice.currency_id.name"/>
                </Batch>
            </FileHeader>
            <Parties>
                <SellerParty>
                    <t t-call="l10n_es_facturae.entity">
                        <t t-set="partner" t-value="company_partner"/>
                    </t>
                </SellerParty>
                <BuyerParty>
                    <t t-call="l10n_es_facturae.entity">
                        <t t-set="partner" t-value="invoice_partner"/>
                    </t>
                </BuyerParty>
            </Parties>
            <Invoices>
                <Invoice>
                    <t t-set="start_date" t-value="invoice.start_date"/>
                    <t t-set="end_date" t-value="invoice.end_date"/>
                    <t t-set="withheld" t-value="False"/>
                    <t t-set="amount_tax" t-value="0.00"/>
                    <t t-set="amount_tax_withheld" t-value="0.00"/>
                    <t t-foreach="invoice.tax_line_ids" t-as="tax_line">
                        <t t-if="tax_line.tax_id.amount &lt; 0">
                            <t t-set="withheld" t-value="True"/>
                            <t
                                t-set="amount_tax_withheld"
                                t-value="amount_tax_withheld - tax_line.amount"
                            />
                        </t>
                        <t t-if="tax_line.tax_id.amount &gt; 0">
                            <t
                                t-set="amount_tax"
                                t-value="amount_tax + tax_line.amount"
                            />
                        </t>
                    </t>
                    <InvoiceHeader>
                        <InvoiceNumber t-length="20" t-esc="invoice.number or ''"/>
                        <InvoiceSeriesCode t-length="20" t-esc="''"/>
                        <InvoiceDocumentType t-esc="'FC'"/>
                        <InvoiceClass
                            t-esc="'OR' if invoice.refund_invoice_id else 'OO'"
                        />
                        <Corrective t-if="invoice.refund_invoice_id">
                            <InvoiceNumber
                                t-length="20"
                                t-esc="invoice.refund_invoice_id.number or ''"
                                t-if="invoice.refund_invoice_id.number"
                            />
                            <InvoiceSeriesCode t-length="20" t-esc="''"/>
                            <ReasonCode t-esc="invoice.facturae_refund_reason"/>
                            <ReasonDescription
                                t-esc="invoice.get_refund_reason_string()"
                            />
                            <TaxPeriod>
                                <StartDate
                                    t-esc="invoice.refund_invoice_id.date_invoice"
                                />
                                <EndDate t-esc="invoice.refund_invoice_id.date_invoice"/>
                            </TaxPeriod>
                            <CorrectionMethod t-esc="invoice.correction_method"/>
                            <CorrectionMethodDescription
                                t-esc="invoice.get_correction_method_string()"
                            />
                            <AdditionalReasonDescription
                                t-length="2500"
                                t-esc="invoice.name"
                            />
                        </Corrective>
                    </InvoiceHeader>
                    <InvoiceIssueData>
                        <IssueDate t-esc="invoice.date_invoice"/>
                        <!-- Added by Moval 4/3/2025-->
                        <t t-if="invoice.service_date">
                            <OperationDate t-if="invoice.service_date" t-esc="invoice.service_date"/>
                        </t>
                        <t t-if="invoice.start_date">
                            <InvoicingPeriod>
                                <StartDate t-esc="start_date"/>
                                <EndDate t-esc="end_date"/>
                            </InvoicingPeriod>
                        </t>
                        <OperationDate t-if="False"/>
                        <PlaceOfIssue t-if="False"/>
                        <InvoicingPeriod t-if="False"/>
                        <InvoiceCurrencyCode t-esc="invoice.currency_id.name"/>
                        <ExchangeRateDetails t-if="invoice.currency_id.name != 'EUR'">
                            <!-- Modify by moval on 04.08.2025 -->
                            <t t-if="invoice.round_decimal">
                                <ExchangeRate t-esc="'%.2f' % (euro_rate / currency_rate)"/>
                            </t>
                            <t t-else="">
                                <ExchangeRate t-esc="'%.8f' % (euro_rate / currency_rate)"/>
                            </t>
                            <ExchangeRateDate
                                t-esc="invoice.get_exchange_rate(euro, currency)"
                            />
                        </ExchangeRateDetails>
                        <TaxCurrencyCode t-esc="'EUR'"/>
                        <!-- Los impuestos siempre deben estar en euros -->
                        <LanguageName t-esc="company.partner_id.lang[:2]"/>
                        <InvoiceDescription
                            t-length="2500"
                            t-if="invoice.comment"
                            t-esc="invoice.comment"
                        />
                        <ReceiverTransactionReference
                            t-esc="invoice.facturae_receiver_transaction_reference"
                            t-length="20"
                            t-if="invoice.facturae_receiver_transaction_reference"
                        />
                        <FileReference t-length="20" t-if="False"/>
                        <ReceiverContractReference
                            t-esc="invoice.facturae_receiver_contract_reference"
                            t-length="20"
                            t-if="invoice.facturae_receiver_contract_reference"
                        />
                    </InvoiceIssueData>

                     <!-- Modify by moval on 23.03.2026 -->
                    <TaxesOutputs>
                        <t t-foreach="invoice.tax_line_ids" t-as="tax_line">
                            <Tax t-if="tax_line.tax_id.amount &gt;= 0">
                                <TaxTypeCode t-esc="tax_line.tax_id.facturae_code"/>
                                <TaxRate t-esc="'%.2f' % (tax_line.tax_id.amount)"/>
                                <TaxableBase>
                                    <TotalAmount
                                        t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_gross_amount_before_taxes'], 2)"
                                    />
                                    <EquivalentInEuros
                                        t-esc="'%.2f' % (float(facturae_invoice_vals['total_gross_amount_before_taxes']) * euro_rate / currency_rate)"
                                    />
                                </TaxableBase>
                                <TaxAmount>
                                    <TotalAmount
                                        t-esc="'%.2f' % (float(facturae_invoice_vals['total_gross_amount_before_taxes']) * (tax_line.tax_id.amount) / 100)"
                                    />
                                    <EquivalentInEuros
                                        t-esc="'%.2f' % (float(facturae_invoice_vals['total_gross_amount_before_taxes']) * (tax_line.tax_id.amount) / 100 * euro_rate / currency_rate)"
                                    />
                                </TaxAmount>
                                <SpecialTaxableBase t-if="False"/>
                                <SpecialTaxAmount t-if="False"/>
                                <EquivalenceSurcharge t-if="False"/>
                                <EquivalenceSurchargeAmount t-if="False"/>
                            </Tax>
                        </t>
                    </TaxesOutputs>

                    <!-- Modify by moval on 23.03.2026 -->
                    <TaxesWithheld t-if="withheld">
                        <t t-foreach="invoice.tax_line_ids" t-as="tax_line">
                            <Tax t-if="tax_line.tax_id.amount &lt; 0">
                                <TaxTypeCode t-esc="tax_line.tax_id.facturae_code"/>
                                <TaxRate t-esc="'%.2f' % (-tax_line.tax_id.amount)"/>
                                <TaxableBase>
                                    <TotalAmount
                                        t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_gross_amount_before_taxes'], 2)"
                                    />
                                    <EquivalentInEuros
                                        t-esc="'%.2f' % (float(facturae_invoice_vals['total_gross_amount_before_taxes']) * euro_rate / currency_rate)"
                                    />
                                </TaxableBase>
                                <TaxAmount>
                                    <TotalAmount
                                        t-esc="'%.2f' % (float(facturae_invoice_vals['total_gross_amount_before_taxes']) * (-tax_line.tax_id.amount) / 100)"
                                    />
                                    <EquivalentInEuros
                                        t-esc="'%.2f' % (float(facturae_invoice_vals['total_gross_amount_before_taxes']) * (-tax_line.tax_id.amount) / 100 * euro_rate / currency_rate)"
                                    />
                                </TaxAmount>
                            </Tax>
                        </t>
                    </TaxesWithheld>

                    <InvoiceTotals>
                        <TotalGrossAmount
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_gross_amount'], 2)"
                        />

                        <GeneralDiscounts t-if="False"/>
                        <GeneralSurcharges t-if="False"/>

                        <TotalGeneralDiscounts
                            t-if="facturae_invoice_vals['total_general_discounts'] != 0"
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_general_discounts'], 2)"
                        />
                        <TotalGeneralSurcharges
                            t-if="facturae_invoice_vals['total_general_surcharges'] != 0"
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_general_surcharges'], 2)"
                        />

                        <TotalGrossAmountBeforeTaxes
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_gross_amount_before_taxes'], 2)"
                        />

                        <TotalTaxOutputs
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_tax_outputs'], 2)"
                        />

                        <TotalTaxesWithheld
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_taxes_withheld'], 2)"
                        />

                        <InvoiceTotal
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['invoice_total'], 2)"
                        />

                        <Subsidies t-if="False"/>
                        <PaymentsOnAccount t-if="False"/>
                        <ReimbursableExpenses t-if="False"/>
                        <TotalFinancialExpenses t-if="False"/>

                        <TotalOutstandingAmount
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_outstanding_amount'], 2)"
                        />

                        <TotalPaymentsOnAccount t-if="False"/>
                        <AmountsWithheld t-if="False"/>

                        <TotalExecutableAmount
                            t-esc="invoice._facturae_amount_to_str(facturae_invoice_vals['total_executable_amount'], 2)"
                        />

                        <TotalReimbursableExpenses t-if="False"/>

                        <PaymentInKind t-if="False">
                            <PaymentInKindReason t-length="2500" />
                            <PaymentInKindAmount />
                        </PaymentInKind>
                    </InvoiceTotals>
                    <Items>
                <!-- Modify by moval on 23.03.2026 -->
                <t t-foreach="invoice.invoice_line_ids" t-as="line">
                    <InvoiceLine>
                        <t t-set="withheld" t-value="False"/>
                        <t t-foreach="line.invoice_line_tax_ids" t-as="line_tax">
                            <t t-if="line_tax.amount &lt; 0">
                                <t t-set="withheld" t-value="True"/>
                            </t>
                        </t>

                        <t t-set="facturae_vals" t-value="invoice.get_facturae_line_amounts(line)"/>

                        <IssuerContractReference t-length="20" t-if="False"/>
                        <IssuerContractDate t-if="False"/>
                        <IssuerTransactionReference t-length="20" t-if="False"/>
                        <IssuerTransactionDate t-if="False"/>

                        <ReceiverContractReference
                            t-length="20"
                            t-esc="invoice.facturae_receiver_contract_reference"
                            t-if="invoice.facturae_receiver_contract_reference"
                        />
                        <ReceiverContractDate t-if="False"/>

                        <ReceiverTransactionReference
                            t-length="20"
                            t-esc="invoice.facturae_receiver_transaction_reference"
                            t-if="invoice.facturae_receiver_transaction_reference"
                        />
                        <ReceiverTransactionDate t-if="False"/>

                        <FileReference t-length="20" t-if="False"/>
                        <FileDate t-if="False"/>
                        <SequenceNumber t-if="False"/>
                        <DeliveryNotesReferences t-if="False"/>

                        <ItemDescription t-length="2500" t-esc="line.name"/>
                        <Quantity t-esc="line.quantity"/>
                        <UnitOfMeasure t-if="False"/>

                        <t t-if="invoice.round_decimal">
                            <UnitPriceWithoutTax
                                t-esc="invoice._facturae_amount_to_str(facturae_vals['unit_price'], 2)"
                            />
                        </t>
                        <t t-else="">
                            <UnitPriceWithoutTax
                                t-esc="invoice._facturae_amount_to_str(facturae_vals['unit_price'], 8)"
                            />
                        </t>

                        <TotalCost>
                            <t t-if="invoice.round_decimal">
                                <t t-esc="invoice._facturae_amount_to_str(facturae_vals['total_cost'], 2)"/>
                            </t>
                            <t t-else="">
                                <t t-esc="invoice._facturae_amount_to_str(facturae_vals['total_cost'], 8)"/>
                            </t>
                        </TotalCost>

                        <DiscountsAndRebates t-if="facturae_vals['has_discount']">
                            <Discount>
                                <DiscountReason t-esc="'Descuento'"/>
                                <t t-if="invoice.round_decimal">
                                    <DiscountRate t-esc="'%.2f' % (line.discount or 0.0)"/>
                                </t>
                                <t t-else="">
                                    <DiscountRate t-esc="'%.8f' % (line.discount or 0.0)"/>
                                </t>
                                <t t-if="invoice.round_decimal">
                                    <DiscountAmount
                                        t-esc="invoice._facturae_amount_to_str(facturae_vals['discount_amount'], 2)"
                                    />
                                </t>
                                <t t-else="">
                                    <DiscountAmount
                                        t-esc="invoice._facturae_amount_to_str(facturae_vals['discount_amount'], 8)"
                                    />
                                </t>
                            </Discount>
                        </DiscountsAndRebates>

                        <Charges t-if="facturae_vals['has_surcharge']">
                            <Charge>
                                <ChargeReason t-esc="'Recargo'"/>
                                <t t-if="invoice.round_decimal">
                                    <ChargeAmount
                                        t-esc="invoice._facturae_amount_to_str(facturae_vals['surcharge_amount'], 2)"
                                    />
                                </t>
                                <t t-else="">
                                    <ChargeAmount
                                        t-esc="invoice._facturae_amount_to_str(facturae_vals['surcharge_amount'], 8)"
                                    />
                                </t>
                            </Charge>
                        </Charges>

                        <t t-if="invoice.round_decimal">
                            <GrossAmount
                                t-esc="invoice._facturae_amount_to_str(facturae_vals['gross_amount'], 2)"
                            />
                        </t>
                        <t t-else="">
                            <GrossAmount
                                t-esc="invoice._facturae_amount_to_str(facturae_vals['gross_amount'], 8)"
                            />
                        </t>

                        <TaxesWithheld t-if="withheld">
                            <t t-foreach="line.invoice_line_tax_ids" t-as="line_tax">
                                <Tax t-if="line_tax.amount &lt; 0">
                                    <TaxTypeCode t-esc="line_tax.facturae_code"/>

                                    <t t-if="invoice.round_decimal">
                                        <TaxRate t-esc="'%.2f' % (-line_tax.amount)"/>
                                    </t>
                                    <t t-else="">
                                        <TaxRate t-esc="'%.8f' % (-line_tax.amount)"/>
                                    </t>

                                    <TaxableBase>
                                        <t t-if="invoice.round_decimal">
                                            <TotalAmount
                                                t-esc="invoice._facturae_amount_to_str(facturae_vals['taxable_base'], 2)"
                                            />
                                        </t>
                                        <t t-else="">
                                            <TotalAmount
                                                t-esc="invoice._facturae_amount_to_str(facturae_vals['taxable_base'], 8)"
                                            />
                                        </t>
                                        <EquivalentInEuros
                                            t-esc="'%.2f' % (float(facturae_vals['taxable_base']) * euro_rate / currency_rate)"
                                        />
                                    </TaxableBase>

                                    <TaxAmount>
                                        <t t-if="invoice.round_decimal">
                                            <TotalAmount
                                                t-esc="'%.2f' % (float(facturae_vals['taxable_base']) * (-line_tax.amount) / 100)"
                                            />
                                        </t>
                                        <t t-else="">
                                            <TotalAmount
                                                t-esc="'%.8f' % (float(facturae_vals['taxable_base']) * (-line_tax.amount) / 100)"
                                            />
                                        </t>
                                        <EquivalentInEuros
                                            t-esc="'%.2f' % (float(facturae_vals['taxable_base']) * (-line_tax.amount) / 100 * euro_rate / currency_rate)"
                                        />
                                    </TaxAmount>
                                </Tax>
                            </t>
                        </TaxesWithheld>

                        <TaxesOutputs>
                            <t t-foreach="line.invoice_line_tax_ids" t-as="line_tax">
                                <Tax t-if="line_tax.amount &gt;= 0">
                                    <TaxTypeCode t-esc="line_tax.facturae_code"/>

                                    <t t-if="invoice.round_decimal">
                                        <TaxRate t-esc="'%.2f' % (line_tax.amount)"/>
                                    </t>
                                    <t t-else="">
                                        <TaxRate t-esc="'%.8f' % (line_tax.amount)"/>
                                    </t>

                                    <TaxableBase>
                                        <t t-if="invoice.round_decimal">
                                            <TotalAmount
                                                t-esc="invoice._facturae_amount_to_str(facturae_vals['taxable_base'], 2)"
                                            />
                                        </t>
                                        <t t-else="">
                                            <TotalAmount
                                                t-esc="invoice._facturae_amount_to_str(facturae_vals['taxable_base'], 8)"
                                            />
                                        </t>
                                        <EquivalentInEuros
                                            t-esc="'%.2f' % (float(facturae_vals['taxable_base']) * euro_rate / currency_rate)"
                                        />
                                    </TaxableBase>

                                    <TaxAmount>
                                        <t t-if="invoice.round_decimal">
                                            <TotalAmount
                                                t-esc="'%.2f' % (float(facturae_vals['taxable_base']) * (line_tax.amount) / 100)"
                                            />
                                        </t>
                                        <t t-else="">
                                            <TotalAmount
                                                t-esc="'%.8f' % (float(facturae_vals['taxable_base']) * (line_tax.amount) / 100)"
                                            />
                                        </t>
                                        <EquivalentInEuros
                                            t-esc="'%.2f' % (float(facturae_vals['taxable_base']) * (line_tax.amount) / 100 * euro_rate / currency_rate)"
                                        />
                                    </TaxAmount>
                                </Tax>
                            </t>
                        </TaxesOutputs>

                        <LineItemPeriod t-if="False"/>
                        <TransactionDate t-if="False"/>
                        <AdditionalLineItemInformation t-length="2500" t-if="False"/>
                        <SpecialTaxableEvent t-if="False"/>
                        <ArticleCode t-length="20" t-if="False"/>
                        <Extensions t-if="False"/>
                    </InvoiceLine>
                </t>




                    </Items>
                    <PaymentDetails t-if="invoice.payment_mode_id">
                            <Installment>
                                <InstallmentDueDate
                                    t-esc="invoice.date_due or invoice.date_invoice"
                                />
                                <InstallmentAmount
                                    t-esc="'%.2f' % (invoice.residual)"
                                />
                                <PaymentMeans
                                    t-esc="invoice.payment_mode_id.facturae_code"
                                />
                                <AccountToBeDebited t-if="invoice.payment_mode_id.facturae_code == '02'">
                                    <IBAN
                                        t-minlength="5"
                                        t-length="34"
                                        t-esc="invoice.mandate_id.partner_bank_id.acc_number or ''"
                                        t-if="invoice.mandate_id.partner_bank_id.acc_number"
                                    />
                                    <BankCode
                                        t-length="60"
                                        t-esc="invoice.partner_bank_id.bank_id.code or ''"
                                        t-if="invoice.partner_bank_id.bank_id.code"
                                    />
                                    <BranchCode t-length="60" t-if="False"/>
                                    <BIC
                                        t-minlength="11"
                                        t-length="11"
                                        t-esc="invoice.mandate_id.partner_bank_id.bank_id.bic or ''"
                                        t-if="invoice.mandate_id.partner_bank_id.bank_id.bic"
                                    />
                                    <PaymentReconciliationReference
                                        t-length="60"
                                        t-if="False"
                                    />
                                </AccountToBeDebited>
                                <AccountToBeCredited t-if="invoice.payment_mode_id.facturae_code != '02'">
                                    <IBAN
                                        t-minlength="5"
                                        t-length="34"
                                        t-esc="invoice.partner_bank_id.acc_number or ''"
                                        t-if="invoice.partner_bank_id.acc_number"
                                    />
                                    <BankCode
                                        t-length="60"
                                        t-esc="invoice.partner_bank_id.bank_id.code or ''"
                                        t-if="invoice.partner_bank_id.bank_id.code"
                                    />
                                    <BranchCode t-length="60" t-if="False"/>
                                    <BIC
                                        t-minlength="11"
                                        t-length="11"
                                        t-esc="invoice.partner_bank_id.bank_id.bic or ''"
                                        t-if="invoice.partner_bank_id.bank_id.bic"
                                    />
                                </AccountToBeCredited>
                                <CollectionAdditionalInformation t-if="False"/>
                                <RegulatoryReportingData t-if="False"/>
                                <DebitReconciliationReference t-if="False"/>
                            </Installment>
                    </PaymentDetails>
                    <LegalLiterals t-if="False"/>
                    <AdditionalData t-if="invoice.comment">
                        <RelatedInvoice t-if="False"/>
                        <RelatedDocuments t-if="False"/>
                        <InvoiceAdditionalInformation
                            t-length="2500"
                            t-esc="invoice.comment"
                        />
                        <Extensions t-if="False"/>
                    </AdditionalData>
                </Invoice>
            </Invoices>
            <Extensions t-if="False"/>
        </t>
    </template>
</odoo>
