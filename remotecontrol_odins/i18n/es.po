#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<code>GET /backend/STH/v1/contextEntities/type/Device/id/{device_id}/"
"attributes/{sensor_id}</code> → get historical readings for a specific sensor"
msgstr ""
"<code>GET /backend/STH/v1/contextEntities/type/Device/id/{device_id}/"
"attributes/{sensor_id}</code> → obtener lecturas históricas de un sensor "
"específico"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<code>GET /backend/v2/entities/</code> → list all available entities/devices "
"and their sensor structure"
msgstr ""
"<code>GET /backend/v2/entities/</code> → lista todas las entidades/"
"dispositivos disponibles y su estructura de sensores."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<code>device_id</code>: ODINS device ID (format: Mex03:XXXXX)"
msgstr ""
"<code>device_id</code>: ID del dispositivo ODINS (formato: Mex03:XXXXX)"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<code>level</code>: For array sensors, specify the array index (0-7). For "
"single value sensors, leave empty."
msgstr ""
"<code>Nivel</code>: para sensores de matriz, especifique el índice de la "
"matriz (0-7). Para sensores de valor único, déjelo vacío."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<code>sensor_id</code>: Full sensor ID from ODINS response (e.g., "
"pulseCounter, Temperature)"
msgstr ""
"<code>sensor_id</code>: ID completo del sensor de la respuesta ODINS (por "
"ejemplo, pulseCounter, Temperature)."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<code>start_date</code>: Default start date if the sensor has no readings"
msgstr ""
"<code>start_date</code>: Fecha de inicio predeterminada si el sensor no "
"tiene lecturas."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<code>start_date</code>: Overrides the device start date if provided"
msgstr ""
"<code>start_date</code>: Anula la fecha de inicio del dispositivo si se "
"proporciona."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>Array sensor (Temperature level 0):</strong>"
msgstr "<strong>Sensor de matriz (nivel de temperatura 0):</strong>"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>Array sensor (Temperature level 3):</strong>"
msgstr "<strong>Sensor de matriz (nivel de temperatura 3):</strong>"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>Array sensors</strong>: Multi-level sensors (Temperature, Humidity, "
"Salinity) contain arrays with up to 8 values (indices 0-7)"
msgstr ""
"<strong>Sensores de matriz</strong>: los sensores multinivel (temperatura, "
"humedad, salinidad) contienen matrices con hasta 8 valores (índices 0-7)."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>Data validation</strong>: Module handles missing values, type "
"conversions, and timestamp parsing errors gracefully"
msgstr ""
"<strong>Validación de datos</strong>: el módulo gestiona con elegancia los "
"valores perdidos, las conversiones de tipos y los errores de análisis de "
"marcas de tiempo."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>Device list response:</strong>"
msgstr "<strong>Respuesta de la lista de dispositivos:</strong>"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>Dynamic sensor IDs</strong>: Sensor keys include unique MongoDB-"
"style IDs (e.g., Temperature)"
msgstr ""
"<strong>ID dinámicos de los sensores</strong>: las claves de los sensores "
"incluyen ID únicos al estilo MongoDB (por ejemplo, Temperatura)."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>Get Devices (Plan)</strong> → builds <code>bag[\"sensors_plan\"]</"
"code> with (sensor_id, device_parameter, sensor_parameter, level, dates)."
msgstr ""
"<strong>Obtener dispositivos (plan)</strong> → crea "
"<code>bag[\"sensors_plan\"]</code> con (sensor_id, device_parameter, "
"sensor_parameter, level, dates)."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>Get Devices</strong> → calls <code>GET /backend/v2/entities/</code> "
"to discover available devices and their sensors, then generates a structured "
"JSON file."
msgstr ""
"<strong>Obtener dispositivos</strong> → llama a <code>GET /backend/v2/"
"entities/</code> para descubrir los dispositivos disponibles y sus sensores, "
"y luego genera un archivo JSON estructurado."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>Get Sensor Readings</strong> → executes:\n"
"    <code>GET /backend/STH/v1/contextEntities/type/Device/id/{device_id}/"
"attributes/{sensor_id}?dateFrom=YYYY-MM-DDTHH:MM:SS.sssZ&amp;dateTo=YYYY-MM-"
"DDTHH:MM:SS.sssZ</code>\n"
"    for each sensor in the plan and updates readings in Odoo."
msgstr ""
"<strong>Obtener lecturas del sensor</strong> → ejecuta:\n"
"   <code>GET /backend/STH/v1/contextEntities/type/Device/id/{device_id}/"
"attributes/{sensor_id}?dateFrom=AAAA-MM-DDTHH:MM:SS.sssZ&amp;dateTo=AAAA-MM-"
"DDTHH:MM:SS.sss</code>Z\n"
"    para cada sensor del plan y actualiza las lecturas en Odoo."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>Humidity</strong>: Humidity sensors"
msgstr "<strong>Humedad</strong>: Sensores de humedad"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>Level configuration</strong>: Use numeric index (0, 1, 2, ..., 7) to "
"select which array position to read"
msgstr ""
"<strong>Configuración de nivel</strong>: utilice el índice numérico (0, 1, "
"2, ..., 7) para seleccionar qué posición de la matriz desea leer."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>ODINS: Get Devices</strong> → discovers all available entities/"
"devices from the platform and generates a structured JSON file for importing "
"devices and sensors into Odoo."
msgstr ""
"<strong>ODINS: Obtener dispositivos</strong> → descubre todas las entidades/"
"dispositivos disponibles en la plataforma y genera un archivo JSON "
"estructurado para importar dispositivos y sensores a Odoo."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>ODINS: Get Sensor Readings</strong> → builds sensor plan and "
"downloads readings from configured sensors for synchronization."
msgstr ""
"<strong>ODINS: Obtener lecturas de sensores</strong> → crea un plan de "
"sensores y descarga las lecturas de los sensores configurados para su "
"sincronización."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>Salinity</strong>: Salinity sensors"
msgstr "<strong>Salinidad</strong>: Sensores de salinidad"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>Sensor readings response:</strong>"
msgstr "<strong>Respuesta de las lecturas del sensor:</strong>"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>Single value sensor (pulseCounter):</strong>"
msgstr "<strong>Sensor de valor único (pulseCounter):</strong>"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>Temperature</strong>: Temperature sensors"
msgstr "<strong>Temperatura</strong>: Sensores de temperatura"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"<strong>Timestamp format</strong>: API returns ISO format "
"(2025-11-01T23:30:00.000Z), converted to Odoo format (2025-11-01 23:30:00)"
msgstr ""
"<strong>Formato de marca de tiempo</strong>: la API devuelve el formato ISO "
"(2025-11-01T23:30:00.000Z), convertido al formato Odoo (2025-11-01 23:30:00)."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>Usage:</strong>"
msgstr "<strong>Uso:</strong>"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>analogInput_*</strong>: Analog inputs (voltage, current, etc.)"
msgstr ""
"<strong>analogInput_*</strong>: Entradas analógicas (voltaje, corriente, "
"etc.)"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>connection_params</strong> (JSON):"

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "<strong>pulseCounter_*</strong>: Pulse counters (e.g., water meters)"
msgstr ""
"<strong>pulseCounter_*</strong>: Contadores de impulsos (por ejemplo, "
"contadores de agua)."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid ""
"Authentication is done via header: <code>x-access-token: &lt;token&gt;</"
"code>."
msgstr ""
"La autenticación se realiza a través del encabezado: <code>x-access-token: "
"&lt;token&gt;</code>."

#. module: remotecontrol_odins
#: model:remotecontrol,remotecontrol_help:remotecontrol_odins.remotecontrol_odins
msgid "Create necessary sensor types and UOMs in Odoo"
msgstr ""
"Crear los tipos de sensores y las unidades de medida necesarios en Odoo."

