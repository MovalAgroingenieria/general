<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ════════════════════════════════════════════════════════════════
         Member Type: List View
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_general_entity_member_type_list" model="ir.ui.view">
        <field name="name">general.entity.member.type.list</field>
        <field name="model">general.entity.member.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
                <field name="note" optional="hide" />
            </list>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         Member Type: Form View
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_general_entity_member_type_form" model="ir.ui.view">
        <field name="name">general.entity.member.type.form</field>
        <field name="model">general.entity.member.type</field>
        <field name="arch" type="xml">
            <form string="Member Type">
                <sheet>
                    <group>
                        <group>
                            <field name="code" />
                            <field name="name" />
                            <field name="sequence" />
                        </group>
                        <group>
                            <field name="active" />
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" placeholder="Notes..." />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         Member Type: Search View
         ════════════════════════════════════════════════════════════════ -->
    <record id="view_general_entity_member_type_search" model="ir.ui.view">
        <field name="name">general.entity.member.type.search</field>
        <field name="model">general.entity.member.type</field>
        <field name="arch" type="xml">
            <search string="Search Member Types">
                <field name="code" />
                <field name="name" />
                <filter
                    name="filter_active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="filter_inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <!-- ════════════════════════════════════════════════════════════════
         Member Type: Action
         ════════════════════════════════════════════════════════════════ -->
    <record id="action_general_entity_member_type" model="ir.actions.act_window">
        <field name="name">Member Types</field>
        <field name="res_model">general.entity.member.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Member Type
            </p>
            <p>
                Member types allow you to classify secondary members
                into categories for filtering and reporting.
            </p>
        </field>
    </record>
</odoo>
