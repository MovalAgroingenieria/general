<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Multi-company rule for General Entity Member.
        Users only see relationships belonging to their active companies.
    -->
    <record id="rule_general_entity_member_company" model="ir.rule">
        <field name="name">General Entity Member: Multi-company</field>
        <field name="model_id" ref="model_general_entity_member" />
        <field name="domain_force">
            ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
</odoo>
