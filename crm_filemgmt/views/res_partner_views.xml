<odoo>
    <record id="view_partner_form_inherit_files" model="ir.ui.view">
        <field name="name">res.partner: Files smart button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_get_files" type="object"
                        class="oe_stat_button" icon="fa-filemgmt-files"
                        invisible="number_of_files == 0">
                    <field name="number_of_files" widget="statinfo" string="Files"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
