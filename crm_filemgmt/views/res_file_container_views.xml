<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========== FORM VIEW ========== -->
    <record id="res_file_container_view_form" model="ir.ui.view">
        <field name="name">res.file.container.form</field>
        <field name="model">res.file.container</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_get_files"
                                class="oe_stat_button"
                                type="object"
                                icon="fa-folder-open">
                            <field name="number_of_files" string="Files"
                                   widget="statinfo"/>
                        </button>
                    </div>

                    <div class="oe_title"/>
                    <group name="master_data" col="12">
                        <group name="master_data_left" colspan="2">
                            <field name="image" widget="image" nolabel="1"
                                   colspan="2"/>
                        </group>
                        <group name="master_data_center" colspan="5">
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                        <group name="master_data_right" colspan="5">
                            <field name="location_id"/>
                            <field name="containertype_id"/>
                        </group>
                    </group>

                    <notebook name="slave_data_notebook" colspan="4">
                        <page name="notes_page" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========== TREE VIEW (principal) ========== -->
    <record id="res_file_container_view_tree" model="ir.ui.view">
        <field name="name">res.file.container.tree</field>
        <field name="model">res.file.container</field>
        <field name="arch" type="xml">
            <list string="File Containers" class="o_res_file_container">
                <field name="image" widget="image" optional="hide"
                       class="align-middle o_res_file_container_image"/>
                <field name="name" class="align-middle"/>
                <field name="location_id" class="align-middle"/>
                <field name="containertype_id" class="align-middle"/>
                <field name="description" class="align-middle" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ========== TREE VIEW (relacionada) ========== -->
    <record id="res_file_container_view_tree_related" model="ir.ui.view">
        <field name="name">res.file.container.tree.related</field>
        <field name="model">res.file.container</field>
        <field name="arch" type="xml">
            <list string="Related Containers" class="o_res_file_container">
                <field name="image" widget="image" optional="hide"
                       class="align-middle o_res_file_container_image"/>
                <field name="name"
                       class="align-middle o_res_file_container_container_code"/>
                <field name="containertype_id" class="align-middle"/>
                <field name="description" class="align-middle" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ========== SEARCH VIEW ========== -->
    <record id="res_file_container_view_search" model="ir.ui.view">
        <field name="name">res.file.container.search</field>
        <field name="model">res.file.container</field>
        <field name="arch" type="xml">
            <search string="Search Containers">
                <field name="name"/>
                <field name="description"/>
                <field name="containertype_id"/>
                <group expand="0" string="Group By">
                    <filter string="Location" name="groupby_location"
                            context="{'group_by':'location_id'}"/>
                    <filter string="Type" name="groupby_type"
                            context="{'group_by':'containertype_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========== ACTION ========== -->
    <record id="res_file_container_action" model="ir.actions.act_window">
        <field name="name">File Container</field>
        <field name="res_model">res.file.container</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
                (ref('crm_filemgmt.res_file_container_view_tree'), 'list'),
                (ref('crm_filemgmt.res_file_container_view_form'), 'form')
            ]"/>
        <field name="search_view_id"
               ref="crm_filemgmt.res_file_container_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Click to add a new file container
            </p>
        </field>
    </record>

    <!-- ========== MENU ========== -->
    <menuitem id="menu_files_container" name="Containers"
              parent="crm_filemgmt.menu_config_general_data"
              sequence="60"
              action="crm_filemgmt.res_file_container_action"/>


</odoo>
