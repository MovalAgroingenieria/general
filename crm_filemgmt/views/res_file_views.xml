<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========= FORM ========= -->
    <record id="res_file_view_form" model="ir.ui.view">
        <field name="name">res.file.form</field>
        <field name="model">res.file</field>
        <field name="arch" type="xml">
            <form string="File">
                <!-- Hidden technical fields -->
                <field name="id" invisible="1"/>
                <field name="active" invisible="1"/>
                <field name="is_blocked" invisible="1"/>
                <field name="is_closing_stage" invisible="1"/>

                <header>
                    <!-- Archive / unarchive buttons (no modifiers / attrs) -->
                    <button name="toggle_active"
                            type="object"
                            string="Archive"
                            class="btn-secondary"
                            confirm="Are you sure you want to archive this file?"
                            invisible="active == False"
                            groups="crm_filemgmt.group_file_manager"/>

                    <button name="toggle_active"
                            type="object"
                            string="Unarchive"
                            class="btn-secondary"
                            confirm="Are you sure you want to unarchive this file?"
                            invisible="active == True"
                            groups="crm_filemgmt.group_file_manager"/>

                    <!-- Block / unblock buttons -->
                    <button name="action_block_file"
                            type="object"
                            string="Block"
                            class="btn-warning"
                            style="width:105px;"
                            invisible="is_closing_stage or is_blocked"
                            groups="crm_filemgmt.group_file_manager"/>

                    <button name="action_unblock_file"
                            type="object"
                            string="Unblock"
                            class="btn-success"
                            style="width:125px;"
                            invisible="is_closing_stage or (not is_blocked)"
                            groups="crm_filemgmt.group_file_manager"/>

                    <!-- Print button -->
                    <button name="action_print_selected_report"
                            type="object"
                            string="Print"
                            class="btn-primary"
                            style="width:105px;"/>

                    <newline/>

                    <!-- Stage as statusbar (always visible) -->
                    <field name="stage_id"
                           widget="statusbar"
                           options="{'clickable': True, 'fold_field': 'fold'}"/>
                </header>

                <sheet>
                    <!-- Ribbons for archived / blocked -->
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon"
                            title="Blocked"
                            bg_color="text-bg-danger"
                            invisible="not is_blocked"/>

                    <!-- Master data -->
                    <group name="master_data">
                        <group name="master_data_left">
                            <field name="image" widget="image" nolabel="1"/>
                        </group>

                        <group name="master_data_center">
                            <field name="alphanum_code"/>
                            <field name="subject"/>
                            <field name="category_id"/>
                            <field name="file_report_id" string="Report"/>
                        </group>

                        <group name="master_data_right">
                            <field name="date_file"/>
                            <field name="container_id"
                                   context="{'show_container_data': True}"/>
                            <field name="technician_id"
                                   context="{'show_container_data': True}"/>
                            <field name="tag_ids"
                                   widget="many2many_tags"
                                   placeholder="Tags..."/>
                            <field name="closing_date"
                                   invisible="not is_closing_stage"/>
                        </group>
                    </group>

                    <!-- Notebook with related data -->
                    <notebook>
                        <!-- Partner links -->
                        <page name="partnerlinks_page" string="Partner Links">
                            <field name="partnerlink_ids"
                                   context="{'list_view_ref': 'crm_filemgmt.res_file_partnerlink_view_tree'}"/>
                        </page>

                        <!-- File links -->
                        <page name="filelinks_page" string="File Links">
                            <field name="filelink_ids"
                                   context="{'list_view_ref': 'crm_filemgmt.res_file_filelink_view_tree'}"/>
                        </page>

                        <!-- Comments -->
                        <page name="file_comments" string="Comments">
                            <group string="Top Comments">
                                <field name="file_top_comment_template_id"
                                       string="Load a template"
                                       domain="[('position','=','before_lines')]"
                                       context="{'default_position': 'before_lines'}"/>
                                <field name="file_top_comment" nolabel="1"/>
                            </group>
                            <group string="Bottom Comments">
                                <field name="file_bottom_comment_template_id"
                                       string="Load a template"
                                       domain="[('position','=','after_lines')]"
                                       context="{'default_position': 'after_lines'}"/>
                                <field name="file_bottom_comment" nolabel="1"/>
                            </group>
                        </page>

                        <!-- Start template -->
                        <page name="start_template_page" string="Template start">
                            <field name="template_start"/>
                            <div class="text-end">
                                <button name="action_get_start_template"
                                        type="object"
                                        class="btn btn-link"
                                        string="Refresh"
                                        help="Copy start template from selected report."
                                        groups="crm_filemgmt.group_file_manager"/>
                            </div>
                        </page>

                        <!-- End template -->
                        <page name="end_template_page" string="Template end">
                            <field name="template_end"/>
                            <div class="text-end">
                                <button name="action_get_end_template"
                                        type="object"
                                        class="btn btn-link"
                                        string="Refresh"
                                        help="Copy end template from selected report."
                                        groups="crm_filemgmt.group_file_manager"/>
                            </div>
                        </page>

                        <!-- Attachments (computed links to ir.attachment) -->
                        <page name="attachments" string="Attachments">
                            <field name="file_attachment_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="create_uid"/>
                                </list>
                            </field>
                        </page>

                        <!-- Notes -->
                        <page name="notes_page" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========= LIST (MAIN) ========= -->
    <record id="res_file_view_list" model="ir.ui.view">
        <field name="name">res.file.list</field>
        <field name="model">res.file</field>
        <field name="arch" type="xml">
            <list class="o_res_file" string="Files" default_order="alphanum_code desc">
                <field name="image" widget="image" optional="hide"
                       class="o_res_file_image"/>
                <field name="alphanum_code" class="align-middle"/>
                <field name="partner_id" optional="show" class="align-middle"/>
                <field name="date_file" optional="show"
                       class="align-middle o_res_file_date_file"/>
                <field name="subject" optional="show"
                       class="align-middle border-right"/>
                <field name="stage_id" string="Stage" optional="show"
                       class="align-middle o_res_file_stage_id"/>
                <field name="technician_id" optional="show" class="align-middle"/>
                <field name="category_id" optional="hide"
                       class="align-middle o_res_file_category_id"/>
                <field name="is_blocked" optional="show"
                       class="align-middle o_res_file_is_blocked"/>
                <field name="tag_ids" widget="many2many_tags" optional="hide"
                       class="align-middle"/>
            </list>
        </field>
    </record>

    <!-- ========= LIST (RELATED) ========= -->
    <record id="res_file_view_list_related" model="ir.ui.view">
        <field name="name">res.file.list.related</field>
        <field name="model">res.file</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" default_order="alphanum_code desc">
                <field name="active" invisible="1"/>
                <field name="alphanum_code" class="align-middle"/>
                <field name="partner_id" optional="show" class="align-middle"/>
                <field name="date_file" optional="show"
                       class="align-middle o_res_file_date_file"/>
                <field name="category_id" optional="hide"
                       class="align-middle o_res_file_category_id"/>
                <field name="subject" optional="show"
                       class="align-middle border-right"/>
                <field name="technician_id" optional="show" class="align-middle"/>
                <field name="is_blocked" optional="show"
                       class="align-middle o_res_file_is_blocked"/>
            </list>
        </field>
    </record>

    <!-- ========= SEARCH ========= -->
    <record id="res_file_view_search" model="ir.ui.view">
        <field name="name">res.file.search</field>
        <field name="model">res.file</field>
        <field name="arch" type="xml">
            <search string="Search Files">
                <field name="alphanum_code"/>
                <field name="partner_id"/>
                <field name="date_file"/>
                <field name="subject"/>
                <field name="category_id"/>
                <field name="technician_id"/>
                <field name="stage_id"/>
                <field name="active"/>

                <!-- Filters -->
                <filter string="In closed stage"
                        name="closed_stage"
                        domain="[('is_closing_stage','=', True)]"/>
                <separator/>
                <filter string="Blocked: Yes"
                        name="blocked_yes"
                        domain="[('is_blocked','=', True)]"/>
                <filter string="Blocked: No"
                        name="blocked_no"
                        domain="[('is_blocked','=', False)]"/>
                <separator/>
                <filter string="Archived: Yes"
                        name="archived_yes"
                        domain="[('active','=', False)]"/>
                <filter string="Archived: No"
                        name="archived_no"
                        domain="[('active','=', True)]"/>
                <separator/>
                <filter string="With technician: Yes"
                        name="technician_yes"
                        domain="[('with_technician','=', True)]"/>
                <filter string="With technician: No"
                        name="technician_no"
                        domain="[('with_technician','=', False)]"/>

                <!-- Group by -->
                <group expand="0" string="Group By">
                    <filter string="Partner"
                            name="groupby_partner"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Technician"
                            name="groupby_technician"
                            context="{'group_by':'technician_id'}"/>
                    <filter string="Stage"
                            name="groupby_stage"
                            context="{'group_by':'stage_id'}"/>
                    <filter string="Category"
                            name="groupby_category"
                            context="{'group_by':'category_id'}"/>
                    <filter string="Container"
                            name="groupby_container"
                            context="{'group_by':'container_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ========= KANBAN ========= -->
    <record id="res_file_view_kanban" model="ir.ui.view">
        <field name="name">res.file.kanban</field>
        <field name="model">res.file</field>
        <field name="arch" type="xml">
            <kanban string="Files" default_group_by="stage_id">
                <field name="id"/>
                <field name="active"/>
                <field name="alphanum_code"/>
                <field name="partner_id"/>
                <field name="date_file"/>
                <field name="subject"/>
                <field name="stage_id"/>
                <field name="tag_ids"/>
                <field name="image"/>
                <field name="color"/>
                <field name="closing_date"/>
                <field name="is_blocked"/>
                <field name="has_filelinks"/>
                <field name="has_attachments"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_global_click o_kanban_record_has_image_fill">
                            <!-- Dropdown menu -->
                            <div class="o_dropdown_kanban dropdown" groups="crm_filemgmt.group_file_user">
                                <a class="dropdown-toggle o-no-caret btn"
                                   data-toggle="dropdown"
                                   data-display="static"
                                   href="#"
                                   role="button"
                                   aria-label="Dropdown menu"
                                   title="Dropdown menu">
                                    <i class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a type="edit" class="dropdown-item">Edit File</a>
                                    <a type="delete" class="dropdown-item">Delete File</a>
                                    <div class="oe_kanban_colorpicker" data-field="color" role="menu"/>
                                </div>
                            </div>

                            <!-- Left image block -->
                            <div class="oe_kanban_details"
                                 style="max-width:30%; margin-left:2%; margin-top:2%;">
                                <div class="o_kanban_image_fill_left o_kanban_image_full"
                                     role="img"
                                     t-attf-style="background-image: url(/web/image/res.file/#{record.id.raw_value}/image)">
                                    <img class="o_kanban_image_inner_pic"
                                         t-if="record.partner_id.raw_value"
                                         t-att-alt="record.partner_id.value"
                                         t-attf-src="/web/image/res.partner/#{record.partner_id.raw_value}/image_128"/>
                                </div>
                            </div>

                            <!-- Right details block -->
                            <div class="oe_kanban_details">
                                <!-- Archived label -->
                                <div name="archived">
                                    <t t-if="record.active.raw_value">
                                        <span/>
                                    </t>
                                    <t t-else="">
                                        <span style="color:red; float:right; margin-right:3%; font-size:10px;">
                                            A R C H I V E D
                                        </span>
                                    </t>
                                </div>
                                <div style="clear:both;"/>

                                <!-- Header with code and icons -->
                                <div style="display:flex;">
                                    <strong class="o_kanban_record_title" style="float:left;">
                                        <field name="alphanum_code"/>
                                    </strong>
                                    <t t-if="record.is_blocked.raw_value">
                                        <i style="color:red; float:right; margin-right:3%;"
                                           title="lock"
                                           class="fa fa-lock fa-lg"/>
                                    </t>
                                    <t t-if="record.has_attachments.raw_value">
                                        <i style="float:right; margin-right:3%;"
                                           title="attachment"
                                           class="fa fa-paperclip o_button_icon"/>
                                    </t>
                                    <t t-if="record.has_filelinks.raw_value">
                                        <i style="float:right; margin-right:3%;"
                                           title="files"
                                           class="fa fa-copy o_button_icon"/>
                                    </t>
                                </div>
                                <div style="clear:both;"/>

                                <!-- Main info -->
                                <ul>
                                    <li t-if="record.partner_id.raw_value" class="o_text_overflow">
                                        <strong>
                                            <field name="partner_id"/>
                                        </strong>
                                    </li>
                                    <li>Date:
                                        <field name="date_file"/>
                                    </li>
                                    <li t-if="record.subject.raw_value" class="o_text_overflow">
                                        Subject:
                                        <field name="subject"/>
                                    </li>
                                    <li t-if="record.closing_date.raw_value">
                                        Closing date:
                                        <field name="closing_date"/>
                                    </li>
                                </ul>

                                <!-- Tags -->
                                <div class="o_kanban_tags_section">
                                    <span class="oe_kanban_list_many2many">
                                        <field name="tag_ids"
                                               widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========= CALENDAR ========= -->
    <record id="res_file_view_calendar" model="ir.ui.view">
        <field name="name">res.file.calendar</field>
        <field name="model">res.file</field>
        <field name="arch" type="xml">
            <calendar string="Files" date_start="date_file" color="category_id" mode="month">
                <field name="subject"/>
                <field name="stage_id"/>
                <field name="partner_id"/>
            </calendar>
        </field>
    </record>

    <!-- ========= ACTION ========= -->
    <record id="res_file_action" model="ir.actions.act_window">
        <field name="name">Files</field>
        <field name="res_model">res.file</field>
        <field name="view_mode">list,form,kanban,calendar</field>
        <field name="views" eval="[
            (ref('crm_filemgmt.res_file_view_list'), 'list'),
            (ref('crm_filemgmt.res_file_view_form'), 'form'),
            (ref('crm_filemgmt.res_file_view_kanban'), 'kanban'),
            (ref('crm_filemgmt.res_file_view_calendar'), 'calendar')
        ]"/>
        <field name="search_view_id" ref="crm_filemgmt.res_file_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Click to add a new file.
            </p>
        </field>
    </record>

    <!-- ========= PARTNERLINK VIEWS ========= -->
    <record id="res_file_partnerlink_view_form" model="ir.ui.view">
        <field name="name">res.file.partnerlink.form</field>
        <field name="model">res.file.partnerlink</field>
        <field name="arch" type="xml">
            <form string="File Partner Link">
                <sheet>
                    <group>
                        <field name="file_id"/>
                        <field name="category_id"/>
                        <field name="partner_id"/>
                        <field name="is_main"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_file_partnerlink_view_list" model="ir.ui.view">
        <field name="name">res.file.partnerlink.list</field>
        <field name="model">res.file.partnerlink</field>
        <field name="arch" type="xml">
            <list editable="bottom" class="o_res_file_partnerlink">
                <field name="partner_id" class="align-middle"/>
                <field name="is_main"
                       class="align-middle o_res_file_partnerlink_is_main"/>
            </list>
        </field>
    </record>

    <record id="res_file_partnerlink_of_partner_view_list" model="ir.ui.view">
        <field name="name">res.file.partnerlink.of.partner.list</field>
        <field name="model">res.file.partnerlink</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false"
                  class="o_res_file_partnerlink">
                <field name="date_file"
                       class="align-middle o_res_file_partnerlink_of_partner_date_file"/>
                <field name="file_id" class="align-middle"/>
                <field name="stage_id"
                       class="align-middle o_res_file_partnerlink_of_partner_stage_id"/>
                <field name="is_main"
                       class="align-middle o_res_file_partnerlink_of_partner_is_main"/>
            </list>
        </field>
    </record>

    <!-- ========= FILELINK VIEWS ========= -->
    <record id="res_file_filelink_view_form" model="ir.ui.view">
        <field name="name">res.file.filelink.form</field>
        <field name="model">res.file.filelink</field>
        <field name="arch" type="xml">
            <form string="File Link">
                <sheet>
                    <group>
                        <field name="file_id"/>
                        <field name="related_file_id"/>
                        <field name="related_file_category_id"/>
                        <field name="related_file_subject"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_file_filelink_view_list" model="ir.ui.view">
        <field name="name">res.file.filelink.list</field>
        <field name="model">res.file.filelink</field>
        <field name="arch" type="xml">
            <list class="o_res_file_filelink" editable="bottom"
                  default_order="related_file_id desc">
                <field name="related_file_category_id" readonly="1"/>
                <field name="related_file_id"/>
                <field name="related_file_subject"/>
            </list>
        </field>
    </record>

    <record id="res_file_filelink_view_search" model="ir.ui.view">
        <field name="name">res.file.filelink.search</field>
        <field name="model">res.file.filelink</field>
        <field name="arch" type="xml">
            <search string="Search File Links">
                <field name="file_id"/>
            </search>
        </field>
    </record>

    <!-- ========= MENU ========= -->
    <menuitem id="menu_files"
              name="Files"
              parent="crm_filemgmt.menu_filemgmt"
              sequence="10"
              action="crm_filemgmt.res_file_action"/>

</odoo>
