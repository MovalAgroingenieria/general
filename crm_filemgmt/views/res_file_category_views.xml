<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view -->
    <record id="res_file_category_view_form" model="ir.ui.view">
        <field name="name">res.file.category.form</field>
        <field name="model">res.file.category</field>
        <field name="arch" type="xml">
            <form duplicate="0">
                <field name="is_readonly" invisible="1"/>
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_get_files"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-folder-open"
                                modifiers="{'invisible': [('number_of_files','=', 0)]}">
                            <div class="o_form_field o_stat_info">
                                <field name="number_of_files"/>
                                <span modifiers="{'invisible': [('number_of_files','>', 1)]}">
                                    file
                                </span>
                                <span modifiers="{'invisible': [('number_of_files','=', 1)]}">
                                    files
                                </span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label class="oe_edit_only" for="name"
                               string="Category Name"/>
                        <h1>
                            <field name="name" placeholder="Category Name"
                                   modifiers="{'readonly': [('is_readonly','=', True)]}"/>
                        </h1>
                        <field name="parent_id"
                               modifiers="{'readonly': [('is_readonly','=', True)]}"/>
                    </div>

                    <group name="master_data"/>
                    <notebook name="slave_data_notebook" colspan="4">
                        <page name="notes_page" string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view -->
    <record id="res_file_category_view_tree" model="ir.ui.view">
        <field name="name">res.file.category.tree</field>
        <field name="model">res.file.category</field>
        <field name="arch" type="xml">
            <list string="File Categories">
                <field name="name"/>
                <field name="number_of_files"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="res_file_category_view_search" model="ir.ui.view">
        <field name="name">res.file.category.search</field>
        <field name="model">res.file.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="res_file_category_action" model="ir.actions.act_window">
        <field name="name">File Category</field>
        <field name="res_model">res.file.category</field>
        <field name="view_mode">list,form</field>
        <field name="views" eval="[
        (ref('res_file_category_view_tree'), 'list'),
        (ref('res_file_category_view_form'), 'form')
      ]"/>
        <field name="search_view_id" ref="res_file_category_view_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add a new file category
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_file_category"
              name="Categories"
              parent="crm_filemgmt.menu_config_general_data"
              sequence="20"
              action="res_file_category_action"/>
</odoo>
