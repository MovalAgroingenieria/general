<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Server action: iframe -->
    <record id="login_into_account_modify_payment_batches_communication_action"
            model="ir.actions.server">
        <field name="name">Account Modify Payment Batches Communication</field>
        <field name="model_id" ref="model_account_modify_payment_batches_communication"/>
        <field name="state">code</field>
        <field name="code">
            action = env['account.modify.payment.batches.communication'].action_open_iframe()
        </field>
    </record>

    <menuitem id="account_modify_payment_batches_communication_menu"
              name="Modify Payment Batches Communication"
              parent="account_payment_order.payment_root"
              action="login_into_account_modify_payment_batches_communication_action"
              sequence="52"/>

</odoo>
