#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>\"flow\"</code> → Reads from NombreSensorCaudal + ValorSensorCaudal"
msgstr "<code>\"flow\"</code> → Lee de NombreSensorCaudal + ValorSensorCaudal"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>\"pressure\"</code> → Reads from NombreSensorPresion + ValorSensorPresion"
msgstr "<code>\"pressure\"</code> → Lee de NombreSensorPresion + ValorSensorPresion"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>\"volume\"</code> → Reads from NombreSensorCaudal + ValorVolumen"
msgstr "<code>\"volume\"</code> → Lee de NombreSensorCaudal + ValorVolumen"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>credentials_json</code>: Name of the attachment containing Google Cloud service account JSON credentials"
msgstr "<code>credentials_json</code>: Nombre del adjunto que contiene el JSON de credenciales de la cuenta de servicio de Google Cloud"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>dataset_id</code>: BigQuery dataset name"
msgstr "<code>dataset_id</code>: Nombre del dataset de BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>device_id</code>: Device identifier that matches EstacionBombeo in BigQuery"
msgstr "<code>device_id</code>: Identificador del dispositivo que debe coincidir con EstacionBombeo en BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>project_id</code>: Google Cloud Project ID containing the BigQuery dataset"
msgstr "<code>project_id</code>: ID del proyecto de Google Cloud que contiene el dataset de BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>sensor_id</code>: Sensor identifier that matches sensor names in BigQuery"
msgstr "<code>sensor_id</code>: Identificador del sensor que coincide con los nombres de sensores en BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>start_date</code>: Initial sync date (default: last reading or current year start)"
msgstr "<code>start_date</code>: Fecha inicial de sincronización (por defecto: última lectura o inicio del año)"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>start_date</code>: Override device start_date for this specific sensor"
msgstr "<code>start_date</code>: Sobrescribe la fecha inicial del dispositivo solo para este sensor concreto"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>table_name</code>: BigQuery table name containing sensor data"
msgstr "<code>table_name</code>: Nombre de la tabla BigQuery que contiene los datos de sensores"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>type</code>: Sensor type determining which BigQuery field to read from"
msgstr "<code>type</code>: Tipo de sensor que determina qué campo de BigQuery debe leerse"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Attachment not found:</strong> Ensure credentials JSON file is uploaded with exact name matching credentials_json parameter"
msgstr "<strong>Adjunto no encontrado:</strong> Asegúrate de que el archivo JSON de credenciales está subido y su nombre coincide exactamente con el parámetro credentials_json"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Build Device/Sensor Plan</strong> - Loads configured devices/sensors from Odoo with remotecontrol_params"
msgstr "<strong>Construir plan de dispositivos/sensores</strong> - Carga los dispositivos y sensores configurados en Odoo mediante remotecontrol_params"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Configure connection:</strong> Set connection_params with project, dataset, table, and credentials file name"
msgstr "<strong>Configurar conexión:</strong> Establece connection_params con proyecto, dataset, tabla y nombre del archivo de credenciales"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Create devices:</strong> Create mdm.measurement.device records with device_id in remotecontrol_params"
msgstr "<strong>Crear dispositivos:</strong> Crea registros mdm.measurement.device con device_id dentro de remotecontrol_params"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Create sensors:</strong> Create mdm.measurement.device.sensor records with type in remotecontrol_params"
msgstr "<strong>Crear sensores:</strong> Crea registros mdm.measurement.device.sensor con type dentro de remotecontrol_params"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Device matching:</strong> EstacionBombeo = device.remotecontrol_params.device_id"
msgstr "<strong>Coincidencia de dispositivo:</strong> EstacionBombeo = device.remotecontrol_params.device_id"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Fetch and Parse Rows</strong> - Queries BigQuery table for new data since last sync"
msgstr "<strong>Obtener y procesar filas</strong> - Consulta la tabla BigQuery para obtener datos nuevos desde la última sincronización"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>IMPORTANT:</strong> Upload the Google Cloud service account JSON credentials file as an attachment to this remotecontrol record. The attachment name must match the <code>credentials_json</code> parameter value."
msgstr "<strong>IMPORTANTE:</strong> Sube el archivo JSON de credenciales de la cuenta de servicio de Google Cloud como adjunto en este registro de telecontrol. El nombre del adjunto debe coincidir con el valor del parámetro <code>credentials_json</code>."

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>No data:</strong> Check start_date configuration and BigQuery table time range"
msgstr "<strong>Sin datos:</strong> Comprueba start_date y el rango temporal disponible en la tabla BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>No sensors found:</strong> Verify device_id and sensor_id in remotecontrol_params match BigQuery data exactly"
msgstr "<strong>No se encontraron sensores:</strong> Verifica que device_id y sensor_id en remotecontrol_params coinciden exactamente con los datos de BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Schedule:</strong> Enable automatic scheduling if desired"
msgstr "<strong>Programación:</strong> Activa la programación automática si se desea"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Sensor matching:</strong> Sensor name field = sensor.remotecontrol_params.sensor_id"
msgstr "<strong>Coincidencia de sensor:</strong> Campo de nombre del sensor = sensor.remotecontrol_params.sensor_id"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Test sync:</strong> Run \"Daily Sync\" procedure manually to verify configuration"
msgstr "<strong>Probar sincronización:</strong> Ejecuta manualmente el procedimiento \"Daily Sync\" para verificar la configuración"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Type mismatch:</strong> Ensure sensor type matches available data (pressure sensors need NombreSensorPresion data)"
msgstr "<strong>Tipo incorrecto:</strong> Asegúrate de que el tipo de sensor coincide con los datos disponibles (los sensores de presión necesitan datos en NombreSensorPresion)"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Type validation:</strong> sensor.remotecontrol_params.type determines which data fields to use"
msgstr "<strong>Validación de tipo:</strong> sensor.remotecontrol_params.type determina qué campos de datos se usan"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Type:</strong> SQL Database Connection (BigQuery)"
msgstr "<strong>Tipo:</strong> Conexión a base de datos SQL (BigQuery)"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Upload credentials:</strong> Attach Google Cloud service account JSON to this remotecontrol record"
msgstr "<strong>Subir credenciales:</strong> Adjunta el JSON de la cuenta de servicio de Google Cloud a este registro de telecontrol"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<strong>Upsert Readings</strong> - Processes data and creates/updates readings in mdm.measurement.device.sensor.reading"
msgstr "<strong>Insertar/Actualizar lecturas</strong> - Procesa los datos y crea/actualiza lecturas en mdm.measurement.device.sensor.reading"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "A) Daily Sync (Scheduled)"
msgstr "A) Sincronización diaria (Programada)"

