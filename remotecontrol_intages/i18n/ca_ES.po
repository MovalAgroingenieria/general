#. module: remotecontrol_intages
msgid "fechahora              : TIMESTAMP - Reading timestamp\n"
"EstacionBombeo         : STRING    - Pumping station identifier\n"
"NombreSensorPresion    : STRING    - Pressure sensor name (nullable)\n"
"NombreSensorCaudal     : STRING    - Flow sensor name (nullable)\n"
"ValorSensorPresion     : FLOAT     - Pressure sensor value (nullable)\n"
"ValorSensorCaudal      : FLOAT     - Flow sensor value (nullable)\n"
"ValorVolumen           : FLOAT     - Volume value (nullable)"
msgstr "fechahora              : TIMESTAMP - Data i hora de lectura\n"
"EstacionBombeo         : STRING    - Identificador de l’estació de bombeig\n"
"NombreSensorPresion    : STRING    - Nom del sensor de pressió (pot ser nul)\n"
"NombreSensorCaudal     : STRING    - Nom del sensor de cabal (pot ser nul)\n"
"ValorSensorPresion     : FLOAT     - Valor del sensor de pressió (pot ser nul)\n"
"ValorSensorCaudal      : FLOAT     - Valor del sensor de cabal (pot ser nul)\n"
"ValorVolumen           : FLOAT     - Valor del volum (pot ser nul)"

