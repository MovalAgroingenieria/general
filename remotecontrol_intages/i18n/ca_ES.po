#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>\"flow\"</code> → Reads from NombreSensorCaudal + ValorSensorCaudal"
msgstr "<code>\"flow\"</code> → Llegeix de NombreSensorCaudal + ValorSensorCaudal"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>\"pressure\"</code> → Reads from NombreSensorPresion + ValorSensorPresion"
msgstr "<code>\"pressure\"</code> → Llegeix de NombreSensorPresion + ValorSensorPresion"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>\"volume\"</code> → Reads from NombreSensorCaudal + ValorVolumen"
msgstr "<code>\"volume\"</code> → Llegeix de NombreSensorCaudal + ValorVolumen"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>credentials_json</code>: Name of the attachment containing Google Cloud service account JSON credentials"
msgstr "<code>credentials_json</code>: Nom de l’adjunt que conté les credencials JSON del compte de servei de Google Cloud"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>dataset_id</code>: BigQuery dataset name"
msgstr "<code>dataset_id</code>: Nom del dataset BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>device_id</code>: Device identifier that matches EstacionBombeo in BigQuery"
msgstr "<code>device_id</code>: Identificador del dispositiu que ha de coincidir amb EstacionBombeo a BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>project_id</code>: Google Cloud Project ID containing the BigQuery dataset"
msgstr "<code>project_id</code>: ID del projecte de Google Cloud que conté el dataset de BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>sensor_id</code>: Sensor identifier that matches sensor names in BigQuery"
msgstr "<code>sensor_id</code>: Identificador del sensor que coincideix amb els noms de sensors a BigQuery"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>start_date</code>: Initial sync date (default: last reading or current year start)"
msgstr "<code>start_date</code>: Data inicial de sincronització (per defecte: última lectura o inici de l'any)"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>start_date</code>: Override device start_date for this specific sensor"
msgstr "<code>start_date</code>: Sobreescriu la data inicial del dispositiu només per a aquest sensor concret"

#. module: remotecontrol_intages
#: model:remotecontrol,remotecontrol_help:remotecontrol_intages.remotecontrol_intages
msgid "<code>table_name</code>: BigQuery table name containing sensor data"
msgstr "<code>table_name</code>: Nom de la taula BigQuery que conté les dades dels sensors"

#. module: remotecontrol_intages
msgid "<code>type</code>: Sensor type determining which BigQuery field to read from"
msgstr "<code>type</code>: Tipus de sensor que determina quin camp de BigQuery s'ha de llegir"

#. module: remotecontrol_intages
msgid "<strong>Attachment not found:</strong> Ensure credentials JSON file is uploaded with exact name matching credentials_json parameter"
msgstr "<strong>Adjunt no trobat:</strong> Assegura’t que el fitxer JSON de credencials està pujat i el nom coincideix exactament amb el valor de credentials_json"

#. module: remotecontrol_intages
msgid "<strong>Build Device/Sensor Plan</strong> - Loads configured devices/sensors from Odoo with remotecontrol_params"
msgstr "<strong>Construir pla de dispositius/sensors</strong> - Carrega els dispositius i sensors configurats a Odoo mitjançant remotecontrol_params"

#. module: remotecontrol_intages
msgid "<strong>Configure connection:</strong> Set connection_params with project, dataset, table, and credentials file name"
msgstr "<strong>Configurar connexió:</strong> Estableix connection_params amb projecte, dataset, taula i nom del fitxer de credencials"

#. module: remotecontrol_intages
msgid "<strong>Create devices:</strong> Create mdm.measurement.device records with device_id in remotecontrol_params"
msgstr "<strong>Crear dispositius:</strong> Crea registres mdm.measurement.device amb device_id dins de remotecontrol_params"

#. module: remotecontrol_intages
msgid "<strong>Create sensors:</strong> Create mdm.measurement.device.sensor records with type in remotecontrol_params"
msgstr "<strong>Crear sensors:</strong> Crea registres mdm.measurement.device.sensor amb type dins de remotecontrol_params"

#. module: remotecontrol_intages
msgid "<strong>Device matching:</strong> EstacionBombeo = device.remotecontrol_params.device_id"
msgstr "<strong>Coincidència de dispositiu:</strong> EstacionBombeo = device.remotecontrol_params.device_id"

#. module: remotecontrol_intages
msgid "<strong>Fetch and Parse Rows</strong> - Queries BigQuery table for new data since last sync"
msgstr "<strong>Obtenir i analitzar files</strong> - Consulta la taula BigQuery per obtenir dades noves des de l’última sincronització"

#. module: remotecontrol_intages
msgid "<strong>IMPORTANT:</strong> Upload the Google Cloud service account JSON credentials file as an attachment to this remotecontrol record. The attachment name must match the <code>credentials_json</code> parameter value."
msgstr "<strong>IMPORTANT:</strong> Puja el fitxer JSON de credencials del compte de servei de Google Cloud com a adjunt en aquest registre de telecontrol. El nom de l’adjunt ha de coincidir amb el valor de <code>credentials_json</code>."

#. module: remotecontrol_intages
msgid "<strong>No data:</strong> Check start_date configuration and BigQuery table time range"
msgstr "<strong>Sense dades:</strong> Comprova start_date i el rang temporal disponible a la taula BigQuery"

#. module: remotecontrol_intages
msgid "<strong>No sensors found:</strong> Verify device_id and sensor_id in remotecontrol_params match BigQuery data exactly"
msgstr "<strong>No s’han trobat sensors:</strong> Verifica que device_id i sensor_id a remotecontrol_params coincideixen exactament amb les dades de BigQuery"

#. module: remotecontrol_intages
msgid "<strong>Schedule:</strong> Enable automatic scheduling if desired"
msgstr "<strong>Programació:</strong> Activa la programació automàtica si es desitja"

#. module: remotecontrol_intages
msgid "<strong>Sensor matching:</strong> Sensor name field = sensor.remotecontrol_params.sensor_id"
msgstr "<strong>Coincidència de sensor:</strong> Camp de nom del sensor = sensor.remotecontrol_params.sensor_id"

#. module: remotecontrol_intages
msgid "<strong>Test sync:</strong> Run \"Daily Sync\" procedure manually to verify configuration"
msgstr "<strong>Provar sincronització:</strong> Executa manualment el procediment «Daily Sync» per verificar la configuració"

#. module: remotecontrol_intages
msgid "<strong>Type mismatch:</strong> Ensure sensor type matches available data (pressure sensors need NombreSensorPresion data)"
msgstr "<strong>Tipus incorrecte:</strong> Assegura’t que el tipus de sensor coincideix amb les dades disponibles (els sensors de pressió necessiten dades a NombreSensorPresion)"

#. module: remotecontrol_intages
msgid "<strong>Type validation:</strong> sensor.remotecontrol_params.type determines which data fields to use"
msgstr "<strong>Validació de tipus:</strong> sensor.remotecontrol_params.type determina quins camps de dades s’utilitzen"

#. module: remotecontrol_intages
msgid "<strong>Type:</strong> SQL Database Connection (BigQuery)"
msgstr "<strong>Tipus:</strong> Connexió a base de dades SQL (BigQuery)"

#. module: remotecontrol_intages
msgid "<strong>Upload credentials:</strong> Attach Google Cloud service account JSON to this remotecontrol record"
msgstr "<strong>Pujar credencials:</strong> Adjunta el JSON del compte de servei de Google Cloud a aquest registre de telecontrol"

#. module: remotecontrol_intages
msgid "<strong>Upsert Readings</strong> - Processes data and creates/updates readings in mdm.measurement.device.sensor.reading"
msgstr "<strong>Inserir/Actualitzar lectures</strong> - Processa les dades i crea/actualitza lectures a mdm.measurement.device.sensor.reading"

#. module: remotecontrol_intages
msgid "A) Daily Sync (Scheduled)"
msgstr "A) Sincronització diària (Programada)"

