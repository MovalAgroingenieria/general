<?xml version="1.0" encoding="utf-8"?>
<odoo>

 <record id="mdm_device_view_form" model="ir.ui.view">
        <field name="name">Measurement Device Form</field>
        <field name="model">mdm.measurement.device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="id" invisible="1"/>
                    <div class="oe_button_box" name="buttons">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive"
                                confirm="Are you sure you want to archive/unarchive this device and all its sensors?">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                        <button name="action_view_sensors"
                                type="object" class="oe_stat_button oe_read_only"
                                icon="fa-mdm-generic-sensor"
                                attrs="{'invisible': [('id', '=', False)]}"
                                string="Sensors">
                        </button>
                        <button name="action_view_readings"
                                type="object" class="oe_stat_button oe_read_only"
                                icon="fa-list"
                                attrs="{'invisible': [('id', '=', False)]}"
                                string="Readings">
                        </button>
                    </div>
                    <group col="2">
                        <group>
                            <field name="name"/>
                            <field name="category_id"/>
                            <field name="description"/>
                            <field name="location"/>
                            <field name="installation_date"/>
                        </group>
                        <group>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="serial_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                        <page name="page_photos" string="Photos">
                            <group name="photos" col="4">
                                <field name="photo"
                                       widget="image"
                                       class="oe_img_259_160"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mdm_device_view_tree" model="ir.ui.view">
        <field name="name">Measurement Device Tree</field>
        <field name="model">mdm.measurement.device</field>
        <field name="arch" type="xml">
            <tree class="o_mdm_measurement_device_tree">
                <field name="name"/>
                <field name="category_id"/>
                <field name="location"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="installation_date"/>
            </tree>
        </field>
    </record>

    <record id="mdm_device_view_search" model="ir.ui.view">
        <field name="name">Measurement Device Search</field>
        <field name="model">mdm.measurement.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <field name="location"/>
                <filter string="Category" name="category" context="{'group_by':'category_id'}"/>
                <filter string="Brand" name="brand" context="{'group_by':'brand'}"/>
                <filter string="Model" name="model" context="{'group_by':'model'}"/>
                <separator/>
                <filter string="Archived" name="archived_devices" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="mdm_measurement_device_action" model="ir.actions.act_window">
        <field name="name">Devices</field>
        <field name="res_model">mdm.measurement.device</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('mdm_device_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mdm_device_view_form')})
        ]"/>
        <field name="search_view_id" ref="mdm_device_view_search"/>
    </record>

    <!-- Action to archive multiple devices -->
    <record id="mdm_archive_devices" model="ir.actions.server">
        <field name="name">Archive</field>
        <field name="model_id" ref="model_mdm_measurement_device"/>
        <field name="state">code</field>
        <field name="code">
            if context.get('active_ids'):
                active_ids = context.get('active_ids', [])
                devices = env['mdm.measurement.device'].browse(active_ids)
                devices.write({'active': False})
        </field>
    </record>

    <record id="mdm_action_archive_devices" model="ir.values">
        <field name="name">Archive</field>
        <field name="model">mdm.measurement.device</field>
        <field name="key">action</field>
        <field name="key2">client_action_multi</field>
        <field name="value" eval="'ir.actions.server,' + str(ref('mdm_archive_devices'))"/>
    </record>

    <!-- Action to unarchive multiple devices -->
    <record id="mdm_unarchive_devices" model="ir.actions.server">
        <field name="name">Unarchive</field>
        <field name="model_id" ref="model_mdm_measurement_device"/>
        <field name="state">code</field>
        <field name="code">
            if context.get('active_ids'):
                active_ids = context.get('active_ids', [])
                devices = env['mdm.measurement.device'].with_context(active_test=False).browse(active_ids)
                devices.write({'active': True})
        </field>
    </record>

    <record id="mdm_action_unarchive_devices" model="ir.values">
        <field name="name">Unarchive</field>
        <field name="model">mdm.measurement.device</field>
        <field name="key">action</field>
        <field name="key2">client_action_multi</field>
        <field name="value" eval="'ir.actions.server,' + str(ref('mdm_unarchive_devices'))"/>
    </record>

</odoo>
