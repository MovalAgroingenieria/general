<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mdm_sensor_view_form" model="ir.ui.view">
        <field name="name">Device Sensor Form</field>
        <field name="model">mdm.measurement.device.sensor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="id" invisible="1"/>
                    <div class="oe_button_box" name="buttons">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive"
                                confirm="Are you sure you want to archive/unarchive this sensor and all its readings?">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                        <button name="action_view_readings"
                                type="object" class="oe_stat_button oe_read_only"
                                attrs="{'invisible': [('id', '=', False)]}"
                                icon="fa-list"
                                string="Readings"/>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="device_id"/>
                            <field name="type_id"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_measurement_time"/>
                            <field name="last_measurement_value"/>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transformation" name="page_transformation">
                            <group>
                                <field name="measurement_transformation_type"/>
                                <field name="measurement_transformation"
                                       attrs="{'invisible': [('measurement_transformation_type', '!=', 'arithmetic')],
                                                'required': [('measurement_transformation_type', '=', 'arithmetic')]}"/>
                                <field name="measurement_transformation_python"
                                       attrs="{'invisible': [('measurement_transformation_type', 'not in', ('custom_python', 'multi_sensor'))],
                                                'required': [('measurement_transformation_type', 'in', ('custom_python', 'multi_sensor'))]}"
                                       groups="base.group_system"/>
                            </group>
                            <field name="dependency_line_ids"
                                   attrs="{'invisible': [('measurement_transformation_type', '!=', 'multi_sensor')]}"
                                   groups="base.group_system">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="dependency_sensor_id"
                                           domain="[('id', '!=', parent.id)]"/>
                                    <field name="variable_name"/>
                                </tree>
                            </field>
                            <div class="oe_edit_only alert alert-info" role="alert"
                                 attrs="{'invisible': [('measurement_transformation_type', '!=', 'arithmetic')]}">
                                <strong>Arithmetic formula help:</strong>
                                Use <code>$</code> as placeholder for the raw value.
                                <br/>
                                <strong>Functions:</strong>
                                <code>sqrt($)</code>,
                                <code>pow($, 2)</code>,
                                <code>log($)</code> (natural),
                                <code>log10($)</code>,
                                <code>exp($)</code>,
                                <code>abs($)</code>,
                                <code>round($)</code>,
                                <code>ceil($)</code>,
                                <code>floor($)</code>,
                                <code>min($, 100)</code>,
                                <code>max($, 0)</code>
                                <br/>
                                <strong>Operators:</strong>
                                <code>+</code> <code>-</code> <code>*</code>
                                <code>/</code> <code>**</code> (power)
                                <br/>
                                <strong>Examples:</strong>
                                <code>$ * 0.001</code> |
                                <code>sqrt($)</code> |
                                <code>$ ** 2</code> |
                                <code>log10($ + 1)</code>
                            </div>
                            <div class="oe_edit_only alert alert-info" role="alert"
                                 attrs="{'invisible': [('measurement_transformation_type', '!=', 'custom_python')]}"
                                 groups="base.group_system">
                                <strong>Custom Python help:</strong>
                                The raw value is available as <code>value</code>.
                                Assign the result to <code>result</code>.
                                <br/>
                                <strong>Available:</strong>
                                <code>math</code>, <code>sqrt</code>, <code>pow</code>,
                                <code>log</code>, <code>log10</code>, <code>exp</code>,
                                <code>abs</code>, <code>round</code>, <code>ceil</code>,
                                <code>floor</code>, <code>min</code>, <code>max</code>
                                <br/>
                                <strong>Example:</strong>
                                <pre>pct = float(value)
result = pct * 100</pre>
                            </div>
                            <div class="oe_edit_only alert alert-info" role="alert"
                                 attrs="{'invisible': [('measurement_transformation_type', '!=', 'multi_sensor')]}"
                                 groups="base.group_system">
                                <strong>Multiple Sensors help:</strong>
                                Add the dependency sensors above. Each one's
                                latest active measurement value is available in the
                                Custom Python code under its
                                <strong>Variable Name</strong>.
                                Dependency readings may differ by up to three
                                hours; the computed reading is stored with the
                                newest measurement time.
                                Assign the result to <code>result</code>.
                                <br/>
                                <strong>Available:</strong>
                                <code>math</code>, <code>sqrt</code>, <code>pow</code>,
                                <code>log</code>, <code>log10</code>, <code>exp</code>,
                                <code>abs</code>, <code>round</code>, <code>ceil</code>,
                                <code>floor</code>, <code>min</code>, <code>max</code>
                                <br/>
                                <strong>Example</strong> (variable names
                                <code>temperature</code>, <code>humidity</code>):
                                <pre>result = (temperature + humidity) / 2</pre>
                            </div>
                        </page>
                        <page string="Range Validation" name="page_range_validation">
                            <group>
                                <group>
                                    <field name="has_range_validation"/>
                                    <field name="has_custom_range"/>
                                    <field name="custom_min_value"
                                           attrs="{'invisible': [('has_custom_range', '=', False)]}"/>
                                    <field name="custom_max_value"
                                           attrs="{'invisible': [('has_custom_range', '=', False)]}"/>
                                </group>
                                <group>
                                    <field name="effective_has_validation" readonly="1"/>
                                    <field name="effective_min_value" readonly="1"/>
                                    <field name="effective_max_value" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Settings" name="page_settings">
                            <group>
                                <field name="reading_retention_days"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mdm_sensor_view_tree" model="ir.ui.view">
        <field name="name">Device Sensor Tree</field>
        <field name="model">mdm.measurement.device.sensor</field>
        <field name="arch" type="xml">
            <tree class="o_mdm_measurement_device_sensor_tree">
                <field name="name"/>
                <field name="device_id"/>
                <field name="type_id"/>
                <field name="reading_retention_days"/>
                <field name="uom_id"/>
                <field name="last_measurement_time"/>
                <field name="last_measurement_value"/>
            </tree>
        </field>
    </record>

    <record id="mdm_sensor_view_search" model="ir.ui.view">
        <field name="name">Device Sensor Search</field>
        <field name="model">mdm.measurement.device.sensor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Type" name="type_id" context="{'group_by':'type_id'}"/>
                <filter string="Device" name="device_id" context="{'group_by':'device_id'}"/>
                <filter string="UOM" name="uom_id" context="{'group_by':'uom_id'}"/>
                <separator/>
                <filter string="Archived" name="archived_sensors" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="mdm_sensor_action" model="ir.actions.act_window">
        <field name="name">Sensors</field>
        <field name="res_model">mdm.measurement.device.sensor</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('mdm_sensor_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('mdm_sensor_view_form')})
        ]"/>
        <field name="search_view_id" ref="mdm_sensor_view_search"/>
    </record>

    <!-- Action to archive multiple sensors -->
    <record id="mdm_archive_sensors" model="ir.actions.server">
        <field name="name">Archive</field>
        <field name="model_id" ref="model_mdm_measurement_device_sensor"/>
        <field name="state">code</field>
        <field name="code">
            if context.get('active_ids'):
                active_ids = context.get('active_ids', [])
                sensors = env['mdm.measurement.device.sensor'].browse(active_ids)
                sensors.write({'active': False})
        </field>
    </record>

    <record id="mdm_action_archive_sensors" model="ir.values">
        <field name="name">Archive</field>
        <field name="model">mdm.measurement.device.sensor</field>
        <field name="key">action</field>
        <field name="key2">client_action_multi</field>
        <field name="value" eval="'ir.actions.server,' + str(ref('mdm_archive_sensors'))"/>
    </record>

    <!-- Action to unarchive multiple sensors -->
    <record id="mdm_unarchive_sensors" model="ir.actions.server">
        <field name="name">Unarchive</field>
        <field name="model_id" ref="model_mdm_measurement_device_sensor"/>
        <field name="state">code</field>
        <field name="code">
            if context.get('active_ids'):
                active_ids = context.get('active_ids', [])
                sensors = env['mdm.measurement.device.sensor'].with_context(active_test=False).browse(active_ids)
                sensors.write({'active': True})
        </field>
    </record>

    <record id="mdm_action_unarchive_sensors" model="ir.values">
        <field name="name">Unarchive</field>
        <field name="model">mdm.measurement.device.sensor</field>
        <field name="key">action</field>
        <field name="key2">client_action_multi</field>
        <field name="value" eval="'ir.actions.server,' + str(ref('mdm_unarchive_sensors'))"/>
    </record>
</odoo>