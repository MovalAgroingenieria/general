<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Unit of Measure: m³ (cubic meters) -->
        <record id="mdm_sensor_uom_m3" model="mdm.measurement.device.sensor.uom">
            <field name="name">m³</field>
            <field name="short_name"></field>
            <field name="description">Cubic meters</field>
            <field name="readonly">True</field>
        </record>

        <!-- Unit of Measure: L/s (liters per second) -->
        <record id="mdm_sensor_uom_ls" model="mdm.measurement.device.sensor.uom">
            <field name="name">L/s</field>
            <field name="short_name"></field>
            <field name="description">Liters per second</field>
            <field name="readonly">True</field>
        </record>

        <!-- Unit of Measure: m.c.a (meters of water column) -->
        <record id="mdm_sensor_uom_mca" model="mdm.measurement.device.sensor.uom">
            <field name="name">m.c.a</field>
            <field name="short_name"></field>
            <field name="description">Meters of water column (pressure)</field>
            <field name="readonly">True</field>
        </record>

        <!-- Unit of Measure: m (meters) -->
        <record id="mdm_sensor_uom_m" model="mdm.measurement.device.sensor.uom">
            <field name="name">m</field>
            <field name="short_name"></field>
            <field name="description">Meters</field>
            <field name="readonly">True</field>
        </record>

    </data>
</odoo>
