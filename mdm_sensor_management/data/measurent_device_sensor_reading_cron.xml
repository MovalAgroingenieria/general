<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron Job for cleaning up old readings -->
        <record id="measurent_device_sensor_reading_cron" model="ir.cron">
            <field name="name">Cleanup Old Device Sensor Readings</field>
            <field name="model">mdm.measurement.device.sensor.reading</field>
            <field name="function">cron_cleanup_old_readings</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>