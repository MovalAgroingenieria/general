msgstr "<strong>Camps de lectura disponibles:</strong>"

#. module: mdm_sensor_management
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_template_view_form
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_wizard_view_form
msgid "<strong>Current datetime:</strong> Use <code>$now</code> to get current date/time\n"
"                                            <br/><span style=\"color: #666;\">Example:</span> <code>\"import_date\": \"$now\"</code>"
msgstr "<strong>Data/hora actual:</strong> Utilitzeu <code>$now</code> per obtenir la data/hora actual\n"
"                                            <br/><span style=\"color: #666;\">Exemple:</span> <code>\"import_date\": \"$now\"</code>"

#. module: mdm_sensor_management
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_template_view_form
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_wizard_view_form
msgid "<strong>Mathematical expressions:</strong> Use Python expressions with field references\n"
"                                            <br/><span style=\"color: #666;\">Example:</span> <code>\"volume\": \"$value * 3.6\"</code> (convert m³/h to m³/day)"
msgstr "<strong>Expressions matemàtiques:</strong> Utilitzeu expressions Python amb referències a camps\n"
"                                            <br/><span style=\"color: #666;\">Exemple:</span> <code>\"volume\": \"$value * 3.6\"</code> (convertir m³/h a m³/dia)"

#. module: mdm_sensor_management
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_template_view_form
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_wizard_view_form
msgid "<strong>Multiple operations:</strong> <code>\"total\": \"($value + $offset) * $factor\"</code>"
msgstr "<strong>Operacions múltiples:</strong> <code>\"total\": \"($value + $offset) * $factor\"</code>"

#. module: mdm_sensor_management
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_template_view_form
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_wizard_view_form
msgid "<strong>Reference sensor reading fields:</strong> Use <code>$field_name</code> syntax\n"
"                                            <br/><span style=\"color: #666;\">Example:</span> <code>\"date\": \"$measurement_time\"</code>"
msgstr "<strong>Referenciar camps de lectura del sensor:</strong> Utilitzeu sintaxi <code>$nom_camp</code>\n"
"                                            <br/><span style=\"color: #666;\">Exemple:</span> <code>\"date\": \"$measurement_time\"</code>"

#. module: mdm_sensor_management
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_template_view_form
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_wizard_view_form
msgid "<strong>Static values:</strong> Numbers, strings, booleans\n"
"                                            <br/><span style=\"color: #666;\">Example:</span> <code>\"active\": true, \"origin\": \"sensor_import\"</code>"
msgstr "<strong>Valors estàtics:</strong> Números, cadenes, booleans\n"
"                                            <br/><span style=\"color: #666;\">Exemple:</span> <code>\"active\": true, \"origin\": \"sensor_import\"</code>"

#. module: mdm_sensor_management
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_template_view_form
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_wizard_view_form
msgid "<strong>Volume difference (negative readings only):</strong> Use <code>$volume_diff</code> in negative field mapping\n"
"                                            <br/><span style=\"color: #666;\">Example:</span> <code>\"volume\": \"$volume_diff\"</code> (difference when counter goes backwards)"
msgstr "<strong>Diferència de volum (només lectures negatives):</strong> Utilitzeu <code>$volume_diff</code> en el mapatge de camps negatius\n"
"                                            <br/><span style=\"color: #666;\">Exemple:</span> <code>\"volume\": \"$volume_diff\"</code> (diferència quan el comptador va enrere)"

