msgid "<strong>Access related fields:</strong> Use dot notation <code>$field.related_field</code>\n"
"                                            <br/><span style=\"color: #666;\">Example:</span> <code>\"sensor_name\": \"$sensor_id.name\"</code>\n"
"                                            <br/><span style=\"color: #666;\">Example:</span> <code>\"location\": \"$sensor_id.location_id.name\"</code>"
msgstr "<strong>Accedir a camps relacionats:</strong> Utilitzeu notació de punt <code>$camp.camp_relacionat</code>\n"
"                                            <br/><span style=\"color: #666;\">Exemple:</span> <code>\"sensor_name\": \"$sensor_id.name\"</code>\n"
"                                            <br/><span style=\"color: #666;\">Exemple:</span> <code>\"location\": \"$sensor_id.location_id.name\"</code>"

#. module: mdm_sensor_management
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_template_view_form
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_wizard_view_form
