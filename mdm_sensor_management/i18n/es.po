msgstr "<strong>Operaciones múltiples:</strong> <code>\"total\": \"($value + $offset) * $factor\"</code>"

#. module: mdm_sensor_management
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_template_view_form
#: model:ir.ui.view,arch_db:mdm_sensor_management.sensor_reading_transform_wizard_view_form
msgid "<strong>Reference sensor reading fields:</strong> Use <code>$field_name</code> syntax\n"
"                                            <br/><span style=\"color: #666;\">Example:</span> <code>\"date\": \"$measurement_time\"</code>"
msgstr "<strong>Referenciar campos de lectura del sensor:</strong> Use sintaxis <code>$nombre_campo</code>\n"
