<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sensor Reading Transform Wizard Form -->
    <record id="sensor_reading_transform_wizard_view_form" model="ir.ui.view">
        <field name="name">mdm.sensor.reading.transform.wizard.form</field>
        <field name="model">mdm.sensor.reading.transform.wizard</field>
        <field name="arch" type="xml">
            <form string="Transform Sensor Readings">
                <sheet>
                    <group>
                        <field name="template_id" colspan="2"/>
                    </group>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="target_model_id"/>
                            <field name="selection_mode"/>
                        </group>
                        <group>
                            <field name="use_all_sensors"/>
                            <field name="sensor_ids" widget="many2many_tags"
                                   attrs="{'invisible': [('use_all_sensors', '=', True)],
                                           'required': [('use_all_sensors', '=', False)]}"/>
                        </group>
                    </group>
                    <group string="Sensor Filter" attrs="{'invisible': [('use_all_sensors', '=', False), ('sensor_ids', '!=', False)]}">
                        <field name="sensor_domain_filter"
                               placeholder='[("sensor_type_id.name", "=", "Temperature")]'
                               help="Filter to restrict which sensors are processed. Applied to all sensors or to selected sensors."/>
                    </group>
                    <group string="Date/Time Selection">
                        <group>
                            <field name="auto_date_from_last_record"
                                   attrs="{'invisible': [('selection_mode', 'in', ['last_reading', 'closest_reading'])]}"/>
                            <field name="target_date_field_id"
                                   attrs="{'invisible': ['|', ('selection_mode', 'in', ['last_reading', 'closest_reading']), ('auto_date_from_last_record', '=', False)],
                                           'required': [('auto_date_from_last_record', '=', True)]}"/>
                            <field name="date_from_computed"
                                   attrs="{'invisible': ['|', ('selection_mode', 'in', ['last_reading', 'closest_reading']), ('auto_date_from_last_record', '=', False)]}"
                                   readonly="1"/>
                            <field name="date_from"
                                   attrs="{'invisible': [('selection_mode', 'in', ['last_reading', 'closest_reading'])],
                                           'required': [('selection_mode', 'in', ['date_range', 'from_date']), ('auto_date_from_last_record', '=', False)],
                                           'readonly': [('auto_date_from_last_record', '=', True)]}"/>
                            <field name="date_to"
                                   attrs="{'invisible': [('selection_mode', '!=', 'date_range')],
                                           'required': [('selection_mode', '=', 'date_range')]}"/>
                        </group>
                        <group>
                            <field name="reference_date"
                                   attrs="{'invisible': [('selection_mode', '!=', 'closest_reading')],
                                           'required': [('selection_mode', '=', 'closest_reading')]}"/>
                        </group>
                    </group>

                    <group string="Field Mapping (JSON)">
                        <field name="field_mapping_json" widget="ace" options="{'mode': 'json'}" nolabel="1"
                               placeholder='{"reading_time": "$measurement_time", "volume": "$value * 3.6", "active": true, "notes": "Imported"}'/>
                    </group>

                    <group string="Negative Reading Detection">
                        <group>
                            <field name="detect_negative_readings"/>
                            <field name="negative_model_id"
                                   attrs="{'invisible': [('detect_negative_readings', '=', False)],
                                           'required': [('detect_negative_readings', '=', True)]}"/>
                            <field name="reference_field" placeholder="flowmeter_id"
                                   attrs="{'invisible': [('detect_negative_readings', '=', False)],
                                           'required': [('detect_negative_readings', '=', True)]}"/>
                            <field name="volume_field"
                                   attrs="{'invisible': [('detect_negative_readings', '=', False)],
                                           'required': [('detect_negative_readings', '=', True)]}"/>
                            <field name="date_field_for_last_reading" placeholder="reading_time"
                                   attrs="{'invisible': [('detect_negative_readings', '=', False)],
                                           'required': [('detect_negative_readings', '=', True)]}"/>
                        </group>
                    </group>
                    <group string="Negative Field Mapping" attrs="{'invisible': [('detect_negative_readings', '=', False)]}">
                        <field name="negative_field_mapping_json" widget="ace" options="{'mode': 'json'}" nolabel="1"
                               placeholder='{"flowmeter_id": 17, "reading_time": "$measurement_time", "volume": "$volume_diff", "instant_flow": "$value * 3.6"}'/>
                    </group>

                    <group>
                        <field name="show_mapping_help"/>
                    </group>
                    <notebook attrs="{'invisible': [('show_mapping_help', '=', False)]}">
                        <page string="Field Mapping Help">
                            <group>
                                <div style="padding: 15px;">
                                    <h3 style="color: #007bff; margin-top: 0;">What you CAN do:</h3>
                                    <ul style="line-height: 1.8;">
                                        <li><strong>Reference sensor reading fields:</strong> Use <code>$field_name</code> syntax
                                            <br/><span style="color: #666;">Example:</span> <code>"date": "$measurement_time"</code></li>
                                        <li><strong>Access related fields:</strong> Use dot notation <code>$field.related_field</code>
                                            <br/><span style="color: #666;">Example:</span> <code>"sensor_name": "$sensor_id.name"</code>
                                            <br/><span style="color: #666;">Example:</span> <code>"location": "$sensor_id.location_id.name"</code></li>
                                        <li><strong>Current datetime:</strong> Use <code>$now</code> to get current date/time
                                            <br/><span style="color: #666;">Example:</span> <code>"import_date": "$now"</code></li>
                                        <li><strong>Volume difference (negative readings only):</strong> Use <code>$volume_diff</code> in negative field mapping
                                            <br/><span style="color: #666;">Example:</span> <code>"volume": "$volume_diff"</code> (difference when counter goes backwards)</li>
                                        <li><strong>Mathematical expressions:</strong> Use Python expressions with field references
                                            <br/><span style="color: #666;">Example:</span> <code>"volume": "$value * 3.6"</code> (convert m³/h to m³/day)</li>
                                        <li><strong>Multiple operations:</strong> <code>"total": "($value + $offset) * $factor"</code></li>
                                        <li><strong>Static values:</strong> Numbers, strings, booleans
                                            <br/><span style="color: #666;">Example:</span> <code>"active": true, "origin": "sensor_import"</code></li>
                                        <li><strong>Available reading fields:</strong>
                                            <ul style="margin-top: 5px;">
                                                <li><code>$measurement_time</code> - Reading timestamp</li>
                                                <li><code>$value</code> - Measured value</li>
                                                <li><code>$sensor_id</code> - Sensor ID (use $sensor_id.field for sensor fields)</li>
                                                <li><code>$device_id</code> - Device ID (use $device_id.field for device fields)</li>
                                                <li><code>$now</code> - Current date/time</li>
                                                <li><code>$volume_diff</code> - Volume difference (only in negative mapping)</li>
                                                <li>Any other field from mdm.measurement.device.sensor.reading model</li>
                                            </ul>
                                        </li>
                                    </ul>

                                    <h3 style="color: #dc3545; margin-top: 20px;">What you CANNOT do:</h3>
                                    <ul style="line-height: 1.8;">
                                        <li>❌ Complex Python code (if/else, loops, function definitions)</li>
                                        <li>❌ Import statements or external libraries</li>
                                        <li>❌ Access to models or database queries</li>
                                        <li>❌ Method calls on objects (except basic math operations)</li>
                                        <li>❌ Multi-line expressions</li>
                                    </ul>

                                    <h3 style="color: #28a745; margin-top: 20px;">Complete Example:</h3>
                                    <pre style="background-color: #f4f4f4; padding: 12px; border-radius: 4px; border: 1px solid #ddd; overflow-x: auto; font-family: monospace;">{
    "reading_time": "$measurement_time",
    "volume_m3": "$value * 3.6",
    "sensor_code": "$sensor_id",
    "sensor_name": "$sensor_id.name",
    "location": "$sensor_id.location_id.name",
    "import_date": "$now",
    "active": true,
    "notes": "Imported from sensor",
    "quality_index": "($value / 100) * 0.95"
}</pre>

                                    <h3 style="color: #ff6b6b; margin-top: 20px;">Negative Reading Example:</h3>
                                    <pre style="background-color: #fff3cd; padding: 12px; border-radius: 4px; border: 1px solid #ffc107; overflow-x: auto; font-family: monospace;">{
    "flowmeter_id": "$sensor_id.flowmeter_id",
    "reading_time": "$measurement_time",
    "volume": "$volume_diff",
    "consumption_volume": "$volume_diff",
    "instant_flow": "$value * 3.6",
    "notes": "Counter rollback detected"
}</pre>
                                </div>
                            </group>
                        </page>
                    </notebook>

                    <group string="Advanced Filters">
                        <field name="domain_filter" placeholder="[('active', '=', True)]"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_transform" string="Transform" type="object" class="btn-primary"/>
                    <button name="action_save_as_template" string="Save as Template" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard Action -->
    <record id="sensor_reading_transform_wizard_action" model="ir.actions.act_window">
        <field name="name">Transform Sensor Readings</field>
        <field name="res_model">mdm.sensor.reading.transform.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="sensor_reading_transform_wizard_menu"
              name="Transform Readings"
              parent="mdm_technical_menu"
              action="sensor_reading_transform_wizard_action"
              sequence="30"
              groups="mdm_sensor_management.group_mdm_user"/>

</odoo>
