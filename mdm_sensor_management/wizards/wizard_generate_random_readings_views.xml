<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_generate_random_readings_view_form" model="ir.ui.view">
        <field name="name">mdm.wizard.generate.random.readings.form</field>
        <field name="model">mdm.wizard.generate.random.readings</field>
        <field name="arch" type="xml">
            <form string="Generate Random Readings">
                <field name="state" invisible="1"/>
                <sheet>
                    <div attrs="{'invisible': [('state', '=', 'done')]}">
                        <p class="oe_grey">
                            Generates random readings between a minimum and
                            maximum value for each selected sensor, from the
                            start date to the end date at the specified
                            interval.
                        </p>
                        <group>
                            <group string="Sensors">
                                <field name="sensor_ids" widget="many2many_tags"
                                       nolabel="1" colspan="2"/>
                            </group>
                            <group string="Date Range">
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="interval_minutes"/>
                            </group>
                        </group>
                        <group string="Value Range">
                            <field name="value_min"/>
                            <field name="value_max"/>
                        </group>
                    </div>
                    <div attrs="{'invisible': [('state', '!=', 'done')]}">
                        <field name="result_message" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_generate"
                            string="Generate"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'done')]}"/>
                    <button string="Close"
                            class="btn-default"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wizard_generate_random_readings_action" model="ir.actions.act_window">
        <field name="name">Generate Random Readings</field>
        <field name="res_model">mdm.wizard.generate.random.readings</field>
        <field name="view_type">form</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="wizard_generate_random_readings_view_form"/>
        <field name="target">new</field>
    </record>

    <record id="mdm_action_generate_random_readings_binding" model="ir.values">
        <field name="name">Generate Random Readings</field>
        <field name="model">mdm.measurement.device.sensor</field>
        <field name="key">action</field>
        <field name="key2">client_action_multi</field>
        <field name="value" eval="'ir.actions.act_window,' + str(ref('wizard_generate_random_readings_action'))"/>
    </record>

</odoo>
