#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>Sensor:</strong>"
msgstr "<strong>Sensor:</strong>"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>VELOCITY</strong>"
msgstr "<strong>VELOCIDAD</strong>"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“CodError ≠ 0”</strong>: the API returned an error code different from 0 (see official documentation for details)."
msgstr "<strong>“CodError ≠ 0”</strong>: la API devolvió un código de error distinto de 0 (ver la documentación oficial para más detalles)."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“Error 15”</strong>: the platform was temporarily unable to access historical data. Try again later."
msgstr "<strong>“Error 15”</strong>: la plataforma no pudo acceder temporalmente a los datos históricos. Inténtelo más tarde."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“Invalid ID”</strong>: the sensor does not have a valid variable ID in Riegos Salz."
msgstr "<strong>“Invalid ID”</strong>: el sensor no tiene un ID de variable válido en Riegos Salz."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“Missing credentials”</strong>: the username or password is missing in the configuration."
msgstr "<strong>“Missing credentials”</strong>: falta el usuario o la contraseña en la configuración."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“No data found”</strong>: no readings are available on the platform for the specified date range."
msgstr "<strong>“No data found”</strong>: no existen lecturas disponibles en la plataforma para el rango de fechas indicado."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“Timeout”</strong>: the connection took too long. Try running the action again later."
msgstr "<strong>“Timeout”</strong>: la conexión tardó demasiado. Intente ejecutar la acción más tarde."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "A JSON file (<code>.json</code>) is generated with a detailed summary of the operation: processed sensors, dates, total readings, and any errors."
msgstr "Se genera un archivo JSON (<code>.json</code>) con un resumen detallado de la operación: sensores procesados, fechas, total de lecturas y errores, si los hubo."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "A message appears in the remote control record showing the total number of readings created and any detected errors."
msgstr "Se muestra un mensaje en el registro del telecontrol indicando el número total de lecturas creadas y los errores detectados, si los hubo."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Depending on the installation, the identification number (<code>id</code>) may correspond to different types of measurements, for example:"
msgstr "Según la instalación, el número de identificación (<code>id</code>) puede corresponder a distintos tipos de medida, por ejemplo:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Devices"
msgstr "Dispositivos"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Each device must define a <strong>start date</strong> from which historical data should be retrieved.\n"
"This date is placed in the device's <em>Remote Control Parameters</em> field:"
msgstr "Cada dispositivo debe definir una <strong>fecha de inicio</strong> a partir de la cual se recuperarán los datos históricos.\n"
"Esta fecha se coloca en el campo <em>Parámetros de telecontrol</em> del dispositivo:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Each reading includes a value and a timestamp, for example: <em>Flow = 35 l/s on 10/10/2025 at 10:00</em>."
msgstr "Cada lectura incluye un valor y una fecha, por ejemplo: <em>Caudal = 35 l/s el 10/10/2025 a las 10:00</em>."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Each sensor must have a linked <strong>variable ID from Riegos Salz</strong>.\n"
"This number uniquely identifies the measurement point (for example, a flow meter or pressure sensor) in the Riegos Salz platform."
msgstr "Cada sensor debe tener vinculado su <strong>ID de variable en Riegos Salz</strong>.\n"
"Este número identifica de manera única el punto de medida (por ejemplo, un contador o una sonda de presión) en la plataforma de Riegos Salz."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Ensure that each sensor has its <strong>variable ID</strong> correctly configured (the exact number provided by Riegos Salz)."
msgstr "Asegúrese de que cada sensor tenga su <strong>ID de variable</strong> correctamente configurado (el número exacto proporcionado por Riegos Salz)."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "If a sensor does not have this number, it cannot be synchronized."
msgstr "Si un sensor no tiene este número, no podrá sincronizarse."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "If no data is returned, check in the Riegos Salz platform that the sensor has historical data for the indicated date range."
msgstr "Si no se devuelven datos, compruebe en la plataforma de Riegos Salz que el sensor tenga datos históricos registrados desde la fecha indicada."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "If no date is specified, the system will use January 1st of the current year by default.\n"
"The start date limits the range of queries and helps optimize download time."
msgstr "Si no se indica ninguna fecha, el sistema usará por defecto el 1 de enero del año actual.\n"
"La fecha de inicio limita el rango de consulta y ayuda a optimizar el tiempo de descarga."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "In the remote control configuration tab, fill in the <strong>Connection Parameters</strong> section with the username and password used in Riegos Salz."
msgstr "En la pestaña de configuración del telecontrol, complete el apartado <strong>Parámetros de conexión</strong> con el usuario y la contraseña utilizados en Riegos Salz."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "In the sensor's <em>Remote Control Parameters</em> field, enter:"
msgstr "En el campo <em>Parámetros de telecontrol</em> del sensor, introduzca:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Once configured, simply run the <strong>“Riegos Salz: Daily Sync”</strong> procedure so Odoo automatically connects, downloads the data, and stores it in the corresponding sensors."
msgstr "Una vez configurado, ejecute el procedimiento <strong>“Riegos Salz: Daily Sync”</strong> para que Odoo se conecte automáticamente, descargue los datos y los almacene en los sensores correspondientes."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Once configured, the system automatically retrieves the values recorded in the Riegos Salz cloud and stores them in Odoo as readings linked to their corresponding sensors.\n"
"This makes all irrigation system information available inside Odoo, simplifying analysis, comparison, and monitoring of the measured variables."
msgstr "Una vez configurado, el sistema recupera automáticamente los valores registrados en la nube de Riegos Salz y los guarda en Odoo como lecturas vinculadas a sus sensores correspondientes.\n"
"Esto permite disponer de toda la información del sistema de riego dentro de Odoo, facilitando el análisis, la comparación y el seguimiento de las variables medidas."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Once synchronization is completed:"
msgstr "Una vez completada la sincronización:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Review the audit file after each execution to confirm that all readings were imported successfully."
msgstr "Revise el archivo de auditoría después de cada ejecución para confirmar que todas las lecturas se hayan importado correctamente."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Riegos Salz · Automatic Synchronization with Odoo"
msgstr "Riegos Salz · Sincronización automática con Odoo"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Sensors"
msgstr "Sensores"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The <strong>“Get devices (plan)”</strong> action scans all configured sensors and internally generates a list containing the sensors, their devices, their Riegos Salz IDs, and the start date from which readings should be downloaded."
msgstr "La acción <strong>“Get devices (plan)”</strong> busca todos los sensores configurados y genera internamente una lista con los sensores, los dispositivos, los IDs de Riegos Salz y la fecha desde la cual deben descargarse las lecturas."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The <strong>“Get readings”</strong> action contacts Riegos Salz and retrieves the historical data for each sensor included in the plan."
msgstr "La acción <strong>“Get readings”</strong> contacta con Riegos Salz y recupera los datos históricos para cada sensor incluido en el plan."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The API returns a list of readings, each containing two values: the <strong>timestamp</strong> (for example, \"2025-10-15 08:00:00\") and the <strong>measured value</strong> (for example, \"75\").\n"
"Each pair becomes a reading in Odoo."
msgstr "La API devuelve una lista de lecturas, cada una con dos valores: la <strong>fecha y hora</strong> (por ejemplo, \"2025-10-15 08:00:00\") y el <strong>valor medido</strong> (por ejemplo, \"75\").\n"
"Cada par se convierte en una lectura en Odoo."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The Riegos Salz API updates its readings approximately every 15 minutes. It is recommended to schedule the synchronization in Odoo as a daily task to keep data up to date."
msgstr "La API de Riegos Salz actualiza sus lecturas aproximadamente cada 15 minutos. Se recomienda programar la sincronización en Odoo como una tarea diaria para mantener los datos actualizados."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The connection is made through the secure Riegos Salz web service (<code>https://cloudcontrol.riegosalz.com/wm-rest.php</code>), which accepts requests in JSON format."
msgstr "La conexión se realiza a través del servicio web seguro de Riegos Salz (<code>https://cloudcontrol.riegosalz.com/wm-rest.php</code>), que acepta peticiones en formato JSON."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The procedure can be run manually or scheduled as a recurring automatic task (cron) to execute daily without user intervention."
msgstr "El procedimiento puede ejecutarse manualmente o programarse como una tarea automática recurrente (cron) para que se ejecute diariamente sin intervención del usuario."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The process uses the <strong>consultaHistoricos</strong> command from the Riegos Salz API.\n"
"Communication is done in JSON format, with the following main fields:"
msgstr "El proceso utiliza el comando <strong>consultaHistoricos</strong> de la API de Riegos Salz.\n"
"La comunicación se realiza en formato JSON, con los siguientes campos principales:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The start date should match the first date you wish to retrieve data from. Setting it too far in the past may increase processing time."
msgstr "La fecha de inicio debe coincidir con la primera fecha desde la que se desee recuperar datos. Si se deja demasiado antigua, el proceso puede tardar más en completarse."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The system automatically saves each reading in Odoo, under the corresponding sensor record.\n"
"This way, daily historical data is continuously stored for later viewing and analysis."
msgstr "El sistema guarda automáticamente cada lectura en Odoo, dentro del registro del sensor correspondiente.\n"
"De este modo, los datos históricos se almacenan día a día para su posterior consulta o análisis."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The system performs one request per configured sensor, ensuring that each reading is linked to the correct sensor and device."
msgstr "El sistema realiza una petición por cada sensor configurado, asegurando que cada lectura se asocie al sensor y dispositivo correctos."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The system uses these credentials to connect with the Riegos Salz web service.\n"
"During the process, the password is automatically encrypted internally (<em>MD5 format</em>), ensuring that it is never sent in plain text."
msgstr "El sistema utiliza estas credenciales para conectarse con el servicio web de Riegos Salz.\n"
"Durante el proceso, la contraseña se cifra automáticamente en formato interno (<em>MD5</em>), garantizando que nunca se envíe en texto plano."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The variable IDs can be obtained from the Riegos Salz platform or through the system's technical equipment list."
msgstr "Los identificadores de variable pueden obtenerse desde la plataforma de Riegos Salz o a través del listado técnico de equipos del sistema."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "This file can be viewed in the remote control attachments section in Odoo.\n"
"A summary message is also recorded in the same entry, allowing historical tracking of past synchronizations."
msgstr "Este archivo puede consultarse en la sección de adjuntos del telecontrol en Odoo.\n"
"Además, se registra un mensaje resumen en el propio registro, permitiendo llevar un control histórico de las sincronizaciones anteriores."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "This step does not download data yet; it only prepares the synchronization plan."
msgstr "Este paso no descarga datos todavía; solo prepara el plan de sincronización."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "This system allows connecting Odoo with the <strong>Riegos Salz</strong> platform to automatically import historical data from sensors (flow, pressure, etc.) installed in the remote control system."
msgstr "Este sistema permite conectar Odoo con la plataforma <strong>Riegos Salz</strong> para importar automáticamente los datos históricos de los sensores (caudales, presiones, etc.) instalados en el sistema de telecontrol."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Verify that the Riegos Salz username and password are correct. If the password changes, update it in Odoo as well."
msgstr "Verifique que el usuario y la contraseña de Riegos Salz sean correctos. Si la contraseña cambia, actualícela también en Odoo."

