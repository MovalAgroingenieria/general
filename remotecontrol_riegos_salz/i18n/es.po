#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>OPENING</strong>"
msgstr "<strong>APERTURA</strong>"

