msgid "<strong>FLOW</strong>"
msgstr "<strong>CABAL</strong>"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>LEVEL</strong>"
msgstr "<strong>NIVELL</strong>"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>OPENING</strong>"
msgstr "<strong>OBERTURA</strong>"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>Sensor:</strong>"
msgstr "<strong>Sensor:</strong>"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>VELOCITY</strong>"
msgstr "<strong>VELOCITAT</strong>"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“CodError ≠ 0”</strong>: the API returned an error code different from 0 (see official documentation for details)."
msgstr "<strong>“CodError ≠ 0”</strong>: l’API ha retornat un codi d’error diferent de 0 (consulteu la documentació oficial per a més detalls)."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“Error 15”</strong>: the platform was temporarily unable to access historical data. Try again later."
msgstr "<strong>“Error 15”</strong>: la plataforma no ha pogut accedir temporalment a les dades històriques. Torneu-ho a provar més tard."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“Invalid ID”</strong>: the sensor does not have a valid variable ID in Riegos Salz."
msgstr "<strong>“Invalid ID”</strong>: el sensor no té un ID de variable vàlid a Riegos Salz."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“Missing credentials”</strong>: the username or password is missing in the configuration."
msgstr "<strong>“Missing credentials”</strong>: falta l’usuari o la contrasenya a la configuració."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“No data found”</strong>: no readings are available on the platform for the specified date range."
msgstr "<strong>“No data found”</strong>: no hi ha lectures disponibles a la plataforma per al rang de dates indicat."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "<strong>“Timeout”</strong>: the connection took too long. Try running the action again later."
msgstr "<strong>“Timeout”</strong>: la connexió ha trigat massa. Proveu d’executar l’acció més tard."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "A JSON file (<code>.json</code>) is generated with a detailed summary of the operation: processed sensors, dates, total readings, and any errors."
msgstr "Es genera un fitxer JSON (<code>.json</code>) amb un resum detallat de l’operació: sensors processats, dates, lectures totals i errors, si n’hi ha."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "A message appears in the remote control record showing the total number of readings created and any detected errors."
msgstr "Es mostra un missatge al registre del telecontrol indicant el nombre total de lectures creades i els possibles errors detectats."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Depending on the installation, the identification number (<code>id</code>) may correspond to different types of measurements, for example:"
msgstr "Segons la instal·lació, el número d’identificació (<code>id</code>) pot correspondre a diferents tipus de mesura, per exemple:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Devices"
msgstr "Dispositius"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Each device must define a <strong>start date</strong> from which historical data should be retrieved.\n"
"This date is placed in the device's <em>Remote Control Parameters</em> field:"
msgstr "Cada dispositiu ha de definir una <strong>data d’inici</strong> a partir de la qual es recuperaran les dades històriques.\n"
"Aquesta data s’introdueix al camp <em>Paràmetres de telecontrol</em> del dispositiu:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Each reading includes a value and a timestamp, for example: <em>Flow = 35 l/s on 10/10/2025 at 10:00</em>."
msgstr "Cada lectura inclou un valor i una data, per exemple: <em>Cabal = 35 l/s el 10/10/2025 a les 10:00</em>."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Each sensor must have a linked <strong>variable ID from Riegos Salz</strong>.\n"
"This number uniquely identifies the measurement point (for example, a flow meter or pressure sensor) in the Riegos Salz platform."
msgstr "Cada sensor ha de tenir vinculat un <strong>ID de variable de Riegos Salz</strong>.\n"
"Aquest número identifica de manera única el punt de mesura (per exemple, un comptador de cabal o un sensor de pressió) dins la plataforma de Riegos Salz."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Ensure that each sensor has its <strong>variable ID</strong> correctly configured (the exact number provided by Riegos Salz)."
msgstr "Assegureu-vos que cada sensor tingui el seu <strong>ID de variable</strong> correctament configurat (el número exacte proporcionat per Riegos Salz)."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "If a sensor does not have this number, it cannot be synchronized."
msgstr "Si un sensor no té aquest número, no podrà sincronitzar-se."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "If no data is returned, check in the Riegos Salz platform that the sensor has historical data for the indicated date range."
msgstr "Si no es retornen dades, comproveu a la plataforma de Riegos Salz que el sensor tingui dades històriques per al rang de dates indicat."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "If no date is specified, the system will use January 1st of the current year by default.\n"
"The start date limits the range of queries and helps optimize download time."
msgstr "Si no s’especifica cap data, el sistema utilitzarà per defecte l’1 de gener de l’any en curs.\n"
"La data d’inici limita el rang de consultes i ajuda a optimitzar el temps de descàrrega."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "In the remote control configuration tab, fill in the <strong>Connection Parameters</strong> section with the username and password used in Riegos Salz."
msgstr "A la pestanya de configuració del telecontrol, ompliu l’apartat <strong>Paràmetres de connexió</strong> amb l’usuari i la contrasenya utilitzats a Riegos Salz."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "In the sensor's <em>Remote Control Parameters</em> field, enter:"
msgstr "Al camp <em>Paràmetres de telecontrol</em> del sensor, introduïu-hi:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Once configured, simply run the <strong>“Riegos Salz: Daily Sync”</strong> procedure so Odoo automatically connects, downloads the data, and stores it in the corresponding sensors."
msgstr "Un cop configurat, executeu el procediment <strong>“Riegos Salz: Daily Sync”</strong> perquè Odoo es connecti automàticament, descarregui les dades i les desi als sensors corresponents."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Once configured, the system automatically retrieves the values recorded in the Riegos Salz cloud and stores them in Odoo as readings linked to their corresponding sensors.\n"
"This makes all irrigation system information available inside Odoo, simplifying analysis, comparison, and monitoring of the measured variables."
msgstr "Un cop configurat, el sistema recupera automàticament els valors registrats al núvol de Riegos Salz i els desa a Odoo com a lectures vinculades als sensors corresponents.\n"
"Això permet tenir tota la informació del sistema de reg disponible dins d’Odoo, facilitant-ne l’anàlisi, la comparació i el seguiment de les variables mesurades."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Once synchronization is completed:"
msgstr "Un cop completada la sincronització:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Review the audit file after each execution to confirm that all readings were imported successfully."
msgstr "Reviseu el fitxer d’auditoria després de cada execució per confirmar que totes les lectures s’han importat correctament."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Riegos Salz · Automatic Synchronization with Odoo"
msgstr "Riegos Salz · Sincronització automàtica amb Odoo"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Sensors"
msgstr "Sensors"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The <strong>“Get devices (plan)”</strong> action scans all configured sensors and internally generates a list containing the sensors, their devices, their Riegos Salz IDs, and the start date from which readings should be downloaded."
msgstr "L’acció <strong>“Get devices (plan)”</strong> analitza tots els sensors configurats i genera internament una llista amb els sensors, els dispositius, els seus IDs de Riegos Salz i la data d’inici des de la qual s’han de descarregar les lectures."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The <strong>“Get readings”</strong> action contacts Riegos Salz and retrieves the historical data for each sensor included in the plan."
msgstr "L’acció <strong>“Get readings”</strong> contacta amb Riegos Salz i recupera les dades històriques de cada sensor inclòs al pla."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The API returns a list of readings, each containing two values: the <strong>timestamp</strong> (for example, \"2025-10-15 08:00:00\") and the <strong>measured value</strong> (for example, \"75\").\n"
"Each pair becomes a reading in Odoo."
msgstr "L’API retorna una llista de lectures, cadascuna amb dos valors: la <strong>data i hora</strong> (per exemple, \"2025-10-15 08:00:00\") i el <strong>valor mesurat</strong> (per exemple, \"75\").\n"
"Cada parell es converteix en una lectura dins d’Odoo."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The Riegos Salz API updates its readings approximately every 15 minutes. It is recommended to schedule the synchronization in Odoo as a daily task to keep data up to date."
msgstr "L’API de Riegos Salz actualitza les seves lectures aproximadament cada 15 minuts. Es recomana programar la sincronització a Odoo com a tasca diària per mantenir les dades actualitzades."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The connection is made through the secure Riegos Salz web service (<code>https://cloudcontrol.riegosalz.com/wm-rest.php</code>), which accepts requests in JSON format."
msgstr "La connexió es fa a través del servei web segur de Riegos Salz (<code>https://cloudcontrol.riegosalz.com/wm-rest.php</code>), que accepta peticions en format JSON."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The procedure can be run manually or scheduled as a recurring automatic task (cron) to execute daily without user intervention."
msgstr "El procediment es pot executar manualment o programar com a tasca automàtica recurrent (cron) per executar-se diàriament sense intervenció de l’usuari."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The process uses the <strong>consultaHistoricos</strong> command from the Riegos Salz API.\n"
"Communication is done in JSON format, with the following main fields:"
msgstr "El procés utilitza l’ordre <strong>consultaHistoricos</strong> de l’API de Riegos Salz.\n"
"La comunicació es fa en format JSON, amb els següents camps principals:"

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The start date should match the first date you wish to retrieve data from. Setting it too far in the past may increase processing time."
msgstr "La data d’inici ha de coincidir amb la primera data de la qual es volen recuperar dades. Si s’estableix massa antiga, pot augmentar el temps de processament."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The system automatically saves each reading in Odoo, under the corresponding sensor record.\n"
"This way, daily historical data is continuously stored for later viewing and analysis."
msgstr "El sistema desa automàticament cada lectura a Odoo, dins del registre del sensor corresponent.\n"
"D’aquesta manera, les dades històriques es guarden diàriament per a la seva posterior consulta i anàlisi."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The system performs one request per configured sensor, ensuring that each reading is linked to the correct sensor and device."
msgstr "El sistema fa una petició per a cada sensor configurat, assegurant que cada lectura es vinculi al sensor i dispositiu correctes."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The system uses these credentials to connect with the Riegos Salz web service.\n"
"During the process, the password is automatically encrypted internally (<em>MD5 format</em>), ensuring that it is never sent in plain text."
msgstr "El sistema utilitza aquestes credencials per connectar-se amb el servei web de Riegos Salz.\n"
"Durant el procés, la contrasenya s’encripta automàticament en format intern (<em>MD5</em>), garantint que mai s’enviï en text pla."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "The variable IDs can be obtained from the Riegos Salz platform or through the system's technical equipment list."
msgstr "Els identificadors de variable es poden obtenir des de la plataforma de Riegos Salz o mitjançant el llistat tècnic d’equipaments del sistema."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "This file can be viewed in the remote control attachments section in Odoo.\n"
"A summary message is also recorded in the same entry, allowing historical tracking of past synchronizations."
msgstr "Aquest fitxer es pot consultar a la secció d’adjunts del telecontrol dins d’Odoo.\n"
"També s’hi grava un missatge resum al mateix registre, permetent fer un seguiment històric de les sincronitzacions anteriors."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "This step does not download data yet; it only prepares the synchronization plan."
msgstr "Aquest pas encara no descarrega dades; només prepara el pla de sincronització."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "This system allows connecting Odoo with the <strong>Riegos Salz</strong> platform to automatically import historical data from sensors (flow, pressure, etc.) installed in the remote control system."
msgstr "Aquest sistema permet connectar Odoo amb la plataforma <strong>Riegos Salz</strong> per importar automàticament les dades històriques dels sensors (cabals, pressions, etc.) instal·lats al sistema de telecontrol."

#. module: remotecontrol_riegos_salz
#: model:remotecontrol,remotecontrol_help:remotecontrol_riegos_salz.remotecontrol_riegos_salz
msgid "Verify that the Riegos Salz username and password are correct. If the password changes, update it in Odoo as well."
msgstr "Verifiqueu que l’usuari i la contrasenya de Riegos Salz siguin correctes. Si la contrasenya canvia, actualitzeu-la també a Odoo."

#. module: remotecontrol_riegos_salz
