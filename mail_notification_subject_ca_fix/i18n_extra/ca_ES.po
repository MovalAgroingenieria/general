# Fix: the Catalan translation shipped in the core mail module incorrectly
# translates Python/Mako operators (or->o, and->i) inside a template
# expression, breaking Mako rendering. The correct msgstr keeps the
# expression unchanged (same as msgid).
#. module: mail
#: model:mail.template,subject:mail.mail_template_data_notification_email_default
msgid ""
"${object.subject or (object.record_name and 'Re: %s' % object.record_name) "
"or (object.parent_id and object.parent_id.subject and 'Re: %s' % "
"object.parent_id.subject) or (object.parent_id and "
"object.parent_id.record_name and 'Re: %s' % "
"object.parent_id.record_name)}"
msgstr ""
"${object.subject or (object.record_name and 'Re: %s' % object.record_name) "
"or (object.parent_id and object.parent_id.subject and 'Re: %s' % "
"object.parent_id.subject) or (object.parent_id and "
"object.parent_id.record_name and 'Re: %s' % "
"object.parent_id.record_name)}"
