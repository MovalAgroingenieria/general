#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<em>Get Token</em> → performs <code>POST /Token</code> (form-urlencoded, grant_type=password) and stores <code>bag[\"access_token\"]</code>."
msgstr "<em>Obtener Token</em> → realiza <code>POST /Token</code> (form-urlencoded, grant_type=password) y almacena <code>bag[\"access_token\"]</code>."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>DateTime format:</strong> <code>dd/MM/yyyy HH:mm</code> (European format)."
msgstr "<strong>Formato DateTime:</strong> <code>dd/MM/yyyy HH:mm</code> (formato europeo)."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Regaber Device Type</strong>: <code>skyreg</code>, <code>skyreg_hydrant</code>, or <code>skymeter_nbiot</code>."
msgstr "<strong>Tipo de dispositivo Regaber</strong>: <code>skyreg</code>, <code>skyreg_hydrant</code> o <code>skymeter_nbiot</code>."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Regaber TreeNode ID</strong>: Integer ID from <code>GET /TreeNode</code>."
msgstr "<strong>ID TreeNode Regaber</strong>: ID entero obtenido de <code>GET /TreeNode</code>."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Regaber: Get Last Readings</strong> — Used internally by the WUA module to fetch the last counter value for each configured waterconnection."
msgstr "<strong>Regaber: Obtener últimas lecturas</strong> — Usado internamente por el módulo WUA para obtener el último valor del contador de cada toma configurada."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Regaber: Get Tree Nodes</strong> — Downloads the full element tree and creates a JSON attachment."
msgstr "<strong>Regaber: Obtener nodos del árbol</strong> — Descarga el árbol completo de elementos y crea un adjunto JSON."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Token validity:</strong> 1 day (1 209 599 seconds). Not persisted; each execution requires a new login."
msgstr "<strong>Validez del token:</strong> 1 día (1 209 599 segundos). No se persiste; cada ejecución requiere un nuevo inicio de sesión."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
