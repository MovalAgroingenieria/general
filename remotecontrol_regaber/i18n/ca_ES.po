#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<em>Get Token</em> → performs <code>POST /Token</code> (form-urlencoded, grant_type=password) and stores <code>bag[\"access_token\"]</code>."
msgstr "<em>Obtenir Token</em> → realitza <code>POST /Token</code> (form-urlencoded, grant_type=password) i emmagatzema <code>bag[\"access_token\"]</code>."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>DateTime format:</strong> <code>dd/MM/yyyy HH:mm</code> (European format)."
msgstr "<strong>Format DateTime:</strong> <code>dd/MM/yyyy HH:mm</code> (format europeu)."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Regaber Device Type</strong>: <code>skyreg</code>, <code>skyreg_hydrant</code>, or <code>skymeter_nbiot</code>."
msgstr "<strong>Tipus de dispositiu Regaber</strong>: <code>skyreg</code>, <code>skyreg_hydrant</code> o <code>skymeter_nbiot</code>."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Regaber TreeNode ID</strong>: Integer ID from <code>GET /TreeNode</code>."
msgstr "<strong>ID TreeNode Regaber</strong>: ID enter obtingut de <code>GET /TreeNode</code>."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Regaber: Get Last Readings</strong> — Used internally by the WUA module to fetch the last counter value for each configured waterconnection."
msgstr "<strong>Regaber: Obtenir últimes lectures</strong> — Usat internament pel mòdul WUA per obtenir l'últim valor del comptador de cada toma configurada."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Regaber: Get Tree Nodes</strong> — Downloads the full element tree and creates a JSON attachment."
msgstr "<strong>Regaber: Obtenir nodes de l'arbre</strong> — Descarrega l'arbre complet d'elements i crea un adjunt JSON."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>Token validity:</strong> 1 day (1 209 599 seconds). Not persisted; each execution requires a new login."
msgstr "<strong>Validesa del token:</strong> 1 dia (1 209 599 segons). No es persisteix; cada execució requereix un nou inici de sessió."

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>connection_params</strong> (JSON):"

#. module: remotecontrol_regaber
#: model:remotecontrol,remotecontrol_help:remotecontrol_regaber.remotecontrol_regaber
msgid "<strong>project_id</strong> in <code>connection_params</code> is optional but recommended. If set, discovery/import is limited to that project."
msgstr "<strong>project_id</strong> a <code>connection_params</code> és opcional però recomanat. Si s'indica, el descobriment/importació es limita a aquest projecte."

