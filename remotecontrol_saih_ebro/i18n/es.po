#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<code>fecha</code>: local timestamp in <code>YYYY-MM-DD HH:MM:SS</code> format."
msgstr "<code>fecha</code>: marca de tiempo local en formato <code>YYYY-MM-DD HH:MM:SS</code>."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<code>senal</code>: signal identifier used for sensor matching."
msgstr "<code>senal</code>: identificador de señal utilizado para la coincidencia de sensores."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<code>unidades</code>: unit of measurement, kept in the execution audit."
msgstr "<code>unidades</code>: unidad de medida, guardada en la auditoría de ejecución."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<code>valor</code>: numeric value."
msgstr "<code>valor</code>: valor numérico."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>Base URL:</strong> https://www.saihebro.com"
msgstr "<strong>URL base:</strong> https://www.saihebro.com"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>Build sensors plan</strong>: extract <code>senal</code> from sensor configuration and compute the missing range."
msgstr "<strong>Construir plan de sensores</strong>: extraer <code>senal</code> de la configuración del sensor y calcular el rango faltante."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>Fetch readings</strong>: query <code>/datos/apiopendata</code> in 24-hour chunks per signal."
msgstr "<strong>Obtener lecturas</strong>: consultar <code>/datos/apiopendata</code> en bloques de 24 horas por señal."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>List signals</strong>: query the signal tree and store it as a JSON attachment."
msgstr "<strong>Listar señales</strong>: consultar el árbol de señales y guardarlo como un adjunto JSON."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>Sensor remotecontrol_params (JSON):</strong>"
msgstr "<strong>Parámetros de telecontrol del sensor (JSON):</strong>"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>Signal type:</strong> returned as <code>LS_TIPO_SENAL</code> in the signal list."
msgstr "<strong>Tipo de señal:</strong> devuelto como <code>LS_TIPO_SENAL</code> en el listado de señales."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>Signal:</strong> OpenData signal identifier (for example <code>E282TIHQCAL4</code>)."
msgstr "<strong>Señal:</strong> identificador de señal OpenData (por ejemplo <code>E282TIHQCAL4</code>)."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>Type:</strong> REST"
msgstr "<strong>Tipo:</strong> REST"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>Upsert readings</strong>: store values in <code>mdm.measurement.device.sensor.reading</code> with UTC timestamp."
msgstr "<strong>Guardar lecturas</strong>: almacenar valores en <code>mdm.measurement.device.sensor.reading</code> con marca de tiempo UTC."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>Verify SSL:</strong> False (certificate issue)"
msgstr "<strong>Verificar SSL:</strong> Falso (problema de certificado)"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "<strong>connection_params</strong> (JSON):"
msgstr "<strong>Parámetros de conexión</strong> (JSON):"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "An optional device-level <code>start_date</code> can also be used as fallback:"
msgstr "Se puede usar opcionalmente <code>start_date</code> a nivel de dispositivo como respaldo:"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "Conversion is automatic during upsert."
msgstr "La conversión es automática durante la carga."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "GET /api/opendata/getListaSenalesArbol"
msgstr "GET /api/opendata/getListaSenalesArbol"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "GET /datos/apiopendata?senal=&lt;SENAL&gt;&amp;inicio=&lt;YYYY-MM-DDTHH:MM:SS&gt;&amp;apikey=&lt;API_KEY&gt;"
msgstr "GET /datos/apiopendata?senal=&lt;SENAL&gt;&amp;inicio=&lt;YYYY-MM-DDTHH:MM:SS&gt;&amp;apikey=&lt;API_KEY&gt;"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "Odoo stores readings in UTC."
msgstr "Odoo almacena las lecturas en UTC."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "SAIH Ebro OpenData organizes readings by signal code:"
msgstr "SAIH Ebro OpenData organiza las lecturas por código de señal:"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "SAIH Ebro timestamps are in local time (Europe/Madrid)."
msgstr "Las marcas de tiempo de SAIH Ebro están en hora local (Europa/Madrid)."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "SAIH Ebro · OpenData API"
msgstr "SAIH Ebro · API OpenData"

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "The legacy keys <code>tag</code> and <code>signal</code> are also accepted as aliases for <code>senal</code>."
msgstr "Las claves antiguas <code>tag</code> y <code>signal</code> también se aceptan como alias de <code>senal</code>."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "The service returns only the 24 hours following the requested start date."
msgstr "El servicio devuelve solo las 24 horas siguientes a la fecha de inicio solicitada."

#. module: remotecontrol_saih_ebro
#: model:remotecontrol,remotecontrol_help:remotecontrol_saih_ebro.remotecontrol_saih_ebro
msgid "{\n"
"    \"api_key\": \"your_api_key_here\",\n"
"    \"default_start_date\": \"2026-06-19T00:00:00\"\n"
"}"
msgstr "{\n"
"    \"api_key\": \"your_api_key_here\",\n"
"    \"default_start_date\": \"2026-06-19T00:00:00\"\n"
